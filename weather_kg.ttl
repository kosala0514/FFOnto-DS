ffonto:IoU a owl:Class ;
    rdfs:label "Intersection over Union" ;
    rdfs:comment "Intersection over Union; a metric comparing area overlap between predicted and reference regions."@en ;
    rdfs:subClassOf ffonto:EvaluationMetric .

ffonto:LaNina a ffonto:ClimateDriver ;
    rdfs:label "La Niña" ;
    rdfs:comment "Cool phase of ENSO often associated with drought conditions in some regions." .

ffonto:LadderFuel a ffonto:FuelType ;
    rdfs:label "Ladder Fuel" ;
    rdfs:comment "Vegetation providing a vertical pathway for fire to climb from the surface to the canopy." .

ffonto:LandslideRisk a owl:Class ;
    rdfs:label "Landslide Risk" ;
    rdfs:comment "Potential ground instability or rockfall that may affect roads or evacuation routes." ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:LeaveEarlyAdvice a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Leave Early Advice" ;
    rdfs:comment "Recommendation to leave early to avoid traffic congestion and rapidly changing fire/smoke." .

ffonto:LeftFlank a owl:Class ;
    rdfs:label "Left Flank" ;
    rdfs:comment "The left lateral edge of a wildfire's active burning front."@en ;
    rdfs:subClassOf ffonto:FireFlank .

ffonto:LiDAR a owl:Class ;
    rdfs:label "LiDAR",
        "LiDAR sensor"@en ;
    rdfs:comment "A remote sensing technology that measures distance using laser light to produce terrain models."@en ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:LiabilityRule a owl:Class ;
    rdfs:label "Liability Rule" ;
    rdfs:comment "A legal rule or policy that assigns responsibility for damages or harms."@en ;
    rdfs:subClassOf ffonto:LegalFramework .

ffonto:LicensePlateBlurring a owl:Class ;
    rdfs:label "License Plate Blurring" ;
    rdfs:comment "A privacy-preserving technique that obscures vehicle license plates in images or videos."@en ;
    rdfs:subClassOf ffonto:PrivacyProtection .

ffonto:LightGray a ffonto:SmokeColor,
        owl:NamedIndividual ;
    rdfs:label "light-gray" .

ffonto:LightningStrike a owl:Class ;
    rdfs:label "Lightning Strike" ;
    rdfs:comment "A single occurrence of lightning contacting the ground or an object."@en ;
    rdfs:subClassOf ffonto:NaturalCause,
        ffonto:NaturalIgnition .

ffonto:Lignin a ffonto:VegetationChemicalComponent ;
    rdfs:label "Lignin" .

ffonto:LitterFuel a owl:Class ;
    rdfs:label "Litter fuel" ;
    rdfs:comment "Small, fine fuels such as leaves and small twigs (fast-burning)." ;
    rdfs:subClassOf ffonto:FuelLoad .

ffonto:LiveFuel a owl:Class ;
    rdfs:label "Live fuel" ;
    rdfs:comment "Live vegetation that can act as fuel when sufficiently dry." ;
    rdfs:subClassOf ffonto:FuelLoad .

ffonto:LocalBuildingCode a ffonto:BuildingCode ;
    rdfs:label "Local WUI Building Code" ;
    ffonto:recommendedAction "Requires ember-resistant vents and non-combustible siding." .

ffonto:LocalCommunityPlan a ffonto:CommunityPreparedness ;
    rdfs:label "Neighborhood Evacuation & Preparedness Plan" ;
    ffonto:hasEmergencyKit ffonto:StandardKit ;
    ffonto:hasEvacuationPlan ffonto:RouteAPlan .

ffonto:LockHomeBeforeLeaving a ffonto:BeforeEvacuationAction ;
    rdfs:label "Lock Home Before Leaving" ;
    rdfs:comment "Close and lock main doors and windows prior to evacuation but leave garage unlocked for responders if advised." .

ffonto:Logging a owl:Class ;
    rdfs:label "Logging" ;
    rdfs:comment "Human activity involving cutting down trees for timber." ;
    rdfs:subClassOf ffonto:Disturbance .

ffonto:LookoutTower a owl:Class ;
    rdfs:label "Lookout Tower Detection" ;
    rdfs:comment "A staffed elevated structure used for fire detection and observation."@en ;
    rdfs:subClassOf ffonto:DetectionMethod .

ffonto:LowFireRisk a owl:Class ;
    rdfs:label "Low fire risk" ;
    rdfs:comment "Indicates low probability of wildfire ignition or spread." ;
    rdfs:subClassOf ffonto:FireSusceptibility .

ffonto:LowFlammability a owl:Class ;
    rdfs:label "Low Flammability" ;
    rdfs:comment "A trait describing vegetation that resists ignition and contributes less to fire intensity." ;
    rdfs:subClassOf ffonto:PlantFlammabilityTrait .

ffonto:LowHumidity a ffonto:EnvironmentalCondition ;
    rdfs:label "Low Humidity" .

ffonto:LowVisibility a ffonto:VisibilityCategory,
        owl:NamedIndividual ;
    rdfs:label "low" .

ffonto:LungDamage a ffonto:RespiratoryIssue ;
    rdfs:label "Lung Damage / COPD risk" ;
    rdfs:comment "ForestFire smoke can cause inflammation, COPD-like outcomes; observed in primate studies from CNPRC / UC Davis." .

ffonto:MERV13Filter a ffonto:IndoorAirQualityStrategy ;
    rdfs:label "MERV-13 Filter" ;
    rdfs:comment "HVAC filter capable of capturing fine smoke particles." .

ffonto:MODIS a owl:Class ;
    rdfs:label "MODIS (polar thermal sensor)" ;
    rdfs:comment "Moderate Resolution Imaging Spectroradiometer; a satellite sensor providing Earth observation data."@en ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:MODISSensor a ffonto:RemoteSensingSensor ;
    rdfs:label "MODIS Satellite Sensor" .

ffonto:MatureForest a owl:Class ;
    rdfs:label "Mature forest" ;
    rdfs:comment "Forest ecosystem with established canopy and stable vegetation structure." ;
    rdfs:subClassOf ffonto:Forest .

ffonto:MeasurementResult a owl:Class ;
    rdfs:label "MeasurementResult" ;
    rdfs:comment "Numeric or measured values (e.g., temperature, humidity)." ;
    rdfs:subClassOf ffonto:Result .

ffonto:MediumVisibility a ffonto:VisibilityCategory,
        owl:NamedIndividual ;
    rdfs:label "medium" .

ffonto:MentalHealthRisk a owl:Class ;
    rdfs:label "Mental Health Risk" ;
    rdfs:comment "The potential for adverse psychological impacts resulting from exposure to stressors or trauma."@en ;
    rdfs:subClassOf ffonto:FirefighterHealthSafety .

ffonto:MeshNetwork a owl:Class ;
    rdfs:label "Mesh Network" ;
    rdfs:comment "A network topology where nodes relay data for robust, decentralized communications."@en ;
    rdfs:subClassOf ffonto:CommunicationNetwork .

ffonto:MinorMisuse a owl:Class ;
    rdfs:label "Misuse by Minors" ;
    rdfs:comment "Usage of a resource or tool outside intended procedures that causes little or no harm."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:MixedVegetation a owl:Class ;
    rdfs:label "Mixed vegetation" ;
    rdfs:comment "Vegetation composed of multiple plant species." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:ModerateFireRisk a owl:Class ;
    rdfs:label "Moderate fire risk" ;
    rdfs:comment "Indicates moderate wildfire risk under certain environmental conditions." ;
    rdfs:subClassOf ffonto:FireSusceptibility .

ffonto:ModerateFlammability a owl:Class ;
    rdfs:label "Moderate Flammability" ;
    rdfs:comment "A trait describing vegetation with moderate susceptibility to ignition and burning." ;
    rdfs:subClassOf ffonto:PlantFlammabilityTrait .

ffonto:Moss a owl:Class ;
    rdfs:label "Moss" ;
    rdfs:comment "Small non-vascular plants commonly found in moist or nutrient-poor environments." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:MountainPineBeetle a ffonto:InsectInfestation ;
    rdfs:label "Mountain Pine Beetle" ;
    rdfs:comment "A destructive insect responsible for widespread forest mortality." .

ffonto:MountainSlope a owl:Class ;
    rdfs:label "Mountain Slope" ;
    rdfs:comment "The inclined surface of mountainous terrain, often affecting water flow and fire behavior."@en ;
    rdfs:subClassOf ffonto:TerrainFeature .

ffonto:MoveFlammableInside a ffonto:BeforeEvacuationAction ;
    rdfs:label "Move Flammable Items Inside" ;
    rdfs:comment "Move patio furniture, firewood, and other combustibles away from structure or inside." .

ffonto:N95Respirator a ffonto:ClothingRecommendation,
        ffonto:ProtectionMethod ;

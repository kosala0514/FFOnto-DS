    rdfs:comment "Respirator for particulate smoke protection (not a substitute for medical advice).",
        "Respirator mask capable of filtering fine particulate smoke." .

ffonto:NAspect a ffonto:AspectCategory ;
    rdfs:label "north" .

ffonto:NDVI a ffonto:VegetationIndex,

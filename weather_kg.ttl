    rdfs:comment "Inverse relation linking monitoring records back to the objects or sites monitored."@en ;
    rdfs:domain ffonto:RemoteSensing ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:monitoredBy .

ffonto:monitoredUsingInverse a owl:ObjectProperty ;
    rdfs:label "inverse of monitored using"@en ;
    rdfs:comment "Inverse relation linking monitoring methods back to the systems or sites they monitor."@en ;
    rdfs:domain ffonto:RemoteSensingSensor ;
    rdfs:range ffonto:ForestFire ;

    rdfs:comment "Connects wildfire to health outcomes from smoke." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SmokeHealthEffect .

ffonto:causesSymptom a owl:ObjectProperty ;

ffonto:treeCrownCondition a owl:DatatypeProperty ;
    rdfs:label "tree crown condition" ;
    rdfs:comment "Describes whether tree crowns appear scorched, intact, or mixed." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:treeCrownStatus a owl:DatatypeProperty ;
    rdfs:label "tree crown status" ;
    rdfs:comment "Status of tree crowns: 'scorched', 'partially consumed', 'fully consumed', 'unaffected'." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:string .

ffonto:treeSpacing a owl:DatatypeProperty ;
    rdfs:label "tree spacing" ;
    rdfs:comment "Represents the spacing between trees within a forest ecosystem." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range xsd:string .

ffonto:treeTrunksCharred a owl:DatatypeProperty ;

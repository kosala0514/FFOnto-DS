    rdfs:comment "Indicates whether a bulldozer is actively cutting a firebreak." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range xsd:boolean .

ffonto:burnDurationHours a owl:DatatypeProperty ;
    rdfs:label "burn duration (hours)" ;
    rdfs:comment "Duration of the fire event measured in hours." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:burnSeverityIndex a owl:DatatypeProperty ;

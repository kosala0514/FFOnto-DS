    rdfs:comment "Indicates whether vehicles are parked a safe distance away from flames." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehiclesTurningAround a owl:DatatypeProperty ;

ffonto:buildingBurned a owl:DatatypeProperty ;
    rdfs:label "building burned" ;
    rdfs:comment "Indicates whether the building was burned in the wildfire." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:buildingDestroyed a owl:DatatypeProperty ;
    rdfs:label "building destroyed" ;
    rdfs:comment "Indicates whether the building was completely destroyed." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:buildingThreatened a owl:DatatypeProperty ;
    rdfs:label "building threatened by embers/heat" ;
    rdfs:comment "Indicates that a structure is at risk of damage from a hazard such as fire."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:buildingVisible a owl:DatatypeProperty ;
    rdfs:label "building visible" ;
    rdfs:comment "Indicates that a building is observable in imagery or situational reports."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:bulldozerCuttingLine a owl:DatatypeProperty ;

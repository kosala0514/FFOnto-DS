    rdfs:comment "Heat index value expressed in degrees Fahrenheit reflecting perceived temperature."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:heatStressRiskPresent a owl:DatatypeProperty ;

ffonto:ActiveFireDetection a owl:Class ;
    rdfs:label "Active Fire Detection" ;
    rdfs:comment "Satellite detection of actively burning fires using thermal sensors." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:AerialResource a owl:Class ;
    rdfs:label "Aerial Firefighting Resource" ;
    rdfs:comment "Aircraft used for water or retardant drops." ;
    rdfs:subClassOf ffonto:SuppressionResource .

ffonto:AirQualityIndex a owl:Class ;
    rdfs:label "Air Quality Index" ;
    rdfs:comment "A numeric scale indicating the quality of air and potential health impacts."@en ;
    rdfs:subClassOf ffonto:AirPollutionMetric .

ffonto:AshFall a owl:Class ;
    rdfs:label "Ash Fall"@en ;
    rdfs:comment "Represents ash deposition events or ash material resulting from fires."@en .

ffonto:AuditRecord a owl:Class ;
    rdfs:label "Audit Record" ;
    rdfs:comment "Audit artifacts such as checksums and class-map checksums." .

ffonto:BriefingArea a owl:Class ;
    rdfs:label "Briefing Area" ;
    rdfs:comment "Location where firefighters receive operational briefings." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:ChallengeOpportunity a owl:Class ;
    rdfs:label "Challenges and Opportunities" ;
    rdfs:comment "Contemporary drivers like climate change and tech advances." .

ffonto:Civilian a owl:Class ;
    rdfs:label "Civilian" ;
    rdfs:comment "Non-responder individuals present in the wildfire area." .

ffonto:CleanAirShelter a owl:Class ;
    rdfs:label "Clean Air Shelter" ;
    rdfs:comment "Building providing filtered indoor air during smoke events." ;
    rdfs:subClassOf ffonto:EmergencyFacility .

ffonto:CommunicationMethod a owl:Class ;
    rdfs:label "Communication Method" ;
    rdfs:comment "Channels used for operational and public communication." .

ffonto:EcologicalStress a owl:Class ;
    rdfs:label "Ecological stress" ;
    rdfs:comment "Environmental pressure affecting ecosystem stability." .

ffonto:EmergencyVehicle a owl:Class ;
    rdfs:label "Emergency Vehicle" ;
    rdfs:comment "Fire trucks, ambulances, and responder vehicles." ;
    rdfs:subClassOf ffonto:Vehicle .

ffonto:EmissionEstimate a owl:Class ;
    rdfs:label "Emission Estimate" ;
    rdfs:comment "An estimate of pollutant or greenhouse gas emissions produced by a source or event."@en ;
    rdfs:subClassOf ffonto:CarbonEmission .

ffonto:EnsembleForecast a owl:Class ;
    rdfs:label "Ensemble Forecast" ;
    rdfs:comment "A forecast produced by combining multiple model runs to represent uncertainty and improve robustness."@en ;
    rdfs:subClassOf ffonto:FireBehaviorModel .

ffonto:EstimationMethod a owl:Class ;
    rdfs:label "Estimation method" ;
    rdfs:comment "A method used to estimate wildfire characteristics such as spread, size, or risk." .

ffonto:EvacuationPlan a owl:Class ;
    rdfs:label "Evacuation Plan" ;
    rdfs:comment "A predefined procedure describing how people should evacuate an area safely."@en ;
    rdfs:subClassOf ffonto:CommunityPreparedness .

ffonto:ExplainableAI a owl:Class ;
    rdfs:label "Explainable AI"@en ;
    rdfs:comment "Techniques that make machine learning model decisions interpretable for wildfire prediction systems."@en ;
    rdfs:subClassOf ffonto:AIModelGovernance .

ffonto:FireEngine a ffonto:FirefightingResource,
        ffonto:SuppressionResource ;
    rdfs:label "Fire Engine" ;
    rdfs:comment "Emergency vehicle used by firefighters to combat fires and protect structures.",
        "Ground vehicle used for transporting firefighters and equipment." ;
    rdfs:subClassOf ffonto:FirefightingResource .

ffonto:FireFlank a owl:Class ;
    rdfs:label "Fire Flank" ;
    rdfs:comment "Side of the fire perimeter (left or right)." ;
    rdfs:subClassOf ffonto:FireFront .

ffonto:FireGeneratedWeather a owl:Class ;
    rdfs:label "Fire Generated Weather" ;
    rdfs:comment "Pyro-weather phenomena created by intense fires." .

ffonto:FireRegime a owl:Class ;
    rdfs:label "Fire Regime" ;
    rdfs:comment "Historical pattern of fire (frequency, intensity, seasonality, size)." ;
    rdfs:subClassOf ffonto:ClimatePattern .

ffonto:FireSpreadCondition a owl:Class ;
    rdfs:label "Fire Spread Condition" ;
    rdfs:comment "Environmental or ecological conditions that influence how a fire spreads across a landscape." .

ffonto:FireType a owl:Class ;
    rdfs:label "Fire Type" ;
    rdfs:comment "Represents categories used to classify fire events." .

ffonto:FireWeatherIndex a owl:Class ;
    rdfs:label "Fire Weather Index (FWI)" ;
    rdfs:comment "Index combining temperature, humidity, wind and precipitation to quantify fire risk." .

ffonto:FlightPath a owl:Class ;
    rdfs:label "Aircraft Flight Path" ;
    rdfs:comment "A planned or recorded trajectory that an aircraft follows between waypoints."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:ForestFireCause a owl:Class ;
    rdfs:label "ForestFire Cause" ;
    rdfs:comment "Natural or human activities responsible for wildfire ignition." .

ffonto:ForestFireRisk a owl:Class ;
    rdfs:label "Forest fire risk"@en ;
    rdfs:comment "The likelihood or probability that a wildfire may start and spread in a forested area based on environmental, climatic, and human factors."@en ;
    rdfs:subClassOf ffonto:RiskAssessment ;
    skos:altLabel "Wildfire risk"@en ;
    skos:definition "A risk assessment concept representing the potential for wildfire ignition and propagation in forest ecosystems."@en .

ffonto:FuelMoisture a owl:Class ;
    rdfs:label "Fuel Moisture" ;
    rdfs:comment "The moisture content of combustible vegetation or fuels, usually expressed as a percentage."@en ;
    rdfs:subClassOf ffonto:FuelCharacteristic .

ffonto:GridLocation a owl:Class ;
    rdfs:label "Grid Location" ;
    rdfs:comment "Spatial grid reference for the monitored site." .

ffonto:IgnitionCause a owl:Class ;
    rdfs:label "Ignition Cause" ;
    rdfs:comment "Factor or event that initiates combustion." .

ffonto:ImpactHazard a owl:Class ;
    rdfs:label "Impact Hazard" ;
    rdfs:comment "Hazard from direct impact of drops (force, debris) or contamination." .

ffonto:IncidentCommandRole a owl:Class ;
    rdfs:label "incident command role"@en ;
    rdfs:comment "A designated function or position within the Incident Command System (ICS) managing the emergency response."@en .

ffonto:IntentionalFire a owl:Class ;
    rdfs:label "Intentional Fire" ;
    rdfs:comment "A fire intentionally set for land clearing or agriculture." ;
    rdfs:subClassOf ffonto:ForestFire .

ffonto:KnowledgeGraph a owl:Class ;
    rdfs:label "Knowledge Graph" ;
    rdfs:comment "Graph representation linking incidents, resources, assets and infrastructure." ;
    rdfs:subClassOf ffonto:DataRepository .

ffonto:LandManagementPractice a owl:Class ;
    rdfs:label "Land Management Practice" ;
    rdfs:comment "A method applied to land to achieve ecological, safety, or production goals."@en ;
    rdfs:subClassOf prov:Activity .

ffonto:LandscapeFeature a owl:Class ;
    rdfs:label "Landscape Feature" ;
    rdfs:comment "A physical natural feature of the landscape." .

ffonto:Limitations a owl:Class ;
    rdfs:label "Operational Limitation" ;
    rdfs:comment "Factors that limit suppression (extreme winds, inaccessible terrain, resource shortage, firefighter safety)." .

ffonto:ManagementAction a owl:Class ;
    rdfs:label "Management action" ;
    rdfs:comment "Human management activities (prescribed burn, buffer creation, reseeding)." .

ffonto:ModalityConsistency a owl:Class ;
    rdfs:label "Modality Consistency Check" ;
    rdfs:comment "Evaluation of consistency between modalities (image, audio, caption, weather)." .

ffonto:ModelExecution a owl:Class ;
    rdfs:label "Model Execution" ;
    rdfs:comment "A specific run of a model on data." .

ffonto:NaturalIgnition a owl:Class ;
    rdfs:label "Natural ignition" ;
    rdfs:comment "Natural causes of ignition such as lightning." ;
    rdfs:subClassOf ffonto:IgnitionCause,
        ffonto:IgnitionSource ;
    owl:disjointWith ffonto:AccidentalIgnition .

ffonto:OperationalStrategy a owl:Class ;
    rdfs:label "operational strategy"@en ;
    rdfs:comment "A high-level plan of action designed to achieve specific goals during an incident response."@en .

ffonto:ParticulateMatter a owl:Class ;
    rdfs:label "Particulate Matter" ;
    rdfs:comment "Tiny particles or droplets (dust, soot, smoke) that affect air quality." ;
    rdfs:subClassOf ffonto:AirPollution,
        ffonto:SmokeComponent .

ffonto:PublicWarningSystem a owl:Class ;
    rdfs:label "Public Warning System" ;
    rdfs:comment "A system for issuing warnings and alerts to the public during emergencies."@en ;
    rdfs:subClassOf ffonto:EmergencyAlert .

ffonto:RateOfSpread a owl:Class ;
    rdfs:label "Rate of Spread" ;
    rdfs:comment "The rate at which a fire front advances over the landscape, typically distance per time."@en ;
    rdfs:subClassOf ffonto:FireBehaviorMetric .

ffonto:RegulatingService a owl:Class ;
    rdfs:label "Regulating Service" ;
    rdfs:comment "Benefits obtained from the regulation of ecosystem processes." ;
    rdfs:subClassOf ffonto:EcosystemService .

ffonto:RemoteSensing a owl:Class ;
    rdfs:label "Remote Sensing" ;
    rdfs:comment "The acquisition of information about objects or areas from a distance, typically via satellites or aircraft."@en .

ffonto:RemoteSensingMethod a owl:Class ;
    rdfs:label "Remote Sensing Method" ;
    rdfs:comment "Satellite or radar techniques used to monitor wildfire risk and impacts." .

ffonto:Roadway a owl:Class ;
    rdfs:label "Roadway" ;
    rdfs:comment "Road surface, lanes, or parking lots within the scene." ;
    rdfs:subClassOf ffonto:TransportationInfrastructure .

ffonto:SimulationModel a owl:Class ;
    rdfs:label "simulation model"@en ;
    rdfs:comment "A computational model used to simulate physical processes, such as fire spread or smoke dispersion."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:SmokeCondition a owl:Class ;
    rdfs:label "Smoke Condition" ;
    rdfs:comment "Represents characteristics of smoke present at the wildfire scene." .

ffonto:SpecialNeedsPlan a owl:Class ;
    rdfs:label "Special Needs Plan" ;
    rdfs:comment "Preparedness measures for those with disabilities, medical dependencies, or other special requirements." .

ffonto:StructuralDamage a owl:Class ;
    rdfs:label "Structural Damage" ;
    rdfs:comment "Damage affecting buildings after wildfire." .

ffonto:SurvivalGuidance a owl:Class ;
    rdfs:label "Survival Guidance" ;
    rdfs:comment "Recommended behaviours during wildfire incidents (evacuate, heed authorities, PPE for smoke)." .

ffonto:TelemetryData a owl:Class ;
    rdfs:label "Telemetry Data" ;
    rdfs:comment "Remote measurements transmitted from sensors or systems for monitoring and analysis."@en .

ffonto:TimeSeriesAnalysis a owl:Class ;
    rdfs:label "Time Series Analysis" ;
    rdfs:comment "Analysis of environmental variables over time to detect trends or anomalies." ;
    rdfs:subClassOf ffonto:DataAnalysisProcess .

ffonto:Topography a owl:Class ;
    rdfs:label "Topography" ;
    rdfs:comment "Physical features of terrain influencing wildfire behavior." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor .

ffonto:TrainingProgram a owl:Class ;
    rdfs:label "Training Program" ;
    rdfs:comment "Educational programs designed to prepare firefighters and communities for wildfire events." .

ffonto:VegetationType a owl:Class ;
    rdfs:label "Vegetation Type" ;
    rdfs:comment "Type of vegetation burning in the wildfire." .

ffonto:WaterTank a owl:Class ;
    rdfs:label "Water Tank" ;
    rdfs:comment "A storage container or reservoir used to store water for firefighting, domestic supply, or emergency use." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:Watershed a owl:Class ;
    rdfs:label "Watershed" ;
    rdfs:comment "A land area where precipitation collects and drains into a common outlet such as a river, lake, or ocean." .

ffonto:hasObservation a owl:ObjectProperty ;
    rdfs:label "has observation"@en ;
    rdfs:comment "Associates an entity with a recorded observation or measurement."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:isObservationOf .

sosa:Sensor rdfs:label "Sensor"@en ;
    rdfs:comment "A device, agent, or software component that observes or measures environmental or physical properties."@en .

ffonto:AccessConstraintDetail a owl:Class ;
    rdfs:label "Access Constraint Detail" ;
    rdfs:comment "Specific access limitations (road blockage, steep grade, narrow road)." .

ffonto:AirCleaner a owl:Class ;
    rdfs:label "Air Cleaner" ;
    rdfs:comment "Device used to filter indoor air." ;
    rdfs:subClassOf ffonto:AirQualityMitigationDevice .

ffonto:AirQualityMitigationStrategy a owl:Class ;
    rdfs:label "air quality mitigation strategy"@en ;
    rdfs:comment "A procedural or policy-based approach to reducing the harmful effects of air pollution on a population."@en .

ffonto:AircraftTracking a owl:Class ;
    rdfs:label "Aircraft Tracking" ;
    rdfs:comment "Monitoring and recording the position and movement of aircraft."@en ;
    rdfs:subClassOf ffonto:AirspaceManagement .

ffonto:AirspaceManagement a owl:Class ;
    rdfs:label "Airspace Management" ;
    rdfs:comment "Procedures and controls for safe and efficient use of airspace during operations."@en ;
    rdfs:subClassOf ffonto:OperationalStrategy .

ffonto:Bridge a owl:Class ;
    rdfs:label "Bridge" ;
    rdfs:comment "Bridges appearing within the scene." ;
    rdfs:subClassOf ffonto:TransportationInfrastructure .

ffonto:ClimateMitigation a owl:Class ;
    rdfs:label "Climate Change Mitigation" ;
    rdfs:comment "Actions taken to reduce greenhouse gas emissions or limit climate change impacts."@en .

ffonto:ClimatePattern a owl:Class ;
    rdfs:label "climate pattern"@en ;
    rdfs:comment "A recurring or sustained meteorological trend within a specific region or on a global scale (e.g., El Niño)."@en .

ffonto:CommunicationNetwork a owl:Class ;
    rdfs:label "Communication Network" ;
    rdfs:comment "Systems and infrastructure enabling information exchange among stakeholders and responders."@en .

ffonto:ContainmentState a owl:Class ;
    rdfs:label "Containment State" ;
    rdfs:comment "Discrete incident status values." .

ffonto:DataProvider a owl:Class ;
    rdfs:label "Data Provider Organization" ;
    rdfs:comment "Organizations that provide wildfire, climate, or satellite data." .

ffonto:EmergencyAlert a owl:Class ;
    rdfs:label "Emergency Alert" ;
    rdfs:comment "A message intended to notify the public or specific groups about an immediate hazard."@en .

ffonto:EmergencyContact a owl:Class ;
    rdfs:label "Emergency Contact" ;
    rdfs:comment "A contact point such as a hotline or emergency number for wildfire-related assistance." .

ffonto:EmergencyOperation a owl:Class ;
    rdfs:label "Emergency Operation Activity" ;
    rdfs:comment "Planned actions and activities performed to respond to and manage an emergency."@en .

ffonto:FireElement a owl:Class ;
    rdfs:label "Fire Element" ;
    rdfs:comment "An essential component required for fire ignition and combustion." .

ffonto:FireSusceptibility a owl:Class ;
    rdfs:label "Fire susceptibility" ;
    rdfs:comment "Classification of how vulnerable an ecosystem is to wildfire ignition and spread." .

ffonto:FirefighterHealthSafety a owl:Class ;
    rdfs:label "Firefighter Health and Safety" ;
    rdfs:comment "Policies and practices aimed at protecting the health and wellbeing of firefighting personnel."@en .

ffonto:ForestFireEffect a owl:Class ;
    rdfs:label "Forest Fire Effect"@en ;
    rdfs:comment "Represents the ecological, environmental, or economic consequence resulting from a wildfire, such as soil erosion or habitat loss."@en .

ffonto:ForestFirePredictionModel a owl:Class ;
    rdfs:label "ForestFire Prediction Model" ;
    rdfs:comment "Computational models used to forecast wildfire ignition, spread, and impact." .

ffonto:ForestFirePrevention a owl:Class ;
    rdfs:label "ForestFire Prevention" ;
    rdfs:comment "Practices aimed at preventing wildfire ignition." .

ffonto:HealthEffect a owl:Class ;
    rdfs:label "Health Effect" ;
    rdfs:comment "Human health impacts caused by smoke or toxic pollutants." .

ffonto:HeavyEquipment a owl:Class ;
    rdfs:label "Heavy Equipment" ;
    rdfs:comment "Large machines such as bulldozers or excavators." .

ffonto:ImageQualityMetadata a owl:Class ;
    rdfs:label "Image Quality Metadata" ;
    rdfs:comment "Quality-related metadata such as blur, cloud_cover quality flags, georeference presence and sensor pose." .

ffonto:LegalFramework a owl:Class ;
    rdfs:label "Legal and Policy Framework" ;
    rdfs:comment "Laws, regulations and policies governing wildfire management." .

ffonto:MLOpsPipeline a owl:Class ;
    rdfs:label "MLOps Pipeline" ;
    rdfs:comment "A sequence of processes for developing, deploying, and maintaining machine learning models in production."@en .

ffonto:MonitoringSystem a owl:Class ;
    rdfs:label "Monitoring System" ;
    rdfs:comment "Technological systems used to monitor wildfire risk or detect fires early." .

ffonto:Plant a owl:Class ;
    rdfs:label "Plant" ;
    rdfs:comment "A living organism belonging to the plant kingdom that performs photosynthesis and forms the biological basis of vegetation in terrestrial ecosystems." .

ffonto:PlantFlammabilityTrait a owl:Class ;
    rdfs:label "Plant Flammability Trait" ;
    rdfs:comment "A characteristic of plant species that influences their susceptibility to ignition and contribution to fire intensity." .

ffonto:PreparednessKit a owl:Class ;
    rdfs:label "Preparedness Kit" ;
    rdfs:comment "A disaster or go-kit with supplies for families and pets." .

ffonto:PreventionMeasure a owl:Class ;
    rdfs:label "Prevention Measure" ;
    rdfs:comment "An action designed to reduce the likelihood or impact of an adverse event."@en ;
    rdfs:subClassOf ffonto:SafetyMeasure .

ffonto:PreventionMethod a owl:Class ;
    rdfs:label "Prevention Method" ;
    rdfs:comment "Strategies or methods used to reduce wildfire risk." .

ffonto:ProtectionMethod a owl:Class ;
    rdfs:label "Protection Method" ;
    rdfs:comment "Method used to reduce smoke exposure or health risk." .

ffonto:ProtectiveEquipment a owl:Class ;
    rdfs:label "Protective Equipment" ;
    rdfs:comment "Personal gear intended to protect individuals from hazards (e.g., helmets, masks)."@en ;
    rdfs:subClassOf ffonto:FirefighterHealthSafety .

ffonto:PublicEducationProgram a owl:Class ;
    rdfs:label "Public Education Program" ;
    rdfs:comment "An organized effort to educate the public about risks, preparedness, and safe behaviors."@en .

ffonto:ReadySetGoPlan a owl:Class ;
    rdfs:label "Ready–Set–Go Plan" ;
    rdfs:comment "Three-stage public guidance: Ready (prepare), Set (be packed), Go (leave immediately)." ;
    rdfs:subClassOf ffonto:EvacuationPlan .

ffonto:Runoff a owl:Class ;
    rdfs:label "Runoff" ;
    rdfs:comment "Water flow occurring when soil cannot absorb rainfall." .

ffonto:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "A device that detects and measures physical or environmental properties and outputs data."@en ;
    rdfs:subClassOf sosa:Sensor .

ffonto:Smoke a owl:Class ;
    rdfs:label "Smoke" ;
    rdfs:comment "Visible smoke produced by combustion." ;
    rdfs:subClassOf ffonto:AirPollution .

ffonto:SnowCover a owl:Class ;
    rdfs:label "Snow Cover" ;
    rdfs:comment "Snow present on the ground that can influence fire behavior by reducing vegetation dryness and limiting fire spread." ;
    rdfs:subClassOf ffonto:EnvironmentalCondition ;
    owl:disjointWith ffonto:SoilCondition .

ffonto:StructureLossStatus a owl:Class ;
    rdfs:label "Structure Loss Status" ;
    rdfs:comment "Classification for damage: intact, damaged, total loss." .

ffonto:TrafficControlDevice a owl:Class ;
    rdfs:label "Traffic Control Device" ;
    rdfs:comment "Cones, barricades, signs, tape used to control access." .

ffonto:TransportationInfrastructure a owl:Class ;
    rdfs:label "Transportation Infrastructure" ;
    rdfs:comment "Infrastructure related to transport (roads, bridges, guardrails, culverts, parking lots)." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:Trend a owl:Class ;
    rdfs:label "Trend (enum)" ;
    rdfs:comment "Temporal trend: increasing, decreasing, stable." ;
    rdfs:subClassOf ffonto:TimeSeriesAnalysis .

ffonto:UtilityInfrastructure a owl:Class ;
    rdfs:label "Utility Infrastructure" ;
    rdfs:comment "Infrastructure related to utilities (power poles, lines, transformers, insulators, meters)." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:VegetationRegrowth a owl:Class ;
    rdfs:label "Vegetation Regrowth" ;
    rdfs:comment "The regrowth of plant species following wildfire disturbance." .

ffonto:VisibilityCategory a owl:Class ;
    rdfs:label "Visibility Category (enum)" ;
    rdfs:comment "Low, Medium, High scene visibility due to smoke." ;
    rdfs:subClassOf ffonto:AirQualityIndex .

sosa:Platform a owl:Class ;
    rdfs:label "platform"@en ;
    rdfs:comment "An entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms."@en .

ffonto:AgriculturalProduce a owl:Class ;
    rdfs:label "Agricultural Produce" ;
    rdfs:comment "Food crops grown at home or on farms that may be affected by wildfire ash." .

ffonto:Aircraft a owl:Class ;
    rdfs:label "Aircraft" ;
    rdfs:comment "Aircraft used in wildfire suppression." .

ffonto:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:comment "Additional information derived from data, not a direct physical observation." .

ffonto:AudioRecord a owl:Class ;
    rdfs:label "Audio Record" ;
    rdfs:comment "An audio clip and its metadata (path, uuid, source, event ids, model outputs)." .

ffonto:BurnSeverityMap a owl:Class ;
    rdfs:label "Burn Severity Map" ;
    rdfs:comment "A spatial representation indicating the intensity or ecological severity of burned areas."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:CaptionModelOutput a owl:Class ;
    rdfs:label "Caption Model Output" ;
    rdfs:comment "Text caption produced by an image captioning model and related descriptors." ;
    owl:subClassOf ffonto:ModelOutput .

ffonto:ContinuityStrategy a owl:Class ;
    rdfs:label "Business Continuity Strategy" ;
    rdfs:comment "Actions businesses take to maintain operations during wildfire disruptions." ;
    rdfs:subClassOf ffonto:OperationalStrategy .

ffonto:CyberSecurityPractice a owl:Class ;
    rdfs:label "Cybersecurity Practice" ;
    rdfs:comment "A policy, control, or procedure intended to protect information systems from cyber threats."@en .

ffonto:DetectionMethod a owl:Class ;
    rdfs:label "ForestFire Detection Method" ;
    rdfs:comment "A technique or sensor approach used to detect events or features of interest."@en .

ffonto:EmergencyResponder a owl:Class ;
    rdfs:label "Emergency Responder" ;
    rdfs:comment "A trained person who responds to incidents to provide assistance or protection."@en .

ffonto:EthicalConsideration a owl:Class ;
    rdfs:label "Ethical Consideration" ;
    rdfs:comment "A factor reflecting moral implications or responsibilities associated with an action or system."@en .

ffonto:FireRadiativePower a owl:Class ;
    rdfs:label "Fire Radiative Power",
        "Fire Radiative Power (FRP)" ;
    rdfs:comment "A measurement of fire energy release rate estimated from thermal remote sensing data."@en ;
    rdfs:subClassOf ffonto:FireBehavior .

ffonto:FireWeatherRecord a owl:Class ;
    rdfs:label "Fuel Moisture & Fire Weather Records" ;
    rdfs:comment "FFMC, ISI, DMC, DC, BUI, FWI values used to assess spread potential." ;
    rdfs:subClassOf ffonto:WeatherObservation .

ffonto:Forest rdfs:label "Forest"@en ;
    rdfs:comment "A large area dominated by trees and natural vegetation."@en .

ffonto:ForestFireRiskFactor a owl:Class ;
    rdfs:label "ForestFire Risk Factor" ;
    rdfs:comment "Environmental or anthropogenic variables influencing wildfire probability." .

ffonto:FuelLoad a owl:Class ;
    rdfs:label "Fuel load" ;
    rdfs:comment "Amount and type of combustible organic material present in a spatial unit." .

ffonto:GeospatialDataFormat a owl:Class ;
    rdfs:label "Geospatial Data Format" ;
    rdfs:comment "A file format or specification for storing and exchanging geographic data."@en .

ffonto:HazardousWasteGuideline a owl:Class ;
    rdfs:label "Hazardous Waste Guideline" ;
    rdfs:comment "Guidelines or instructions for safely handling and disposing of hazardous waste after a wildfire." .

ffonto:HoseLine a owl:Class ;
    rdfs:label "Fire Hose Line" ;
    rdfs:comment "A length of fire hose deployed to deliver water or foam to a fire."@en ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:House a owl:Class ;
    rdfs:label "House" ;
    rdfs:comment "Residential structure potentially threatened by wildfire." .

ffonto:ImmediateEvacuationAction a owl:Class ;
    rdfs:label "Immediate Evacuation Action" ;
    rdfs:comment "Actions to do when authorities advise or order evacuation." ;
    rdfs:subClassOf ffonto:EvacuationAction .

ffonto:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "Generic geographic area or site (field, orchard, region, coordinate) where produce is produced."@en ;
    rdfs:subClassOf ffonto:ObservableProperty .

ffonto:ModelProvenance a owl:Class ;
    rdfs:label "Model Provenance" ;
    rdfs:comment "Provenance information for a model (repo/URL/name/version) used for audit." .

ffonto:ModelTrainingTechnique a owl:Class ;
    rdfs:label "Model Training Technique" ;
    rdfs:comment "A method or algorithm used to train a machine learning model."@en .

ffonto:ParticulateMatterPM25 a owl:Class ;
    rdfs:label "PM2.5 Particulate Matter" ;
    rdfs:comment "Fine particulate matter with a diameter of 2.5 micrometers or less.",
        "Fine particulate matter with diameter ≤2.5 micrometers, associated with health impacts."@en ;
    rdfs:subClassOf ffonto:AirPollutantProperty,
        ffonto:ParticulateMatter .

ffonto:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual; used to represent people in data and processes."@en .

ffonto:PrivacyProtection a owl:Class ;
    rdfs:label "Privacy Protection" ;
    rdfs:comment "Measures and practices that protect personal or sensitive information from disclosure."@en ;
    rdfs:subClassOf ffonto:CyberSecurityPractice .

ffonto:RemoteSensingSensor rdfs:label "Remote sensing sensor"@en ;
    rdfs:comment "A sensor used to capture environmental data remotely, such as from satellites, drones, or aircraft."@en .

ffonto:RespiratoryDisease a owl:Class ;
    rdfs:label "Respiratory Disease" ;
    rdfs:comment "Medical conditions affecting lungs such as asthma or COPD." ;
    rdfs:subClassOf ffonto:RespiratoryIssue .

ffonto:RespiratoryIssue a owl:Class ;
    rdfs:label "Respiratory issue"@en ;
    rdfs:comment "A breathing or lung-related health condition influenced by wildfire smoke or air pollution."@en ;
    rdfs:subClassOf ffonto:HealthImpact .

ffonto:RiskAssessment rdfs:label "Risk assessment"@en ;
    rdfs:comment "The evaluation of potential hazards, impacts, and likelihood of wildfire-related events or environmental threats."@en .

ffonto:SceneElement a owl:Class ;
    rdfs:label "Scene Element"@en ;
    rdfs:comment "Physical objects, features, or evidence detected within an image or scene."@en .

ffonto:SmokeLayerObservation a owl:Class ;
    rdfs:label "Smoke Layer Observation" ;
    rdfs:comment "Observation describing presence of multilayer smoke and qualitative descriptions per layer." .

ffonto:SuppressionOperation a owl:Class ;
    rdfs:label "Suppression Operation" ;
    rdfs:comment "An organized operation (ground, aerial, mop-up) to control a fire." .

ffonto:ThresholdSet a owl:Class ;
    rdfs:label "Threshold Set" ;
    rdfs:comment "A set of configured thresholds (global, smoke, fire, frame_thresh) stored with predictions." .

ffonto:VegetationFunctionalGroup a owl:Class ;
    rdfs:label "Vegetation functional group" ;
    rdfs:comment "Functional grouping such as coniferous, deciduous, shrub, or grass." .

ffonto:WildfireStatistic a owl:Class ;
    rdfs:label "Wildfire Statistic"@en,
        "wildfire statistic"@en ;
    rdfs:comment "Base class for all wildfire data points.",
        "A quantitative data point or aggregated metric regarding a wildfire, such as acres burned or containment percentage."@en .

ffonto:Wildlife a owl:Class ;
    rdfs:label "Wildlife" ;
    rdfs:comment "Wild animals affected by fire and smoke." .

ffonto:AirToxic a owl:Class ;
    rdfs:label "Air Toxic Pollutant" ;
    rdfs:comment "Hazardous air pollutants generated during wildfire combustion." .

ffonto:AircraftAction a owl:Class ;
    rdfs:label "Aircraft Action" ;
    rdfs:comment "Helicopter/aerial tanker activities (drops, bucket use, dip sites)." .

ffonto:AspectCategory a owl:Class ;
    rdfs:label "Aspect Category (enum)" ;
    rdfs:comment "Cardinal aspect(s) active in the scene." .

ffonto:BuildingComponent a owl:Class ;
    rdfs:label "Building Component" ;
    rdfs:comment "Structural parts of a building that may influence wildfire vulnerability." .

ffonto:ClothingRecommendation a owl:Class ;
    rdfs:label "Clothing Recommendation" ;
    rdfs:comment "Recommended clothing types for safe evacuation and wildfire exposure." .

ffonto:CrowdsourcedReport a owl:Class ;
    rdfs:label "Crowdsourced Report" ;
    rdfs:comment "A report or observation submitted by members of the public or volunteers."@en ;
    rdfs:subClassOf ffonto:CitizenObservation .

ffonto:DefensibleZone a owl:Class ;
    rdfs:label "Defensible Zone" ;
    rdfs:comment "A named sub-area within defensible space (e.g., Zone 1, Zone 2, Zone 3)." .

ffonto:Disturbance a owl:Class ;
    rdfs:label "Disturbance" ;
    rdfs:comment "An event or process that disrupts ecosystem structure or function." .

ffonto:DropZone a owl:Class ;
    rdfs:label "Drop Zone" ;
    rdfs:comment "Designated area for aerial retardant/water drops; clearance & safety required." .

ffonto:EcologicalImpact a owl:Class ;
    rdfs:label "Ecological Impact" ;
    rdfs:comment "Environmental consequences resulting from fires." ;
    rdfs:subClassOf ffonto:EthicalConsideration .

ffonto:EvaluationMetric a owl:Class ;
    rdfs:label "Evaluation Metric" ;
    rdfs:comment "A quantitative measure used to assess model or system performance."@en .

ffonto:FireManagementStrategy a owl:Class ;
    rdfs:label "Fire Management Strategy" ;
    rdfs:comment "Methods used to control or mitigate wildfire spread." .

ffonto:FireSeverity a owl:Class ;
    rdfs:label "Fire severity" ;
    rdfs:comment "Categorical or continuous measure of ecological severity / intensity of a burn." .

ffonto:Fireline a owl:Class ;
    rdfs:label "Fireline" ;
    rdfs:comment "A cleared or treated strip of land intended to stop fire spread."@en .

ffonto:ForestFireTechnology a owl:Class ;
    rdfs:label "ForestFire Technology" ;
    rdfs:comment "Technologies designed to detect, model, mitigate, or respond to forest fires."@en .

ffonto:FuelCharacteristic a owl:Class ;
    rdfs:label "Fuel Characteristic" ;
    rdfs:comment "Properties affecting how fuels burn." .

ffonto:FuelCondition a owl:Class ;
    rdfs:label "Fuel Condition" ;
    rdfs:comment "Live/dead fuel moisture conditions, curing status, height/continuity of grasses, canopy base height and crown potential." .

ffonto:Groundwater a owl:Class ;
    rdfs:label "Groundwater" ;
    rdfs:comment "Water stored underground in soil or rock formations." .

ffonto:IncidentCommandSystem a owl:Class ;
    rdfs:label "Incident Command System (ICS)" ;
    rdfs:comment "ICS roles should be established in advance; see national incident management guidance for details." .

ffonto:IndoorAirQualityStrategy a owl:Class ;
    rdfs:label "Indoor Air Quality Strategy" ;
    rdfs:comment "Methods to improve indoor air quality during smoke events." ;
    rdfs:subClassOf ffonto:AirQualityMitigationStrategy .

ffonto:InsurancePolicy a owl:Class ;
    rdfs:label "Insurance Policy" ;
    rdfs:comment "A contract that provides financial protection against specified losses or damages."@en .

ffonto:LandCover a owl:Class ;
    rdfs:label "Land cover" ;
    rdfs:comment "The physical material covering the surface of the earth such as forest, water, or barren land." .

ffonto:RemoteSensor a owl:Class ;
    rdfs:label "Remote Sensor" ;
    rdfs:comment "A sensor that collects data from a distance, often without direct contact with the measurement target."@en ;
    rdfs:subClassOf sosa:Sensor .

ffonto:SmokeColor a owl:Class ;
    rdfs:label "Smoke Color",
        "Smoke Color (enum)" ;
    rdfs:comment "Smoke color categories." ;
    rdfs:subClassOf ffonto:SmokePlume .

ffonto:SpatialExtent a owl:Class ;
    rdfs:label "spatial extent"@en ;
    rdfs:comment "The physical area, geographic boundary, or geospatial footprint covered by an event or entity."@en .

ffonto:TerrainFeature a owl:Class ;
    rdfs:label "Terrain Feature" ;
    rdfs:comment "Topographic elements that influence fire behavior (hills, slopes, valleys, rivers)." .

ffonto:WaterAvailability a owl:Class ;
    rdfs:label "Water availability" ;
    rdfs:comment "Hydrological conditions (moisture, groundwater) affecting vegetation and fire risk." .

ffonto:AirPollutantProperty a owl:Class ;
    rdfs:label "Air Pollutant Property" ;
    rdfs:comment "Physical or chemical characteristics of airborne pollutants." ;
    rdfs:subClassOf ffonto:AirQualityIndex .

ffonto:Airspace a owl:Class ;
    rdfs:label "Airspace" ;
    rdfs:comment "A defined volume of airspace where specific rules and procedures apply."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:Animal a owl:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "Domestic animals or pets potentially affected by wildfire smoke." .

ffonto:CommunityPreparedness a owl:Class ;
    rdfs:label "Community Preparedness" ;
    rdfs:comment "Plans, programs and actions at community level to prepare for wildfire events." .

ffonto:Contact a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:comment "Contact information (web, phone) for incident resources." .

ffonto:DataRepository a owl:Class ;
    rdfs:label "Data Repository" ;
    rdfs:comment "Platform used to store and distribute Earth observation datasets." .

ffonto:DecisionSupportSystem a owl:Class ;
    rdfs:label "Decision Support System" ;
    rdfs:comment "A tool or system providing information and analysis to aid decision-makers."@en ;
    rdfs:subClassOf ffonto:InformationSystem .

ffonto:EvacuationZone a owl:Class ;
    rdfs:label "Evacuation Zone" ;
    rdfs:comment "A geographic area designated for evacuation procedures during an emergency."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:HealthAdvice a owl:Class ;
    rdfs:label "Health Advice" ;
    rdfs:comment "Guidance provided to the public for wildfire smoke protection." .

ffonto:HomeProtectionMeasure a owl:Class ;
    rdfs:label "Home Protection Measure" ;
    rdfs:comment "Measures to reduce the chance of home ignition from embers, heat, and flame." .

ffonto:IncidentCommand a owl:Class ;
    rdfs:label "Incident Command" ;
    rdfs:comment "The authority and structure responsible for overall incident management and decision-making."@en ;
    rdfs:subClassOf ffonto:EmergencyResponder .

ffonto:SafetyMeasure a owl:Class ;
    rdfs:label "Safety Measure" ;
    rdfs:comment "Protective action or precaution used to reduce wildfire risks." .

ffonto:SatelliteData a owl:Class ;
    rdfs:label "Satellite Data" ;
    rdfs:comment "Observational data collected by Earth-orbiting satellites, including imagery and sensor measurements."@en ;
    rdfs:subClassOf ffonto:EarthObservationData .

ffonto:SmokeComponent a owl:Class ;
    rdfs:label "Smoke Component" ;
    rdfs:comment "Chemical compounds and particles present in wildfire smoke." .

ffonto:SuppressionMethod a owl:Class ;
    rdfs:label "ForestFire Suppression Method" ;
    rdfs:comment "A technique or tactic used to extinguish or control fire."@en .

prov:Entity a owl:Class ;
    rdfs:label "entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imagined."@en .

ffonto:FireSuppressionAction a owl:Class ;
    rdfs:label "Fire Suppression Action" ;
    rdfs:comment "Operational activity such as hose suppression, line cutting, or aerial water drops.",
        "Tactical actions (air tanker drops, dozer lines, hand crews, backburning) used to control fires." .

ffonto:FirefightingResource a owl:Class ;
    rdfs:label "Firefighting Resource" ;
    rdfs:comment "Personnel, equipment, or vehicles used to combat wildfires." .

ffonto:ICSFunction a owl:Class ;
    rdfs:label "ICS Functional Area" ;
    rdfs:comment "Command, Operations, Planning, Logistics, Finance/Admin." ;
    rdfs:subClassOf ffonto:IncidentCommandSystem .

ffonto:MeteorologicalObservation a owl:Class ;
    rdfs:label "Meteorological Observation" ;
    rdfs:comment "Raw physical weather measurements (e.g., Temp, Wind)." ;
    rdfs:subClassOf ffonto:WeatherObservation .

ffonto:ProvenanceRecord a owl:Class ;
    rdfs:label "Provenance Record" ;
    rdfs:comment "Metadata that documents the origin, lineage, and processing history of data or artifacts."@en .

ffonto:RecoveryGuideline a owl:Class ;
    rdfs:label "Recovery Guideline" ;
    rdfs:comment "Guidelines provided to residents after a wildfire event." .

ffonto:Result a owl:Class ;
    rdfs:label "Result" ;
    rdfs:comment "Results got from observation at a wildfire scene." .

ffonto:SmokeHealthEffect a owl:Class ;
    rdfs:label "Smoke Health Effect" ;
    rdfs:comment "Adverse human health outcomes caused by wildfire smoke exposure." .

ffonto:SoilQuality a owl:Class ;
    rdfs:label "Soil quality" ;
    rdfs:comment "Indicators of soil fertility or texture that influence vegetation growth and distribution." .

ffonto:SuppressionTactic a owl:Class ;
    rdfs:label "Suppression Tactic" ;
    rdfs:comment "A specific technique applied to control or extinguish a fire."@en ;
    rdfs:subClassOf ffonto:FireManagementStrategy .

ffonto:VegetationChemicalComponent a owl:Class ;
    rdfs:label "Vegetation Chemical Component" ;
    rdfs:comment "Chemical compounds present in vegetation that influence smoke composition when burned." ;
    rdfs:subClassOf ffonto:FuelCharacteristic .

ffonto:VegetationCondition a owl:Class ;
    rdfs:label "Vegetation condition" ;
    rdfs:comment "Represents the health or status of vegetation within an ecosystem." .

prov:Activity a owl:Class ;
    rdfs:label "activity"@en ;
    rdfs:comment "Something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities."@en .

ffonto:BeforeEvacuationAction a owl:Class ;
    rdfs:label "Before Evacuation Action" ;
    rdfs:comment "Actions to do if wildfire is approaching but evacuation has not been ordered yet." ;
    rdfs:subClassOf ffonto:EvacuationAction .

ffonto:ComputerVisionTask a owl:Class ;
    rdfs:label "Computer Vision Task" ;
    rdfs:comment "A defined problem in computer vision such as detection, segmentation, or classification."@en .

ffonto:HealthSymptom a owl:Class ;
    rdfs:label "Health Symptom" ;
    rdfs:comment "Physical symptom caused by wildfire smoke exposure." .

ffonto:InformationResource a owl:Class ;
    rdfs:label "Information Resource" ;
    rdfs:comment "Online resources providing wildfire safety and health information." .

ffonto:MLModel a owl:Class ;
    rdfs:label "Machine Learning Model" ;
    rdfs:comment "A model used to generate annotations or results." .

ffonto:MachineLearningModel a owl:Class ;
    rdfs:label "Machine learning model"@en ;
    rdfs:comment "A trained computational model used to analyze wildfire-related data or make predictions."@en ;
    rdfs:subClassOf ffonto:ForestFirePredictionModel .

ffonto:ObservableProperty a owl:Class ;
    rdfs:label "ObservableProperty" ;
    rdfs:comment "Observable Property." .

ffonto:CameraObservation a owl:Class ;
    rdfs:label "Camera Observation" ;
    rdfs:comment "Observation produced from a fixed or mobile camera (image/frame-level)." ;
    rdfs:subClassOf ffonto:ImageObservation .

ffonto:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment "Tools or devices used during firefighting operations." .

ffonto:FireSpread a owl:Class ;
    rdfs:label "Fire Spread",
        "Fire Spread Behavior" ;
    rdfs:comment "Represents spread characteristics of the wildfire.",
        "The rate and direction in which fire moves." ;
    rdfs:subClassOf ffonto:FireBehavior .

ffonto:FuelType a owl:Class ;
    rdfs:label "Fuel Type" ;
    rdfs:comment "Combustible vegetation material that contributes to fire spread." .

ffonto:IgnitionSource a owl:Class ;
    rdfs:label "Ignition source" ;
    rdfs:comment "Cause or source of ignition for a fire event." .

ffonto:ImageAsset a owl:Class ;
    rdfs:label "Image Asset" ;
    rdfs:comment "Represents an image file and its metadata (resolution, checksum, georef, path, license, etc.)." .

ffonto:ProtectionMeasure a owl:Class ;
    rdfs:label "Protection Measure" ;
    rdfs:comment "Hose lines, sprinklers, foam, pumps and other structure-protection measures." .

ffonto:SmokePlume a owl:Class ;
    rdfs:label "Smoke Plume" ;
    rdfs:comment "A concentrated column or mass of smoke rising from a fire source."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:SuppressionResource a owl:Class ;
    rdfs:label "Suppression Resource" ;
    rdfs:comment "Equipment or personnel used to control or extinguish wildfires." .

ffonto:TemporalExtent a owl:Class ;
    rdfs:label "temporal extent"@en ;
    rdfs:comment "The specific timeframe, duration, or time interval during which an event or phenomenon occurs."@en .

ffonto:Tool a owl:Class ;
    rdfs:label "Hand Tool" ;
    rdfs:comment "Hand tools used by crews (Pulaski, McLeod, shovel, etc.)." .

ffonto:VegetationDistribution a owl:Class ;
    rdfs:label "Vegetation distribution" ;
    rdfs:comment "The spatial pattern or arrangement of vegetation within a defined area or ecosystem." .

ffonto:AirPollution a owl:Class ;
    rdfs:label "Air pollution" ;
    rdfs:comment "Airborne emissions resulting from fire (smoke, particulates)." .

ffonto:Fuel a owl:Class ;
    rdfs:label "Fuel" ;
    rdfs:comment "Combustible material consumed during a wildfire.",
        "Combustible materials such as dry grass, leaf litter, and logs that contribute to fire spread." ;
    rdfs:subClassOf ffonto:FireElement .

ffonto:IncidentCommandSection a owl:Class ;
    rdfs:label "incident command section"@en ;
    rdfs:comment "A primary organizational division within the Incident Command System, such as Operations, Planning, or Logistics."@en .

ffonto:Tree a owl:Class ;
    rdfs:label "Tree" ;
    rdfs:comment "A woody perennial plant forming the main structural component of forest vegetation." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:WaterSource a owl:Class ;
    rdfs:label "Water Source" ;
    rdfs:comment "A natural or artificial water source used for firefighting." .

ffonto:EnvironmentalFactor a owl:Class ;
    rdfs:label "Environmental Factor" ;
    rdfs:comment "Environmental conditions affecting fire behavior." .

ffonto:EvacuationPreparation a owl:Class ;
    rdfs:label "Evacuation Preparation" ;
    rdfs:comment "High-level plan and actions to prepare before and for evacuation." .

ffonto:FirefightingOperation a owl:Class ;
    rdfs:label "Firefighting Operation" ;
    rdfs:comment "An operational activity conducted to control or suppress wildfire." .

ffonto:HumanIgnition a owl:Class ;
    rdfs:label "Human Ignition" ;
    rdfs:comment "Ignitions resulting from human activity or infrastructure failure." ;
    rdfs:subClassOf ffonto:IgnitionCause,
        ffonto:IgnitionSource .

ffonto:LabelAssignment a owl:Class ;
    rdfs:label "Label Assignment" ;
    rdfs:comment "Represents the association of a Label to an ImageAsset, including source and count." ;
    rdfs:subClassOf ffonto:ModelOutput .

ffonto:ModelOutput a owl:Class ;
    rdfs:label "Model Output" ;
    rdfs:comment "Results produced by a model, including predictions, maps, or summary statistics."@en .

ffonto:SpatialUnit a owl:Class ;
    rdfs:label "Spatial unit" ;
    rdfs:comment "Spatial unit for measurement and observation (plot, patch, landscape unit)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ffonto:hasVegetationDistribution ;
            owl:someValuesFrom ffonto:VegetationDistribution ] .

ffonto:ClimateDriver a owl:Class ;
    rdfs:label "Climate Driver" ;
    rdfs:comment "Climate-related conditions that influence wildfire probability and behavior." .

ffonto:EvacuationAction a owl:Class ;
    rdfs:label "Evacuation Action" ;
    rdfs:comment "Actions and procedures for safe evacuation (routes, kits, sheltering)." .

ffonto:PopulationGroup a owl:Class ;
    rdfs:label "Population Group" ;
    rdfs:comment "Group of people potentially affected by wildfire smoke." .

ffonto:ProtectiveAction a owl:Class ;
    rdfs:label "Protective Action" ;
    rdfs:comment "An action recommended to protect people from wildfire smoke or fire-related hazards." .

ffonto:SmokeObservation a owl:Class ;
    rdfs:label "Smoke Observation" ;
    rdfs:comment "An observation indicating the presence of smoke within an environmental image, which may suggest an ongoing fire or combustion event." ;
    rdfs:subClassOf ffonto:ImageObservation .

ffonto:UAV a owl:Class ;
    rdfs:label "Uncrewed Aerial Vehicle (UAV) / Drone",
        "Unmanned Aerial Vehicle"@en,
        "Unmanned aerial vehicle"@en ;
    rdfs:comment "An aircraft without a human pilot used for aerial wildfire monitoring and data collection."@en ;
    rdfs:subClassOf ffonto:SensorPlatform .

ffonto:WeatherObservation a owl:Class ;
    rdfs:label "Weather Observation" ;
    rdfs:comment "Meteorological measurements at the incident site." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:CombustionProcess a owl:Class ;
    rdfs:label "Combustion Process" ;
    rdfs:comment "Chemical process of burning fuel that produces smoke, gases, and heat during wildfires." ;
    rdfs:subClassOf ffonto:PhysicalProcess .

ffonto:EcosystemService a owl:Class ;
    rdfs:label "Ecosystem Service" ;
    rdfs:comment "The benefits provided by ecosystems that support environmental health and human well-being." .

ffonto:EnvironmentalCondition a owl:Class ;
    rdfs:label "Environmental Condition" ;
    rdfs:comment "A physical environmental factor that influences ecological processes, such as temperature, moisture, or snow cover." .

ffonto:VisionModelScores a owl:Class ;
    rdfs:label "Vision Model Scores" ;
    rdfs:comment "Scores produced by a vision classifier/model (fire/smoke/no-fire etc.) and the producing model name/version." ;
    owl:subClassOf ffonto:ModelOutput .

ffonto:FireRiskAssessment a owl:Class ;
    rdfs:label "Fire Risk Assessment",
        "ForestFire Risk Assessment" ;
    rdfs:comment "Assessment of risk to infrastructure, people, and environment.",
        "Processes and outputs used to evaluate wildfire likelihood and consequences." .

ffonto:ResponseOrganization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization providing health or wildfire safety information." .

ffonto:SoilCondition a owl:Class ;
    rdfs:label "Soil Condition" ;
    rdfs:comment "Characteristics of soil such as moisture and nutrient content.",
        "Physical and chemical characteristics of soil that influence vegetation growth and ecosystem health." ;
    rdfs:subClassOf ffonto:EnvironmentalCondition,
        ffonto:EnvironmentalFactor .

ffonto:SpatialEntity a owl:Class ;
    rdfs:label "Spatial entity"@en ;
    rdfs:comment "An entity that exists in physical or geographic space and can have a spatial location or geometry."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:FireBehaviorModel a owl:Class ;
    rdfs:label "Fire Behavior Model" ;
    rdfs:comment "A model that simulates the spread, intensity, and effects of fire under various conditions."@en ;
    rdfs:subClassOf ffonto:SimulationModel .

ffonto:PreparednessItem a owl:Class ;
    rdfs:label "Preparedness Item" ;
    rdfs:comment "Items included in emergency preparedness kits." .

ffonto:PublicSafetyGuidance a owl:Class ;
    rdfs:label "Public Safety Guidance" ;
    rdfs:comment "Advice for drivers/evacuees and general safety Q&A." .

ffonto:FireFront a owl:Class ;
    rdfs:label "Fire Front" ;
    rdfs:comment "Leading edge of the wildfire." ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:HealthRisk a owl:Class ;
    rdfs:label "Health Risk" ;
    rdfs:comment "Health risk caused by wildfire smoke exposure." .

ffonto:AudioObservation a owl:Class ;
    rdfs:label "Audio Observation" ;
    rdfs:comment "Observation derived from audio captured at the wildfire scene." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:EcologicalEffect a owl:Class ;
    rdfs:label "Ecological Effect" ;
    rdfs:comment "The physical, chemical, or biological changes in an ecosystem resulting from a fire event." .

ffonto:ForestEcosystem a owl:Class ;
    rdfs:label "Forest Ecosystem" ;
    rdfs:comment "An ecosystem dominated by trees and woody vegetation." ;
    rdfs:subClassOf ffonto:Ecosystem .

ffonto:WaterBody a owl:Class ;
    rdfs:label "Water Body" ;
    rdfs:comment "A natural accumulation of water such as lakes or rivers." ;
    rdfs:subClassOf ffonto:LandscapeFeature .

ffonto:StructureFire a owl:Class ;
    rdfs:label "Structure Fire" ;
    rdfs:comment "Fire involving buildings / infrastructure (houses, outbuildings)." ;
    rdfs:subClassOf ffonto:ForestFire .

ffonto:Vehicle a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:comment "Ground vehicles used in wildfire operations." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:comment "A constructed structure such as a house or garage." ;
    rdfs:subClassOf ffonto:Infrastructure .

geo:SpatialObject rdfs:label "Spatial object"@en ;
    rdfs:comment "An entity that has a spatial representation or location in geographic space."@en .

ffonto:FireBehavior a owl:Class ;
    rdfs:label "Fire Behavior" ;
    rdfs:comment "Characteristics describing how a fire behaves and spreads." .

ffonto:Responder a owl:Class ;
    rdfs:label "Responder" ;
    rdfs:comment "Emergency personnel responding to wildfire incidents." .

ffonto:WildfireIncident a owl:Class ;
    rdfs:label "wildfire incident"@en ;
    rdfs:comment "An uncontrolled fire occurring in nature that requires an emergency response."@en .

ffonto:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure" ;
    rdfs:comment "Human-built structures within natural landscapes.",
        "Temporary or permanent structures used during wildfire response." ;
    rdfs:subClassOf ffonto:SceneElement .

ffonto:ImageObservation a owl:Class ;
    rdfs:label "Image observation" ;
    rdfs:comment "Observation derived from imagery analysis with provenance and confidence metadata." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:Firefighter a owl:Class ;
    rdfs:label "Firefighter" ;
    rdfs:comment "Wildland or structural firefighters engaged in suppression operations." ;
    rdfs:subClassOf ffonto:Responder .

ffonto:Ecosystem a owl:Class ;
    rdfs:label "Ecosystem" ;
    rdfs:comment "A biological community interacting with its physical environment." .

ffonto:Vegetation a owl:Class ;
    rdfs:label "Vegetation" ;
    rdfs:comment "Plant life present in a forest ecosystem including trees, shrubs, and grasses." ;
    rdfs:subClassOf ffonto:SceneElement .

ffonto:Hazard a owl:Class ;
    rdfs:label "Hazard" ;
    rdfs:comment "A dangerous condition present during wildfire operations." .

ffonto:Road a owl:Class ;
    rdfs:label "Road" ;
    rdfs:comment "Transportation pathway crossing natural landscapes." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:WildfireScene a owl:Class ;
    rdfs:label "Wildfire Scene" ;
    rdfs:comment "The environmental context where a wildfire event occurs and observations are made." .

ffonto:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "An observation or record about conditions at a wildfire scene." .

ffonto:TemporalExtent a owl:Class .

<https://purl.org/ffkg/spatial/60365e4c33915ad39a21c4f5> a ffonto:SpatialExtent ;
    ffonto:hasSite "Sidi-Bel Abbes Region" .

<https://purl.org/ffkg/spatial/c53d79d8c8bc501089be429f> a ffonto:SpatialExtent ;
    ffonto:hasCountry "Algeria" ;
    ffonto:hasSite "Bejaia Region" .

ffonto:FireWeatherRecord a owl:Class .

ffonto:humidity a ffonto:ObservableProperty ;
    rdfs:label "humidity" .

ffonto:rainfall a ffonto:ObservableProperty ;
    rdfs:label "rainfall" .

ffonto:temperature a ffonto:ObservableProperty ;
    rdfs:label "temperature" .

ffonto:windSpeed a ffonto:ObservableProperty ;
    rdfs:label "wind speed" .

ffonto:ForestFire a owl:Class ;
    rdfs:label "Forest Fire" ;
    rdfs:comment "An uncontrolled fire occurring in natural vegetation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ffonto:hasIgnitionSource ;
            owl:someValuesFrom ffonto:IgnitionSource ],
        [ a owl:Restriction ;
            owl:onProperty ffonto:hasBurnSeverity ;
            owl:someValuesFrom ffonto:FireSeverity ],
        [ a owl:Restriction ;
            owl:onClass ffonto:ForestEcosystem ;
            owl:onProperty ffonto:occursIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:altLabel "Wildfire" .


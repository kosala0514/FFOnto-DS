ffonto:rainGuttersScorched a owl:DatatypeProperty ;
    rdfs:label "rain gutters scorched" ;
    rdfs:comment "Indicates whether rain gutters are scorched." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:rainMm a owl:DatatypeProperty ;
    rdfs:label "rain mm",
        "rain mm"@en ;

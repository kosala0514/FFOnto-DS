    rdfs:comment "Indicates whether a roof is free of combustible debris." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:roofHasDebris a owl:DatatypeProperty ;
    rdfs:label "roof has debris" ;
    rdfs:comment "Specifies whether the roof contains leaves or debris that could ignite." ;
    rdfs:domain ffonto:Roof ;
    rdfs:range xsd:boolean .

ffonto:rootsExposed a owl:DatatypeProperty ;
    rdfs:label "roots exposed by combustion or erosion" ;
    rdfs:comment "Indicates whether roots are exposed due to combustion or erosion." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:rowIndex a owl:DatatypeProperty ;
    rdfs:label "rowI index",
        "row index"@en ;
    rdfs:comment "Indicates the specific sequential line number or tabular position of a record within a dataset."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:integer .

ffonto:runoffIntensity a owl:DatatypeProperty ;
    rdfs:label "runoff intensity" ;
    rdfs:comment "Describes the intensity of surface runoff (e.g., low, moderate, high)." ;
    rdfs:domain ffonto:Runoff ;
    rdfs:range xsd:string .

ffonto:satelliteSmokeVisible a owl:DatatypeProperty ;
    rdfs:label "smoke visible in satellite imagery" ;
    rdfs:comment "Indicates today's satellite passes show the smoke plume." ;
    rdfs:domain ffonto:SatelliteObservation ;
    rdfs:range xsd:boolean .

ffonto:sceneFeaturesObservation a owl:ObjectProperty ;
    rdfs:label "scene features observation"@en ;
    rdfs:comment "Inverse of observedAtScene - Links a scene to the observations made within it." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:observedAtScene .

ffonto:sceneLocatedIn rdfs:label "scene located in"@en ;
    rdfs:comment "Specifies the geographic area or location where an observed scene or event occurs."@en .

ffonto:sceneLocatedOf rdfs:comment "Inverse relation linking scene location statements back to the incident or report referencing them."@en .

ffonto:schemaVersion a owl:DatatypeProperty ;
    rdfs:label "schema version",
        "schema version"@en ;
    rdfs:comment "Specifies the numeric or alphanumeric release identifier of the ontological or structural framework governing the dataset."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:schoolsCloseGuidance a owl:DatatypeProperty ;
    rdfs:label "will schools close during severe smoke/fire" ;
    rdfs:comment "Guidance on closure of educational institutions during hazardous events."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:scoreFire a owl:DatatypeProperty ;
    rdfs:label "fire score" ;
    rdfs:comment "Fire score from vision model (0-1)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:scoreNoFire a owl:DatatypeProperty ;
    rdfs:label "no-fire score" ;
    rdfs:comment "No-fire score from vision model (0-1)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:scoreSmoke a owl:DatatypeProperty ;
    rdfs:label "smoke score" ;
    rdfs:comment "Smoke score from vision model (0-1)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:sendsAlert a owl:ObjectProperty ;
    rdfs:label "sends alert"@en ;
    rdfs:comment "Indicates that a system, device, or agent transmits a warning or notification regarding a specific condition."@en ;
    rdfs:domain ffonto:EDXLMessage ;
    rdfs:range ffonto:PublicWarningSystem ;
    owl:inverseOf ffonto:receivesEDXLMessage .

ffonto:sensorPoseRecorded a owl:DatatypeProperty ;
    rdfs:label "sensor orientation/pose recorded?" ;
    rdfs:comment "True if yaw/pitch/roll are recorded; false otherwise." ;
    rdfs:domain ffonto:ImageQualityMetadata ;
    rdfs:range xsd:boolean .

ffonto:shelterBurned a owl:DatatypeProperty ;
    rdfs:label "barn or shelter burned" ;
    rdfs:comment "Indicates whether a barn or livestock shelter is burned or shows burn damage." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:shelterInPlaceGuidance a owl:DatatypeProperty ;
    rdfs:label "when to shelter in place guidance" ;
    rdfs:comment "Instructions advising individuals to remain indoors and take protective actions during hazards."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:shelteringInPlace a owl:DatatypeProperty ;
    rdfs:label "sheltering in place" ;
    rdfs:comment "The act of remaining in a safe indoor location rather than evacuating."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:shovelsOrHoesScrapingToMineralSoil a owl:DatatypeProperty ;
    rdfs:label "shovels/hoes scraping to mineral soil" ;
    rdfs:comment "Indicates use of hand tools to remove vegetation to mineral soil as a fire control measure."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:shrubsBurnedToStems a owl:DatatypeProperty ;
    rdfs:label "shrubs burned to stems" ;
    rdfs:comment "Indicates whether shrubs or chaparral are burned down to stems." ;
    rdfs:domain ffonto:Shrub ;
    rdfs:range xsd:boolean .

ffonto:signpostScorched a owl:DatatypeProperty ;
    rdfs:label "signpost scorched" ;
    rdfs:comment "Whether a signpost appears scorched or burned." ;
    rdfs:domain ffonto:Signpost ;
    rdfs:range xsd:boolean .

ffonto:simulatedByActivity a owl:ObjectProperty ;
    rdfs:label "simulated by activity"@en ;
    rdfs:comment "Relates a forest fire to a provenance-tracked modeling or simulation activity."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range prov:Activity ;
    owl:inverseOf ffonto:simulatesFire .

ffonto:sirenVehiclePresent a owl:DatatypeProperty ;
    rdfs:label "siren vehicle present" ;
    rdfs:comment "Observation that a vehicle equipped with a siren is present at the scene."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:siteLiteral a owl:DatatypeProperty ;
    rdfs:label "site literal",
        "site literal"@en ;
    rdfs:comment "Records the localized name, physical designation, or descriptive text of an observation station or facility."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:smoke a ffonto:ObservableProperty .

ffonto:smokeAffectsAviation a owl:DatatypeProperty ;
    rdfs:label "smoke affecting aviation routes" ;
    rdfs:comment "Indicates that smoke conditions are impacting aviation operations and safety."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:smokeBlowingAcrossEvacRoutes a owl:DatatypeProperty ;
    rdfs:label "smoke blowing across evacuation routes" ;
    rdfs:comment "Observation that smoke is crossing designated evacuation routes, potentially affecting safety."@en ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:boolean .

ffonto:smokeColor a owl:DatatypeProperty ;
    rdfs:label "smoke color" ;
    rdfs:comment "Indicates smoke color such as white, gray, brown, or black." ;
    rdfs:domain ffonto:SmokeCondition ;
    rdfs:range xsd:string .

ffonto:smokeColorLiteral a owl:DatatypeProperty ;
    rdfs:label "smoke color description" ;
    rdfs:comment "Literal description of smoke color (e.g., 'dark-gray with a brown tinge')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokeDensity a owl:DatatypeProperty ;
    rdfs:label "smoke density level" ;
    rdfs:comment "Describes smoke density level (low, medium, high)." ;
    rdfs:domain ffonto:SmokeCondition ;
    rdfs:range xsd:string .

ffonto:smokeExposureDuration a owl:DatatypeProperty ;
    rdfs:label "smoke exposure duration" ;
    rdfs:comment "Duration of exposure to wildfire smoke." ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range xsd:duration .

ffonto:smokeLayerLowerDesc a owl:DatatypeProperty ;
    rdfs:label "lower smoke layer description" ;
    rdfs:comment "Descriptive text for lower smoke layer (dense, ground-hugging, etc.)." ;
    rdfs:domain ffonto:SmokeLayerObservation ;
    rdfs:range xsd:string .

ffonto:smokeLayerUpperDesc a owl:DatatypeProperty ;
    rdfs:label "upper smoke layer description" ;
    rdfs:comment "Descriptive text for higher/aloft plumes (rising columns, pyrocumulus building)." ;
    rdfs:domain ffonto:SmokeLayerObservation ;
    rdfs:range xsd:string .

ffonto:smokePM25 a owl:DatatypeProperty ;
    rdfs:label "smoke PM2.5 (ug/m3)" ;
    rdfs:comment "Measured PM2.5 concentration in micrograms per cubic meter from smoke." ;
    rdfs:domain ffonto:ParticulateMatter ;
    rdfs:range xsd:decimal .

ffonto:smokePlumeHeight a owl:DatatypeProperty ;
    rdfs:label "smoke plume height (descriptive)" ;
    rdfs:comment "Descriptive height of the smoke plume (e.g., 'very tall, extending high into the atmosphere')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokePlumeOrientation a owl:DatatypeProperty ;
    rdfs:label "smoke plume orientation" ;
    rdfs:comment "Whether plume is rising vertically or drifting horizontally (plus direction)." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokeReachedStratosphere a owl:DatatypeProperty ;
    rdfs:label "smoke reached stratosphere" ;
    rdfs:comment "Indicates that smoke from a fire has risen into the stratospheric layer of the atmosphere."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:smokeRising a owl:DatatypeProperty ;
    rdfs:label "smoke rising" ;
    rdfs:comment "Indicates whether smoke is still rising from a building after a wildfire." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:smokeScore a owl:DatatypeProperty ;
    rdfs:label "smoke score",
        "smoke score"@en ;
    rdfs:comment "Indicates a numerical value or algorithmic confidence metric representing the likelihood or density of detected smoke."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:smokeScoreAboveThreshold a owl:DatatypeProperty ;
    rdfs:label "smoke score above threshold",
        "smoke score above threshold"@en ;
    rdfs:comment "A boolean flag or indicator denoting whether the calculated smoke density metric exceeds the established warning limit."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:boolean .

ffonto:smokeThickness a owl:DatatypeProperty ;
    rdfs:label "smoke thickness (descriptive)" ;
    rdfs:comment "Descriptive thickness of smoke (e.g., 'extremely thick')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokeThreshold a owl:DatatypeProperty ;
    rdfs:label "smoke threshold",
        "smoke threshold"@en ;
    rdfs:comment "Defines the specific numerical boundary or concentration level at which a smoke detection alert is triggered."@en ;
    rdfs:domain ffonto:ThresholdSet ;
    rdfs:range xsd:decimal .

ffonto:smokeVisibilityDistance a owl:DatatypeProperty ;
    rdfs:label "visibility distance in miles" ;
    rdfs:comment "Estimated distance at which smoke visibility is reduced or obscured."@en ;
    rdfs:domain ffonto:EnvironmentalCondition ;
    rdfs:range xsd:decimal .

ffonto:smolderingPresent a owl:DatatypeProperty ;
    rdfs:label "smoldering present" ;
    rdfs:comment "Indicates smoldering patches are visible without open flames." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:boolean .

ffonto:snagsCount a owl:DatatypeProperty ;
    rdfs:label "snags count" ;
    rdfs:comment "Approximate number of snags visible (integer)." ;
    rdfs:domain ffonto:Snag ;
    rdfs:range xsd:integer .

ffonto:snagsPresent a owl:DatatypeProperty ;
    rdfs:label "snags present" ;
    rdfs:comment "Indicates whether dead standing trees (snags) are common in the frame." ;
    rdfs:domain ffonto:Snag ;
    rdfs:range xsd:boolean .

ffonto:snagsVisible a owl:DatatypeProperty ;
    rdfs:label "snags visible" ;
    rdfs:comment "Indicates whether many dead standing trees (snags) are visible." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:snowDepth a owl:DatatypeProperty ;
    rdfs:label "Snow Depth",
        "snow depth" ;
    rdfs:comment "Represents the depth of snow cover in the forest ecosystem." ;
    rdfs:domain ffonto:MeteorologicalObservation,
        ffonto:SnowCover ;
    rdfs:range xsd:decimal .

ffonto:soilMoisturePercent a owl:DatatypeProperty ;
    rdfs:label "soil moisture percent" ;
    rdfs:comment "Soil moisture percentage (volumetric or gravimetric as specified)." ;
    rdfs:domain ffonto:SoilQuality ;
    rdfs:range xsd:decimal .

ffonto:soilNutrientIndex a owl:DatatypeProperty ;
    rdfs:label "soil nutrient index" ;
    rdfs:comment "Index indicating soil nutrient availability." ;
    rdfs:domain ffonto:SoilQuality ;
    rdfs:range xsd:decimal .

ffonto:soilNutrientLevel a owl:DatatypeProperty ;
    rdfs:label "soil nutrient level" ;
    rdfs:comment "Represents the level of nutrients present in the soil." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:decimal .

ffonto:solarPanelDamaged a owl:DatatypeProperty ;
    rdfs:label "solar panel damaged" ;
    rdfs:comment "Indicates whether solar panels installed on a building are damaged." ;
    rdfs:domain ffonto:SolarPanel ;
    rdfs:range xsd:boolean .

ffonto:sourceLiteral a owl:DatatypeProperty ;
    rdfs:label "source literal",
        "source literal"@en ;
    rdfs:comment "Specifies the origin, creating agency, or foundational system of a dataset or observation as a text string."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:speciesDiversityIncrease a owl:DatatypeProperty ;
    rdfs:label "species diversity increase" ;
    rdfs:comment "Indicates whether plant species diversity increases after vegetation regrowth." ;
    rdfs:domain ffonto:VegetationRegrowth ;
    rdfs:range xsd:boolean .

ffonto:speciesRichness a owl:DatatypeProperty ;
    rdfs:label "species richness" ;
    rdfs:comment "Count of species observed in the habitat (richness metric)." ;
    rdfs:domain ffonto:HabitatType ;
    rdfs:range xsd:decimal .

ffonto:spotFiresDetected a owl:DatatypeProperty ;
    rdfs:label "spot fires detected" ;
    rdfs:comment "Indicates detection of new fires ignited ahead of the main fire front."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range xsd:boolean .

ffonto:spotFiresVisible a owl:DatatypeProperty ;
    rdfs:label "spot fires visible" ;
    rdfs:comment "Indicates visible spot fires ahead of main flame." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:boolean .

ffonto:spottersVisible a owl:DatatypeProperty ;
    rdfs:label "spotters or lookouts visible" ;
    rdfs:comment "Indicates whether spotters are positioned on higher ground." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:spottingNearStructureFires a owl:DatatypeProperty ;
    rdfs:label "spotting occurring near structures" ;
    rdfs:comment "True if ember spotting or small spot fires are visible near structures." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:boolean .

ffonto:spottingPotential a owl:DatatypeProperty ;
    rdfs:label "spotting potential present" ;
    rdfs:comment "The likelihood that firebrands will generate spot fires beyond the main fire front."@en ;
    rdfs:domain ffonto:SpottingEvent ;
    rdfs:range xsd:boolean .

ffonto:sprinklersOperating a owl:DatatypeProperty ;
    rdfs:label "sprinklers or misters operating" ;
    rdfs:comment "Indicates that sprinkler systems are actively discharging water for protection or suppression."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:sprinklersOrHoseRunning a owl:DatatypeProperty ;
    rdfs:label "sprinklers or hose running" ;
    rdfs:comment "Indicates whether water hoses or sprinklers are operating." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:stagedNearOf a owl:ObjectProperty ;
    rdfs:label "staged near of",
        "staged near of"@en ;
    rdfs:comment "Connects a deployed resource, equipment cache, or staging area back to the geographic feature or incident it is positioned for."@en ;
    rdfs:domain ffonto:CommandPost ;
    rdfs:range ffonto:Vehicle ;
    owl:inverseOf ffonto:stagedNear .

ffonto:stagingAreaVisible a owl:DatatypeProperty ;
    rdfs:label "staging area visible" ;
    rdfs:comment "Indicates whether a staging area for firefighting resources is visible." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:standingTreesCondition a owl:DatatypeProperty ;
    rdfs:label "standing trees condition" ;
    rdfs:comment "Condition of standing trees: 'mostly alive', 'mixed', 'mostly dead'." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:statisticDate rdfs:comment "The date associated with a statistical measure or reporting period."@en .

ffonto:steamVisible a owl:DatatypeProperty ;
    rdfs:label "steam visible where hot ground meets water" ;
    rdfs:comment "Indicates whether steam is visible where hot ground meets water." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range xsd:boolean .

ffonto:storesWaterOf a owl:ObjectProperty ;
    rdfs:label "stores water of" ;
    rdfs:comment "Inverse - Indicates that a water tank stores water that can be used as a water source." ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:WaterTank ;
    owl:inverseOf ffonto:storesWater .

ffonto:streamsRunningLow a owl:DatatypeProperty ;
    rdfs:label "streams running low or dry" ;
    rdfs:comment "Boolean indicating likely low streamflow conditions nearby." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:streetlightsDamaged a owl:DatatypeProperty ;
    rdfs:label "streetlights damaged or dark" ;
    rdfs:comment "Indicates whether streetlights appear damaged or unlit during daytime smoke conditions." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:structureAffectedOf a owl:ObjectProperty ;
    rdfs:label "inverse of structure affected"@en ;
    rdfs:comment "Inverse relation linking affected structures back to the incidents or hazards impacting them."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:structureAffected .

ffonto:structureCollapseRisk a owl:DatatypeProperty ;
    rdfs:label "structure collapse risk" ;
    rdfs:comment "Indicates whether a burning structure is likely to collapse." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:structureIgnitionRisk a owl:DatatypeProperty ;
    rdfs:label "structural ignition risk from radiant heat" ;
    rdfs:comment "Indicates whether structures are likely to ignite due to radiant heat." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:stumpsSmoking a owl:DatatypeProperty ;
    rdfs:label "stumps smoking" ;
    rdfs:comment "Indicates whether stumps are still smoking." ;
    rdfs:domain ffonto:Stump ;
    rdfs:range xsd:boolean .

ffonto:suggestsEnvironmentalProcessOf a owl:ObjectProperty ;
    rdfs:label "inverse of suggests environmental process"@en ;
    rdfs:comment "Inverse relation linking proposed environmental processes back to the evidence or observations supporting them."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:suggestsEnvironmentalProcess .

ffonto:sunVisible a owl:DatatypeProperty ;
    rdfs:label "sun visible through smoke" ;
    rdfs:comment "Indicates whether the sun is visible through smoke." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:boolean .

ffonto:supervisesAircraft a owl:ObjectProperty ;
    rdfs:label "supervises aircraft"@en ;
    rdfs:comment "Connects an air tactical group supervisor or air traffic control entity to the aerial assets under their direction."@en ;
    rdfs:domain ffonto:AirAttackSupervisor ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:isSupervisedByAirAttack .

ffonto:supportsBiodiversityOf a owl:ObjectProperty ;
    rdfs:label "supports biodiversity of" ;
    rdfs:comment "Inverse - Indicates that an ecosystem or vegetation type supports biodiversity." ;
    rdfs:domain ffonto:Biodiversity ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:supportsBiodiversity .

ffonto:supportsCommunity a owl:ObjectProperty ;
    rdfs:label "supports community"@en ;
    rdfs:comment "Links a plan, resource, or organization to the civilian population it aids or protects."@en ;
    rdfs:domain ffonto:NeighborSupportPlan ;
    rdfs:range ffonto:EvacuationZone ;
    owl:inverseOf ffonto:hasNeighborSupportPlan .

ffonto:supportsDecision a owl:ObjectProperty ;
    rdfs:label "supports decision"@en ;
    rdfs:comment "Links analytical data, a DSS (Decision Support System), or an observation to the operational command choice it informs."@en ;
    rdfs:domain ffonto:DecisionSupportSystem ;
    rdfs:range ffonto:IncidentCommand ;
    owl:inverseOf ffonto:isSupportedByDSS .

ffonto:supportsEcosystemHealthOf a owl:ObjectProperty ;
    rdfs:label "supports ecosystem health of" ;
    rdfs:comment "Inverse - Indicates that a feature such as a water body contributes to ecosystem services." ;
    rdfs:domain ffonto:EcosystemService ;
    rdfs:range ffonto:WaterBody ;
    owl:inverseOf ffonto:supportsEcosystemHealth .

ffonto:suppressionDifficultyLevel a owl:DatatypeProperty ;
    rdfs:label "suppression difficulty level" ;
    rdfs:comment "A categorical or numeric indicator of the difficulty in suppressing a fire."@en ;
    rdfs:domain ffonto:SuppressionDifficulty ;
    rdfs:range xsd:string .

ffonto:tankHeatDamage a owl:DatatypeProperty ;
    rdfs:label "tank heat damage visible" ;
    rdfs:comment "Indicates whether a tank shows heat damage (soot, warping)." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:teamworkObserved a owl:DatatypeProperty ;
    rdfs:label "teamwork evident" ;
    rdfs:comment "Indicates whether coordinated teamwork among firefighters is visible." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:comment "The textual content of the annotation." ;
    rdfs:domain ffonto:TextAnnotation ;
    rdfs:range xsd:string .

ffonto:threatenedByHazardOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatened by hazard"@en ;
    rdfs:comment "Inverse relation linking threats back to the hazards that threaten specified entities or areas."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:threatenedByHazard .

ffonto:threatensCommunityOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatens community"@en ;
    rdfs:comment "Inverse relation linking threats back to the communities that are endangered."@en ;
    rdfs:domain ffonto:Community ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:threatensCommunity .

ffonto:threatensFarmlandOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatens farmland"@en ;
    rdfs:comment "Inverse relation linking threats to farmland back to the hazards or events responsible."@en ;
    rdfs:domain ffonto:Farmland ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:threatensFarmland .

ffonto:threatensInfrastructureOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatens infrastructure"@en ;
    rdfs:comment "Inverse relation linking infrastructure threats back to the hazards or events that cause them."@en ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:threatensInfrastructure .

ffonto:threatensOf a owl:ObjectProperty ;
    rdfs:label "threatens of" ;
    rdfs:comment "Inverse - Who/what is threatened by a given hazard." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:Person ffonto:StructureFire ffonto:Animal ffonto:Infrastructure ) ] ;
    rdfs:range ffonto:Hazard ;
    owl:inverseOf ffonto:threatens .

ffonto:toolInUseOf a owl:ObjectProperty ;
    rdfs:label "inverse of tool in use"@en ;
    rdfs:comment "Inverse relation linking tools in use back to the crews, tasks, or operations employing them."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:toolInUse .

ffonto:torchingEvidence a owl:DatatypeProperty ;
    rdfs:label "evidence of torching" ;
    rdfs:comment "Indicates whether torching (single trees fully burned) is evident." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:boolean .

ffonto:tracksAircraft a owl:ObjectProperty ;
    rdfs:label "tracks aircraft"@en ;
    rdfs:comment "Links a system, radar, or operational role to the specific aerial vehicle whose flight path is being monitored."@en ;
    rdfs:domain ffonto:AircraftTracking ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:isTrackedBy .

ffonto:trafficControlSignsDeployed a owl:DatatypeProperty ;
    rdfs:label "traffic control signs deployed" ;
    rdfs:comment "Indicates whether responders deployed cones or warning signs." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:trafficSignsCharred a owl:DatatypeProperty ;

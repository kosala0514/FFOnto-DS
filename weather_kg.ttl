    rdfs:comment "A malfunction or breakage in electrical power lines that can result in outages or hazards."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:PowerOutageEvent a owl:Class ;
    rdfs:label "Power Outage Event" ;
    rdfs:comment "An interruption of electricity supply affecting households after wildfire." ;
    rdfs:subClassOf ffonto:EmergencyActivity .

ffonto:PregnantPerson a owl:Class ;
    rdfs:label "Pregnant Person" ;
    rdfs:comment "A person who is currently pregnant; may have specific health and safety considerations."@en ;
    rdfs:subClassOf ffonto:PopulationGroup .

ffonto:PrescribedBurn a owl:Class ;

ffonto:PhysicsInformedModel a owl:Class ;
    rdfs:label "Physics Informed ML Model",
        "Physics-informed ML" ;
    rdfs:comment "A model that incorporates known physical laws or constraints into its structure."@en ;
    rdfs:subClassOf ffonto:MachineLearning,
        ffonto:MachineLearningModel .

ffonto:Pine a owl:Class ;
    rdfs:label "Pine tree" ;
    rdfs:comment "A coniferous tree species belonging to the genus Pinus commonly found in boreal forests." ;
    rdfs:subClassOf ffonto:ConiferousTree .

ffonto:PlannedIgnition a owl:Class ;
    rdfs:label "Planned ignition" ;
    rdfs:comment "Deliberate ignition (e.g., prescribed burn)." ;
    rdfs:subClassOf ffonto:IgnitionSource ;
    owl:disjointWith ffonto:AccidentalIgnition,
        ffonto:NaturalIgnition .

ffonto:PlanningSection a owl:Class ;
    rdfs:label "Planning Section" ;
    rdfs:comment "The organizational unit responsible for incident planning, documentation, and future operations."@en ;
    rdfs:subClassOf ffonto:IncidentCommandSection .

ffonto:PoliceCar a owl:Class ;
    rdfs:label "Police Car" ;
    rdfs:comment "A vehicle operated by police personnel for law enforcement and emergency response."@en ;
    rdfs:subClassOf ffonto:Vehicle .

ffonto:PoorSoilFertility a owl:Class ;
    rdfs:label "Poor soil fertility" ;
    rdfs:comment "Soil condition characterized by low nutrient availability for plant growth." ;
    rdfs:subClassOf ffonto:SoilQuality .

ffonto:PortableGeneratorSafety a ffonto:GeneratorSafety ;
    rdfs:label "Portable Generator Safety" ;
    ffonto:generatorUsage "Outdoors only; keep >20 feet from openings; never operate in enclosed spaces; use CO monitor" ;
    rdfs:comment "Guidance: operate generators outdoors, away from doors/windows/balconies; never backfeed into household wiring; use CO alarms." .

ffonto:PortableWaterTank a owl:Class ;
    rdfs:label "Portable Water Tank (Pumpkin)" ;
    rdfs:comment "A movable container used to store water for firefighting or emergency supply."@en ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:PowerLineFailure a owl:Class ;

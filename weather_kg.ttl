    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:AirspaceConflictDetection ;
    owl:inverseOf ffonto:monitorsAirspace .

ffonto:monitorsInfrastructureOf a owl:ObjectProperty ;

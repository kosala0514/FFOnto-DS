    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:hostsSensor a owl:ObjectProperty ;
    rdfs:label "hosts sensor"@en ;
    rdfs:comment "Relates a physical platform, such as a weather station, tower, or UAV, to the sensory hardware installed upon it."@en .

ffonto:howToReceiveRealTimeAlerts a owl:DatatypeProperty ;

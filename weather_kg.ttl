ffonto:recommendedProtectionOf a owl:ObjectProperty ;
    rdfs:label "inverse of recommended protection"@en ;
    rdfs:comment "Inverse relation linking recommended protection measures to the assets they protect."@en ;
    rdfs:domain ffonto:ProtectionMethod ;
    rdfs:range ffonto:HealthAdvice ;
    owl:inverseOf ffonto:recommendedProtection .

ffonto:recommendsActionOf a owl:ObjectProperty ;
    rdfs:label "inverse of recommends action"@en ;
    rdfs:comment "Inverse relation linking recommended actions back to the guidance or authority issuing them."@en ;
    rdfs:domain ffonto:ProtectiveAction ;
    rdfs:range ffonto:HealthGuideline ;
    owl:inverseOf ffonto:recommendsAction .

ffonto:recordUUID a owl:DatatypeProperty ;
    rdfs:label "record UUID" ;
    rdfs:comment "Unique identifier of the stored record." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:recordsDecision a owl:ObjectProperty ;
    rdfs:label "records decision"@en ;
    rdfs:comment "Indicates that a log, database, or administrative document captures a specific operational choice or command action."@en ;
    rdfs:domain ffonto:DecisionLog ;
    rdfs:range ffonto:IncidentCommand ;

@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ffonto: <http://purl.org/ffonto#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ns2: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ffonto:AICC a ffonto:ResponseOrganization ;
    rdfs:label "Alaska Interagency Coordination Center" .

ffonto:AccessControl a owl:Class ;
    rdfs:label "Access Control" ;
    rdfs:comment "Mechanisms that restrict or permit entry to locations or data based on rules."@en ;
    rdfs:subClassOf ffonto:PrivacyProtection .

ffonto:AcresBurnedStatistic a owl:Class ;
    rdfs:label "Acres Burned"@en ;
    rdfs:subClassOf ffonto:WildfireStatistic .

ffonto:Acrolein a ffonto:AirToxic ;
    rdfs:label "Acrolein" ;
    ffonto:causesHealthEffect ffonto:RespiratoryIrritation ;
    rdfs:comment "A toxic aldehyde that causes irritation of eyes and respiratory system." .

ffonto:ActionArrangeHousing a ffonto:BeforeEvacuationAction ;
    rdfs:label "Arrange Temporary Housing" ;
    rdfs:comment "Identify friend/relative outside threatened area or shelter options." .

ffonto:ActionChooseRouteAwayFromFire a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Choose Route Away From Fire" ;
    rdfs:comment "Select routes that move away from smoke and fire, watch for changes in fire behavior." .

ffonto:ActionPackKit a ffonto:BeforeEvacuationAction ;
    rdfs:label "Pack Disaster Supply Kit" ;
    rdfs:comment "Gather family kit, medications, documents, pet supplies, cash, and chargers." .

ffonto:ActionPrepareCar a ffonto:BeforeEvacuationAction ;
    rdfs:label "Prepare Vehicle" ;
    rdfs:comment "Back vehicle into garage or park facing escape direction; ensure fuel and keys ready; roll up windows." .

ffonto:ActionTellSomeone a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Tell Someone When You Leave" ;
    rdfs:comment "Inform an out-of-area contact of destination and route." .

ffonto:ActionWearProtectiveClothing a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Wear Protective Clothing" ;
    ffonto:hasClothing ffonto:GlovesAndEyeProtection,
        ffonto:LongSleevesAndPants,
        ffonto:SturdyBoots ;
    rdfs:comment "Sturdy shoes, cotton/wool long pants & sleeves, gloves, and eye protection." .

ffonto:ActiveFire a owl:Class ;
    rdfs:label "Active Fire" ;
    rdfs:comment "An area where combustion is currently occurring and producing flames, heat, or smoke."@en ;
    rdfs:subClassOf ffonto:ContainmentState .

ffonto:ActiveForestFire a ffonto:ForestFire ;
    rdfs:label "Active Forest Wildfire" ;
    ffonto:createsHazard ffonto:CrownFireRisk,
        ffonto:EmberSpotting,
        ffonto:ReducedVisibility,
        ffonto:SmokeInhalation ;
    ffonto:hasFuel ffonto:DownedLogs,
        ffonto:DryGrass,
        ffonto:LeafLitter,
        ffonto:PineNeedles ;
    ffonto:hasSmokeDensity "High" ;
    ffonto:managedBy ffonto:USForestService ;
    ffonto:respondedBy ffonto:AerialFirefighting,
        ffonto:FireEngine,
        ffonto:WaterTanker .

ffonto:ActiveLearning a owl:Class ;
    rdfs:label "Active Learning" ;
    rdfs:comment "A machine learning approach where the algorithm selects data points to be labeled to improve learning efficiency."@en ;
    rdfs:subClassOf ffonto:ModelTrainingTechnique .

ffonto:AerialDropOperation a owl:Class ;
    rdfs:label "Aerial Drop Operation" ;
    rdfs:comment "A mission to release water, retardant, or supplies from aircraft to a target area."@en ;
    rdfs:subClassOf ffonto:SuppressionOperation .

ffonto:AerialFuel a ffonto:FuelType ;
    rdfs:label "Aerial Fuel" ;
    rdfs:comment "Standing vegetation crowns forming upper canopy fuels." .

ffonto:AerialPatrol a owl:Class ;
    rdfs:label "Aerial Patrol Detection" ;
    rdfs:comment "Aerial surveillance flight conducted to detect hazards, fires, or other incidents."@en ;
    rdfs:subClassOf ffonto:DetectionMethod .

ffonto:AgriculturalBuilding a owl:Class ;
    rdfs:label "Agricultural Building" ;
    rdfs:comment "A structure used for farming activities, storage, or livestock housing."@en ;
    rdfs:subClassOf ffonto:Building .

ffonto:AgriculturalBurn a owl:Class ;
    rdfs:label "Agricultural Burn" ;
    rdfs:comment "A controlled fire used in agricultural practices such as clearing crop residues." ;
    rdfs:subClassOf ffonto:IntentionalFire .

ffonto:AgriculturalExpansion a owl:Class ;
    rdfs:label "Agricultural Expansion" ;
    rdfs:comment "Conversion of natural landscapes into farmland." ;
    rdfs:subClassOf ffonto:LandCoverChange .

ffonto:AirQualityImpact a owl:Class ;
    rdfs:label "Air Quality Impact" ;
    rdfs:comment "Changes in atmospheric composition due to smoke and particulate matter." ;
    rdfs:subClassOf ffonto:PhysicalImpact .

ffonto:AirQualityRisk a owl:Class ;
    rdfs:label "Air Quality Risk" ;
    rdfs:comment "The risk to health or environment due to degraded air quality conditions."@en ;
    rdfs:subClassOf ffonto:HealthRisk .

ffonto:AirSupport a owl:Class ;
    rdfs:label "Air Support Suppression" ;
    rdfs:comment "Aerial resources assigned to assist ground operations, such as water drops or reconnaissance."@en ;
    rdfs:subClassOf ffonto:SuppressionMethod .

ffonto:AirTankerDrop a owl:Class ;
    rdfs:label "Air Tanker Drop" ;
    rdfs:comment "An aerial operation where an aircraft releases fire retardant or water over a target area."@en ;
    rdfs:subClassOf ffonto:SuppressionTactic .

ffonto:AirTankerDrops a ffonto:FireSuppressionAction ;
    rdfs:label "Air tanker retardant/water drops" ;
    ffonto:hasSuppressionLimit ffonto:ExtremeWindLimit .

ffonto:AircraftSensor a owl:Class ;
    rdfs:label "Aircraft Infrared Sensor" ;
    rdfs:comment "A sensor mounted on an aircraft used to collect airborne observations or imagery."@en ;
    rdfs:subClassOf ffonto:RemoteSensing .

ffonto:AlaskaPublicHealthResource a ffonto:InformationResource,
        ffonto:ResponseOrganization ;
    rdfs:label "Alaska Department of Health and Social Services" ;
    ffonto:hasWebsite "https://health.alaska.gov/en/division-of-public-health/"^^xsd:anyURI ;
    rdfs:comment "Public health organization providing wildfire smoke guidance." .

ffonto:AlternateRoutes a ffonto:EvacuationRoute ;
    rdfs:label "Alternate Evacuation Route" ;
    rdfs:comment "Have multiple routes planned to avoid blocked roads and reduce gridlock." .

ffonto:Arson a owl:Class ;
    rdfs:label "Arson" ;
    rdfs:comment "The deliberate ignition of fires with malicious or unlawful intent."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:AshPitHazard a owl:Class ;
    rdfs:label "Ash Pit Hazard" ;
    rdfs:comment "A danger from hot, smoldering ash pits that can cause burns or reignition."@en ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:Aspect a owl:Class ;
    rdfs:label "Aspect" ;
    rdfs:comment "The compass direction that a slope faces, affecting sun exposure and fire behavior."@en ;
    rdfs:subClassOf ffonto:Topography .

ffonto:Asthma a owl:Class ;
    rdfs:label "Asthma" ;
    rdfs:comment "A chronic respiratory condition characterized by airway inflammation and episodic breathing difficulties."@en ;
    rdfs:subClassOf ffonto:RespiratoryDisease .

ffonto:BUI a owl:DatatypeProperty ;
    rdfs:label "BUI" ;
    rdfs:comment "Buildup Index." ;
    rdfs:domain ffonto:FireWeatherRecord ;
    rdfs:range xsd:decimal .

ffonto:Backburning a owl:Class ;
    rdfs:label "Backburning" ;
    rdfs:comment "A controlled burning operation set inside control lines to consume fuel and reduce fire intensity."@en ;
    rdfs:subClassOf ffonto:SuppressionMethod,
        ffonto:SuppressionTactic .

ffonto:BarkBeetleInfestation a owl:Class ;
    rdfs:label "Bark beetle infestation" ;
    rdfs:comment "A specific pest disturbance where bark beetles damage trees." ;
    rdfs:subClassOf ffonto:PestInfestation .

ffonto:BarkBeetleOutbreak a owl:Class ;
    rdfs:label "Insect Outbreak (e.g., bark beetle)" ;
    rdfs:comment "A widespread infestation event of bark beetles causing tree mortality."@en ;
    rdfs:subClassOf ffonto:ClimateDriver .

ffonto:BarrenLand a owl:Class ;
    rdfs:label "Barren land" ;
    rdfs:comment "Land with little or no vegetation cover." ;
    rdfs:subClassOf ffonto:LandCover .

ffonto:BarrenTerrain a owl:Class ;
    rdfs:label "Barren terrain" ;
    rdfs:comment "Terrain with minimal vegetation cover." ;
    rdfs:subClassOf ffonto:TerrainType .

ffonto:Barricade a owl:Class ;
    rdfs:label "Barricade / Road-closure Sign" ;
    rdfs:comment "A physical obstruction placed to block access or protect an area."@en ;
    rdfs:subClassOf ffonto:TrafficControlDevice .

ffonto:Benzene a ffonto:AirToxic ;
    rdfs:label "Benzene" ;
    ffonto:causesHealthEffect ffonto:CancerRisk ;
    rdfs:comment "Carcinogenic chemical causing dizziness, anemia, and organ damage." .

ffonto:BiologicalControl rdfs:label "Biological Control" ;
    rdfs:comment "The service provided by natural processes in regulating populations of pests and pathogens." ;
    rdfs:subClassOf ffonto:EcosystemService .

ffonto:Birds a owl:Class ;
    rdfs:label "Birds" ;
    rdfs:comment "Avian species present in an area; may be affected by environmental events."@en ;
    rdfs:subClassOf ffonto:Wildlife .

ffonto:Black a ffonto:SmokeColor,
        owl:NamedIndividual ;
    rdfs:label "black" .

ffonto:BrownTinge a ffonto:SmokeColor,
        owl:NamedIndividual ;
    rdfs:label "brown-tinge" .

ffonto:BrushEngine a owl:Class ;
    rdfs:label "Brush Engine (Type 6)" ;
    rdfs:comment "A small firefighting vehicle designed for off-road access to brush and wildland fires."@en ;
    rdfs:subClassOf ffonto:FireEngine .

ffonto:BurnScarSegmentation a owl:Class ;
    rdfs:label "Burn Scar Segmentation" ;
    rdfs:comment "The classification of satellite or aerial imagery to delineate areas affected by burning."@en ;
    rdfs:subClassOf ffonto:ComputerVisionTask .

ffonto:CALFIRE a owl:NamedIndividual ;
    rdfs:label "California Department of Forestry and Fire Protection" ;
    ffonto:hasPhoneNumber "+1-916-653-7772" ;
    ffonto:hasWebsite "https://www.fire.ca.gov"^^xsd:anyURI .

ffonto:CAPAlert a owl:Class ;
    rdfs:label "Common Alerting Protocol (CAP) Alert" ;
    rdfs:comment "Common Alerting Protocol message used to distribute emergency alerts and warnings."@en ;
    rdfs:subClassOf ffonto:EmergencyAlert .

ffonto:CDCWildfireSmoke a ffonto:InformationResource ;
    rdfs:label "CDC Wildfire Smoke Resource" ;
    ffonto:hasWebsite "https://www.cdc.gov/wildfires/risk-factors/index.html"^^xsd:anyURI ;
    rdfs:comment "Official CDC webpage providing information on wildfire smoke health risks." .

ffonto:CDCWildfireSmokeGuide a ffonto:InformationResource ;
    rdfs:label "CDC ForestFire Smoke Health Guide" ;
    ffonto:hasWebsite "https://www.cdc.gov/wildfires/risk-factors/index.html"^^xsd:anyURI ;
    rdfs:comment "Official CDC guidance on wildfire smoke health risks." .

ffonto:CNPRC a owl:NamedIndividual ;
    rdfs:label "California National Primate Research Center (CNPRC)" ;
    ffonto:infoURL "https://cnprc.ucdavis.edu"^^xsd:anyURI .

ffonto:COG a owl:Class ;
    rdfs:label "Cloud Optimized GeoTIFF" ;
    rdfs:comment "Center of gravity (COG); a weighted center point used in analysis or modeling contexts."@en ;
    rdfs:subClassOf ffonto:GeospatialDataFormat .

ffonto:COPD a owl:Class ;
    rdfs:label "Chronic Obstructive Pulmonary Disease" ;
    rdfs:comment "Chronic Obstructive Pulmonary Disease; a respiratory condition that can be exacerbated by smoke exposure."@en ;
    rdfs:subClassOf ffonto:RespiratoryDisease .

ffonto:Camera a owl:Class ;
    rdfs:label "Camera"@en ;
    rdfs:comment "An imaging device used to capture visual data for wildfire monitoring or detection."@en ;
    rdfs:subClassOf ffonto:Sensor .

ffonto:CampfireIgnition a owl:Class ;
    rdfs:label "Campfire Ignition" ;
    rdfs:comment "The event or action that causes a campfire to be ignited."@en ;
    rdfs:subClassOf ffonto:HumanCause .

ffonto:CampfireRisk a ffonto:EvacuationAction ;
    rdfs:label "Campfire Risk Action" ;
    rdfs:comment "Observe burn bans, keep water and a shovel nearby, and ensure campfires are cold before leaving." .

ffonto:CampfireSafety a owl:Class ;
    rdfs:label "Campfire Safety Practice" ;
    rdfs:comment "Practices that reduce the risk of accidental fires when using campfires."@en ;
    rdfs:subClassOf ffonto:ForestFirePrevention .

ffonto:Canyon a owl:Class ;
    rdfs:label "Canyon"@en ;
    rdfs:comment "A deep valley with steep sides that can influence wildfire behavior and wind patterns."@en ;
    rdfs:subClassOf ffonto:Topography .

ffonto:CarbonDioxide a ffonto:SmokeComponent ;
    rdfs:label "Carbon Dioxide" .

ffonto:CarbonMonoxide a ffonto:SmokeComponent ;
    rdfs:label "Carbon Monoxide" ;
    rdfs:comment "Colorless, odorless gas produced during incomplete combustion." .

ffonto:CarbonSequestration a owl:Class ;
    rdfs:label "Carbon Sequestration" ;
    rdfs:comment "The process of removing carbon dioxide from the atmosphere and storing it in biomass or soils."@en ;
    rdfs:subClassOf ffonto:ClimateMitigation .

ffonto:CardiacStress a ffonto:CardiacIssue ;
    rdfs:label "Cardiac stress / thrombotic risk" .

ffonto:CashAndCards a ffonto:PreparednessItem ;
    rdfs:label "Cash and Payment Cards" ;
    rdfs:comment "Small cash reserve and credit/debit card for emergency purchases." .

ffonto:CautionTape a owl:Class ;
    rdfs:label "Caution Tape" ;
    rdfs:comment "Barrier tape used to mark hazards or restrict access at an incident scene."@en ;
    rdfs:subClassOf ffonto:TrafficControlDevice .

ffonto:Cellulose a ffonto:VegetationChemicalComponent ;
    rdfs:label "Cellulose" .

ffonto:Chainsaw a owl:Class ;
    rdfs:label "Chainsaw" ;
    rdfs:comment "A powered cutting tool used for felling and cutting wood; requires safety protocols."@en ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:ChangeDetection a owl:Class ;
    rdfs:label "Change Detection" ;
    rdfs:comment "Techniques to identify differences between datasets or images acquired at different times."@en ;
    rdfs:subClassOf ffonto:ComputerVisionTask .

ffonto:CigaretteButt a owl:Class ;
    rdfs:label "Discarded Cigarette Butt" ;
    rdfs:comment "The remnant of a smoked cigarette, often a source of ignition if improperly discarded."@en ;
    rdfs:subClassOf ffonto:HumanCause .

ffonto:CigaretteSafety a owl:Class ;
    rdfs:label "Cigarette Disposal Safety" ;
    rdfs:comment "Practices or measures aimed at reducing ignition risk associated with smoking materials."@en ;
    rdfs:subClassOf ffonto:ForestFirePrevention .

ffonto:Cistern a owl:Class ;
    rdfs:label "Cistern" ;
    rdfs:comment "A container for storing water, typically used as an emergency water source." ;
    rdfs:subClassOf ffonto:WaterSource .

ffonto:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A large human settlement." ;
    rdfs:subClassOf ffonto:SpatialEntity .

ffonto:ClimateChangeChallenge a ffonto:ChallengeOpportunity ;
    rdfs:label "Climate Change" ;
    ffonto:recommendedAction "Longer seasons, increased drought; requires strategic adaptation." .

ffonto:ClimateEngine a ffonto:MonitoringSystem ;
    rdfs:label "Climate Engine" ;
    ffonto:providedBy ffonto:NASA ;
    rdfs:comment "Web-based climate and remote sensing analysis platform using Google Earth Engine." .

ffonto:ClimateFeedbackLoop a owl:Class ;
    rdfs:label "Climate Feedback Loop" ;
    rdfs:comment "A process where climate system responses amplify or dampen an initial forcing."@en ;
    rdfs:subClassOf ffonto:ClimatePattern .

ffonto:CoarseWoodyDebris a owl:Class ;
    rdfs:label "Coarse woody debris" ;
    rdfs:comment "Large downed logs and branches contributing to long-duration burns." ;
    rdfs:subClassOf ffonto:FuelLoad .

ffonto:CommunityPlanning a owl:Class ;
    rdfs:label "Community Planning" ;
    rdfs:comment "Processes by which communities prepare policies and actions to reduce hazard impacts."@en ;
    rdfs:subClassOf ffonto:LandManagementPractice .

ffonto:CommunityProgram a owl:Class ;
    rdfs:label "Community ForestFire Protection Program" ;
    rdfs:comment "An organized local initiative to support preparedness, mitigation, or response activities."@en ;
    rdfs:subClassOf ffonto:CommunityPreparedness .

ffonto:CommunityWorkshop a owl:Class ;
    rdfs:label "Community Workshop" ;
    rdfs:comment "A public meeting or training session aimed at community engagement and education."@en ;
    rdfs:subClassOf ffonto:PublicEducationProgram .

ffonto:ConfinePets a ffonto:PetPreparation ;
    rdfs:label "Confine Pets to One Room" ;
    rdfs:comment "Temporarily confining pets to a single room prior to evacuation may simplify gathering them quickly." .

ffonto:ConiferForest a ffonto:VegetationType ;
    rdfs:label "Conifer Forest" ;
    rdfs:comment "Forest dominated by cone-bearing trees such as pine or fir." .

ffonto:ConiferousFunctional a owl:Class ;
    rdfs:label "Coniferous functional group" ;
    rdfs:comment "Conifer-dominated functional group." ;
    rdfs:subClassOf ffonto:VegetationFunctionalGroup ;
    owl:disjointWith ffonto:DeciduousFunctional .

ffonto:ContainedFire a owl:Class ;
    rdfs:label "Contained Fire" ;
    rdfs:comment "A fire that has been confined within established control lines or barriers."@en ;
    rdfs:subClassOf ffonto:ContainmentState .

ffonto:ContinuousDistribution a ffonto:VegetationDistribution ;
    rdfs:label "Continuous distribution" ;
    rdfs:comment "A vegetation distribution pattern where plant cover is relatively uniform and continuous across the landscape with minimal gaps." .

ffonto:ControlledFire a owl:Class ;
    rdfs:label "Controlled Fire" ;
    rdfs:comment "A deliberately ignited fire conducted under controlled conditions for management objectives."@en ;
    rdfs:subClassOf ffonto:ContainmentState .

ffonto:Coughing a ffonto:HealthSymptom ;
    rdfs:label "Coughing" .

ffonto:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A sovereign nation or state." ;
    rdfs:subClassOf ffonto:SpatialEntity .

ffonto:CountyFireDepartment a ffonto:ResponseOrganization ;
    rdfs:label "County Fire Department" ;
    ffonto:hasPhoneNumber "911" ;
    ffonto:hasWebsite "https://www.example-countyfire.gov"^^xsd:anyURI ;
    rdfs:comment "Local incident command and structural protection." .

ffonto:CrownFire a ffonto:FireType,
        owl:NamedIndividual ;
    rdfs:label "Crown fire" ;
    rdfs:comment "Crown fire (canopy-level)." .

ffonto:DAAC a ffonto:DataRepository ;
    rdfs:label "Distributed Active Archive Center (DAAC)" ;
    rdfs:comment "NASA data centers responsible for archiving and distributing Earth science data." .

ffonto:DC a owl:DatatypeProperty ;
    rdfs:label "DC" ;
    rdfs:comment "Drought Code." ;
    rdfs:domain ffonto:FireWeatherRecord ;
    rdfs:range xsd:decimal .

ffonto:DMC a owl:DatatypeProperty ;
    rdfs:label "DMC" ;
    rdfs:comment "Duff Moisture Code." ;
    rdfs:domain ffonto:FireWeatherRecord ;
    rdfs:range xsd:decimal .

ffonto:Damaged a owl:Class ;
    rdfs:label "Damaged" ;
    rdfs:comment "An item or structure that has sustained physical harm or impairment."@en ;
    rdfs:subClassOf ffonto:StructureLossStatus .

ffonto:DarkGray a ffonto:SmokeColor,
        owl:NamedIndividual ;
    rdfs:label "dark-gray" .

ffonto:DataBackup a ffonto:ContinuityStrategy ;
    rdfs:label "Data Backup Strategy" .

ffonto:DeadBiomass a owl:Class ;
    rdfs:label "Dead biomass" ;
    rdfs:comment "Accumulated dead plant material acting as fuel for fire." ;
    rdfs:subClassOf ffonto:ForestFireRiskFactor .

ffonto:DebrisBurning a owl:Class ;
    rdfs:label "Debris / Open Burning" ;
    rdfs:comment "The controlled or uncontrolled burning of vegetative or man-made debris."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:DebrisFlowHazard a owl:Class ;
    rdfs:label "Debris Flow Hazard" ;
    rdfs:comment "The presence of conditions that increase the likelihood of debris flows."@en ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:Decreasing a ffonto:Trend,
        owl:NamedIndividual ;
    rdfs:label "decreasing" .

ffonto:Deer a owl:Class ;
    rdfs:label "Deer" ;
    rdfs:comment "A cervid species; wildlife potentially affected by habitat change or fire."@en ;
    rdfs:subClassOf ffonto:Wildlife .

ffonto:DefaultPrioritization a ffonto:ResourcePrioritization ;
    rdfs:label "Default Prioritization Rule" ;
    ffonto:prioritizes ffonto:IncidentStabilization,
        ffonto:LifeSafety,
        ffonto:PropertyProtection .

ffonto:DefensibleSpaceAction a owl:Class ;
    rdfs:label "Defensible Space Action" ;
    rdfs:comment "The mitigation activity of removing or thinning vegetation and combustibles around structures to reduce ignition risk from a spreading wildfire." ;
    rdfs:subClassOf ffonto:ProtectiveAction .

ffonto:DefensibleSpaceSmall a ffonto:DefensibleSpace ;
    rdfs:label "Small defensible space (limited)" .

ffonto:Deforestation a owl:Class ;
    rdfs:label "Deforestation" ;
    rdfs:comment "Large-scale removal of forest cover." ;
    rdfs:subClassOf ffonto:Disturbance .

ffonto:DeforestationFire a owl:Class ;
    rdfs:label "Deforestation Fire" ;
    rdfs:comment "A fire intentionally set to clear forests for agriculture, infrastructure, or development." ;
    rdfs:subClassOf ffonto:IntentionalFire .

ffonto:DegradedVegetation a owl:Class ;
    rdfs:label "Degraded vegetation" ;
    rdfs:comment "Land cover where vegetation health or density has declined due to disturbance or environmental stress." ;
    rdfs:subClassOf ffonto:LandCover .

ffonto:DenseForest a owl:Class ;
    rdfs:label "Dense forest" ;
    rdfs:comment "Land cover characterized by dense tree canopy and continuous vegetation." ;
    rdfs:subClassOf ffonto:LandCover .

ffonto:DetectionResult a owl:Class ;
    rdfs:label "DetectionResult" ;
    rdfs:comment "Classification or detection outputs (e.g., smoke, fire)." ;
    rdfs:subClassOf ffonto:ModelOutput,
        ffonto:Result .

ffonto:DiceCoefficient a owl:Class ;
    rdfs:label "Dice Coefficient" ;
    rdfs:comment "A statistic for measuring similarity between two samples, commonly used in segmentation evaluation."@en ;
    rdfs:subClassOf ffonto:EvaluationMetric .

ffonto:DirectAttack a owl:Class ;
    rdfs:label "Direct Attack" ;
    rdfs:comment "A firefighting tactic where suppression efforts are applied directly to the fire's edge."@en ;
    rdfs:subClassOf ffonto:SuppressionMethod .

ffonto:DisabilityPrep a ffonto:SpecialNeedsPlan ;
    rdfs:label "Disability Evacuation Plan" ;
    rdfs:comment "Arrange accessible transport, backup power for medical devices, support network contacts, and accessible shelter options." .

ffonto:DiscardedCigarette a owl:Class ;
    rdfs:label "Discarded Cigarette" ;
    rdfs:comment "A cigarette that has been discarded; potential ignition source if still burning."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:DisconnectGarageOpener a ffonto:BeforeEvacuationAction ;
    rdfs:label "Disconnect Automatic Garage Door Opener" ;
    rdfs:comment "Prevent garage doors from opening unexpectedly during fire and allow manual operation if needed." .

ffonto:Division a owl:Class ;
    rdfs:label "Division",
        "Fire Division" ;
    rdfs:comment "A major administrative subdivision within a region." ;
    rdfs:subClassOf ffonto:Region .

ffonto:DocumentSafeguardFireproof a ffonto:ImportantDocument ;
    rdfs:label "Fireproof and Cloud Backup for Documents" ;
    ffonto:documentStorageMethod "fire-resistant safe; waterproof pouches; encrypted cloud backup" ;
    rdfs:comment "Keep originals in a fire-resistant safe, copies in waterproof pouches, and encrypted cloud backups for redundancy." .

ffonto:DomesticPets a ffonto:Animal ;
    rdfs:label "Domestic Pets" ;
    rdfs:comment "Pets such as dogs or cats affected by wildfire smoke exposure." .

ffonto:DownedPowerLine a owl:Class ;
    rdfs:label "Downed Power Line" ;
    rdfs:comment "An electrical conductor that has fallen from its support and may present hazard."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:DownedPowerLineHazard a owl:Class ;
    rdfs:label "Downed Power Line Hazard" ;
    rdfs:comment "A danger posed by electrical conductors that have fallen and may be energized."@en ;
    rdfs:subClassOf ffonto:Hazard .


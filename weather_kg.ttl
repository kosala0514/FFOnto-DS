    rdfs:comment "Whether bicycles or small portable machines (e.g., small generators) appear burned." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:biodiversityImpactDescription a owl:DatatypeProperty ;
    rdfs:label "biodiversity impact description" ;
    rdfs:comment "Describes how biodiversity may be impacted by wildfire disturbance." ;
    rdfs:domain ffonto:EcosystemImpact ;
    rdfs:range xsd:string .

ffonto:blockingRoadOf a owl:ObjectProperty ;

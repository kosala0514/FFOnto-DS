ffonto:occursDuring a owl:ObjectProperty ;
    rdfs:label "occurs during"@en ;
    rdfs:comment "A temporal relationship linking an event or action to the timeframe or larger incident in which it happens."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:OperationalPeriod ;
    owl:inverseOf ffonto:isOperationalPeriodOf .

ffonto:occursForPurposeOf a owl:ObjectProperty ;
    rdfs:label "inverse of occurs for purpose"@en ;
    rdfs:comment "Inverse relation linking activities to the purposes for which they occur."@en ;
    rdfs:domain ffonto:LandClearing ;
    rdfs:range ffonto:IntentionalFire ;
    owl:inverseOf ffonto:occursForPurpose .

ffonto:occursInArea a owl:ObjectProperty ;
    rdfs:label "occurs in area"@en ;
    rdfs:comment "Connects an event, operation, or incident to its specific geospatial location or physical boundary."@en ;
    rdfs:domain ffonto:DebrisFlowRisk ;
    rdfs:range geo:SpatialObject ;
    owl:inverseOf ffonto:hasDebrisFlowRisk .

ffonto:occursInEcosystem a owl:ObjectProperty ;
    rdfs:label "occurs in ecosystem"@en ;
    rdfs:comment "Relates specific vegetation back to the forest ecosystem it inhabits."@en ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:ForestEcosystem ;
    owl:inverseOf ffonto:hasVegetation .

ffonto:occursInSceneOf rdfs:comment "Inverse relation linking scene occurrences back to the events or objects within those scenes."@en .

ffonto:occursInTerrainOf a owl:ObjectProperty ;
    rdfs:label "inverse of occurs in terrain"@en ;
    rdfs:comment "Inverse relation linking occurrences to the terrain types where they take place."@en ;
    rdfs:domain ffonto:ForestTerrain ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:occursInTerrain .

ffonto:occursInWatershedOf a owl:ObjectProperty ;
    rdfs:label "occurs in watershed of" ;
    rdfs:comment "Inverse - Indicates the watershed where runoff flows and accumulates." ;
    rdfs:domain ffonto:Watershed ;
    rdfs:range ffonto:Runoff ;
    owl:inverseOf ffonto:occursInWatershed .

ffonto:onFlankOf a owl:ObjectProperty ;
    rdfs:label "inverse of on flank"@en ;
    rdfs:comment "Inverse relation linking flank-location descriptors back to the fire incidents or stretches they describe."@en ;
    rdfs:domain rdfs:Literal ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:onFlank .

ffonto:opacity a owl:DatatypeProperty ;
    rdfs:label "opacity",
        "opacity"@en ;
    rdfs:comment "Quantifies the degree to which an emission, such as a smoke plume, obscures visibility or blocks light transmission."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:operatesAtSceneOf a owl:ObjectProperty ;
    rdfs:label "operates at scene of" ;
    rdfs:comment "Inverse - Links responders or vehicles to the wildfire scene where they operate." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:operatesAtScene .

ffonto:operatesEquipmentOf a owl:ObjectProperty ;
    rdfs:label "inverse of operates equipment"@en ;
    rdfs:comment "Inverse relation indicating which agent or unit operates particular equipment."@en ;
    rdfs:domain ffonto:Equipment ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:operatesEquipment .

ffonto:operatesFromFacility a owl:ObjectProperty ;
    rdfs:label "operates from facility"@en ;
    rdfs:comment "Links an Incident Command Section to the physical emergency facility (e.g., basecamp) it operates from."@en ;
    rdfs:domain ffonto:IncidentCommandSection ;
    rdfs:range ffonto:EmergencyFacility ;
    owl:inverseOf ffonto:isFacilityOperatedBy .

ffonto:operatingInLine a owl:DatatypeProperty ;
    rdfs:label "operating in line formation" ;
    rdfs:comment "Indicates firefighters operating shoulder-to-shoulder." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:outrunWildfireGuidance a owl:DatatypeProperty ;
    rdfs:label "can you outrun a wildfire guidance" ;
    rdfs:comment "Guidance describing actions if a vehicle or person cannot escape an approaching fire."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:overheadCablesSagging a owl:DatatypeProperty ;
    rdfs:label "overhead cables sagging" ;
    rdfs:comment "Indicates whether overhead cables are sagging from heat." ;
    rdfs:domain ffonto:PowerLine ;
    rdfs:range xsd:boolean .

ffonto:overheadPowerlinesOverRoute a owl:DatatypeProperty ;
    rdfs:label "powerlines over evacuation route" ;
    rdfs:comment "Indicates whether powerlines cross evacuation routes." ;
    rdfs:domain ffonto:PowerInfrastructure ;
    rdfs:range xsd:boolean .

ffonto:parkingLotSurfaceDamaged a owl:DatatypeProperty ;
    rdfs:label "parking lot surface damaged" ;
    rdfs:comment "Indicates whether parking lot surfaces are blackened or cracked." ;
    rdfs:domain ffonto:Roadway ;
    rdfs:range xsd:boolean .

ffonto:partOfBuildingOf a owl:ObjectProperty ;
    rdfs:label "inverse of part of building"@en ;
    rdfs:comment "Inverse relation linking building component records back to the parent building they belong to."@en ;
    rdfs:domain ffonto:Building ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ffonto:Chimney ffonto:MeterBox ) ] ;
    owl:inverseOf ffonto:partOfBuilding .

ffonto:partOfFire a owl:ObjectProperty ;
    rdfs:label "part of fire"@en ;
    rdfs:comment "Relates a specific zone, such as a flank or head, or a secondary ignition to the primary wildfire incident."@en ;
    rdfs:domain ffonto:FireFlank ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasFireFlank .

ffonto:partOfIncidentCommandOf a owl:ObjectProperty ;
    rdfs:label "part of incident command of"@en ;
    rdfs:comment "Links a role, section, or individual within the Incident Command System to the specific emergency event they are managing."@en ;
    rdfs:domain ffonto:IncidentCommand ;
    rdfs:range ffonto:Branch ;
    owl:inverseOf ffonto:partOfIncidentCommand .

ffonto:partOfWildfire a owl:ObjectProperty ;
    rdfs:label "part of wildfire"@en ;
    rdfs:comment "Connects a distinct spatial zone (like a flank or spot fire) or temporal phase to the overarching natural fire incident."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasFireFront .

ffonto:particulateConcentration a owl:DatatypeProperty ;
    rdfs:label "particulate concentration" ;
    rdfs:comment "Represents the concentration of particulate matter in the air pollution measurement." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range xsd:float .

ffonto:particulateLevel a owl:DatatypeProperty ;
    rdfs:label "particulate level"@en ;
    rdfs:comment "The measured concentration of airborne particulate matter present in the atmosphere."@en ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range xsd:float .

ffonto:patioFurnitureBurned a owl:DatatypeProperty ;
    rdfs:label "patio furniture burned" ;
    rdfs:comment "Indicates whether patio furniture or outdoor items appear burned." ;
    rdfs:domain ffonto:OutdoorItems ;
    rdfs:range xsd:boolean .

ffonto:patioFurnitureMelted a owl:DatatypeProperty ;
    rdfs:label "patio furniture melted" ;
    rdfs:comment "Indicates whether patio furniture or plastic outdoor items melted from heat." ;
    rdfs:domain ffonto:OutdoorItems ;
    rdfs:range xsd:boolean .

ffonto:patrollingPerimeter a owl:DatatypeProperty ;
    rdfs:label "patrolling perimeter" ;
    rdfs:comment "Indicates firefighters walking along the fire perimeter." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:peopleCongregatingAtAssemblyPoint a owl:DatatypeProperty ;
    rdfs:label "people congregating at designated assembly point" ;
    rdfs:comment "Indicates that people are gathering at a designated assembly or rendezvous point."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:peopleEvacuating a owl:DatatypeProperty ;
    rdfs:label "people evacuating" ;
    rdfs:comment "An observation that people are in the process of leaving an area due to an emergency."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:peopleVisible a owl:DatatypeProperty ;
    rdfs:label "people visible" ;
    rdfs:comment "Indicates that people are observable in imagery or reports for situational awareness."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:peopleWearingMasks a owl:DatatypeProperty ;
    rdfs:label "people wearing masks" ;
    rdfs:comment "Observation that individuals are using masks, often for smoke or particulate protection."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:performingMopUp a owl:DatatypeProperty ;
    rdfs:label "performing mop-up" ;
    rdfs:comment "Indicates mop-up operations such as stirring and soaking hotspots." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range xsd:boolean .

ffonto:performsOperationOf a owl:ObjectProperty ;
    rdfs:label "performs operation of" ;
    rdfs:comment "Inverse - Relates a firefighter to an operation they perform." ;
    rdfs:domain ffonto:EmergencyOperation ;
    rdfs:range ffonto:EmergencyResponder ;
    owl:inverseOf ffonto:performsOperation .

ffonto:performsSuppressionOf a owl:ObjectProperty ;
    rdfs:label "performs suppression action of" ;
    rdfs:comment "Inverse - Indicates that responders perform a suppression activity." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:performsSuppression .

ffonto:performsTaskOf a owl:ObjectProperty ;
    rdfs:label "performs CV task of",
        "performs task of"@en ;
    rdfs:comment "Connects a specific action, duty, or assignment back to the operational role, team, or agent executing it."@en ;
    rdfs:domain ffonto:ComputerVisionTask ;
    rdfs:range ffonto:MachineLearningModel ;
    owl:inverseOf ffonto:performsTask .

ffonto:perimeterEstablished a owl:DatatypeProperty ;
    rdfs:label "perimeter established by responders" ;
    rdfs:comment "Indicates that a control or safety perimeter has been set up around an incident area."@en ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:personAssistingOthers a owl:DatatypeProperty ;
    rdfs:label "person assisting children/elderly" ;
    rdfs:comment "Observation that an individual is actively helping others during an event."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "phone number" ;
    rdfs:comment "Contact phone number." ;
    rdfs:domain ffonto:Contact ;
    rdfs:range xsd:string .

ffonto:pilotNavigationRisk a owl:DatatypeProperty ;
    rdfs:label "smoke risk for pilot navigation" ;
    rdfs:comment "Indicates whether smoke affects pilot navigation and visibility." ;
    rdfs:domain ffonto:AerialVehicle ;
    rdfs:range xsd:boolean .

ffonto:placeName a owl:DatatypeProperty ;
    rdfs:label "place name" ;
    rdfs:comment "Name of the place." ;
    rdfs:domain ffonto:SpatialEntity ;
    rdfs:range xsd:string .

ffonto:plansAerialDrop a owl:ObjectProperty ;
    rdfs:label "plans aerial drop"@en ;
    rdfs:comment "Connects an operational strategy or command role to the scheduled deployment of retardant or water from an aircraft."@en ;
    rdfs:domain ffonto:AerialDropPlanning ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:isPlannedByAerialDrop .

ffonto:portablePumpPlacedNearWaterSource a owl:DatatypeProperty ;
    rdfs:label "portable pump placed near water source" ;
    rdfs:comment "Indicates placement of a portable pump adjacent to a water source for supply operations."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:portableTankSetup a owl:DatatypeProperty ;
    rdfs:label "portable tank setup" ;
    rdfs:comment "Indicates whether portable tanks are set up near structures." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:posesHealthRiskOf a owl:ObjectProperty ;
    rdfs:label "inverse of poses health risk"@en ;
    rdfs:comment "Inverse relation linking posed health risks back to the hazardous source or condition."@en ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:posesHealthRisk .

ffonto:positionedBetweenFireAndStructureFire a owl:DatatypeProperty ;
    rdfs:label "positioned between fire and structure" ;
    rdfs:comment "Indicates a resource or barrier placed between a fire and a structure to protect it."@en ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:positionedBetweenOf a owl:ObjectProperty ;
    rdfs:label "positioned between" ;
    rdfs:comment "Inverse - Resources placed between fire and a structure to protect it." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:positionedBetween .

ffonto:postFireHazards a owl:DatatypeProperty ;
    rdfs:label "hazards in recently burned areas" ;
    rdfs:comment "Hazards that emerge after a fire, such as unstable trees, ash pits, or erosion."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code of a city or region." ;
    rdfs:domain ffonto:SpatialEntity ;
    rdfs:range xsd:string .

ffonto:powerLinesDown a owl:DatatypeProperty ;
    rdfs:label "power lines down" ;
    rdfs:comment "Indicates whether overhead electrical wires are visibly downed." ;
    rdfs:domain ffonto:PowerLine ;
    rdfs:range xsd:boolean .

ffonto:powerPoleBaseCharred a owl:DatatypeProperty ;
    rdfs:label "power pole base charred" ;
    rdfs:comment "Indicates whether the base of a power pole is charred." ;
    rdfs:domain ffonto:PowerPole ;
    rdfs:range xsd:boolean .

ffonto:powerPoleDamaged a owl:DatatypeProperty ;
    rdfs:label "power pole damaged or on fire" ;
    rdfs:comment "Indicates visible damage to an electrical power pole that may affect services or safety."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:powerShutoffPossibility a owl:DatatypeProperty ;
    rdfs:label "can power shutoffs occur during extreme fire weather" ;
    rdfs:comment "The potential for intentional power shutdowns to reduce ignition risk."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:powerlineArcing a owl:DatatypeProperty ;
    rdfs:label "powerline arcing detected" ;
    rdfs:comment "Indicates whether electrical powerlines are producing sparks or arcing." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:powerlineDown a owl:DatatypeProperty ;
    rdfs:label "powerline down" ;
    rdfs:comment "Indicates whether powerlines are down and potentially hazardous." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:powerlinesArcingOrDowned a owl:DatatypeProperty ;
    rdfs:label "powerlines arcing or downed" ;
    rdfs:comment "Indicates whether powerlines show sparks, arcing or are downed." ;
    rdfs:domain ffonto:PowerInfrastructure ;
    rdfs:range xsd:boolean .

ffonto:powerlinesVisible a owl:DatatypeProperty ;
    rdfs:label "powerlines visible" ;
    rdfs:comment "Observation that overhead powerlines are present and observable in imagery or reports."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:practicesOf a owl:ObjectProperty ;
    rdfs:label "inverse of practices"@en ;
    rdfs:comment "Inverse relation linking practices back to the programs, communities, or agencies that implement them."@en ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:EvacuationDrill ;
    owl:inverseOf ffonto:practices .

ffonto:precipitation a owl:DatatypeProperty ;
    rdfs:label "precipitation" ;
    rdfs:comment "Daily accumulated precipitation in millimeters (mm)." ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range xsd:decimal .

ffonto:predictsFireSpread a owl:ObjectProperty ;
    rdfs:label "predicts fire spread"@en ;
    rdfs:comment "Links a computational model, simulation, or analytical process to its forecast of how a fire perimeter will expand."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:isPredictedByModel .

ffonto:predictsSmokePlumeOf a owl:ObjectProperty ;
    rdfs:label "predicts smoke plume of"@en ;
    rdfs:comment "Connects a computational model or forecast to the specific wildfire whose particulate emissions and dispersion it estimates."@en ;
    rdfs:domain ffonto:SmokePlume ;
    rdfs:range ffonto:SmokeDispersionModel ;
    owl:inverseOf ffonto:predictsSmokePlume .

ffonto:preparedForZone a owl:ObjectProperty ;
    rdfs:label "prepared for zone"@en ;
    rdfs:comment "Connects a mitigation plan, resource cache, or community strategy to the specific geographic area it is designed to protect."@en ;
    rdfs:domain ffonto:ReadySetGoPlan ;
    rdfs:range ffonto:EvacuationZone ;
    owl:inverseOf ffonto:hasPreparednessPlan .

ffonto:prioritizesOf a owl:ObjectProperty ;
    rdfs:label "inverse of prioritizes"@en ;
    rdfs:comment "Inverse relation linking prioritization decisions back to the plans or authorities that set them."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:ResourcePrioritization ;
    owl:inverseOf ffonto:prioritizes .

ffonto:privateCarsPresent a owl:DatatypeProperty ;
    rdfs:label "private cars present" ;
    rdfs:comment "Observation that privately owned vehicles are present at a scene or location."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:processedByPlatform a owl:ObjectProperty ;
    rdfs:label "processed by platform"@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:ComputingPlatform .

ffonto:processesCloudCover a owl:ObjectProperty ;
    rdfs:label "processes cloud cover"@en ;
    rdfs:comment "Relates an atmospheric transport model to the cloud cover quality data it processes."@en ;
    rdfs:domain ffonto:AtmosphericTransportModel ;
    rdfs:range ffonto:CloudCoverQuality ;
    owl:inverseOf ffonto:isCloudCoverProcessedBy .

ffonto:produceSafeToEat a owl:DatatypeProperty ;
    rdfs:label "produce safe to eat"@en ;
    rdfs:comment "Indicates whether the agricultural produce is considered safe for consumption (true/false) after contamination assessment."@en ;
    rdfs:domain ffonto:AgriculturalProduce ;
    rdfs:range xsd:boolean .

ffonto:producedByFire a owl:ObjectProperty ;
    rdfs:label "produced by fire"@en ;
    rdfs:comment "Relates an emission, physical artifact (like ash), or environmental impact to the specific combustion event that created it."@en ;
    rdfs:domain ffonto:SmokePlume ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:producesSmokePlume .

ffonto:producedInAreaOf a owl:ObjectProperty ;
    rdfs:label "inverse of produced in area"@en ;
    rdfs:comment "Inverse relation linking produced materials or datasets back to the geographic area of production."@en ;
    rdfs:domain ffonto:Location ;
    rdfs:range ffonto:AgriculturalProduce ;
    owl:inverseOf ffonto:producedInArea .

ffonto:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:comment "A general relation indicating that an entity, event, or process generates a specific output, emission, or artifact."@en ;
    rdfs:domain ffonto:ModelExecution ;
    rdfs:range ffonto:ModelOutput ;
    owl:inverseOf ffonto:producedBy .

ffonto:producesAirPollutionOf a owl:ObjectProperty ;
    rdfs:label "produces air pollution of" ;
    rdfs:comment "Inverse - Smoke and particulate emissions resulting from a fire event." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:producesAirPollution .

ffonto:producesPollutionOf a owl:ObjectProperty ;
    rdfs:label "inverse of produces pollution"@en ;
    rdfs:comment "Inverse relation linking pollution production records back to the sources or activities responsible."@en ;
    rdfs:domain ffonto:WildfireSmoke ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:producesPollution .

ffonto:producesToxicOf a owl:ObjectProperty ;
    rdfs:label "inverse of produces toxic"@en ;
    rdfs:comment "Inverse relation linking production of toxic substances back to the generating process or event."@en ;
    rdfs:domain ffonto:AirToxic ;
    rdfs:range ffonto:Smoke ;
    owl:inverseOf ffonto:producesToxic .

ffonto:promotesRegenerationOf a owl:ObjectProperty ;
    rdfs:label "promotes regeneration of" ;
    rdfs:comment "Inverse - Fire can stimulate forest regrowth." ;
    rdfs:domain ffonto:ForestRegeneration ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:promotesRegeneration .

ffonto:propaneTankVisible a owl:DatatypeProperty ;
    rdfs:label "propane or gas tank visible" ;
    rdfs:comment "Indicates whether a propane or gas tank is visible near a structure." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:protectedOf a owl:ObjectProperty ;
    rdfs:label "inverse of protected by"@en ;
    rdfs:comment "Inverse relation linking protection status back to the assets or areas that are protected."@en ;
    rdfs:domain ffonto:ProtectionMethod ;
    rdfs:range ffonto:PopulationGroup ;
    owl:inverseOf ffonto:protectedBy .

ffonto:protectingAssetOf a owl:ObjectProperty ;
    rdfs:label "inverse of protecting asset"@en ;
    rdfs:comment "Inverse relation linking protection actions back to the assets being safeguarded."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:protectingAsset .

ffonto:protectingSpecificBuilding a owl:DatatypeProperty ;
    rdfs:label "protecting specific building" ;
    rdfs:comment "Indicates focused protection efforts directed toward a particular structure."@en ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:protectiveEquipmentDescription a owl:DatatypeProperty ;
    rdfs:label "protective equipment description" ;
    rdfs:comment "Text describing protective equipment worn by responders." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:string .

ffonto:protectsAgainst a owl:ObjectProperty ;
    rdfs:label "protects against"@en ;
    rdfs:comment "Indicates the specific hazard, threat, or condition that an entity, policy, or mitigation strategy defends against."@en ;
    rdfs:domain ffonto:SafetyMeasure ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:isMitigatedBy .

ffonto:protectsData a owl:ObjectProperty ;
    rdfs:label "protects data"@en ;
    rdfs:comment "Indicates that a cybersecurity protocol, privacy policy, or governance framework secures a specific information asset."@en ;
    rdfs:domain ffonto:PrivacyProtection ;
    rdfs:range ffonto:DataRepository ;
    owl:inverseOf ffonto:isProtectedByPrivacyPolicy .

ffonto:protectsStructureOf a owl:ObjectProperty ;
    rdfs:label "inverse of protects structure"@en ;
    rdfs:comment "Inverse relation linking structure protection measures back to the structures they protect."@en ;
    rdfs:domain ffonto:House ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:protectsStructure .

ffonto:protectsSystem a owl:ObjectProperty ;
    rdfs:label "protects system"@en ;
    rdfs:comment "Indicates that a mitigation strategy, policy, or device safeguards a technological or infrastructural system."@en ;
    rdfs:domain ffonto:CyberSecurityPractice ;
    rdfs:range ffonto:KnowledgeGraph ;
    owl:inverseOf ffonto:isProtectedBy .

ffonto:provenanceChecksumSHA256 a owl:DatatypeProperty ;
    rdfs:label "provenance checksum sha256",
        "provenance checksum SHA256"@en ;
    rdfs:comment "Records the SHA-256 cryptographic hash value used to verify the integrity and unchanged state of a digital asset."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range xsd:string .

ffonto:provenanceURI a owl:DatatypeProperty ;
    rdfs:label "provenance uri",
        "provenance URI"@en ;
    rdfs:comment "Provides the standard Uniform Resource Identifier linking to the detailed origin and lineage metadata of a resource."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range xsd:string .

ffonto:providedOf a owl:ObjectProperty ;
    rdfs:label "inverse of provided by"@en ;
    rdfs:comment "Inverse relation linking provided services or resources back to the providers."@en ;
    rdfs:domain ffonto:ResponseOrganization ;
    rdfs:range ffonto:HealthAdvice ;
    owl:inverseOf ffonto:providedBy .

ffonto:providesCarbonStorageOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides carbon storage"@en ;
    rdfs:comment "Inverse relation linking carbon storage services back to the ecosystems that provide them."@en ;
    rdfs:domain ffonto:CarbonSink ;
    rdfs:range ffonto:Forest ;
    owl:inverseOf ffonto:providesCarbonStorage .

ffonto:providesEcosystemServiceOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides ecosystem service"@en ;
    rdfs:comment "Inverse relation indicating that an entity supplies a particular ecosystem service to another."@en ;
    rdfs:domain ffonto:EcosystemService ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:providesEcosystemService .

ffonto:providesHabitatOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides habitat"@en ;
    rdfs:comment "Inverse relation linking habitat provisions back to the ecosystems or areas providing them."@en ;
    rdfs:domain ffonto:Habitat ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:providesHabitat .

ffonto:providesImageFor a owl:ObjectProperty ;
    rdfs:label "provides image for"@en ;
    rdfs:comment "Connects a camera, satellite, or visual dataset to the specific analysis, report, or system that utilizes its imagery."@en ;
    rdfs:domain ffonto:ImageContribution ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasImageContribution .

ffonto:providesInformationOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides information"@en ;
    rdfs:comment "Inverse relation linking informational resources back to the topics or entities they describe."@en ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range ffonto:InformationResource ;
    owl:inverseOf ffonto:providesInformation .

ffonto:providesProtectionFromSmoke a owl:ObjectProperty ;
    rdfs:label "provides protection from smoke"@en ;
    rdfs:comment "Indicates that a device, shelter, or policy shields individuals or equipment from the harmful effects of airborne particulate matter."@en ;
    rdfs:domain ffonto:CleanAirShelter ;
    rdfs:range ffonto:SmokePlume ;
    owl:inverseOf ffonto:isShelteredFrom .

ffonto:providesResourcesFor a owl:ObjectProperty ;
    rdfs:label "provides resources for"@en ;
    rdfs:comment "Links an organization, logistics hub, or mutual aid agreement to the specific incident or operation it supplies."@en ;
    rdfs:domain ffonto:LogisticsSection ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasLogisticsSupport .

ffonto:providesTrackingData a owl:ObjectProperty ;

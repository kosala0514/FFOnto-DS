ffonto:liveFuelMoistureLiteral a owl:DatatypeProperty ;
    rdfs:label "live fuel moisture (description)" ;
    rdfs:comment "Descriptive assessment of live fuel moisture in dominant brush." ;
    rdfs:domain ffonto:FuelCondition ;
    rdfs:range xsd:string .

ffonto:livestockTrailerPresent a owl:DatatypeProperty ;
    rdfs:label "livestock trailer present" ;
    rdfs:comment "Indicates the presence of a trailer used for transporting livestock."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:locatedAt a owl:ObjectProperty ;
    rdfs:label "located at"@en ;
    rdfs:comment "Relates an event or physical phenomenon to the geographic place/entity where it occurs."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SpatialEntity ;
    owl:inverseOf ffonto:isLocationOf .

ffonto:locatedInWUIOf a owl:ObjectProperty ;
    rdfs:label "located in WUI of",
        "located in WUI of"@en ;
    rdfs:comment "Connects a structure, incident, or operation to the specific Wildland-Urban Interface zone where human development meets natural terrain."@en ;
    rdfs:domain ffonto:WildlandUrbanInterface ;
    rdfs:range ffonto:WUICommunity ;

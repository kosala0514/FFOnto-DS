    rdfs:range xsd:float .

ffonto:hasTemperature rdfs:comment "Associates an entity with a measured temperature value."@en .

ffonto:hasTimestamp rdfs:comment "Associates an entity with a specific date-time stamp."@en .

ffonto:hasTrafficCones a owl:DatatypeProperty ;

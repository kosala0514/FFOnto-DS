    rdfs:label "Normalized Difference Vegetation Index (NDVI)" ;
    rdfs:comment "Normalized Difference Vegetation Index; a satellite-derived index indicating vegetation greenness."@en ;
    rdfs:subClassOf ffonto:VegetationIndex .

ffonto:NIOSH a ffonto:ResponseOrganization ;
    rdfs:label "National Institute for Occupational Safety and Health" .

ffonto:NOAA a ffonto:DataProvider ;
    rdfs:label "National Oceanic and Atmospheric Administration" ;
    ffonto:website "https://www.noaa.gov" .

ffonto:NWAspect a ffonto:AspectCategory ;
    rdfs:label "northwest" .

ffonto:NationalFireProtectionAssociation a ffonto:ResponseOrganization ;
    rdfs:label "National Fire Protection Association" ;
    ffonto:hasPhoneNumber "+1-617-770-3000" ;
    ffonto:hasWebsite "https://www.nfpa.org"^^xsd:anyURI ;
    rdfs:comment "Standards and guidance relevant to structure and vegetation fire hazards." .

ffonto:NationalFireRiskMap a ffonto:FireRiskMap ;
    rdfs:label "National Wildfire Risk Map" ;
    ffonto:mapUpdateFrequency "Updated daily during fire season" .

ffonto:NationalInteragencyFireCenter a owl:NamedIndividual ;
    rdfs:label "National Interagency Fire Center (NIFC)" ;
    ffonto:infoURL "https://www.nifc.gov"^^xsd:anyURI ;
    rdfs:comment "Interagency coordinating center for wildland fire response (US)." .

ffonto:NationalPrescribedBurnPolicy a ffonto:PrescribedBurnPolicy ;
    rdfs:label "National Prescribed Burn Policy Example" ;
    ffonto:recommendedAction "Specifies permit process, notification and monitoring requirements." .

ffonto:NaturalFeature rdfs:label "Natural feature"@en ;
    rdfs:comment "A naturally occurring geographic or environmental element such as forests, rivers, mountains, or vegetation."@en .

ffonto:NaturalFireline a owl:Class ;
    rdfs:label "Natural Fireline" ;
    rdfs:comment "A physical landscape feature that acts as a natural barrier to fire spread."@en ;
    rdfs:subClassOf ffonto:Fireline .

ffonto:NeighborhoodCoordination a ffonto:NeighborSupportPlan ;
    rdfs:label "Neighborhood Coordination Plan" ;
    rdfs:comment "Plan to identify neighbors with special needs, pool resources, and coordinate evacuation assistance." .

ffonto:NightConditions a owl:Class ;
    rdfs:label "Nighttime Conditions" ;
    rdfs:comment "Lower visibility, potential downslope winds, and operational hazards." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor .

ffonto:NighttimeConditions a ffonto:EnvironmentalCondition ;
    rdfs:label "Nighttime Conditions" .

ffonto:NitrogenOxides a ffonto:SmokeComponent ;
    rdfs:label "Nitrogen Oxides" .

ffonto:NormalizedBurnRatio a ffonto:RemoteSensingIndex ;
    rdfs:label "Normalized Burn Ratio (NBR)" ;
    ffonto:derivedFrom ffonto:SatelliteImagery ;
    rdfs:comment "Remote sensing index used to measure burn severity using pre- and post-fire imagery." .

ffonto:NutrientCycling a owl:Class ;
    rdfs:label "Nutrient Cycling" ;
    rdfs:comment "The release and recycling of nutrients (like Nitrogen and Carbon) back into the soil." ;
    rdfs:subClassOf ffonto:SupportingService .

ffonto:NutrientPoorSoil a owl:Class ;
    rdfs:label "Nutrient poor soil" ;
    rdfs:comment "Soil with low nutrient availability limiting vegetation growth." ;
    rdfs:subClassOf ffonto:SoilQuality .

ffonto:OGC a owl:NamedIndividual ;
    rdfs:label "Open Geospatial Consortium" ;
    ffonto:hasWebsite "https://www.ogc.org"^^xsd:anyURI .

ffonto:Oils a ffonto:VegetationChemicalComponent ;
    rdfs:label "Plant Oils" .

ffonto:OpticalScattering a owl:Class ;
    rdfs:label "Optical Scattering" ;
    rdfs:comment "Light scattering caused by smoke particles which reduces visibility." ;
    rdfs:subClassOf ffonto:AirPollutantProperty .

ffonto:P2Respirator a ffonto:ProtectiveEquipment ;
    rdfs:label "P2 Respirator Mask" ;
    rdfs:comment "Equivalent respirator used to protect against wildfire smoke particles." .

ffonto:ParkFacingEscapeDirection a ffonto:VehiclePreparation ;
    rdfs:label "Park Vehicle Facing Escape Direction" ;
    ffonto:vehicleFuelLevel "Keep fuel above half tank when in fire season" ;
    rdfs:comment "Back vehicle into garage or park facing escape direction for quick departure." .

ffonto:ParticleSize a owl:Class ;
    rdfs:label "Particle Size" ;
    rdfs:comment "Diameter of particulate matter in smoke, often measured in micrometers." ;
    rdfs:subClassOf ffonto:AirPollutantProperty .

ffonto:PatchyDistribution a ffonto:VegetationDistribution ;
    rdfs:label "Patchy distribution" ;
    rdfs:comment "A vegetation distribution pattern where plants occur in irregular, scattered patches separated by areas with little or no vegetation." .

ffonto:PeopleWithHeartDisease a ffonto:PopulationGroup ;
    rdfs:label "People with Heart Disease" .

ffonto:PestReduction rdfs:label "Pest and Disease Reduction" ;
    rdfs:comment "The reduction of harmful biological agents, such as invasive insects or fungal pathogens, through the heat or chemical effects of fire." ;
    rdfs:subClassOf ffonto:EcologicalEffect .

ffonto:PetGoKit a ffonto:PreparednessKit ;
    rdfs:label "Pet Go-Kit" ;
    ffonto:hasRequiredItem ffonto:PetCarrier,
        ffonto:PetFood,
        ffonto:PetVaccineRecord ;
    rdfs:comment "Supplies for pets: food, water, vaccination records, carrier, leash." .

ffonto:PetIndoorProtection a ffonto:SafetyMeasure ;
    rdfs:label "Keep Pets Indoors During Smoke Events" .

ffonto:PhysicalHazard a owl:Class ;
    rdfs:label "Physical Hazard" ;

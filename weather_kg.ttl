ffonto:ADSB a owl:Class ;
    rdfs:label "Automatic Dependent Surveillance Broadcast (ADS-B)" ;
    rdfs:comment "Automatic Dependent Surveillance–Broadcast; an aircraft surveillance technology broadcasting position information."@en ;
    rdfs:subClassOf ffonto:AircraftTracking .

ffonto:AccessConstraint a owl:Class ;
    rdfs:label "Access Constraint" ;
    rdfs:comment "Limited roads, steep slopes, blocked evacuation routes, equipment access issues." ;
    rdfs:subClassOf ffonto:PrivacyProtection .

ffonto:AccidentalIgnition a owl:Class ;
    rdfs:label "Accidental ignition" ;
    rdfs:comment "Human-caused accidental ignition." ;
    rdfs:subClassOf ffonto:IgnitionSource .

ffonto:AerialDropPlanning a owl:Class ;
    rdfs:label "Aerial Drop Planning" ;
    rdfs:comment "The logistical planning process for aircraft drops including safety, target selection, and quantities."@en ;
    rdfs:subClassOf ffonto:SuppressionTactic .

ffonto:AerialVisibility a owl:Class ;
    rdfs:label "Aerial Visibility" ;
    rdfs:comment "Visibility condition relevant to aerial resources." ;
    rdfs:subClassOf ffonto:VisibilityCondition .

ffonto:AgriculturalLand a owl:Class ;
    rdfs:label "Agricultural Land" ;
    rdfs:comment "Farms, crop fields, or managed grasslands impacted by wildfire." .

ffonto:AirAttackSupervisor a owl:Class ;
    rdfs:label "Air Attack Supervisor" ;
    rdfs:comment "An individual responsible for coordinating aerial firefighting resources and tactics."@en ;
    rdfs:subClassOf ffonto:IncidentCommandRole .

ffonto:AirConditioner a owl:Class ;
    rdfs:label "Air Conditioner" ;
    rdfs:comment "Cooling system used indoors that may filter air." ;
    rdfs:subClassOf ffonto:AirCleaner .

ffonto:AirspaceConflictDetection a owl:Class ;
    rdfs:label "Airspace Conflict Detection" ;
    rdfs:comment "The process of identifying potential conflicts between aircraft or airspace users."@en ;
    rdfs:subClassOf ffonto:AirspaceManagement .

ffonto:AnimalSmokeExposure a owl:Class ;
    rdfs:label "Animal Smoke Exposure" ;
    rdfs:comment "Risk of smoke inhalation or displacement for animals." .

ffonto:AssemblyArea a owl:Class ;
    rdfs:label "Assembly Area" ;
    rdfs:comment "Pre-designated safe area (parking lot, cleared road) where evacuees gather." .

ffonto:AudioAnalytics a owl:Class ;
    rdfs:label "Audio Analytics" ;
    rdfs:comment "Automated analysis of audio signals to detect events or extract features."@en ;
    rdfs:subClassOf ffonto:SensorFusion .

ffonto:AviationRoute a owl:Class ;
    rdfs:label "Aviation Route" ;
    rdfs:comment "Air traffic corridor affected by smoke or wildfire plume." .

ffonto:BAERAssessment a owl:Class ;
    rdfs:label "Burned Area Emergency Response Assessment" ;
    rdfs:comment "Burned Area Emergency Response assessment evaluating post-fire risks and recovery needs."@en ;
    rdfs:subClassOf ffonto:RiskAssessment .

ffonto:BVLOS a owl:Class ;
    rdfs:label "Beyond Visual Line Of Sight (BVLOS) Operation" ;
    rdfs:comment "Beyond Visual Line Of Sight: UAV operations conducted without direct visual contact with the aircraft."@en ;
    rdfs:subClassOf ffonto:UAVOperation .

ffonto:Biodiversity a owl:Class ;
    rdfs:label "Biodiversity" ;
    rdfs:comment "The variety and variability of living organisms within an ecosystem." .

ffonto:Branch a owl:Class ;
    rdfs:label "Operational Branch" ;
    rdfs:comment "A large organizational subdivision within an incident management structure."@en ;
    rdfs:subClassOf ffonto:OperationsSection .

ffonto:BurnEvidence a owl:Class ;
    rdfs:label "Burn Evidence" ;
    rdfs:comment "Observable evidence of burning such as ash, charring, scorch, smoldering." ;
    rdfs:subClassOf ffonto:SceneElement .

ffonto:CanaryDeployment a owl:Class ;
    rdfs:label "Canary Deployment" ;
    rdfs:comment "A software deployment strategy that releases changes to a subset of users to reduce risk."@en ;
    rdfs:subClassOf ffonto:CyberSecurityPractice .

ffonto:CancerRisk a ffonto:HealthEffect ;
    rdfs:label "Cancer Risk" .

ffonto:CarbonSink a owl:Class ;
    rdfs:label "Carbon Sink" ;
    rdfs:comment "The storage of carbon in biomass and soil to mitigate climate change." ;
    rdfs:subClassOf ffonto:RegulatingService .

ffonto:ClimateAnomaly a owl:Class ;
    rdfs:label "Climate Anomaly" ;
    rdfs:comment "Deviation of climate variables from long-term averages." ;
    rdfs:subClassOf ffonto:ClimateEvent .

ffonto:ClimateChange a owl:Class ;
    rdfs:label "Climate change" ;
    rdfs:comment "Long-term changes in global or regional climate patterns." .

ffonto:CloudCoverQuality a owl:Class ;
    rdfs:label "Cloud Cover Quality Metadata" ;
    rdfs:comment "Quality metadata for cloud cover field (presence/absence of quality flag)." .

ffonto:CommandPost a owl:Class ;
    rdfs:label "Command Post" ;
    rdfs:comment "A location from which incident command and coordination are conducted."@en .

ffonto:CommunicationTower a owl:Class ;
    rdfs:label "Communication Tower" ;
    rdfs:comment "Cell/communication towers." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:Community a owl:Class ;
    rdfs:label "Community" ;
    rdfs:comment "Population centers, towns, or settlements near a fire." .

ffonto:ComputingPlatform a owl:Class ;
    rdfs:label "Computing Platform"@en ;
    rdfs:comment "A software or cloud platform used to store, process, or analyze observation data."@en .

ffonto:DataAssimilation a owl:Class ;
    rdfs:label "Data Assimilation" ;
    rdfs:comment "Ingesting observations (hotspots, perimeters, weather) to nudge forecasts." ;
    rdfs:subClassOf ffonto:TimeSeriesAnalysis .

ffonto:DataStream a owl:Class ;
    rdfs:label "Data Stream" ;
    rdfs:comment "A continuous flow of data records generated over time from sensors or systems."@en .

ffonto:DatasetVersion a owl:Class ;
    rdfs:label "Dataset Version" ;
    rdfs:comment "A specific, identifiable release of a dataset, often with a version identifier and changelog."@en .

ffonto:DebrisFlowRisk a owl:Class ;
    rdfs:label "Debris Flow Risk" ;
    rdfs:comment "The potential for rapid mass-wasting events composed of water-saturated debris following storms or fires."@en ;
    rdfs:subClassOf ffonto:PostFireFloodRisk .

ffonto:DeciduousTree a owl:Class ;
    rdfs:label "Deciduous Tree" ;
    rdfs:comment "A tree species that sheds its leaves seasonally and is generally less flammable than coniferous trees." ;
    rdfs:subClassOf ffonto:Tree .

ffonto:DecisionLog a owl:Class ;
    rdfs:label "Decision Log" ;
    rdfs:comment "A record documenting decisions, rationale, and relevant facts made during an operation."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:DigitalTwin a owl:Class ;
    rdfs:label "Digital Twin" ;
    rdfs:comment "Dynamic virtual model of wildfire incidents integrating real-time sensor data.",
        "Live fused model of sensors, weather, fuel and operations for what-if simulation." ;
    rdfs:subClassOf ffonto:SimulationModel .

ffonto:DisturbanceHistory a owl:Class ;
    rdfs:label "Disturbance history" ;
    rdfs:comment "Records of past disturbances (fires, logging, disease) affecting a spatial unit." .

ffonto:EDXLMessage a owl:Class ;
    rdfs:label "Emergency Data Exchange Language Message" ;
    rdfs:comment "An Emergency Data Exchange Language message used for interoperable emergency communications."@en ;
    rdfs:subClassOf ffonto:EmergencyAlert .

ffonto:EmissionInventory a owl:Class ;
    rdfs:label "Emission Inventory" ;
    rdfs:comment "A compiled estimate of emissions by source, type, and timeframe."@en .

ffonto:EnvironmentType a owl:Class ;
    rdfs:label "Environment Type" ;
    rdfs:comment "General environmental setting (forested, grassland, agricultural)." .

ffonto:ErosionControl a owl:Class ;
    rdfs:label "Erosion Control" ;
    rdfs:comment "Prevention of soil erosion through vegetation cover." ;
    rdfs:subClassOf ffonto:PostFireRehabilitation,
        ffonto:RegulatingService .

ffonto:EvacuationDrill a owl:Class ;
    rdfs:label "Evacuation Drill" ;
    rdfs:comment "Organized practice of evacuation procedures." .

ffonto:EvacuationOrder a owl:Class ;
    rdfs:label "Evacuation Order" ;
    rdfs:comment "Formal direction to evacuate from authorities." ;
    rdfs:subClassOf ffonto:ProtectiveAction .

ffonto:EvacuationRoutingAlgorithm a owl:Class ;
    rdfs:label "Evacuation Routing Algorithm" ;
    rdfs:comment "An algorithm that computes recommended evacuation paths given constraints and hazards."@en .

ffonto:EvacuationShelter a owl:Class ;
    rdfs:label "Evacuation Shelter" ;
    rdfs:comment "Temporary housing (friend/relative, public shelter) information and rules (pet policies)." .

ffonto:EvacuationStatus a owl:Class ;
    rdfs:label "Evacuation Status" ;
    rdfs:comment "Status of evacuation routes or decisions during wildfire emergencies." .

ffonto:Evapotranspiration a owl:Class ;
    rdfs:label "Evapotranspiration" ;
    rdfs:comment "Combined evaporation and plant transpiration influencing drought conditions." ;
    rdfs:subClassOf ffonto:MeteorologicalObservation .

ffonto:ExteriorSiding a owl:Class ;
    rdfs:label "Exterior Siding" ;
    rdfs:comment "Represents the exterior covering or material attached to the outside walls of buildings." .

ffonto:FarmEquipment a owl:Class ;
    rdfs:label "Farm Equipment" ;
    rdfs:comment "Agricultural machines such as tractors or ATVs." ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:Farmland a owl:Class ;
    rdfs:label "Farmland" ;
    rdfs:comment "Agricultural land at risk from fire and embers." .

ffonto:FinanceAdministrationSection a owl:Class ;
    rdfs:label "Finance and Administration Section" ;
    rdfs:comment "The organizational unit handling fiscal, procurement, and administrative tasks during an incident."@en ;
    rdfs:subClassOf ffonto:IncidentCommandSection .

ffonto:FireBehaviorMetric a owl:Class ;
    rdfs:label "fire behavior metric"@en ;
    rdfs:comment "A quantitative measure used to describe how a fire burns, such as rate of spread, flame length, or intensity."@en ;
    rdfs:subClassOf ffonto:ObservableProperty .

ffonto:FireCluster a owl:Class ;
    rdfs:label "Fire Cluster" ;
    rdfs:comment "A distinct group or cluster of flames detected in the scene." .

ffonto:FireDriver a owl:Class ;
    rdfs:label "Fire Driver" ;
    rdfs:comment "Underlying cause or purpose of a fire event." .

ffonto:FireHose a owl:Class ;
    rdfs:label "Fire Hose" ;
    rdfs:comment "A flexible hose used to deliver water to extinguish fire." ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:FireLine a owl:Class ;
    rdfs:label "Fire Line" ;
    rdfs:comment "Constructed control line to stop fire spread." ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:FirePerimeter a owl:Class ;
    rdfs:label "Fire Perimeter" ;
    rdfs:comment "A boundary line delineating the outermost extent of active or recently active fire."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:FireRiskMap a owl:Class ;
    rdfs:label "Fire Risk Map" ;
    rdfs:comment "A map showing wildfire risk levels based on environmental and human factors." .

ffonto:FireSimulationSoftware a owl:Class ;
    rdfs:label "Fire Simulation Software" ;
    rdfs:comment "Software used to simulate fire behavior, spread, and related environmental effects."@en ;
    rdfs:subClassOf ffonto:ForestFireTechnology .

ffonto:FireTruck a owl:Class ;
    rdfs:label "Fire Truck" ;
    rdfs:comment "Ground firefighting vehicle." ;
    rdfs:subClassOf ffonto:EmergencyVehicle .

ffonto:ForestStructure a owl:Class ;
    rdfs:label "Forest structure" ;
    rdfs:comment "Structural characteristics of a forest ecosystem." .

ffonto:FuelAccumulation a owl:Class ;
    rdfs:label "Fuel Accumulation" ;
    rdfs:comment "Excess live or dead vegetation due to fire suppression or forest change." .

ffonto:Gate a owl:Class ;
    rdfs:label "Gate" ;
    rdfs:comment "Gates attached to fences or driveways." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:GroundCrew a owl:Class ;
    rdfs:label "Ground Fire Crew" ;
    rdfs:comment "Firefighters operating on the ground." .

ffonto:GroundVisibility a owl:Class ;
    rdfs:label "Ground Visibility" ;
    rdfs:comment "Visibility condition relevant to ground crews and roads." ;
    rdfs:subClassOf ffonto:VisibilityCondition .

ffonto:Guardrail a owl:Class ;
    rdfs:label "Guardrail" ;
    rdfs:comment "Roadside guardrails." ;
    rdfs:subClassOf ffonto:TransportationInfrastructure .

ffonto:Habitat a owl:Class ;
    rdfs:label "Habitat" ;
    rdfs:comment "The natural environment where species live and obtain resources." .

ffonto:HabitatFragmentation a owl:Class ;
    rdfs:label "Habitat fragmentation" ;
    rdfs:comment "Division of ecosystems into smaller isolated patches." .

ffonto:HazardousMaterial a owl:Class ;
    rdfs:label "Hazardous Material" ;
    rdfs:comment "Dangerous household or industrial substances that require special handling after wildfire." .

ffonto:Headache a ffonto:HealthSymptom ;
    rdfs:label "Headache" ;
    rdfs:comment "Common symptom from smoke inhalation." .

ffonto:HealthImpact a owl:Class ;
    rdfs:label "health impact"@en ;
    rdfs:comment "The effect of an event or environmental condition (e.g., smoke inhalation) on human or animal health."@en ;
    rdfs:subClassOf ffonto:ForestFireEffect .

ffonto:HeavyFuel a ffonto:FuelType ;
    rdfs:label "Heavy Fuel" ;
    rdfs:comment "Large woody materials like logs and branches that burn longer and produce high heat intensity." .

ffonto:Helispot a owl:Class ;
    rdfs:label "Helispot" ;
    rdfs:comment "A prepared area where helicopters can land and take off safely during operations."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:HomeHardening a owl:Class ;
    rdfs:label "Home Hardening" ;
    rdfs:comment "Structural and behavioral modifications to a building that reduce wildfire vulnerability."@en .

ffonto:HumanHealth a owl:Class ;
    rdfs:label "Human Health" ;
    rdfs:comment "Represents the respiratory or overall health condition of humans affected by environmental factors like air pollution." .

ffonto:Hydrant a owl:Class ;
    rdfs:label "Hydrant" ;
    rdfs:comment "Fire hydrants." ;
    rdfs:subClassOf ffonto:UtilityInfrastructure .

ffonto:ImageContribution a owl:Class ;
    rdfs:label "Image Contribution" ;
    rdfs:comment "An image or photograph provided by a person or organization for analysis or documentation."@en ;
    rdfs:subClassOf ffonto:CrowdsourcedReport .

ffonto:IncidentBriefing a owl:Class ;
    rdfs:label "Incident Briefing" ;
    rdfs:comment "A short, focused presentation of current situation, objectives, and safety information for personnel."@en ;
    rdfs:subClassOf ffonto:SituationReport .

ffonto:IncidentCommandPost a owl:Class ;
    rdfs:label "Incident Command Post" ;
    rdfs:comment "The central command location for managing wildfire response." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:IncidentCommander a owl:Class ;
    rdfs:label "Incident Commander" ;
    rdfs:comment "The person with overall responsibility for managing an incident and its response."@en ;
    rdfs:subClassOf ffonto:IncidentCommandSystem .

ffonto:InfrastructureRisk a owl:Class ;
    rdfs:label "Infrastructure Risk" ;
    rdfs:comment "Risks posed to roads, settlements, water supply systems, or utilities." ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:LandClearing a owl:Class ;
    rdfs:label "Land Clearing" ;
    rdfs:comment "Represents the purpose of clearing land for agriculture, development, or other uses." .

ffonto:LandCoverChange a owl:Class ;
    rdfs:label "Land Cover Change" ;
    rdfs:comment "Changes in land surface due to human activity such as deforestation or agriculture." ;
    rdfs:subClassOf ffonto:AnthropogenicFactor .

ffonto:LogisticsSection a owl:Class ;
    rdfs:label "Logistics Section" ;
    rdfs:comment "The organizational unit responsible for support services and resource provision during an incident."@en ;
    rdfs:subClassOf ffonto:IncidentCommandSection .

ffonto:MapBoard a owl:Class ;
    rdfs:label "Map Board" ;
    rdfs:comment "A board used during briefings to display maps and operational information." ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:MediaAsset a owl:Class ;
    rdfs:label "Media Asset" ;
    rdfs:comment "Represents an media file (audio/image) and its metadata (resolution, checksum, georef, path, license, etc.)." .

ffonto:MitigationSolution a owl:Class ;
    rdfs:label "Wildfire Mitigation Solution"@en ;
    rdfs:comment "A method or technology designed to reduce wildfire impact (e.g., fire-resistant housing)." .

ffonto:ModelDrift a owl:Class ;
    rdfs:label "Model Drift" ;
    rdfs:comment "A change in model performance over time due to changes in data or environment."@en .

ffonto:ModelVersion a owl:Class ;
    rdfs:label "Model Version" ;
    rdfs:comment "A named or numbered release of a model representing a specific state of development."@en .

ffonto:MultimodalDataFusion a owl:Class ;
    rdfs:label "Multimodal Data Fusion" ;
    rdfs:comment "Combining data from different modalities (e.g., imagery, audio, text) to improve analysis."@en .

ffonto:NASA a ffonto:DataProvider ;
    rdfs:label "NASA" ;
    ffonto:website "https://www.nasa.gov" .

ffonto:NaturalFirebreak a owl:Class ;
    rdfs:label "Natural Firebreak" ;
    rdfs:comment "Landscape features (rivers, wetlands, snowfields) that reduce fire spread risk." ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:OperationalPeriod a owl:Class ;
    rdfs:label "Operational Period" ;
    rdfs:comment "A defined time interval for which incident operations are planned or reported."@en ;
    rdfs:subClassOf ffonto:TemporalExtent .

ffonto:OutdoorItems a owl:Class ;
    rdfs:label "Outdoor Items" ;
    rdfs:comment "Patio furniture, tools, trailers, etc., located outside buildings." ;
    rdfs:subClassOf ffonto:Infrastructure,
        ffonto:SceneElement .

ffonto:PSPS a owl:Class ;
    rdfs:label "Planned Power Shutoff (PSPS)" ;
    rdfs:comment "Preemptive de-energization to reduce utility-caused ignitions." .

ffonto:PhysicalImpact a owl:Class ;
    rdfs:label "Physical Impact" ;
    rdfs:comment "Direct physical changes to the landscape and atmosphere." ;
    rdfs:subClassOf ffonto:EcologicalEffect .

ffonto:PortableTank a owl:Class ;
    rdfs:label "Portable Water Tank" ;
    rdfs:comment "Portable tanks (pumpkins) used to store water near structures during firefighting operations." ;
    rdfs:subClassOf ffonto:Equipment .

ffonto:PostFireRehabilitation a owl:Class ;
    rdfs:label "Post-Fire Rehabilitation" ;
    rdfs:comment "Actions to stabilize, restore and mitigate post-fire impacts." ;
    rdfs:subClassOf prov:Activity .

ffonto:PowerInfrastructureFailure a owl:Class ;
    rdfs:label "Power Infrastructure Failure" ;
    rdfs:comment "Unplanned failure of electric infrastructure that may cause ignitions." .

ffonto:PowerPole a owl:Class ;
    rdfs:label "Power Pole" ;
    rdfs:comment "Poles supporting overhead electrical infrastructure." ;
    rdfs:subClassOf ffonto:UtilityInfrastructure .

ffonto:PredictiveInterval a owl:Class ;
    rdfs:label "Predictive Interval" ;
    rdfs:comment "A statistical interval that quantifies the uncertainty range for future observations or forecasts."@en ;
    rdfs:subClassOf ffonto:PredictionUncertainty .

ffonto:PropaneTank a owl:Class ;
    rdfs:label "Propane Tank" ;
    rdfs:comment "A tank used to store propane gas near residential structures." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:PublicAlert a owl:Class ;
    rdfs:label "Public Alert / Warning" ;
    rdfs:comment "A notification issued to inform the public about an emergency or required action."@en ;
    rdfs:subClassOf ffonto:CommunicationMethod .

ffonto:Radio a owl:Class ;
    rdfs:label "Handheld Radio" ;
    rdfs:comment "A device or system for wireless audio communication used in operations."@en ;
    rdfs:subClassOf ffonto:CommunicationDevice .

ffonto:RadioComms a ffonto:RadioComms,
        owl:Class ;
    rdfs:label "Operational Radio Communications",
        "Radio Communications" ;
    rdfs:comment "Two-way communication using radio frequencies for coordination and information exchange."@en ;
    rdfs:subClassOf ffonto:CommunicationMethod .

ffonto:RehabArea a owl:Class ;
    rdfs:label "Rehabilitation Area" ;
    rdfs:comment "A rest area where firefighters recover and hydrate." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:ReportVerification a owl:Class ;
    rdfs:label "Report Verification" ;
    rdfs:comment "The process of confirming the accuracy, source, or validity of a report or observation."@en ;
    rdfs:subClassOf ffonto:QualityControlProcess .

ffonto:ResourceAllocationOptimization a owl:Class ;
    rdfs:label "Resource Allocation Optimization" ;
    rdfs:comment "Methods to allocate limited resources efficiently to meet objectives under constraints."@en ;
    rdfs:subClassOf ffonto:DecisionSupportSystem .

ffonto:ResourcePlacement a owl:Class ;
    rdfs:label "Resource Placement" ;
    rdfs:comment "Location/orientation of resources relative to assets and terrain." .

ffonto:RoadAccess a owl:Class ;
    rdfs:label "Road Access" ;
    rdfs:comment "Availability and condition of roadways allowing passage for vehicles and responders."@en ;
    rdfs:subClassOf ffonto:AccessConstraintDetail .

ffonto:RollbackStrategy a owl:Class ;
    rdfs:label "Rollback Strategy" ;
    rdfs:comment "A plan to revert systems, deployments, or operations to a previous stable state."@en .

ffonto:Roof a owl:Class ;
    rdfs:label "Roof" ;
    rdfs:comment "The upper covering of a building." ;
    rdfs:subClassOf ffonto:BuildingComponent .

ffonto:SafetyZone a owl:Class ;
    rdfs:label "Safety Zone" ;
    rdfs:comment "A cleared area used as refuge during wildfire operations where responders or civilians can remain safe." .

ffonto:SatelliteDetection a owl:Class ;
    rdfs:label "Satellite Detection" ;
    rdfs:comment "Thermal or spectral satellite detection of wildfire signatures." ;
    rdfs:subClassOf ffonto:DetectionMethod .

ffonto:SealVentsAction a ffonto:BeforeEvacuationAction ;
    rdfs:label "Seal Vents Action" ;
    rdfs:comment "Install pre-cut plywood or commercial seals over vents when time permits." .

ffonto:SeasonalFlammability a owl:Class ;
    rdfs:label "Seasonal Flammability" ;
    rdfs:comment "Variation in vegetation flammability depending on seasonal conditions." ;
    rdfs:subClassOf ffonto:FuelCharacteristic .

ffonto:SeedReleaseMechanism a owl:Class ;
    rdfs:label "Seed Release Mechanism" ;
    rdfs:comment "Biological processes that release seeds in response to fire." .

ffonto:SensorPlatform a owl:Class ;
    rdfs:label "Sensor Platform"@en ;
    rdfs:comment "A physical carrier or structure (e.g., drone, satellite, tower) that hosts sensors."@en ;
    rdfs:subClassOf sosa:Platform .

ffonto:ShortestSafePath a owl:Class ;
    rdfs:label "Shortest Safe Path" ;
    rdfs:comment "A computed route that minimizes distance while satisfying safety constraints."@en .

ffonto:Shrub a owl:Class ;
    rdfs:label "Shrub" ;
    rdfs:comment "A woody plant smaller than a tree, typically with multiple stems and forming part of forest understory vegetation." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:ShutOffGasAction a ffonto:BeforeEvacuationAction ;
    rdfs:label "Shut Off Gas Action" ;
    rdfs:comment "Procedure for turning off gas; only performed if instructed and safe." .

ffonto:SmokeDamage a owl:Class ;
    rdfs:label "Smoke Damage" ;
    rdfs:comment "Damage caused by smoke, often resulting from wildfires, house fires, or other combustion events." .

ffonto:SmokeDispersionModel a owl:Class ;
    rdfs:label "Smoke Dispersion Model" ;
    rdfs:comment "A computational model that simulates the transport and spread of smoke in the atmosphere."@en ;
    rdfs:subClassOf ffonto:AtmosphericTransportModel .

ffonto:Snag a owl:Class ;
    rdfs:label "Snag" ;
    rdfs:comment "Standing dead trees (snags)." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:SoilMoistureIndex a owl:Class ;
    rdfs:label "Soil Moisture Index" ;
    rdfs:comment "Indicator measuring soil water availability." ;
    rdfs:subClassOf ffonto:VegetationIndex .

ffonto:SpatialFeature rdfs:label "Spatial feature"@en ;
    rdfs:comment "A geographic feature or object that can be located or represented in spatial coordinates."@en .

ffonto:SpotFire a owl:Class ;
    rdfs:label "Spot Fire" ;
    rdfs:comment "Secondary ignition caused by embers." ;
    rdfs:subClassOf ffonto:FireFront .

ffonto:StructureProtection a ffonto:EmergencyOperation,
        owl:Class ;
    rdfs:label "Structure Protection",
        "Structure Protection Strategy" ;
    rdfs:comment "Measures undertaken to defend buildings and infrastructure from fire damage."@en .

ffonto:SuccessionStage a owl:Class ;
    rdfs:label "Succession stage" ;
    rdfs:comment "Post-disturbance vegetation stage (early successional shrubland, grassland, regenerating forest, etc.)." .

ffonto:SupportingService a owl:Class ;
    rdfs:label "Supporting Service" ;
    rdfs:comment "Fundamental services necessary for the production of all other ecosystem services." ;
    rdfs:subClassOf ffonto:EcosystemService .

ffonto:TemporaryFlightRestriction a owl:Class ;
    rdfs:label "Temporary Flight Restriction (TFR)" ;
    rdfs:comment "Airspace restriction protecting wildfire aircraft operations." ;
    rdfs:subClassOf ffonto:AirspaceManagement .

ffonto:ThermalCamera a owl:Class ;
    rdfs:label "Thermal Camera",
        "Thermal camera"@en ;
    rdfs:comment "A camera capable of detecting heat signatures for identifying fire hotspots."@en ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:TransitionalEcosystem a owl:Class ;
    rdfs:label "Transitional ecosystem" ;
    rdfs:comment "An ecosystem occurring between two ecological zones." ;
    rdfs:subClassOf ffonto:Ecosystem .

ffonto:TransportationRoute a owl:Class ;
    rdfs:label "Transportation Route" ;
    rdfs:comment "Roads or travel corridors affected by wildfire." .

ffonto:UrbanWildlandInterface a owl:Class ;
    rdfs:label "Urban Wildland Interface" ;
    rdfs:comment "Area where human infrastructure meets wildland vegetation." .

ffonto:UtilitySystem a owl:Class ;
    rdfs:label "Utility System" ;
    rdfs:comment "Infrastructure systems such as water or gas supply." .

ffonto:WUICommunity a owl:Class ;
    rdfs:label "WUI Community" ;
    rdfs:comment "A community located in the Wildland–Urban Interface (area where wildland and human development meet)."@en .

ffonto:WaterHose a owl:Class ;
    rdfs:label "Water Hose" ;
    rdfs:comment "Equipment used to deliver water to wet down structures or suppress wildfire flames." ;
    rdfs:subClassOf ffonto:FirefightingResource .

ffonto:WeatherCondition a owl:Class ;
    rdfs:label "Weather Condition" ;
    rdfs:comment "Current atmospheric state including variables such as temperature, wind, and precipitation."@en .

ffonto:WetRoofAction a ffonto:BeforeEvacuationAction ;
    rdfs:label "Wet Roof Action" ;
    rdfs:comment "Use hose or sprinklers to wet roof and vulnerable vegetation; prioritize ember-blocking measures." .

ffonto:WildfireSmoke a owl:Class ;
    rdfs:label "Wildfire Smoke" ;
    rdfs:comment "Smoke generated by wildfire combustion." ;
    rdfs:subClassOf ffonto:Smoke .

ffonto:WildlandUrbanInterface a owl:Class ;
    rdfs:label "Wildland-Urban Interface (WUI)" ;
    rdfs:comment "Areas where human development intermingles with wildland fuels." .

ffonto:WildlifeImpact a owl:Class ;
    rdfs:label "Wildlife Impact" ;
    rdfs:comment "Effects of fires/smoke on fauna (respiratory, cardiac, developmental, mortality)." ;
    rdfs:subClassOf ffonto:EnvironmentalImpact .

ffonto:hasBurnSeverity a owl:ObjectProperty ;
    rdfs:label "has burn severity" ;
    rdfs:comment "Severity class or index for a fire event." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireSeverity .

ffonto:hasManagementPurpose a owl:ObjectProperty ;
    rdfs:label "has management purpose" ;
    rdfs:comment "The stated objective of a management action (e.g., fuel reduction)." ;
    rdfs:domain ffonto:ManagementAction ;
    rdfs:range ffonto:ManagementPurpose .

ffonto:hasVegetation a owl:ObjectProperty ;
    rdfs:label "has vegetation" ;
    rdfs:comment "Relates a forest ecosystem to the vegetation present within it." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range ffonto:Vegetation .

ffonto:influencedBy a owl:ObjectProperty ;
    rdfs:label "influenced by" ;
    rdfs:comment "Indicates environmental conditions that affect the behavior of a fire event." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range ffonto:EnvironmentalCondition .


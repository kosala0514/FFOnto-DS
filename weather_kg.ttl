    rdfs:domain ffonto:AudioObservation ;
    rdfs:range xsd:decimal .

ffonto:audioMaxConfidence a owl:DatatypeProperty ;
    rdfs:label "audio max confidence" ;
    rdfs:comment "Maximum confidence observed for the audio detection." ;

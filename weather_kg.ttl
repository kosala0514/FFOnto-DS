    rdfs:domain ffonto:PreparednessKit ;
    rdfs:range xsd:integer .

ffonto:labelConfidence a owl:DatatypeProperty ;
    rdfs:label "label confidence",
        "label confidence"@en ;
    rdfs:comment "Indicates the statistical probability or subjective certainty that a specific annotation or tag is correct."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:decimal .

ffonto:labelCount a owl:DatatypeProperty ;
    rdfs:label "label count" ;
    rdfs:comment "Number of labels attached to an image record." ;
    rdfs:domain ffonto:ImageAsset ;
    rdfs:range xsd:integer .

ffonto:labelSeverity a owl:DatatypeProperty ;
    rdfs:label "label severity",
        "label severity"@en ;
    rdfs:comment "Indicates the level of intensity, danger, or urgency associated with a specific classification or alert."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:labelSourceLiteral a owl:DatatypeProperty ;
    rdfs:label "label source literal",
        "label source literal"@en ;
    rdfs:comment "Specifies the entity, system, or annotator responsible for generating a specific data tag, recorded as a text string."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:labelSourceOfOf a owl:ObjectProperty ;
    rdfs:label "inverse of label source of"@en ;
    rdfs:comment "Inverse relation linking label sources back to the entities or datasets they annotate."@en ;
    rdfs:domain ffonto:ModelProvenance ;
    rdfs:range ffonto:LabelAssignment ;
    owl:inverseOf ffonto:labelSourceOf .

ffonto:labelText a owl:DatatypeProperty ;
    rdfs:label "label text" ;
    rdfs:comment "Text of the label (e.g., 'high', 'smoke', 'fire')." ;
    rdfs:domain ffonto:PredictedLabel ;
    rdfs:range xsd:string .

ffonto:labelType a owl:DatatypeProperty ;
    rdfs:label "label type",
        "label type"@en ;
    rdfs:comment "Specifies the classification category or semantic nature of a given annotation or data tag."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:ladderFuelsMostlyGone a owl:DatatypeProperty ;
    rdfs:label "ladder fuels mostly gone" ;
    rdfs:comment "Indicates whether low branches and ladder fuels are mostly gone." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:landslideRiskVisible a owl:DatatypeProperty ;
    rdfs:label "landslide risk visible" ;
    rdfs:comment "Indicates whether landslide or rockfall risk is visible." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:leadsToEffectOf a owl:ObjectProperty ;
    rdfs:label "inverse of leads to effect"@en ;
    rdfs:comment "Inverse relation linking causal chains back to the effects they produce for specified targets."@en ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:leadsToEffect .

ffonto:leafLitterConsumed a owl:DatatypeProperty ;

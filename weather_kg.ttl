    rdfs:subClassOf ffonto:PreventionMeasure .

ffonto:ProlongedFireSeason a owl:Class ;
    rdfs:label "Longer Fire Season" ;
    rdfs:comment "An extended period of the year with elevated wildfire activity compared to historical norms."@en ;
    rdfs:subClassOf ffonto:ClimateDriver .

ffonto:PublicEducation a ffonto:PreventionMethod ;
    rdfs:label "Public Education" ;
    rdfs:comment "Awareness campaigns aimed at reducing accidental fire ignition." .

ffonto:PublicReporting a owl:Class ;
    rdfs:label "Public Fire Reporting" ;
    rdfs:comment "Mechanisms by which the public submits observations or incident reports to authorities."@en ;
    rdfs:subClassOf ffonto:DetectionMethod .

ffonto:PyrocumulusCloud a owl:Class ;

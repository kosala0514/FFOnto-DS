    rdfs:comment "Indicates whether vehicles show damage from fire or smoke." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehicleOnFire a owl:DatatypeProperty ;
    rdfs:label "vehicle on fire" ;
    rdfs:comment "Observation that a vehicle is actively burning."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:vehiclePartOf a owl:ObjectProperty ;
    rdfs:label "vehicle part of" ;

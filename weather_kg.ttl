        ffonto:PrescriptionMedications,
        ffonto:ThreeDayFoodSupply,
        ffonto:WaterOnePersonPerDay ;
    ffonto:kitDurationDays 5 ;
    rdfs:comment "Kit to sustain a household through evacuation and temporary displacement." .

ffonto:FetalNeuroEffect a ffonto:NeurologicalDevelopmentIssue ;
    rdfs:label "Prenatal neurodevelopmental risk" .

ffonto:FireContainmentFactor a owl:Class ;
    rdfs:label "Fire Containment Factor" ;
    rdfs:comment "A natural or artificial factor that limits or prevents the spread of fire." ;
    rdfs:subClassOf ffonto:FireSpreadCondition .

ffonto:FireCountStatistic a owl:Class ;
    rdfs:label "Fire Count"@en ;
    rdfs:subClassOf ffonto:WildfireStatistic .

ffonto:FireDrivenEcologicalChange a owl:Class ;
    rdfs:label "Fire Driven Ecological Change" ;
    rdfs:comment "Any ecological effect that is logically linked to a forest fire event." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ffonto:EcologicalEffect [ a owl:Restriction ;
                        owl:onProperty ffonto:isEcologicalEffectOf ;
                        owl:someValuesFrom ffonto:ForestFire ] ) ] .

ffonto:FireEmergencyService a owl:NamedIndividual ;
    rdfs:label "Fire Emergency Service Sri Lanka" ;
    ffonto:hasPhoneNumber "110" ;

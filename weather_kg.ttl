    rdfs:comment "Observation that vehicles are reversing course or turning to avoid hazards."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:verifiesReport a owl:ObjectProperty ;
    rdfs:label "verifies report"@en ;
    rdfs:comment "Indicates that a designated authority, secondary sensor, or validation process confirms the details of an incident log or alert."@en ;
    rdfs:domain ffonto:ReportVerification ;

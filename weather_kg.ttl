ffonto:hasAudioRecord a owl:ObjectProperty ;
    rdfs:label "has audio record" ;
    rdfs:comment "Relates an audio-based observation to the actual acoustic recording file." ;
    rdfs:domain ffonto:AudioObservation ;
    rdfs:range ffonto:AudioRecord .

ffonto:hasAudit a owl:ObjectProperty ;

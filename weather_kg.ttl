        ffonto:SoreThroat .

ffonto:SmokeExposureSystemic a ffonto:CardiovascularEffect ;
    rdfs:label "Cardiovascular stress" ;
    ffonto:hasSymptom ffonto:Headache,
        ffonto:Nausea .

ffonto:SmokeInhalationRisk a ffonto:HealthRisk ;
    rdfs:label "Smoke Inhalation Risk" ;
    rdfs:comment "Health risk caused by breathing wildfire smoke particles." .

ffonto:SmokeProtectionGuideline a ffonto:HealthGuideline ;
    rdfs:label "Wildfire Smoke Protection Guideline" ;
    ffonto:recommendsAction ffonto:CloseWindows,
        ffonto:LimitExercise,
        ffonto:StayIndoors,
        ffonto:UseHEPAFilter ;
    rdfs:comment "Guideline recommending protective actions to reduce health risks from wildfire smoke." .

ffonto:Smoker a owl:Class ;
    rdfs:label "Smoker" ;
    rdfs:comment "A person who uses tobacco or other smoked substances; potential ignition source in certain contexts."@en ;
    rdfs:subClassOf ffonto:PopulationGroup .

ffonto:SmokeyBearCampaign a ffonto:AwarenessCampaign ;
    rdfs:label "Smokey Bear ForestFire Prevention Campaign" ;
    ffonto:comment "Public campaign promoting wildfire prevention." .

ffonto:Smoking a owl:Class ;
    rdfs:label "Smoking (Discarded Cigarette)" ;
    rdfs:comment "The act of inhaling and exhaling tobacco or other substances; a potential fire ignition source."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:SmolderingPhase a owl:Class ;
    rdfs:label "Smoldering Phase" ;
    rdfs:comment "Low-temperature combustion phase producing high levels of carbon monoxide and smoke." ;
    rdfs:subClassOf ffonto:CombustionProcess .

ffonto:SnowCoverObservation a owl:Class ;
    rdfs:label "Snow Cover Observation" ;
    rdfs:comment "An observation indicating the presence of snow cover on the ground or vegetation in an environmental image." ;
    rdfs:subClassOf ffonto:ImageObservation .

ffonto:SocialEquity a owl:Class ;
    rdfs:label "Social Equity" ;
    rdfs:comment "The fair and just distribution of resources, opportunities, and burdens across populations."@en ;
    rdfs:subClassOf ffonto:EthicalConsideration .

ffonto:SoilErosion a owl:Class ;
    rdfs:label "Soil Erosion" ;
    rdfs:comment "The displacement of soil layers following the loss of protective vegetation." ;
    rdfs:subClassOf ffonto:PhysicalImpact .

ffonto:SoilMoistureRetention a owl:Class ;
    rdfs:label "Soil moisture retention" ;
    rdfs:comment "Ability of an ecosystem or water body to maintain soil moisture levels." ;
    rdfs:subClassOf ffonto:EcosystemService .

ffonto:SoilNutrientLoss a owl:Class ;
    rdfs:label "Soil nutrient loss" ;
    rdfs:comment "Reduction in soil fertility due to environmental factors." ;
    rdfs:subClassOf ffonto:EcologicalStress .

ffonto:SparseVegetation a owl:Class ;
    rdfs:label "Sparse vegetation" ;
    rdfs:comment "Vegetation distributed sparsely across the landscape." ;
    rdfs:subClassOf ffonto:VegetationCondition .

ffonto:SparseWoodland a owl:Class ;
    rdfs:label "Sparse woodland" ;
    rdfs:comment "Woodland area with scattered trees and lower canopy density." ;
    rdfs:subClassOf ffonto:LandCover .

ffonto:SpecialNeedsForHousehold a ffonto:SpecialNeedsPlan ;
    rdfs:label "Household Special Needs Plan" ;
    rdfs:comment "Arrangements for transport, backup power, medication continuity, and accessible shelter; coordinate with local agencies." .

ffonto:SpeciesCompositionChange a owl:Class ;
    rdfs:label "Species Composition Change" ;
    rdfs:comment "A shift in the types and proportions of species present in an ecosystem following disturbance." ;
    rdfs:subClassOf ffonto:VegetationDynamics .

ffonto:SpontaneousCombustion a owl:Class ;
    rdfs:label "Spontaneous Combustion" ;
    rdfs:comment "A self-ignition event caused by internal heat generation without external ignition sources."@en ;
    rdfs:subClassOf ffonto:NaturalCause,
        ffonto:NaturalIgnition .

ffonto:Spruce a owl:Class ;
    rdfs:label "Spruce tree" ;
    rdfs:comment "A coniferous tree species belonging to the genus Picea commonly found in cold forest ecosystems." ;
    rdfs:subClassOf ffonto:ConiferousTree .

ffonto:SriLankaForestDepartment a owl:NamedIndividual ;
    rdfs:label "Sri Lanka Forest Department" ;
    ffonto:hasPhoneNumber "+94-11-2866631" ;
    ffonto:hasWebsite "https://www.fd.gov.lk"^^xsd:anyURI .

ffonto:Stable a ffonto:Trend,
        owl:NamedIndividual ;
    rdfs:label "stable" .

ffonto:StageGo a ffonto:ReadySetGoPlan,
        owl:NamedIndividual ;
    rdfs:label "Go Stage" ;
    rdfs:comment "Leave immediately when ordered or when conditions are unsafe; follow official routes." .

ffonto:StageReady a ffonto:ReadySetGoPlan,
        owl:NamedIndividual ;
    rdfs:label "Ready Stage" ;
    rdfs:comment "Prepare home and kit; plan routes; maintain vehicle fuel; safeguard important documents." .

ffonto:StageSet a ffonto:ReadySetGoPlan,
        owl:NamedIndividual ;
    rdfs:label "Set Stage" ;
    rdfs:comment "Be packed and prepared to leave at short notice; move family and pets to central location; load car if safe to do so." .

ffonto:StandardCommunicationPlan a ffonto:CommunicationPlan ;
    rdfs:label "Standard Communication Plan" ;
    ffonto:contacts ffonto:NationalFireAgency ;
    rdfs:comment "Tell someone where you're going; share rendezvous points and alternate contacts." .

ffonto:StandardDeployableShelter a ffonto:DeployableShelter ;
    rdfs:label "Standard Deployable Fire Shelter" ;
    ffonto:hasLimitation "Intended as last-resort; limited protection from direct flame and extreme radiant heat." .

ffonto:StandardICS a ffonto:IncidentCommandSystem ;
    rdfs:label "Standard ICS Model" ;
    ffonto:hasCommunicationMethod ffonto:PublicAlert,
        ffonto:RadioComms ;
    ffonto:hasICSFunction ffonto:CommandFunction,
        ffonto:FinanceFunction,
        ffonto:LogisticsFunction,
        ffonto:OperationsFunction,
        ffonto:PlanningFunction .

ffonto:Starch a ffonto:VegetationChemicalComponent ;
    rdfs:label "Starch" .

ffonto:StayIndoorsAdvice a ffonto:HealthAdvice ;
    rdfs:label "Stay indoors health advice" ;
    ffonto:providedBy ffonto:CDC ;
    rdfs:comment "Recommendation to remain indoors and limit physical activity during hazardous smoke conditions." .

ffonto:SteepGradeConstraint a ffonto:VehicleAccess ;
    rdfs:label "Steep grade constraint" ;
    rdfs:comment "Steep grade limiting vehicle access" .

ffonto:SteepHillside a ffonto:ForestTerrain ;
    rdfs:label "Steep Hillside Terrain" ;
    rdfs:comment "Steep slopes that accelerate wildfire spread uphill." .

ffonto:SteepTerrain a ffonto:EnvironmentalCondition ;
    rdfs:label "Steep Terrain" .

ffonto:Stream a owl:Class ;
    rdfs:label "Stream" ;
    rdfs:comment "A natural flowing water source that may be used for drafting water." ;
    rdfs:subClassOf ffonto:WaterBody .

ffonto:StrongWind a ffonto:EnvironmentalCondition ;
    rdfs:label "Strong Wind" .

ffonto:StructuralCollapse a owl:Class ;
    rdfs:label "Structural Collapse Hazard" ;
    rdfs:comment "Risk of building collapse endangering personnel." ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:SurfaceFire a ffonto:FireType,
        owl:NamedIndividual ;
    rdfs:label "Surface/ground fire" ;
    rdfs:comment "Surface or ground fire (includes intermittent torching)." .

ffonto:SwarmUAV a owl:Class ;
    rdfs:label "UAV Swarm" ;
    rdfs:comment "A coordinated group of unmanned aerial vehicles operating together to accomplish tasks."@en ;
    rdfs:subClassOf ffonto:UAV .

ffonto:TFRdefinition a owl:DatatypeProperty ;
    rdfs:label "what is a Temporary Flight Restriction (TFR)" ;
    rdfs:comment "Definition of a Temporary Flight Restriction (airspace limitation for safety or security)."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:Tannins a ffonto:VegetationChemicalComponent ;
    rdfs:label "Tannins" .

ffonto:TechOpportunity a ffonto:ChallengeOpportunity ;
    rdfs:label "Technology Opportunity" ;
    ffonto:recommendedAction "Improved detection, modeling and communications." .

ffonto:TemperatureAnomaly a owl:Class ;
    rdfs:label "Temperature Anomaly" ;
    rdfs:comment "Periods of unusually high temperature." ;
    rdfs:subClassOf ffonto:ClimateDriver .

ffonto:TemporalRecord a owl:Class ;
    rdfs:label "Temporal Record" ;
    rdfs:comment "Represents whether timestamp metadata is available for pairing events." ;
    rdfs:subClassOf ffonto:TemporalExtent .

ffonto:ThermalUAV a ffonto:UAV ;
    rdfs:label "Thermal UAV with thermal camera and edge device" ;
    ffonto:enables ffonto:SmokeDetection .

ffonto:TotalLoss a owl:Class ;
    rdfs:label "Total Loss" ;
    rdfs:comment "Structure deemed unsalvageable; resource priorities change." ;
    rdfs:subClassOf ffonto:StructureLossStatus .

ffonto:Town a owl:Class ;
    rdfs:label "Town" ;
    rdfs:comment "A smaller urban settlement than a city." ;
    rdfs:subClassOf ffonto:SpatialEntity .

ffonto:ToxicSmoke a owl:Class ;
    rdfs:label "Toxic Smoke" ;
    rdfs:comment "Smoke from structures or hazardous materials containing toxic combustion products (plastics, treated wood)." ;
    rdfs:subClassOf ffonto:SmokeHazard .

ffonto:TrafficAvoidance a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Traffic Avoidance Actions" ;
    rdfs:comment "Leave early, follow official evacuation routes, obey traffic control and consider alternate routes." .

ffonto:TrafficCone a owl:Class ;
    rdfs:label "Traffic Cone" ;
    rdfs:comment "A portable conical marker used for traffic control and scene safety."@en ;
    rdfs:subClassOf ffonto:TrafficControlDevice .

ffonto:Trailer a owl:Class ;
    rdfs:label "Trailer" ;
    rdfs:comment "Represents a towable vehicle such as a travel trailer or utility trailer." ;
    rdfs:subClassOf ffonto:Vehicle .

ffonto:TreeCollapse a ffonto:Hazard ;
    rdfs:label "Falling Tree Hazard" .

ffonto:Tundra a owl:Class ;
    rdfs:label "Tundra ecosystem" ;
    rdfs:comment "Cold ecosystem with minimal vegetation and permafrost soils." ;
    rdfs:subClassOf ffonto:Ecosystem .

ffonto:UCDavis a owl:NamedIndividual ;
    rdfs:label "University of California, Davis (UC Davis)" ;
    ffonto:infoURL "https://www.ucdavis.edu"^^xsd:anyURI .

ffonto:UNOOSA a owl:NamedIndividual ;
    rdfs:label "United Nations Office for Outer Space Affairs" ;
    ffonto:hasWebsite "https://www.unoosa.org"^^xsd:anyURI .

ffonto:USFS a owl:NamedIndividual ;
    rdfs:label "United States Forest Service (USFS)" ;
    ffonto:infoURL "https://www.fs.usda.gov"^^xsd:anyURI ;
    ffonto:phone "+1-202-205-8333" .

ffonto:USGS a ffonto:DataProvider ;
    rdfs:label "United States Geological Survey" ;
    ffonto:website "https://www.usgs.gov" .

ffonto:UrbanDevelopment a owl:Class ;
    rdfs:label "Urban Development Near Forests" ;
    rdfs:comment "Human settlements near forests increasing ignition risk." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor .

ffonto:UrbanGrowth a owl:Class ;
    rdfs:label "Urban Growth" ;
    rdfs:comment "Expansion of urban areas into natural landscapes increasing ignition sources." ;
    rdfs:subClassOf ffonto:LandCoverChange .

ffonto:UtilityCrew a owl:Class ;
    rdfs:label "Utility Crew" ;
    rdfs:comment "Crew from utility companies (power, gas) working on infrastructure." ;
    rdfs:subClassOf ffonto:Responder .

ffonto:VIIRSInstrument a ffonto:VIIRS ;
    rdfs:label "VIIRS satellite instrument" .

ffonto:VIIRSSensor a ffonto:RemoteSensingSensor ;
    rdfs:label "VIIRS Satellite Sensor" .

ffonto:Valley a owl:Class ;
    rdfs:label "Valley"@en ;
    rdfs:comment "A low area between hills or mountains that may influence wildfire spread and smoke movement."@en ;
    rdfs:subClassOf ffonto:TerrainFeature .

ffonto:VegetationDryness a owl:Class ;
    rdfs:label "Vegetation Dryness" ;
    rdfs:comment "A measure of moisture deficiency in vegetation that influences flammability."@en ;
    rdfs:subClassOf ffonto:ForestFireRiskFactor .

ffonto:VegetationPatternObservation a owl:Class ;
    rdfs:label "Vegetation Pattern Observation" ;
    rdfs:comment "An observation describing spatial patterns of vegetation such as dense clusters, sparse coverage, or uneven distribution detected in an image." ;
    rdfs:subClassOf ffonto:ImageObservation .

ffonto:VegetationStress a owl:Class ;
    rdfs:label "Vegetation stress" ;
    rdfs:comment "Stress affecting plant growth or health." ;
    rdfs:subClassOf ffonto:EcologicalStress .

ffonto:VehicleDamage a owl:Class ;
    rdfs:label "Vehicle Damage" ;
    rdfs:comment "Damage to vehicles caused by wildfire heat or smoke." ;
    rdfs:subClassOf ffonto:ForestFireEffect .

ffonto:VehiclePrepGuidance a ffonto:VehiclePreparation ;
    rdfs:label "Vehicle Evacuation Preparation Guidance" ;
    ffonto:vehicleFuelLevel ">=50%" ;
    rdfs:comment "Maintain vehicles, keep fuel above half tank, store emergency kit, and plan routes." .

ffonto:VehicleSafety a owl:Class ;
    rdfs:label "Vehicle Fire Safety" ;
    rdfs:comment "Design features and practices that reduce risk to vehicle occupants and responders."@en ;
    rdfs:subClassOf ffonto:ForestFirePrevention .

ffonto:VehicleSpark a owl:Class ;
    rdfs:label "Vehicle Spark" ;
    rdfs:comment "Sparks from exhaust, dragging chains, or catalytic converters igniting roadside fuels." ;
    rdfs:subClassOf ffonto:HumanCause,
        ffonto:HumanIgnition .

ffonto:Village a owl:Class ;
    rdfs:label "Village" ;
    rdfs:comment "A small rural settlement." ;
    rdfs:subClassOf ffonto:SpatialEntity .

ffonto:VisibilityHazard a ffonto:Hazard ;
    rdfs:label "Reduced Visibility Hazard" ;
    rdfs:comment "Hazard where dense smoke reduces visibility for responders." .

ffonto:VisibilityReduction a owl:Class ;
    rdfs:label "Visibility Reduction" ;
    rdfs:comment "Decreased atmospheric visibility caused by smoke particles." ;
    rdfs:subClassOf ffonto:AirPollutantProperty .

ffonto:VolcanicActivity a owl:Class ;
    rdfs:label "Volcanic Eruption" ;
    rdfs:comment "Geologic processes and events associated with volcanic unrest or eruptions."@en ;
    rdfs:subClassOf ffonto:NaturalCause,
        ffonto:NaturalIgnition .

ffonto:VulnerabilityAssessment a owl:Class ;
    rdfs:label "Vulnerability Assessment" ;
    rdfs:comment "An evaluation of susceptibilities to harm from hazards or threats."@en ;
    rdfs:subClassOf ffonto:FireRiskAssessment .

ffonto:VulnerablePopulation a owl:Class ;
    rdfs:label "Vulnerable Population" ;
    rdfs:comment "Groups of people who may require special assistance or are at increased risk during emergencies."@en ;
    rdfs:subClassOf ffonto:PopulationGroup .

ffonto:WAspect a ffonto:AspectCategory ;
    rdfs:label "west" .

ffonto:WaterDropOperation a ffonto:FirefightingOperation ;
    rdfs:label "Helicopter Water Drop Operation" .

ffonto:WaterSupply a owl:Class ;
    rdfs:label "Water Supply System" ;
    rdfs:comment "Local water infrastructure used for community and firefighting needs." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:WaterSupplyDisruption a ffonto:InfrastructureRisk ;
    rdfs:label "Water Supply Disruption Risk" .

ffonto:WaterTender a owl:Class ;
    rdfs:label "Water Tender" ;
    rdfs:comment "A vehicle designed to transport and supply water for firefighting operations."@en ;
    rdfs:subClassOf ffonto:Vehicle .

ffonto:WaterVapor a ffonto:SmokeComponent ;
    rdfs:label "Water Vapor" .

ffonto:WatershedManagement a owl:Class ;
    rdfs:label "Watershed Management" ;
    rdfs:comment "Planning and practices to manage water resources and land use in a watershed."@en ;
    rdfs:subClassOf ffonto:LandManagementPractice .

ffonto:Waxes a ffonto:VegetationChemicalComponent ;
    rdfs:label "Plant Waxes" .

ffonto:WetLine a owl:Class ;
    rdfs:label "Wet Line" ;
    rdfs:comment "A line of water applied to vegetation or ground to act as a temporary firebreak."@en ;
    rdfs:subClassOf ffonto:Fireline .

ffonto:WetRoofAndNearby a ffonto:HomeProtectionMeasure ;
    rdfs:label "Wet Roof and Nearby Vegetation" ;
    ffonto:usesProtectionMethod ffonto:WetRoofAction ;
    rdfs:comment "If time allows, wet roof and nearby shrubs to reduce ember ignition — note this is not a guaranteed defense." .

ffonto:Wetland a owl:Class ;
    rdfs:label "Wetland" ;
    rdfs:comment "An ecosystem where land is saturated with water." ;
    rdfs:subClassOf ffonto:Ecosystem .

ffonto:WildfireDamage a owl:Class ;
    rdfs:label "Wildfire damage" ;
    rdfs:comment "Vegetation damage caused by wildfire events." ;
    rdfs:subClassOf ffonto:Disturbance .

ffonto:WildfireEvacuation a ffonto:EvacuationProcedure ;
    rdfs:label "Wildfire Evacuation Procedure" ;
    ffonto:requiresItem ffonto:FirstAidKit,
        ffonto:ImportantDocuments,
        ffonto:Medication,
        ffonto:Water ;
    rdfs:comment "Procedures residents should follow during wildfire emergencies." .

ffonto:WildfireInformationLine a ffonto:EmergencyContact ;
    rdfs:label "Wildfire Public Information Hotline" ;
    ffonto:hasPhoneNumber "+1-800-237-3633" ;
    rdfs:comment "Public hotline providing wildfire information and assistance." .

ffonto:WildfireSmokeExposure a ffonto:HealthRisk ;
    rdfs:label "Wildfire Smoke Exposure" ;
    ffonto:affectsPopulation ffonto:Children,
        ffonto:HeartLungPatients,
        ffonto:OlderAdults,
        ffonto:PregnantPeople ;
    rdfs:comment "Exposure to smoke containing gases and fine particulate matter." .

ffonto:WildfireVsPrescribed a owl:NamedIndividual ;
    rdfs:label "Wildfire vs Prescribed Burn - distinction" ;
    rdfs:comment "Wildfires are unplanned and uncontrolled; prescribed burns are planned and conducted under controlled conditions." .

ffonto:Wind a owl:Class ;
    rdfs:label "Wind" ;
    rdfs:comment "Air movement that influences fire spread and ember transport." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor,
        ffonto:ForestFireRiskFactor,
        ffonto:WeatherFactor .

ffonto:WindEvent a owl:Class ;
    rdfs:label "High Wind Event" ;
    rdfs:comment "Periods of elevated winds that promote fire spread and ember transport." ;
    rdfs:subClassOf ffonto:ClimateDriver .

ffonto:WorldviewPlatform a ffonto:FireAlertSystem ;
    rdfs:label "NASA Worldview Fire Monitoring Platform" ;
    rdfs:comment "NASA web application for visualizing near-real-time satellite imagery including wildfire detections." .

ffonto:ZeroTrustArchitecture a owl:Class ;
    rdfs:label "Zero Trust Architecture" ;
    rdfs:comment "A security model that assumes no implicit trust and enforces continuous verification."@en ;
    rdfs:subClassOf ffonto:CyberSecurityPractice .

ffonto:Zone1 a owl:Class ;
    rdfs:label "Zone 1 (Home Zone)" ;
    rdfs:comment "Closest zone to the structure; typically 0-5 feet (or meters) - remove all flammable materials." ;
    rdfs:subClassOf ffonto:DefensibleZone .

ffonto:Zone2 a owl:Class ;
    rdfs:label "Zone 2 (Intermediate Zone)" ;
    rdfs:comment "Intermediate area for fuel reduction and spacing (e.g., 5-30 feet)." ;
    rdfs:subClassOf ffonto:DefensibleZone .

ffonto:Zone3 a owl:Class ;
    rdfs:label "Zone 3 (Extended Zone)" ;
    rdfs:comment "Outer zone used for thinning, ladder-fuel removal (e.g., 30-100 feet)." ;
    rdfs:subClassOf ffonto:DefensibleZone .

ffonto:activeFireSuppression a owl:DatatypeProperty ;
    rdfs:label "active fire suppression occurring" ;
    rdfs:comment "Indicates whether firefighters are actively suppressing fire." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range xsd:boolean .

ffonto:activeFlamesPresent a owl:DatatypeProperty ;
    rdfs:label "active flames present" ;
    rdfs:comment "Indicates whether active flames are still present after the fire front." ;
    rdfs:domain ffonto:SmokeCondition ;
    rdfs:range xsd:boolean .

ffonto:addressesRisk a owl:ObjectProperty ;
    rdfs:domain ffonto:MitigationSolution ;
    rdfs:range ffonto:FireRiskAssessment .

ffonto:adjacentOf rdfs:comment "Inverse relation linking adjacency statements back to the neighboring spatial units."@en .

ffonto:adjacentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "adjacent to" ;
    rdfs:comment "A symmetric relation indicating that two spatial units share a boundary. No separate inverse is needed as symmetry implies bi-directionality." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:SpatialUnit .

ffonto:adjacentToWaterBodyOf a owl:ObjectProperty ;
    rdfs:label "inverse of adjacent to water body"@en ;
    rdfs:comment "Inverse relation linking adjacency to water bodies back to the features or areas described."@en ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:adjacentToWaterBody .

ffonto:advancingTowardOf a owl:ObjectProperty ;
    rdfs:label "inverse of advancing toward"@en ;
    rdfs:comment "Inverse relation indicating movement or progression directed toward a referenced location or asset."@en ;
    rdfs:domain ffonto:HoseLine ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:advancingToward .

ffonto:affectedByAshOf a owl:ObjectProperty ;
    rdfs:label "inverse of affected by ash"@en ;
    rdfs:comment "Inverse relation linking ash-related effects back to the sources or burned areas that produced them."@en ;
    rdfs:domain ffonto:AshFall ;
    rdfs:range ffonto:AgriculturalProduce ;
    owl:inverseOf ffonto:affectedByAsh .

ffonto:affectedOf a owl:ObjectProperty ;
    rdfs:label "affected by wildfire of" ;
    rdfs:comment "Inverse - Indicates infrastructure threatened by wildfire." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Infrastructure ;
    owl:inverseOf ffonto:affectedBy .

ffonto:affectsAnimal a owl:ObjectProperty ;
    rdfs:label "affects animals or pets" ;
    rdfs:comment "Indicates animals impacted by wildfire smoke." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Animal ;
    owl:inverseOf ffonto:affectsAnimalOf .

ffonto:affectsAviationRouteOf a owl:ObjectProperty ;
    rdfs:label "affects aviation route of",
        "affects aviation route of"@en ;
    rdfs:comment "Links a smoke plume, Temporary Flight Restriction (TFR), or hazard back to the specific flight corridor it disrupts."@en ;
    rdfs:domain ffonto:AviationRoute ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:affectsAviationRoute .

ffonto:affectsClimatePattern a owl:ObjectProperty ;
    rdfs:label "affects climate pattern"@en ;
    rdfs:comment "Relates a large-scale environmental event or continuous emission to its altering effect on long-term weather and atmospheric trends."@en ;
    rdfs:domain ffonto:ClimateAnomaly ;
    rdfs:range ffonto:FireRegime ;
    owl:inverseOf ffonto:isAffectedByAnomaly .

ffonto:affectsEcosystemOf a owl:ObjectProperty ;
    rdfs:label "inverse of affects ecosystem"@en ;
    rdfs:comment "Inverse relation linking ecosystem impacts back to the causal event or agent."@en ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:affectsEcosystem .

ffonto:affectsForestAreaOf a owl:ObjectProperty ;
    rdfs:label "affects forest area of"@en ;
    rdfs:comment "Indicates that an event or policy impacts a specific wooded region belonging to a broader geographic or administrative boundary."@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:ForestDisturbance ;
    owl:inverseOf ffonto:affectsForestArea .

ffonto:affectsGroundwaterRechargeOf a owl:ObjectProperty ;
    rdfs:label "affects groundwater recharge of" ;
    rdfs:comment "Inverse - Indicates that a wildfire influences groundwater recharge rates by altering soil permeability and vegetation cover." ;
    rdfs:domain ffonto:Groundwater ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:affectsGroundwaterRecharge .

ffonto:affectsHabitatOf a owl:ObjectProperty ;
    rdfs:label "inverse of affects habitat"@en ;
    rdfs:comment "Inverse relation linking habitat effects back to the driving event or condition."@en ;
    rdfs:domain ffonto:HabitatType ;
    rdfs:range ffonto:EcologicalEffect ;
    owl:inverseOf ffonto:affectsHabitat .

ffonto:affectsHealthCondition a owl:ObjectProperty ;
    rdfs:label "affects health condition"@en ;
    rdfs:comment "Links an environmental hazard, like smoke or extreme heat, to its impact on a specific pre-existing medical issue or physiological state."@en ;
    rdfs:domain ffonto:ParticulateMatterPM25 ;
    rdfs:range ffonto:RespiratoryDisease ;
    owl:inverseOf ffonto:healthAffectedByPM25 .

ffonto:affectsHealthOf a owl:ObjectProperty ;
    rdfs:label "affects health of"@en ;
    rdfs:comment "Indicates the specific population, individual, or demographic whose medical well-being is impacted by a hazard."@en ;
    rdfs:domain ffonto:RespiratoryIssue ;
    rdfs:range ffonto:AirPollutantProperty ;
    owl:inverseOf ffonto:affectsHealth .

ffonto:affectsOf a owl:ObjectProperty ;
    rdfs:label "inverse of affects"@en ;
    rdfs:comment "Inverse relation indicating what entities or systems are affected by a given cause."@en ;
    rdfs:domain ffonto:Person ;
    rdfs:range ffonto:Hazard ;
    owl:inverseOf ffonto:affects .

ffonto:affectsPopulation a owl:ObjectProperty ;
    rdfs:label "affects population group",
        "affects population"@en ;
    rdfs:comment "Indicates that a health risk affects a specific population group.",
        "Original property (exists in your ontology). Declared inverseOf :exposedToSmoke."@en ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range ffonto:PopulationGroup ;
    owl:inverseOf ffonto:exposedToSmoke .

ffonto:affectsRespiratoryHealthOf a owl:ObjectProperty ;
    rdfs:label "affects respiratory health of" ;
    rdfs:comment "Inverse - Represents the impact of air pollution on human respiratory health." ;
    rdfs:domain ffonto:HumanHealth ;
    rdfs:range ffonto:AirPollution ;
    owl:inverseOf ffonto:affectsRespiratoryHealth .

ffonto:affectsVegetationMoisture a owl:ObjectProperty ;
    rdfs:label "affects vegetation moisture"@en ;
    rdfs:comment "Indicates that a climate event or weather condition alters the water content of plant fuel loads."@en ;
    rdfs:domain ffonto:Evapotranspiration ;
    rdfs:range ffonto:FuelMoisture ;
    owl:inverseOf ffonto:isAffectedByEvapotranspiration .

ffonto:affectsVegetationOf a owl:ObjectProperty ;
    rdfs:label "affects vegetation of" ;
    rdfs:comment "Inverse - Indicates wildfire effects on vegetation." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:WildfireScene ;
    owl:inverseOf ffonto:affectsVegetation .

ffonto:affectsWaterBodyOf a owl:ObjectProperty ;
    rdfs:label "affects water body of" ;
    rdfs:comment "Inverse - Indicates that wildfire impacts affect a nearby water body." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range ffonto:WildfireScene ;
    owl:inverseOf ffonto:affectsWaterBody .

ffonto:affectsWildlifeOf a owl:ObjectProperty ;
    rdfs:label "inverse of affects wildlife"@en ;
    rdfs:comment "Inverse relation linking wildlife impacts back to the causative disturbances or conditions."@en ;
    rdfs:domain ffonto:Wildlife ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:affectsWildlife .

ffonto:airQuality a owl:DatatypeProperty ;
    rdfs:label "air quality descriptor" ;
    rdfs:comment "Descriptor of air quality (good/poor/etc.)." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:airTemperature a owl:DatatypeProperty ;
    rdfs:label "air temperature" ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range xsd:decimal .

ffonto:aircraftActionOf a owl:ObjectProperty ;
    rdfs:label "aircraft action of",
        "aircraft action of"@en ;
    rdfs:comment "Links a specific aerial maneuver, drop, or reconnaissance flight back to the broader aviation operation or incident strategy."@en ;
    rdfs:domain ffonto:AircraftAction ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:aircraftAction .

ffonto:aircraftStabilityAffected a owl:DatatypeProperty ;
    rdfs:label "aircraft stability affected by updrafts" ;
    rdfs:comment "Indicates whether strong fire convection affects aircraft stability." ;
    rdfs:domain ffonto:AerialVehicle ;
    rdfs:range xsd:boolean .

ffonto:airtankerVisible a owl:DatatypeProperty ;
    rdfs:label "airtanker (fixed-wing) visible" ;
    rdfs:comment "Observation that an airtanker aircraft is present in the area of operations."@en ;
    rdfs:domain ffonto:AircraftAction ;
    rdfs:range xsd:boolean .

ffonto:alertFieldsComplete a owl:DatatypeProperty ;
    rdfs:label "all alerting fields present" ;
    rdfs:comment "Indicates that required alert metadata fields have been populated."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:alertReady a owl:DatatypeProperty ;
    rdfs:label "alert ready" ;
    rdfs:comment "Indicates if all required fields are present for automated alerts." ;
    rdfs:domain ffonto:AlertSystemStatus ;
    rdfs:range xsd:boolean .

ffonto:allocatesResourceOf a owl:ObjectProperty ;
    rdfs:label "allocates resource of"@en ;
    rdfs:comment "Connects an assignment action or logistical plan to the specific equipment, personnel, or funds being distributed."@en ;
    rdfs:domain ffonto:FirefightingResource ;
    rdfs:range ffonto:ResourceAllocationOptimization ;
    owl:inverseOf ffonto:allocatesResource .

ffonto:alternateRouteVisible a owl:DatatypeProperty ;
    rdfs:label "alternate route visible" ;
    rdfs:comment "Observation that an alternate travel route is present and discernible."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:altersSpeciesCompositionOf a owl:ObjectProperty ;
    rdfs:label "inverse of alters species composition"@en ;
    rdfs:comment "Inverse relation linking species composition changes back to the drivers or disturbances responsible."@en ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:EcologicalEffect ;
    owl:inverseOf ffonto:altersSpeciesComposition .

ffonto:analyzesAudioSignal a owl:ObjectProperty ;
    rdfs:label "analyzes audio signal"@en ;
    rdfs:comment "Connects a system, AI model, or sensor to the acoustic data it processes to detect anomalies or events."@en ;
    rdfs:domain ffonto:AudioAnalytics ;
    rdfs:range ffonto:TelemetryData ;
    owl:inverseOf ffonto:isAnalyzedByAudio .

ffonto:analyzesTemporalData a owl:ObjectProperty ;
    rdfs:label "analyzes temporal data"@en ;
    rdfs:comment "Connects a system, algorithm, or process to its function of examining time-series information for trends or anomalies."@en ;
    rdfs:domain ffonto:TimeSeriesAnalysis ;
    rdfs:range ffonto:TelemetryData ;
    owl:inverseOf ffonto:isAnalyzedTemporally .

ffonto:animalVisibleOf a owl:ObjectProperty ;
    rdfs:label "inverse of animal visible"@en ;
    rdfs:comment "Inverse relation linking animal visibility observations back to the reports or imagery in which they appear."@en ;
    rdfs:domain ffonto:Animal ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:animalVisible .

ffonto:animalsBeingLoaded a owl:DatatypeProperty ;
    rdfs:label "animals being loaded for evacuation" ;
    rdfs:comment "Observation that animals are being placed into transport for evacuation."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:animalsPennedInThreatenedArea a owl:DatatypeProperty ;
    rdfs:label "animals penned in threatened area" ;
    rdfs:comment "Indicates that penned animals are located within an area threatened by hazards."@en ;
    rdfs:domain ffonto:ForestFire ;

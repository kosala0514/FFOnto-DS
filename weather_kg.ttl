    rdfs:comment "Indicates that a vehicle contains occupants such as people or pets."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:vehicleCount a owl:DatatypeProperty ;
    rdfs:label "vehicle count" ;
    rdfs:comment "A count of vehicles observed or recorded in a given area."@en ;
    rdfs:domain ffonto:EmergencyVehicle ;
    rdfs:range xsd:integer .

ffonto:vehicleDamaged a owl:DatatypeProperty ;
    rdfs:label "vehicle damaged" ;
    rdfs:comment "Indicates whether a vehicle suffered wildfire damage." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehicleFuelLevel a owl:DatatypeProperty ;

    rdfs:comment "Heat index value expressed in degrees Celsius reflecting perceived temperature."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:heatIndexF a owl:DatatypeProperty ;

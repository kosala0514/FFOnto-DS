ffonto:FFMC a owl:DatatypeProperty ;
    rdfs:label "FFMC" ;
    rdfs:comment "Fine Fuel Moisture Code." ;
    rdfs:domain ffonto:FireWeatherRecord ;
    rdfs:range xsd:decimal .

ffonto:FIRMS a ffonto:MonitoringSystem ;
    rdfs:label "NASA Fire Information for Resource Management System (FIRMS)" ;

    rdfs:comment "Indicates the assignment of a fire apparatus to an incident or location."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireTruck .

ffonto:derivedFromData a owl:ObjectProperty ;
    rdfs:label "derived from dataset version" ;
    rdfs:comment "Indicates that an artifact or value was generated from specific input data."@en ;
    rdfs:domain ffonto:ModelOutput ;
    rdfs:range ffonto:DatasetVersion .

ffonto:derivedFromFire a owl:ObjectProperty ;
    rdfs:label "derived from fire"@en ;
    rdfs:comment "Connects data, emissions, impacts, or statistics back to the specific combustion event that generated them."@en ;
    rdfs:domain ffonto:BurnSeverityMap ;
    rdfs:range ffonto:WildfireIncident .

ffonto:derivedRemoteSensingIndexFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "Links remote sensing indices to methods or satellite data." ;
    rdfs:domain ffonto:RemoteSensingIndex ;
    rdfs:range ffonto:RemoteSensingMethod .

ffonto:detectedBySatellite a owl:ObjectProperty ;
    rdfs:label "detected by satellite"@en ;
    rdfs:comment "Indicates that a wildfire or hotspot was detected using satellite observations."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SatelliteDetection .

ffonto:detectedInModel a owl:ObjectProperty ;
    rdfs:label "detected in model"@en ;
    rdfs:comment "Links an anomaly, pattern, or simulated event to the specific computational or predictive model in which it was observed."@en ;
    rdfs:domain ffonto:ModelDrift ;
    rdfs:range ffonto:FireBehaviorModel .

ffonto:directingEvacuation a owl:ObjectProperty ;
    rdfs:label "directing evacuation" ;
    rdfs:comment "Responder directing civilians to evacuate or to safe areas." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:Civilian .

ffonto:dominantAspect a owl:ObjectProperty ;
    rdfs:label "dominant aspect" ;
    rdfs:comment "Cardinal aspect dominating the active fire area." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AspectCategory .

ffonto:educatesPublic a owl:ObjectProperty ;
    rdfs:label "educates public on wildfire prevention" ;
    rdfs:comment "Relates an entity or program to public education and outreach activities."@en ;
    rdfs:domain ffonto:PublicEducationProgram ;
    rdfs:range ffonto:ForestFirePrevention .

ffonto:enables a owl:ObjectProperty ;
    rdfs:label "enables on-device inference" ;
    rdfs:comment "A general relation indicating that one entity makes another action or capability possible."@en ;
    rdfs:domain ffonto:EdgeDevice ;
    rdfs:range ffonto:ComputerVisionTask .

ffonto:enhancesEcosystemService a owl:ObjectProperty ;
    rdfs:label "enhances ecosystem service" ;
    rdfs:comment "Relates an environmental activity or event to the ecosystem service that it improves or supports." ;
    rdfs:domain ffonto:ManagementAction ;
    rdfs:range ffonto:EcosystemService .

ffonto:environmentalAffectedBy a owl:ObjectProperty ;
    rdfs:label "environmentally affected by" ;
    rdfs:comment "Indicates environmental factors influencing wildfire behavior." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:EnvironmentalFactor .

ffonto:estimatedBy a owl:ObjectProperty ;
    rdfs:label "estimated by" ;
    rdfs:comment "Relates a forest fire to the method used to estimate it." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:EstimationMethod .

ffonto:estimatedFrom a owl:ObjectProperty ;
    rdfs:label "estimated from"@en ;
    rdfs:comment "Relates a calculated metric or forecast to the specific baseline data, proxy, or model used to derive it."@en ;
    rdfs:domain ffonto:EmissionEstimate ;
    rdfs:range ffonto:FireRadiativePower .

ffonto:evacuationAction a owl:ObjectProperty ;
    rdfs:label "recommends action" ;
    rdfs:comment "Links survival guidance to concrete evacuation/safety actions." ;
    rdfs:domain ffonto:SurvivalGuidance ;
    rdfs:range ffonto:EvacuationAction .

ffonto:evacuationPreparation a owl:ObjectProperty ;
    rdfs:label "recommends action" ;
    rdfs:comment "Links a preparedness or advisory entity to a recommended EvacuationAction." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:EvacuationAction .

ffonto:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluated by metric" ;
    rdfs:comment "Associates an entity with the agent or method used to perform an evaluation."@en ;
    rdfs:domain ffonto:MachineLearningModel ;
    rdfs:range ffonto:EvaluationMetric .

ffonto:evaluatesRiskOf a owl:ObjectProperty ;
    rdfs:label "evaluates risk of"@en ;
    rdfs:comment "Links a risk assessment process, model, or analyst to the specific hazard, operational plan, or geographic area being scrutinized."@en ;
    rdfs:domain ffonto:RiskAssessment ;
    rdfs:range ffonto:ForestFire .

ffonto:exposedToSmoke a owl:ObjectProperty ;
    rdfs:label "exposed to smoke" ;
    rdfs:comment "Indicates a person or population group is exposed to wildfire smoke." ;
    rdfs:domain ffonto:PopulationGroup ;
    rdfs:range ffonto:HealthRisk .

ffonto:extractedFrom a owl:ObjectProperty ;
    rdfs:label "extracted from" ;
    rdfs:comment "Indicates that well water is extracted from groundwater." ;
    rdfs:domain ffonto:WellWater ;
    rdfs:range ffonto:Groundwater .

ffonto:favorsSpecies a owl:ObjectProperty ;
    rdfs:label "favors species group" ;
    rdfs:comment "Indicates which functional groups are favored by a given ecological effect." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:VegetationFunctionalGroup .

ffonto:fireSpreadAffectedByEnvironmentalFactor a owl:ObjectProperty ;
    rdfs:label "fire spread affected by environmental factor"@en ;
    rdfs:comment "Indicates that the rate or direction of a fire's growth is altered by a specific natural condition, such as wind speed or topography."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range ffonto:EnvironmentalFactor .

ffonto:followsFlightPath a owl:ObjectProperty ;
    rdfs:label "follows flight path"@en ;
    rdfs:comment "Indicates the pre-planned or dynamic aerial route navigated by an aircraft or UAV."@en ;
    rdfs:domain ffonto:UAV ;
    rdfs:range ffonto:FlightPath .

ffonto:fragmentsHabitat a owl:ObjectProperty ;
    rdfs:label "fragments habitat" ;
    rdfs:comment "Indicates that infrastructure divides habitats." ;
    rdfs:domain ffonto:Road ;
    rdfs:range ffonto:HabitatFragmentation .

ffonto:fusesData a owl:ObjectProperty ;
    rdfs:label "fuses data stream" ;
    rdfs:comment "Combines multiple data sources into a unified representation for analysis."@en ;
    rdfs:domain ffonto:MultimodalDataFusion ;
    rdfs:range ffonto:DataStream .

ffonto:gatheringAt a owl:ObjectProperty ;
    rdfs:label "gathering at" ;
    rdfs:comment "Civilians gathering at a safe area." ;
    rdfs:domain ffonto:Civilian ;
    rdfs:range ffonto:AssemblyArea .

ffonto:generated a owl:ObjectProperty ;
    rdfs:label "generated" ;
    rdfs:comment "Inverse of generated by." ;
    rdfs:domain ffonto:MLModel ;
    rdfs:range ffonto:Annotation .

ffonto:generatedByModel a owl:ObjectProperty ;
    rdfs:label "generated by model version" ;
    rdfs:comment "Denotes that an output or dataset was produced by a specific model."@en ;
    rdfs:domain ffonto:ModelOutput ;
    rdfs:range ffonto:ModelVersion .

ffonto:generatedByWildfire a owl:ObjectProperty ;
    rdfs:label "generated by wildfire"@en ;
    rdfs:comment "Relates an AshFall instance to a Wildfire instance that generated the ash (if known)."@en ;
    rdfs:domain ffonto:AshFall ;
    rdfs:range ffonto:ForestFire .

ffonto:generatesAlert a owl:ObjectProperty ;
    rdfs:label "generates alert"@en ;
    rdfs:comment "Links a sensor, predictive model, or monitoring system to the warning notification it produces in response to a threshold breach."@en ;
    rdfs:domain ffonto:FireAlertSystem ;
    rdfs:range ffonto:EmergencyAlert .

ffonto:generatesPyroWeather a owl:ObjectProperty ;
    rdfs:label "generates pyro-weather" ;
    rdfs:comment "Indicates fire-induced weather (pyrocumulus, fire-generated winds)." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Hazard .

ffonto:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Associates an activity or plan with a legal or policy instrument." ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:LegalFramework .

ffonto:guidingTraffic a owl:ObjectProperty ;
    rdfs:label "guiding traffic" ;
    rdfs:comment "Responder actively guiding traffic on a road." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:Road .

ffonto:hasAccessConstraint a owl:ObjectProperty ;
    rdfs:label "has access constraint" ;
    rdfs:comment "Specific access limitation (single road, steep grade)." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AccessConstraintDetail .

ffonto:hasAerialResource a owl:ObjectProperty ;
    rdfs:label "has aerial firefighting resource" ;
    rdfs:comment "Associates an incident or operation with assigned aerial assets."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AerialResource .

ffonto:hasAerialVisibility a owl:ObjectProperty ;
    rdfs:label "has aerial visibility" ;
    rdfs:comment "Visibility condition for aircraft." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AerialVisibility .

ffonto:hasAirConditioner a owl:ObjectProperty ;
    rdfs:label "has air conditioner"@en ;
    rdfs:comment "Relates a facility or sheltered environment to the HVAC system used to regulate its temperature and indoor air quality."@en ;
    rdfs:domain ffonto:CleanAirShelter ;
    rdfs:range ffonto:AirConditioner .

ffonto:hasAlertStatus a owl:ObjectProperty ;
    rdfs:label "has alert system status" ;
    rdfs:comment "Specifies the current alert or warning level for an entity or area."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AlertSystemStatus .

ffonto:hasAudioObservation a owl:ObjectProperty ;
    rdfs:label "has audio event" ;
    rdfs:comment "Audio detections associated with the incident." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AudioObservation ;
    rdfs:subPropertyOf ffonto:hasObservation .

ffonto:hasAudioRecord a owl:ObjectProperty ;
    rdfs:label "has audio record" ;
    rdfs:comment "Relates an audio-based observation to the actual acoustic recording file." ;
    rdfs:domain ffonto:AudioObservation ;
    rdfs:range ffonto:AudioRecord .

ffonto:hasAudit a owl:ObjectProperty ;
    rdfs:label "has audit record" ;
    rdfs:comment "Links an item to an AuditRecord (checksums, class-map checksum, etc.)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:ImageAsset ffonto:VisionModelScores ffonto:AudioRecord ) ] ;
    rdfs:range ffonto:AuditRecord .

ffonto:hasBriefingArea a owl:ObjectProperty ;
    rdfs:label "has briefing area" ;
    rdfs:comment "Indicates a briefing area at the wildfire scene." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:BriefingArea .

ffonto:hasCameraObservation a owl:ObjectProperty ;
    rdfs:label "has camera observation" ;
    rdfs:comment "Link from incident to camera-derived frame observations." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:CameraObservation ;
    rdfs:subPropertyOf ffonto:hasObservation .

ffonto:hasCause a owl:ObjectProperty ;
    rdfs:label "has cause"@en ;
    rdfs:comment "Links a wildfire incident to the cause that triggered it."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ForestFireCause .

ffonto:hasClothing a owl:ObjectProperty ;
    rdfs:label "has clothing" ;
    rdfs:comment "Links actions or persons to ClothingRecommendation instances." ;
    rdfs:domain ffonto:EvacuationAction ;
    rdfs:range ffonto:ClothingRecommendation .

ffonto:hasCluster a owl:ObjectProperty ;
    rdfs:label "has fire cluster" ;
    rdfs:comment "Indicates membership in a spatial or data cluster representing grouped items."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range ffonto:FireCluster .

ffonto:hasCommandPost a owl:ObjectProperty ;
    rdfs:label "has command post" ;
    rdfs:comment "Indicates that a wildfire scene includes an incident command post." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:IncidentCommandPost .

ffonto:hasCommunicationMethod a owl:ObjectProperty ;
    rdfs:label "has communication method" ;
    rdfs:comment "Specifies the mode used for communication (e.g., radio, cellular, satellite)."@en ;
    rdfs:domain ffonto:IncidentCommandSystem ;
    rdfs:range ffonto:CommunicationMethod .

ffonto:hasComponent a owl:ObjectProperty ;
    rdfs:label "has building component" ;
    rdfs:comment "Relates a building to its structural components such as roof, gutter, or siding." ;
    rdfs:domain ffonto:Building ;
    rdfs:range ffonto:BuildingComponent .

ffonto:hasConfidenceScore a owl:ObjectProperty ;
    rdfs:label "has confidence score"@en ;
    rdfs:comment "Links a prediction, analytical finding, or AI model output to the statistical probability or certainty metric associated with it."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:ConfidenceScore .

ffonto:hasContact a owl:ObjectProperty ;
    rdfs:label "has contact" ;
    rdfs:comment "Contact information for incident resources." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Contact .

ffonto:hasContainmentState a owl:ObjectProperty ;
    rdfs:label "has containment state" ;
    rdfs:comment "Indicates whether an incident is Active, Contained, or Controlled." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ContainmentState .

ffonto:hasContinuityStrategy a owl:ObjectProperty ;
    rdfs:label "has continuity strategy"@en ;
    rdfs:comment "Links an organization, system, or operation to the plan designed to maintain its essential functions during a disruption."@en ;
    rdfs:domain ffonto:DecisionSupportSystem ;
    rdfs:range ffonto:ContinuityStrategy .

ffonto:hasDamage a owl:ObjectProperty ;
    rdfs:label "has damage" ;
    rdfs:comment "Indicates that a building has suffered structural damage." ;
    rdfs:domain ffonto:Building ;
    rdfs:range ffonto:StructuralDamage .

ffonto:hasDebrisFlowRisk a owl:ObjectProperty ;
    rdfs:label "has debris flow risk"@en ;
    rdfs:comment "Indicates the potential for mudslides or rockfalls in a specific area, often following severe wildfire burn damage to the landscape."@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:DebrisFlowRisk .

ffonto:hasDigitalTwin a owl:ObjectProperty ;
    rdfs:label "has digital twin"@en ;
    rdfs:comment "Links a physical entity, system, or environment to its virtual, real-time computational replica."@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:DigitalTwin .

ffonto:hasDisturbanceHistory a owl:ObjectProperty ;
    rdfs:label "has disturbance history" ;
    rdfs:comment "Links spatial units to their record of past disturbances." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:DisturbanceHistory .

ffonto:hasDominantVegetation a owl:ObjectProperty ;
    rdfs:label "has dominant vegetation" ;
    rdfs:comment "Relates an ecosystem to the vegetation type that dominates the landscape." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:Vegetation .

ffonto:hasDropZone a owl:ObjectProperty ;
    rdfs:label "has drop zone" ;
    rdfs:comment "Assign drop zone to aerial operations." ;
    rdfs:domain ffonto:SuppressionOperation ;
    rdfs:range ffonto:DropZone .

ffonto:hasEcologicalEffect a owl:ObjectProperty ;
    rdfs:label "has ecological effect" ;
    rdfs:comment "Links a fire event to its biological or physical consequences." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:EcologicalEffect .

ffonto:hasEcosystemImpact a owl:ObjectProperty ;
    rdfs:label "has ecosystem impact" ;
    rdfs:comment "Links wildfire scenes to ecosystem impacts." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:EcosystemImpact .

ffonto:hasElement a owl:ObjectProperty ;
    rdfs:label "has fire element" ;
    rdfs:comment "Associates fire triangle with its components." ;
    rdfs:domain ffonto:FireTriangle ;
    rdfs:range ffonto:FireElement .

ffonto:hasEmergencyContact a owl:ObjectProperty ;
    rdfs:label "has emergency contact" ;
    rdfs:comment "Associates an information resource with emergency contact numbers." ;
    rdfs:domain ffonto:InformationResource ;
    rdfs:range ffonto:EmergencyContact .

ffonto:hasEmergencyKit a owl:ObjectProperty ;
    rdfs:label "has emergency kit" ;
    rdfs:comment "Associates an entity with possession or availability of an emergency supply kit."@en ;
    rdfs:domain ffonto:CommunityPreparedness ;
    rdfs:range ffonto:EmergencyKit .

ffonto:hasEnvironment a owl:ObjectProperty ;
    rdfs:label "has environment"@en ;
    rdfs:comment "Relates a wildfire incident or observation to its surrounding environmental context."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:EnvironmentType .

ffonto:hasEnvironmentalCondition a owl:ObjectProperty ;
    rdfs:label "has environmental condition" ;
    rdfs:comment "Associates an entity with prevailing environmental variables or states."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:EnvironmentalCondition .

ffonto:hasEvacuationPlan a owl:ObjectProperty ;
    rdfs:label "has evacuation plan" ;
    rdfs:comment "A predefined procedure describing how people should evacuate an area safely."@en,
        "Relates an entity (e.g., building or zone) to a defined evacuation plan."@en ;
    rdfs:domain ffonto:CommunityPreparedness ;
    rdfs:range ffonto:EvacuationPlan .

ffonto:hasEvacuationRoute a owl:ObjectProperty ;

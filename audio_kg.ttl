ffonto:buildingBurned a owl:DatatypeProperty ;
    rdfs:label "building burned" ;
    rdfs:comment "Indicates whether the building was burned in the wildfire." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:buildingDestroyed a owl:DatatypeProperty ;
    rdfs:label "building destroyed" ;
    rdfs:comment "Indicates whether the building was completely destroyed." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:buildingThreatened a owl:DatatypeProperty ;
    rdfs:label "building threatened by embers/heat" ;
    rdfs:comment "Indicates that a structure is at risk of damage from a hazard such as fire."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:buildingVisible a owl:DatatypeProperty ;
    rdfs:label "building visible" ;
    rdfs:comment "Indicates that a building is observable in imagery or situational reports."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:bulldozerCuttingLine a owl:DatatypeProperty ;
    rdfs:label "bulldozer cutting control line" ;
    rdfs:comment "Indicates whether a bulldozer is actively cutting a firebreak." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range xsd:boolean .

ffonto:burnDurationHours a owl:DatatypeProperty ;
    rdfs:label "burn duration (hours)" ;
    rdfs:comment "Duration of the fire event measured in hours." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:burnSeverityIndex a owl:DatatypeProperty ;
    rdfs:label "burn severity index" ;
    rdfs:comment "Numeric index representing burn severity (higher values = more severe)." ;
    rdfs:domain ffonto:FireSeverity ;
    rdfs:range xsd:decimal .

ffonto:burnedAreaSize a owl:DatatypeProperty ;
    rdfs:label "burned area size" ;
    rdfs:comment "Represents the size of the area affected by the fire event, typically measured in hectares." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:burningNearRiverInverse rdfs:comment "Inverse relation indicating burning activities located near riverine environments linked back to the source."@en .

ffonto:burningNearRiverOf a owl:ObjectProperty ;
    rdfs:label "inverse of burning near river"@en ;
    rdfs:domain ffonto:River ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:burningNearRiver .

ffonto:burningVegetationOf a owl:ObjectProperty ;
    rdfs:label "burning vegetation type of",
        "burning vegetation of"@en ;
    rdfs:comment "Relates an area of actively combusting plant matter to the broader geographic region or wildfire incident."@en ;
    rdfs:domain ffonto:VegetationType ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:burningVegetation .

ffonto:burnsVegetationOf a owl:ObjectProperty ;
    rdfs:label "burns vegetation of" ;
    rdfs:comment "Inverse - Indicates that a wildfire burns vegetation within an ecosystem." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:burnsVegetation .

ffonto:busesPresent a owl:DatatypeProperty ;

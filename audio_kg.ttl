    rdfs:comment "A trait describing vegetation that ignites easily and burns intensely." ;
    rdfs:subClassOf ffonto:PlantFlammabilityTrait .

ffonto:HighVisibility a ffonto:VisibilityCategory,
        owl:NamedIndividual ;
    rdfs:label "high" .

ffonto:Hillside a owl:Class ;
    rdfs:label "Hillside"@en ;
    rdfs:comment "A sloping terrain area that can affect wildfire spread direction and intensity."@en ;
    rdfs:subClassOf ffonto:TerrainFeature .

ffonto:HomeInsurance a owl:Class ;

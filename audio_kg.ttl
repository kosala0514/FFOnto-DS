    rdfs:domain ffonto:CrowdsourcedReport ;
    rdfs:range ffonto:CitizenObservation ;
    owl:inverseOf ffonto:reportedThrough .

ffonto:reportsEvent a owl:ObjectProperty ;
    rdfs:label "reports event"@en ;

ffonto:bridgeHeatDamage a owl:DatatypeProperty ;
    rdfs:label "bridge heat damage" ;
    rdfs:comment "Indicates whether a visible bridge shows heat-related damage." ;
    rdfs:domain ffonto:Bridge ;
    rdfs:range xsd:boolean .

ffonto:bridgePassable a owl:DatatypeProperty ;
    rdfs:label "bridge passable" ;
    rdfs:comment "Indicates whether a bridge is safe and usable for passage."@en ;
    rdfs:domain ffonto:Bridge ;
    rdfs:range xsd:boolean .

ffonto:bridgePresent a owl:DatatypeProperty ;
    rdfs:label "bridge present" ;
    rdfs:comment "Indicates whether a bridge is visible in the scene." ;
    rdfs:domain ffonto:Bridge ;
    rdfs:range xsd:boolean .

ffonto:bridgeScorched a owl:DatatypeProperty ;
    rdfs:label "bridge deck or guardrail scorched" ;
    rdfs:comment "Indicates visible scorching or heat damage to a bridge structure."@en ;
    rdfs:domain ffonto:Bridge ;
    rdfs:range xsd:boolean .

ffonto:bridgeVisible a owl:DatatypeProperty ;
    rdfs:label "bridge visible" ;
    rdfs:comment "Indicates that a bridge structure is present and observable in imagery or reports."@en ;
    rdfs:domain ffonto:Bridge ;
    rdfs:range xsd:boolean .

ffonto:briefingHuddleVisible a owl:DatatypeProperty ;
    rdfs:label "briefing huddle visible" ;
    rdfs:comment "Indicates a visible briefing group of firefighters." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:briefsIncident a owl:ObjectProperty ;
    rdfs:label "briefs incident"@en ;

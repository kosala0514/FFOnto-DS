    rdfs:comment "True if caption suggests daytime conditions." ;
    rdfs:domain ffonto:CaptionModelOutput ;
    rdfs:range xsd:boolean .

ffonto:captionImpliesWindy a owl:DatatypeProperty ;
    rdfs:label "caption implies windy conditions?" ;
    rdfs:comment "True if caption wording (e.g., 'billowing') implies windy/turbulent conditions." ;
    rdfs:domain ffonto:CaptionModelOutput ;
    rdfs:range xsd:boolean .

ffonto:captionProducedOf a owl:ObjectProperty ;

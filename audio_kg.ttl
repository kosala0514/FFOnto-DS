    rdfs:comment "Indicates activities or conditions that contribute to accumulation of combustible fuels."@en ;
    rdfs:domain ffonto:ClimateDriver ;
    rdfs:range ffonto:FuelAccumulation .

ffonto:createsHazard a owl:ObjectProperty ;
    rdfs:label "creates hazard" ;
    rdfs:comment "Indicates that an action or condition generates a potential danger."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Hazard .

ffonto:createsPyroWeather a owl:ObjectProperty ;
    rdfs:label "creates pyro-weather" ;
    rdfs:comment "Denotes conditions where fires alter local atmospheric behavior, producing fire-driven weather."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireGeneratedWeather .

ffonto:createsSpotFire a owl:ObjectProperty ;
    rdfs:label "creates spot fire"@en ;
    rdfs:comment "Indicates that a primary fire or emission (like embers) ignites a new, secondary fire outside the main perimeter."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:SpotFire .

ffonto:crossedWatershed a owl:ObjectProperty ;
    rdfs:label "crossed watershed boundary" ;
    rdfs:comment "Indicates that a feature or event spans across watershed boundaries."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Watershed .

ffonto:crosses a owl:ObjectProperty ;
    rdfs:label "crosses location" ;
    rdfs:comment "Indicates that one spatial feature intersects or passes through another."@en ;
    rdfs:domain ffonto:HoseLine ;
    rdfs:range ffonto:SpatialFeature .

ffonto:dataProvidedBy a owl:ObjectProperty ;
    rdfs:label "provided by" ;
    rdfs:comment "Indicates organizations providing wildfire datasets." ;
    rdfs:domain ffonto:MonitoringSystem ;
    rdfs:range ffonto:DataProvider .

ffonto:dependsOnWaterSource a owl:ObjectProperty ;
    rdfs:label "depends on water source" ;
    rdfs:comment "Indicates that an entity or activity relies on availability of water from a specified source."@en ;
    rdfs:domain ffonto:WaterAvailability ;
    rdfs:range ffonto:WaterBody .

ffonto:deploysAirTanker a owl:ObjectProperty ;
    rdfs:label "deploys air tanker" ;
    rdfs:comment "Indicates the assignment of an air tanker for suppression or support operations."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AirTanker .

ffonto:deploysFireTruck a owl:ObjectProperty ;

ffonto:animalsVisible a owl:DatatypeProperty ;
    rdfs:label "pets or livestock visible" ;
    rdfs:comment "Indicates that animals are observable in imagery or reports."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:annotationSource a owl:DatatypeProperty ;
    rdfs:label "annotation source" ;
    rdfs:comment "The source of the annotation." ;
    rdfs:domain ffonto:Annotation ;
    rdfs:range xsd:string .

ffonto:appliesAfterFireOf rdfs:comment "Inverse relation indicating actions or policies applied following a fire for a given area."@en .

ffonto:appliesToUAV a owl:ObjectProperty ;
    rdfs:label "applies to UAV"@en ;
    rdfs:comment "Relates a rule, strategy, protocol, or physical attachment specifically to an Unmanned Aerial Vehicle."@en ;
    rdfs:domain ffonto:BVLOS ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:operatesUnderBVLOS .

ffonto:appliesToUtilityOf a owl:ObjectProperty ;
    rdfs:label "inverse of applies to utility"@en ;
    rdfs:comment "Inverse relation linking policy applicability back to the utility or infrastructure to which it applies."@en ;
    rdfs:domain ffonto:UtilitySystem ;
    rdfs:range ffonto:RecoveryGuideline ;
    owl:inverseOf ffonto:appliesToUtility .

ffonto:appliesToWaterOf a owl:ObjectProperty ;
    rdfs:label "inverse of applies to water"@en ;
    rdfs:comment "Inverse relation linking applicability of policies or measures to specific water resources."@en ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:WaterSafetyAdvisory ;
    owl:inverseOf ffonto:appliesToWater .

ffonto:applyingWaterToFlames a owl:DatatypeProperty ;
    rdfs:label "applying water to flames" ;
    rdfs:comment "Indicates water being applied directly to flames." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range xsd:boolean .

ffonto:areaAcres a owl:DatatypeProperty ;
    rdfs:label "area (acres)" ;
    rdfs:comment "Perimeter-derived area in acres." ;
    rdfs:domain ffonto:PerimeterSnapshot ;
    rdfs:range xsd:decimal .

ffonto:areaHa a owl:DatatypeProperty ;
    rdfs:label "area ha",
        "area ha"@en ;
    rdfs:comment "Records the calculated spatial extent or geographic footprint of an entity or incident, measured in hectares."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:decimal .

ffonto:ashAccumulationOnRoofOrDeck a owl:DatatypeProperty ;
    rdfs:label "ash accumulation on roofs or decks" ;
    rdfs:comment "Whether ash accumulation is visible on roofs, decks, or other surfaces." ;
    rdfs:domain ffonto:BurnEvidence ;
    rdfs:range xsd:boolean .

ffonto:ashColorDominance a owl:DatatypeProperty ;
    rdfs:label "ash color dominance" ;
    rdfs:comment "Dominant ash color observed: 'white', 'gray', or 'black'." ;

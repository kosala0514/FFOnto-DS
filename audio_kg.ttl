    rdfs:comment "Inverse - Nearby water body or source useful for suppression." ;
    rdfs:domain ffonto:Location ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:relatedWaterSource .

ffonto:relativeHumidity a owl:DatatypeProperty ;
    rdfs:label "Relative Humidity" ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range xsd:decimal .

ffonto:relativeHumidityPercent a owl:DatatypeProperty ;
    rdfs:label "relative humidity (%)" ;
    rdfs:comment "Relative humidity expressed as a percentage value."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:releasedDuringFire a owl:ObjectProperty ;
    rdfs:label "released during fire"@en ;

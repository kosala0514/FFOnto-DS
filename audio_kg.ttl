    rdfs:comment "Connects a system, AI model, or sensor to the acoustic data it processes to detect anomalies or events."@en ;
    rdfs:domain ffonto:AudioAnalytics ;
    rdfs:range ffonto:TelemetryData ;
    owl:inverseOf ffonto:isAnalyzedByAudio .

ffonto:analyzesTemporalData a owl:ObjectProperty ;

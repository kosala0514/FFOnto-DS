ffonto:respondersGuidingTraffic a owl:DatatypeProperty ;
    rdfs:label "responders guiding traffic present" ;
    rdfs:comment "Observation that emergency personnel are directing vehicular movement to support safety."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:respondersUsingHandheldRadios a owl:DatatypeProperty ;
    rdfs:label "responders using handheld radios" ;
    rdfs:comment "Indicates whether responders communicate using handheld radios." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:respondersUsingSceneLights a owl:DatatypeProperty ;
    rdfs:label "responder vehicles using scene lights" ;
    rdfs:comment "Indicates that emergency personnel are using lights to illuminate or signal at a scene."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:respondersVisible a owl:DatatypeProperty ;
    rdfs:label "firefighter or responder presence visible" ;
    rdfs:comment "Indicates whether responders are visible in the scene." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:respondsToIncident a owl:ObjectProperty ;
    rdfs:label "responds to incident"@en ;
    rdfs:comment "Links an emergency responder, vehicle, or operational unit to the specific crisis event they are assigned to manage."@en ;
    rdfs:domain ffonto:FireEngine ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasFireEngine .

ffonto:restorationMeasuresSuggested a owl:DatatypeProperty ;
    rdfs:label "restoration measures suggested" ;
    rdfs:comment "Describes restoration actions recommended for the landscape." ;
    rdfs:domain ffonto:RestorationStrategy ;
    rdfs:range xsd:string .

ffonto:restrictsAccessTo a owl:ObjectProperty ;
    rdfs:label "restricts access to"@en ;

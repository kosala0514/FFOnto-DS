    rdfs:comment "A legal rule or policy that assigns responsibility for damages or harms."@en ;
    rdfs:subClassOf ffonto:LegalFramework .

ffonto:LicensePlateBlurring a owl:Class ;
    rdfs:label "License Plate Blurring" ;
    rdfs:comment "A privacy-preserving technique that obscures vehicle license plates in images or videos."@en ;
    rdfs:subClassOf ffonto:PrivacyProtection .

ffonto:LightGray a ffonto:SmokeColor,
        owl:NamedIndividual ;
    rdfs:label "light-gray" .

ffonto:LightningStrike a owl:Class ;

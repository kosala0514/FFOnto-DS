    rdfs:comment "Percent canopy closure for the spatial unit (0-100)." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range xsd:decimal .

ffonto:canopyDensity a owl:DatatypeProperty ;
    rdfs:label "canopy density" ;
    rdfs:comment "Represents the density of the forest canopy in a forest ecosystem." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range xsd:decimal .

ffonto:canopyOpen a owl:DatatypeProperty ;
    rdfs:label "canopy open due to crown loss" ;
    rdfs:comment "Indicates whether the canopy looks open because of crown loss." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:captionImpliesDaytime a owl:DatatypeProperty ;

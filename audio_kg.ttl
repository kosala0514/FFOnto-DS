    rdfs:comment "Cool phase of ENSO often associated with drought conditions in some regions." .

ffonto:LadderFuel a ffonto:FuelType ;
    rdfs:label "Ladder Fuel" ;
    rdfs:comment "Vegetation providing a vertical pathway for fire to climb from the surface to the canopy." .

ffonto:LandslideRisk a owl:Class ;

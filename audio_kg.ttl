    rdfs:range ffonto:WaterTank .

ffonto:hasZone a owl:ObjectProperty ;
    rdfs:label "has zone",
        "is zone"@en ;
    rdfs:comment "Relates a defensible space to its zones.",
        "Indicates that an area or region is classified as a specific type of zone."@en ;
    rdfs:domain ffonto:DefensibleSpace ;
    rdfs:range ffonto:DefensibleZone .

ffonto:healthAffectedByPM25 a owl:ObjectProperty ;

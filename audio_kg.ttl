    rdfs:domain ffonto:RespiratoryDisease ;
    rdfs:range ffonto:ParticulateMatterPM25 .

ffonto:heavyEquipmentInUse a owl:ObjectProperty ;
    rdfs:label "heavy equipment in use" ;
    rdfs:comment "Indicates that heavy machinery (e.g., dozers, graders) is being employed on-site."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:HeavyEquipment .

ffonto:impactsEcosystem a owl:ObjectProperty ;
    rdfs:label "impacts ecosystem" ;
    rdfs:comment "Indicates that an environmental factor affects an ecosystem." ;
    rdfs:domain ffonto:ClimateChange ;
    rdfs:range ffonto:Ecosystem .

ffonto:impactsTransportation a owl:ObjectProperty ;
    rdfs:label "impacts transportation routes" ;
    rdfs:comment "Indicates that an event or condition affects transport systems and mobility."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:TransportationRoute .

ffonto:impairsVisibility a owl:ObjectProperty ;
    rdfs:label "impairs visibility" ;
    rdfs:comment "Whether the hazard reduces visibility (true/false)." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:implementsPSPS a owl:ObjectProperty ;

ffonto:AIModelGovernance a owl:Class ;
    rdfs:label "AI model governance"@en ;
    rdfs:comment "The policies, procedures, and ethical guidelines governing the deployment and use of artificial intelligence models within the system."@en .

ffonto:AerialVehicle a owl:Class ;
    rdfs:label "Aerial Firefighting Vehicle" ;
    rdfs:comment "Aircraft used for aerial firefighting such as helicopters." ;
    rdfs:subClassOf ffonto:Vehicle .

ffonto:AirPollutionMetric a owl:Class ;
    rdfs:label "air pollution metric"@en ;
    rdfs:comment "A quantifiable measure used to assess the concentration of pollutants in the air."@en ;
    rdfs:subClassOf ffonto:ObservableProperty .

ffonto:AirQualityMitigationDevice a owl:Class ;
    rdfs:label "air quality mitigation device"@en ;
    rdfs:comment "A physical apparatus designed to monitor, filter, or improve air quality conditions during or after a fire."@en ;
    rdfs:subClassOf sosa:Platform .

ffonto:AirTanker a owl:Class ;
    rdfs:label "Air Tanker" ;
    rdfs:comment "Aircraft used to drop fire retardant." ;
    rdfs:subClassOf ffonto:Aircraft .

ffonto:AlertSystemStatus a owl:Class ;
    rdfs:label "Alert System Status" ;
    rdfs:comment "Represents completeness of required fields for automated alert generation." .

ffonto:AtmosphericTransportModel a owl:Class ;
    rdfs:label "Atmospheric Transport Model" ;
    rdfs:comment "A model that simulates the transport of pollutants or particles through the atmosphere."@en .

ffonto:CarbonEmission a owl:Class ;
    rdfs:label "Carbon Emission" ;
    rdfs:comment "The release of carbon dioxide or equivalent greenhouse gases into the atmosphere."@en .

ffonto:CarbonRelease a owl:Class ;
    rdfs:label "Carbon release" ;
    rdfs:comment "Carbon (CO2, CO) emitted during combustion." .

ffonto:CardiacIssue rdfs:label "Cardiac issue"@en ;
    rdfs:comment "A heart-related health condition potentially triggered or worsened by wildfire smoke exposure."@en ;
    rdfs:subClassOf ffonto:HealthImpact .

ffonto:Chimney a owl:Class ;
    rdfs:label "Chimney" ;
    rdfs:comment "A vertical structure that vents smoke from buildings." .

ffonto:CitizenObservation a owl:Class ;
    rdfs:label "Citizen Observation" ;
    rdfs:comment "An observation or report made by a member of the public, often for situational awareness."@en ;
    rdfs:subClassOf ffonto:Observation .

ffonto:CommunicationPlan a owl:Class ;
    rdfs:label "Communication Plan" ;
    rdfs:comment "Who to notify, check-in procedures, and contact numbers during evacuation." .

ffonto:ConfidenceScore a owl:Class ;
    rdfs:label "Confidence Score" ;
    rdfs:comment "A numeric value representing the estimated reliability of a prediction or measurement."@en ;
    rdfs:subClassOf ffonto:PredictionMetric .

ffonto:ConiferousTree a owl:Class ;
    rdfs:label "Coniferous Tree" ;
    rdfs:comment "A tree species that produces cones and typically has needle-like leaves, often containing resin that increases flammability." ;
    rdfs:subClassOf ffonto:Tree ;
    owl:disjointWith ffonto:DeciduousTree .

ffonto:DefensibleSpace a owl:Class ;
    rdfs:label "Defensible Space" ;
    rdfs:comment "Zone distances are guidance and may be adapted to local regulation; use local building codes and WUI guidance." ;
    rdfs:subClassOf ffonto:PreventionMeasure,
        ffonto:StructureDefense .

ffonto:EarthObservationData a owl:Class ;
    rdfs:label "earth observation data"@en ;
    rdfs:comment "Data collected from remote sensing platforms, such as satellites or UAVs, to monitor environmental conditions."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:EcosystemImpact a owl:Class ;
    rdfs:label "Ecosystem Impact" ;
    rdfs:comment "Represents ecological impacts of wildfire including biodiversity changes, habitat loss, and ecosystem disruption." .

ffonto:EdgeDevice a owl:Class ;
    rdfs:label "Edge Inference Device" ;
    rdfs:comment "A computing device located near data sources for local processing and low-latency responses."@en .

ffonto:EmergencyActivity a owl:Class ;
    rdfs:label "Emergency Activity" ;
    rdfs:comment "Activities indicating emergency conditions such as evacuations or escalations." .

ffonto:EmergencyFacility a owl:Class ;
    rdfs:label "emergency facility"@en ;
    rdfs:comment "A physical building or location, such as a shelter or fire station, utilized during an incident response."@en .

ffonto:EmergencyKit a owl:Class ;
    rdfs:label "Emergency Kit" ;
    rdfs:comment "A collection of essential supplies and tools prepared for use during emergencies."@en ;
    rdfs:subClassOf ffonto:CommunityPreparedness .

ffonto:EnvironmentalRisk a owl:Class ;
    rdfs:label "Environmental risk" ;
    rdfs:comment "Potential environmental hazards affecting ecosystems." .

ffonto:ErosionFeature a owl:Class ;
    rdfs:label "Erosion Feature" ;
    rdfs:comment "Represents erosion indicators such as rills, exposed soil, and denuded banks." .

ffonto:ErosionRisk a owl:Class ;
    rdfs:label "Erosion risk" ;
    rdfs:comment "Likelihood of increased soil erosion after vegetation removal or high-severity fire." ;
    rdfs:subClassOf ffonto:EcologicalImpact .

ffonto:EvacuationProcedure a owl:Class ;
    rdfs:label "Evacuation Procedure" ;
    rdfs:comment "Guidelines and processes for safely evacuating residents during wildfires." .

ffonto:EvacuationRoute a owl:Class ;
    rdfs:label "Evacuation Route" ;
    rdfs:comment "Planned routes out of the danger area; may include alternate routes." .

ffonto:FireAlertSystem a owl:Class ;
    rdfs:label "Fire Alert System" ;
    rdfs:comment "Systems that notify users about active fires or fire danger conditions." ;
    rdfs:subClassOf ffonto:DecisionSupportSystem .

ffonto:FireImpact a owl:Class ;
    rdfs:label "Fire Impact" ;
    rdfs:comment "Immediate environmental effects caused by a fire event, such as vegetation loss or carbon release." .

ffonto:FireProbabilityModel a owl:Class ;
    rdfs:label "Fire Probability Model" ;
    rdfs:comment "Model output describing fire probability for an image/frame." .

ffonto:FireShelter a owl:Class ;
    rdfs:label "Fire Shelter" ;
    rdfs:comment "Personal deployable shelters and pre-positioned sheltering options." .

ffonto:FireTriangle a owl:Class ;
    rdfs:label "Fire Triangle" ;
    rdfs:comment "Concept describing the three elements required for combustion: heat, fuel, and oxygen." .

ffonto:ForestDisturbance a owl:Class ;
    rdfs:label "Forest Disturbance" ;
    rdfs:comment "Events that alter forest ecosystems such as pests, disease, or drought." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor .

ffonto:ForestRegeneration rdfs:label "Forest Regeneration" ;
    rdfs:comment "The natural recovery and regrowth of vegetation following a disturbance." ;
    rdfs:subClassOf ffonto:VegetationDynamics .

ffonto:ForestTerrain a owl:Class ;
    rdfs:label "Forest Terrain" ;
    rdfs:comment "Physical terrain conditions such as slopes and hills influencing fire behavior." .

ffonto:GISApplication a owl:Class ;
    rdfs:label "GIS Application" ;
    rdfs:comment "Use of geographic information systems in wildfire management." .

ffonto:GeneratorSafety a owl:Class ;
    rdfs:label "Generator Safety" ;
    rdfs:comment "Rules and guidance for safe generator use to avoid carbon monoxide and electrical hazards." .

ffonto:Grass a ffonto:Fuel,
        owl:Class ;
    rdfs:label "Grass" ;
    ffonto:hasFuelType ffonto:LightFuel ;
    rdfs:comment "Herbaceous vegetation characterized by narrow leaves and soft stems, commonly forming ground cover in forest and grassland ecosystems." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:HabitatLoss a owl:Class ;
    rdfs:label "Habitat Loss" ;
    rdfs:comment "Destruction or reduction of habitats due to fire." ;
    rdfs:subClassOf ffonto:EcologicalImpact .

ffonto:HabitatType a owl:Class ;
    rdfs:label "Habitat type" ;
    rdfs:comment "Wildlife habitat categories (mature canopy, shrubland, grassland) relevant to biodiversity." .

ffonto:HealthGuideline a owl:Class ;
    rdfs:label "Health Guideline" ;
    rdfs:comment "Public health recommendations designed to reduce health impacts from wildfire smoke exposure." .

ffonto:HumanCause a owl:Class ;
    rdfs:label "Human-caused ForestFire" ;
    rdfs:comment "An event or condition initiated by human activity that may lead to incidents."@en ;
    rdfs:subClassOf ffonto:ForestFireCause .

ffonto:ImportantDocument a owl:Class ;
    rdfs:label "Important Document" ;
    rdfs:comment "Key legal and personal documents (IDs, insurance, wills) to safeguard and take during evacuation." ;
    rdfs:subClassOf ffonto:PreparednessItem .

ffonto:ManagementPurpose a owl:Class ;
    rdfs:label "Management purpose" ;
    rdfs:comment "Purpose of a management action (fuel reduction, biodiversity enhancement, hazard reduction)." .

ffonto:MediaGroup a owl:Class ;
    rdfs:label "Media / Observers" ;
    rdfs:comment "Journalists, camera crews, and observers." .

ffonto:MeterBox a owl:Class ;
    rdfs:label "Meter Box" ;
    rdfs:comment "Electric or gas meter boxes on buildings." ;
    rdfs:subClassOf ffonto:UtilityInfrastructure .

ffonto:ModelMonitoring a owl:Class ;
    rdfs:label "Model Monitoring" ;
    rdfs:comment "Ongoing assessment of a model's performance and behavior after deployment."@en ;
    rdfs:subClassOf ffonto:MLOpsPipeline,
        ffonto:ModelMonitoring .

ffonto:NaturalCause a owl:Class ;
    rdfs:label "Natural ForestFire Cause" ;
    rdfs:comment "An event or condition originating from natural processes rather than human action."@en ;
    rdfs:subClassOf ffonto:ForestFireCause .

ffonto:NeighborSupportPlan a owl:Class ;
    rdfs:label "Neighborhood Support Plan" ;
    rdfs:comment "How neighbors coordinate to help those with special needs and to protect neighborhood assets." ;
    rdfs:subClassOf ffonto:CommunityPreparednessPlan .

ffonto:OperationsSection a owl:Class ;
    rdfs:label "Operations Section" ;
    rdfs:comment "The organizational unit responsible for tactical operations during an incident."@en ;
    rdfs:subClassOf ffonto:IncidentCommandSection .

ffonto:PPE a owl:Class ;
    rdfs:label "Personal Protective Equipment" ;
    rdfs:comment "Protective equipment worn by firefighters during operations.",
        "Respirators, fire-resistant clothing, eye protection, etc." ;
    rdfs:subClassOf ffonto:ProtectiveAction .

ffonto:PerimeterSnapshot a owl:Class ;
    rdfs:label "Perimeter Snapshot" ;
    rdfs:comment "Geospatial perimeter capture (time-stamped) used to compute area." .

ffonto:PetPreparation a owl:Class ;
    rdfs:label "Pet Preparation" ;
    rdfs:comment "Actions and items to prepare pets for evacuation." .

ffonto:PostFireFloodRisk a owl:Class ;
    rdfs:label "Post Fire Flood Risk" ;
    rdfs:comment "The increased risk of flooding or debris flow following vegetation loss from fire."@en ;
    rdfs:subClassOf ffonto:FireRiskAssessment .

ffonto:PowerInfrastructure a owl:Class ;
    rdfs:label "Power Infrastructure" ;
    rdfs:comment "Powerlines and electrical infrastructure." .

ffonto:PowerLine a owl:Class ;
    rdfs:label "Power Line" ;
    rdfs:comment "Overhead electrical conductors and cables." ;
    rdfs:subClassOf ffonto:UtilityInfrastructure .

ffonto:PredictedLabel a owl:Class ;
    rdfs:label "PredictedLabel" ;
    rdfs:comment "A human or automatic label assigned to an image record (e.g., severity, content label)." .

ffonto:PredictionUncertainty a owl:Class ;
    rdfs:label "Prediction Uncertainty" ;
    rdfs:comment "A quantitative or qualitative measure of how uncertain a prediction or forecast is."@en ;
    rdfs:subClassOf ffonto:ConfidenceScore .

ffonto:QualityControlProcess a owl:Class ;
    rdfs:label "Data Quality Control Process" ;
    rdfs:comment "Procedures used to validate and verify scientific datasets before public release." .

ffonto:RemoteSensingIndex a owl:Class ;
    rdfs:label "Remote Sensing Index" ;
    rdfs:comment "Indices derived from satellite imagery used to measure fire severity or vegetation condition." .

ffonto:ResourcePrioritization a owl:Class ;
    rdfs:label "Resource Prioritization" ;
    rdfs:comment "Decision-making process for allocating firefighting resources." .

ffonto:RestorationStrategy a owl:Class ;
    rdfs:label "Restoration Strategy" ;
    rdfs:comment "Represents strategies or actions that may be applied to restore ecosystems after wildfire disturbance." .

ffonto:River a owl:Class ;
    rdfs:label "River" ;
    rdfs:comment "A natural flowing watercourse." ;
    rdfs:subClassOf ffonto:WaterBody .

ffonto:SensorFusion a owl:Class ;
    rdfs:label "Sensor fusion"@en ;
    rdfs:comment "The process of combining data from multiple sensors to improve wildfire detection or monitoring."@en .

ffonto:Signpost a owl:Class ;
    rdfs:label "Signpost" ;
    rdfs:comment "Traffic or informational signposts." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:SituationReport a owl:Class ;
    rdfs:label "Situation Report (SITREP)" ;
    rdfs:comment "A concise report summarizing current conditions, impacts, and response actions."@en ;
    rdfs:subClassOf ffonto:IncidentReport .

ffonto:SpottingEvent a owl:Class ;
    rdfs:label "Spotting / Ember Cast Event" ;
    rdfs:comment "Transport of embers causing spot fires ahead of main front." .

ffonto:StructureDefense a owl:Class ;
    rdfs:label "Structure Defense" ;
    rdfs:comment "Measures to protect buildings (defensible space, sprinklers, roof coverings)." .

ffonto:SuppressionDifficulty a owl:Class ;
    rdfs:label "Suppression Difficulty" ;
    rdfs:comment "Assessment of wildfire suppression difficulty." .

ffonto:TerrainType a owl:Class ;
    rdfs:label "Terrain type" ;
    rdfs:comment "Classification of physical landscape terrain." .

ffonto:Understory a owl:Class ;
    rdfs:label "Understory" ;
    rdfs:comment "Shrub and herbaceous vegetation and litter layer beneath the forest canopy; important as surface fuel." .

ffonto:UtilityPowerShutoff a owl:Class ;
    rdfs:label "Planned Utility Power Shutoff (PSPS)" ;
    rdfs:comment "Deliberate de-energization of electric lines to reduce ignition risk during extreme fire weather." .

ffonto:VegetationDynamics a owl:Class ;
    rdfs:label "Vegetation Dynamics" ;
    rdfs:comment "Changes related to plant life, growth, and community structure." ;
    rdfs:subClassOf ffonto:EcologicalEffect .

ffonto:VegetationIndex a owl:Class ;
    rdfs:label "Vegetation Index" ;
    rdfs:comment "Satellite-derived index used to monitor vegetation health and density." ;
    rdfs:subClassOf ffonto:ObservableProperty .

ffonto:VehiclePreparation a owl:Class ;
    rdfs:label "Vehicle Preparation" ;
    rdfs:comment "Preparations to make vehicles ready for evacuation (fuel, parking orientation, kit stored)." .

ffonto:VisibilityCondition a owl:Class ;
    rdfs:label "Visibility Condition" ;
    rdfs:comment "Visibility measures for aerial and ground ops." .

ffonto:WaterSafetyAdvisory a owl:Class ;
    rdfs:label "Water Safety Advisory" ;
    rdfs:comment "Advisories regarding drinking water safety after wildfire events." ;
    rdfs:subClassOf ffonto:RecoveryGuideline .

ffonto:WellWater a owl:Class ;
    rdfs:label "Well Water" ;
    rdfs:comment "Groundwater extracted from a well used for drinking or household use." ;
    rdfs:subClassOf ffonto:WaterSource .

ffonto:Window a owl:Class ;
    rdfs:label "Window" ;
    rdfs:comment "Glass openings in a building or vehicle." ;
    rdfs:subClassOf ffonto:BuildingComponent .

ffonto:hasFuelLoad a owl:ObjectProperty ;
    rdfs:label "has fuel load" ;
    rdfs:comment "Amount/type of fuel present in a spatial unit or vegetation patch." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:FuelLoad .

ffonto:hasIgnitionSource a owl:ObjectProperty ;
    rdfs:label "has ignition source" ;
    rdfs:comment "Causes or source of ignition for a fire event." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:IgnitionSource .

ffonto:hasVegetationDistribution a owl:ObjectProperty ;
    rdfs:label "has vegetation distribution" ;
    rdfs:comment "Associates a spatial unit with its vegetation distribution pattern." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:VegetationDistribution .

ffonto:occursIn a owl:ObjectProperty ;
    rdfs:label "occurs in" ;
    rdfs:comment "Specifies the forest ecosystem where a fire event takes place." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:WildfireScene .


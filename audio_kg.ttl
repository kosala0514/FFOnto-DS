        "Meteorological index estimating fire danger based on weather conditions." ;
    rdfs:domain ffonto:FireWeatherRecord ;
    rdfs:range xsd:decimal .

ffonto:FaceBlurring a owl:Class ;
    rdfs:label "Face Blurring" ;

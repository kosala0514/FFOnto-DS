    rdfs:comment "Flying embers that generate spot fires or ignite structures/vegetation." ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:EmergencyCommunicationPlan a ffonto:ContinuityStrategy ;
    rdfs:label "Emergency Communication Plan" .

ffonto:EmergencyFireService a ffonto:EmergencyContact ;
    rdfs:label "Emergency Fire Department Contact" ;
    ffonto:hasPhoneNumber "911" ;
    rdfs:comment "Emergency phone number for fire response services." .

ffonto:EmergencyServices a ffonto:ResponseOrganization ;
    rdfs:label "Emergency Services" ;
    ffonto:hasPhoneNumber "911" ;
    ffonto:website "https://www.ready.gov/wildfires" ;
    rdfs:comment "Emergency response contact number." .

ffonto:Encryption a owl:Class ;
    rdfs:label "Encryption" ;

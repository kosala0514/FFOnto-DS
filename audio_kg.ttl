    rdfs:comment "Indicates that an entity has a causal or supporting role in an outcome."@en ;
    rdfs:domain ffonto:ForestFireTechnology ;
    rdfs:range ffonto:ClimateMitigation .

ffonto:contributesToFireIntensity a owl:ObjectProperty ;

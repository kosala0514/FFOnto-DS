    rdfs:range xsd:boolean .

ffonto:roadWidth a owl:DatatypeProperty ;
    rdfs:label "road width (m)" ;
    rdfs:comment "The measured width of a road, used for access and safety planning."@en ;
    rdfs:domain ffonto:RoadAccess ;

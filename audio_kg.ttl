    rdfs:domain ffonto:EvacuationRoutingAlgorithm ;
    rdfs:range ffonto:ShortestSafePath .

ffonto:contacts a owl:ObjectProperty ;
    rdfs:label "contacts" ;
    rdfs:comment "Links a CommunicationPlan to organization or person contact individuals." ;
    rdfs:domain ffonto:CommunicationPlan ;
    rdfs:range ffonto:ResponseOrganization .

ffonto:containsLandscapeFeature a owl:ObjectProperty ;
    rdfs:label "contains landscape feature" ;
    rdfs:comment "Relates an ecosystem to physical landscape features present within it." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:LandscapeFeature .

ffonto:containsParticulate a owl:ObjectProperty ;
    rdfs:label "contains particulate matter" ;
    rdfs:comment "Indicates that air pollution contains particulate matter particles." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range ffonto:ParticulateMatter .

ffonto:containsVegetation a owl:ObjectProperty ;
    rdfs:label "contains vegetation" ;
    rdfs:comment "Indicates vegetation types that occur within an ecosystem." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:Vegetation .

ffonto:contributesTo a owl:ObjectProperty ;

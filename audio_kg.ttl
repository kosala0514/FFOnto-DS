    rdfs:domain ffonto:TemporaryFlightRestriction ;
    rdfs:range ffonto:Airspace ;
    owl:inverseOf ffonto:isAirspaceRestrictedBy .

ffonto:resultsInDropZone a owl:ObjectProperty ;

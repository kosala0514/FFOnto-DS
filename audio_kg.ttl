    rdfs:comment "Indicates execution of Public Safety Power Shutoff procedures to reduce fire ignition risk."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:PSPS .

ffonto:impliesHighSeverity a owl:ObjectProperty ;
    rdfs:label "implies high severity" ;
    rdfs:comment "Indicates that fuel load combined with ignition source conditions suggests high fire severity." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireSeverity ;
    owl:propertyChainAxiom ( ffonto:hasFuelLoad ffonto:hasIgnitionSource ) .

ffonto:improvesSafety a owl:ObjectProperty ;
    rdfs:label "improves safety using equipment" ;
    rdfs:comment "Indicates that an action or measure enhances safety or reduces risk."@en ;
    rdfs:domain ffonto:FirefighterHealthSafety ;
    rdfs:range ffonto:ProtectiveEquipment .

ffonto:includesPetPlan a owl:ObjectProperty ;
    rdfs:label "includes pet plan" ;
    rdfs:comment "Links a household plan to PetPreparation activities." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:PetPreparation .

ffonto:increasesEnvironmentalRisk a owl:ObjectProperty ;
    rdfs:label "increases environmental risk" ;
    rdfs:comment "Indicates factors that increase environmental hazards." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:EnvironmentalRisk .

ffonto:increasesErosionRisk a owl:ObjectProperty ;
    rdfs:label "increases erosion risk" ;
    rdfs:comment "Indicates that a fire event elevates post-fire erosion risk." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ErosionRisk .

ffonto:increasesFireRisk a owl:ObjectProperty ;
    rdfs:label "increases fire risk" ;
    rdfs:comment "Indicates that an environmental factor increases wildfire risk through vegetation distribution and fuel load." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:ForestFireRisk ;
    owl:propertyChainAxiom ( ffonto:hasVegetationDistribution ffonto:hasFuelLoad ) .

ffonto:increasesHumanAccess a owl:ObjectProperty ;
    rdfs:label "increases human access" ;
    rdfs:comment "Indicates that infrastructure increases human access to ecosystems." ;
    rdfs:domain ffonto:Road ;
    rdfs:range ffonto:Ecosystem .

ffonto:increasesRunoff a owl:ObjectProperty ;
    rdfs:label "increases runoff" ;
    rdfs:comment "Indicates that a wildfire increases surface water runoff due to reduced vegetation and altered soil conditions." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Runoff .

ffonto:increasesWildfireRisk a owl:ObjectProperty ;
    rdfs:label "increases wildfire risk" ;
    rdfs:comment "Indicates that a condition contributes to increased wildfire risk." ;
    rdfs:domain ffonto:ForestFireRiskFactor ;
    rdfs:range ffonto:FireBehavior .

ffonto:indicatesCombustion a owl:ObjectProperty ;
    rdfs:label "indicates combustion"@en ;
    rdfs:comment "Relates a chemical, thermal, or visual signature to the active presence of burning material."@en ;
    rdfs:domain ffonto:SmokeColor ;
    rdfs:range ffonto:CombustionProcess .

ffonto:indicatesEcologicalStress a owl:ObjectProperty ;
    rdfs:label "indicates ecological stress" ;
    rdfs:comment "Relates vegetation conditions to ecological stress indicators." ;
    rdfs:domain ffonto:VegetationCondition ;
    rdfs:range ffonto:EcologicalStress .

ffonto:influencedByGroundwater a owl:ObjectProperty ;
    rdfs:label "influenced by groundwater"@en ;
    rdfs:comment "Indicates that an environmental condition or feature is affected by groundwater presence or movement."@en ;
    rdfs:domain ffonto:WaterAvailability ;
    rdfs:range ffonto:Groundwater .

ffonto:influencedBySoilQuality a owl:ObjectProperty ;
    rdfs:label "influenced by soil quality" ;
    rdfs:comment "Indicates soil quality factors influencing vegetation distribution." ;
    rdfs:domain ffonto:VegetationDistribution ;
    rdfs:range ffonto:SoilQuality .

ffonto:influencedByWaterAvailability a owl:ObjectProperty ;
    rdfs:label "influenced by water availability" ;
    rdfs:comment "Indicates water availability effects on vegetation distribution." ;
    rdfs:domain ffonto:VegetationDistribution ;
    rdfs:range ffonto:WaterAvailability .

ffonto:influencedByWeather a owl:ObjectProperty ;
    rdfs:label "influenced by weather" ;
    rdfs:comment "Indicates wildfire risk influenced by weather variability." ;
    rdfs:domain ffonto:ForestFireRisk ;
    rdfs:range ffonto:WeatherCondition .

ffonto:influencesFireBehaviorByCharacteristic a owl:ObjectProperty ;
    rdfs:label "influences fire behavior by characteristic"@en ;
    rdfs:comment "Links a terrain feature or environmental condition to the specific physical attributes (like slope or density) that alter fire dynamics."@en ;
    rdfs:domain ffonto:FuelCharacteristic ;
    rdfs:range ffonto:FireBehavior .

ffonto:inhibitsSpecies a owl:ObjectProperty ;
    rdfs:label "inhibits species group" ;
    rdfs:comment "Indicates which functional groups are suppressed by a given ecological effect." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:VegetationFunctionalGroup .

ffonto:involvesFirefighter a owl:ObjectProperty ;
    rdfs:label "involves firefighter" ;
    rdfs:comment "Indicates firefighters participating in an operation." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range ffonto:Firefighter .

ffonto:isAccessRestrictedBy a owl:ObjectProperty ;
    rdfs:label "is access restricted by"@en ;
    rdfs:comment "Links a geographic area or facility to the policy, hazard, or authority that limits entry."@en ;
    rdfs:domain ffonto:DataRepository ;
    rdfs:range ffonto:AccessConstraint .

ffonto:isAffectedByAnomaly a owl:ObjectProperty ;
    rdfs:label "is affected by anomaly"@en ;
    rdfs:comment "Connects a system, dataset, or operational baseline to an unexpected deviation or irregular event impacting it."@en ;
    rdfs:domain ffonto:FireRegime ;
    rdfs:range ffonto:ClimateAnomaly .

ffonto:isAffectedByEvapotranspiration a owl:ObjectProperty ;
    rdfs:label "is affected by evapotranspiration"@en ;
    rdfs:comment "Indicates that fuel moisture, fire behavior, or local climate is influenced by the transfer of water from land and plants to the atmosphere."@en ;
    rdfs:domain ffonto:FuelMoisture ;
    rdfs:range ffonto:Evapotranspiration .

ffonto:isAirspaceRestrictedBy a owl:ObjectProperty ;
    rdfs:label "is airspace restricted by"@en ;
    rdfs:comment "Links a designated flight zone to the authority, incident, or condition enforcing a temporary flight restriction (TFR)."@en ;
    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:TemporaryFlightRestriction .

ffonto:isAnalyzedByAudio a owl:ObjectProperty ;
    rdfs:label "is analyzed by audio"@en ;
    rdfs:comment "Relates an event, operational environment, or mechanical system to the acoustic processing techniques used to monitor it."@en ;
    rdfs:domain ffonto:TelemetryData ;
    rdfs:range ffonto:AudioAnalytics .

ffonto:isAnalyzedTemporally a owl:ObjectProperty ;
    rdfs:label "is analyzed temporally"@en ;
    rdfs:comment "Indicates that a dataset, event sequence, or phenomenon is examined based on its chronological patterns and time-based progression."@en ;
    rdfs:domain ffonto:TelemetryData ;
    rdfs:range ffonto:TimeSeriesAnalysis .

ffonto:isAnnotationOf a owl:ObjectProperty ;
    rdfs:label "is annotation of" ;
    rdfs:comment "inverse of has annotation" ;
    rdfs:domain ffonto:Annotation ;
    rdfs:range ffonto:Observation .

ffonto:isApplicableToScene a owl:ObjectProperty ;
    rdfs:label "is applicable to scene"@en ;
    rdfs:comment "Indicates that a hazardous waste guideline must be followed in a specific wildfire scene after the fire." ;
    rdfs:domain ffonto:HazardousWasteGuideline ;
    rdfs:range ffonto:WildfireScene .

ffonto:isAssessedBy a owl:ObjectProperty ;
    rdfs:label "is assessed by"@en ;
    rdfs:comment "Relates a risk level, operational situation, or geographic area to the analytical process, system, or personnel evaluating it."@en ;
    rdfs:domain ffonto:BurnSeverityMap ;
    rdfs:range ffonto:BAERAssessment .

ffonto:isBriefedBy a owl:ObjectProperty ;
    rdfs:label "is briefed by"@en ;
    rdfs:comment "Relates an incident, operational period, or responder to the specific role or document providing status updates and situational awareness."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:IncidentBriefing .

ffonto:isCloudCoverProcessedBy a owl:ObjectProperty ;
    rdfs:label "is cloud cover processed by"@en ;
    rdfs:comment "Inverse property indicating which atmospheric transport model processes the cloud cover quality."@en ;
    rdfs:domain ffonto:CloudCoverQuality ;
    rdfs:range ffonto:AtmosphericTransportModel .

ffonto:isCombinedInForecast a owl:ObjectProperty ;
    rdfs:label "is combined in forecast"@en ;
    rdfs:comment "Indicates that a specific dataset, meteorological variable, or individual model is integrated into a larger synthesized prediction."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:EnsembleForecast .

ffonto:isCombustionAffectedByChemicalComponent a owl:ObjectProperty ;
    rdfs:label "is combustion affected by chemical component"@en ;
    rdfs:comment "Indicates that the burning characteristics of a fuel are modulated by its specific chemical makeup, such as volatile oils."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:VegetationChemicalComponent .

ffonto:isCombustionAffectedByFuelMoisture a owl:ObjectProperty ;
    rdfs:label "is combustion affected by fuel moisture"@en ;
    rdfs:comment "Relates the burning process of a fire to the modulating influence of water content within the available biomass."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:FuelMoisture .

ffonto:isConsumedIn a owl:ObjectProperty ;
    rdfs:label "is consumed in"@en ;
    rdfs:comment "Connects a resource, such as water, retardant, or fuel, to the specific incident or operational process that depletes it."@en ;
    rdfs:domain ffonto:FuelCharacteristic ;
    rdfs:range ffonto:CombustionProcess .

ffonto:isContainedByFireLine a owl:ObjectProperty ;
    rdfs:label "is contained by fire line"@en ;
    rdfs:comment "Links a fire incident or advancing front to the physical barrier constructed or utilized to stop its spread."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:FireLine .

ffonto:isDataEntityGeneratedBy a owl:ObjectProperty ;
    rdfs:label "is data entity generated by"@en ;
    rdfs:comment "Inverse property linking a data entity back to the activity that generated it."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity .

ffonto:isDataReliedOnBy a owl:ObjectProperty ;
    rdfs:label "is data relied on by"@en ;
    rdfs:comment "Inverse property indicating the sensor fusion process that depends on specific observation data."@en ;
    rdfs:domain ffonto:EarthObservationData ;
    rdfs:range ffonto:SensorFusion .

ffonto:isDetectedBy a owl:ObjectProperty ;
    rdfs:label "is detected by"@en ;
    rdfs:comment "Connects a phenomenon, incident, or entity to the sensor, system, or agent that discovers it."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:ActiveFireDetection .

ffonto:isDetectedByThermalCamera a owl:ObjectProperty ;
    rdfs:label "is detected by thermal camera"@en ;
    rdfs:comment "Indicates that an entity, heat source, or phenomenon is identified specifically using an infrared or thermal imaging device."@en ;
    rdfs:domain ffonto:ActiveFireDetection ;
    rdfs:range ffonto:ThermalCamera .

ffonto:isDeviceUtilizedBy a owl:ObjectProperty ;
    rdfs:label "is device utilized by"@en ;
    rdfs:comment "Inverse property linking a device to the mitigation strategy utilizing it."@en ;
    rdfs:domain ffonto:AirQualityMitigationDevice ;
    rdfs:range ffonto:AirQualityMitigationStrategy .

ffonto:isEcologicalEffectOf a owl:ObjectProperty ;
    rdfs:label "is ecological effect of" ;
    rdfs:comment "Connects a biological or environmental impact (like habitat loss) back to the specific natural disaster that caused it."@en ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:hasEcologicalEffect .

ffonto:isEffectCausedBy a owl:ObjectProperty ;
    rdfs:label "is effect caused by"@en ;
    rdfs:comment "Inverse property linking a resulting effect back to the forest fire that caused it."@en ;
    rdfs:domain ffonto:ForestFireEffect ;
    rdfs:range ffonto:ForestFire .

ffonto:isElementOfScene a owl:ObjectProperty ;
    rdfs:label "is element of scene"@en ;
    rdfs:comment "Relates a detected element to the scene/image it appears in."@en ;
    rdfs:domain ffonto:SceneElement ;
    rdfs:range ffonto:WildfireScene .

ffonto:isEvacuationOrderFor a owl:ObjectProperty ;
    rdfs:label "is evacuation order for"@en ;
    rdfs:comment "Relates an official mandate to leave an area to the specific incident or hazard that necessitated it."@en ;
    rdfs:domain ffonto:EvacuationOrder ;
    rdfs:range ffonto:Hazard .

ffonto:isEvacuationZoneFor a owl:ObjectProperty ;
    rdfs:label "is evacuation zone for"@en ;
    rdfs:comment "Relates a designated geographic area to the specific incident or population it is intended to clear and protect."@en ;
    rdfs:domain ffonto:EvacuationZone ;
    rdfs:range ffonto:WildfireIncident .

ffonto:isExplainedBy a owl:ObjectProperty ;
    rdfs:label "is explained by"@en ;
    rdfs:comment "Links an observation, anomaly, or model prediction to the underlying rationale, data, or theory that justifies it."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:ExplainableAI .

ffonto:isFacilityOperatedBy a owl:ObjectProperty ;
    rdfs:label "is facility operated by"@en ;
    rdfs:comment "Inverse property linking an emergency facility to the command section utilizing it."@en ;
    rdfs:domain ffonto:EmergencyFacility ;
    rdfs:range ffonto:IncidentCommandSection .

ffonto:isFireBehaviorInfluencedBy a owl:ObjectProperty ;
    rdfs:label "is fire behavior influenced by"@en ;
    rdfs:comment "Inverse property indicating the climate pattern that influenced a specific forest fire."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ClimatePattern .

ffonto:isFireBehaviorInfluencedByFuel a owl:ObjectProperty ;
    rdfs:label "is fire behavior influenced by fuel"@en ;
    rdfs:comment "Indicates that the spread and intensity of a fire are directly modulated by the type, density, and condition of available biomass."@en ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range ffonto:FuelType .

ffonto:isFireBehaviorModelInfluencedByWeather a owl:ObjectProperty ;
    rdfs:label "is fire behavior model influenced by weather"@en ;
    rdfs:comment "Relates a predictive fire simulation to the meteorological data inputs that shape its calculations."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:WeatherFactor .

ffonto:isFireWeatherIndexInfluencedByClimateDriver a owl:ObjectProperty ;
    rdfs:label "is fire weather index influenced by climate driver"@en ;
    rdfs:comment "Connects a calculated fire danger rating to the overarching meteorological patterns affecting it."@en ;
    rdfs:domain ffonto:FireWeatherIndex ;
    rdfs:range ffonto:ClimateDriver .

ffonto:isInfluencedBy a owl:ObjectProperty ;
    rdfs:label "is influenced by climate/environmental driver" ;
    rdfs:comment "Indicates climatic or environmental conditions contributing to ignition/spread." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ClimateDriver .

ffonto:isIntegratedIntoKG a owl:ObjectProperty ;
    rdfs:label "is integrated into KG"@en ;
    rdfs:comment "Relates a discrete dataset, entity, or document to the encompassing Knowledge Graph where it is semantically linked."@en ;
    rdfs:domain ffonto:SatelliteData ;
    rdfs:range ffonto:KnowledgeGraph .

ffonto:isLocationOf a owl:ObjectProperty ;
    rdfs:label "inverse of located at"@en,
        "is location of"@en ;
    rdfs:comment "A relation indicating geographic placement or position of an entity."@en,
        "Relates a spatial entity or natural feature to the event or phenomenon occurring at it."@en ;
    rdfs:domain ffonto:Observation,
        ffonto:SpatialEntity ;
    rdfs:range ffonto:ForestFire,
        ffonto:SpatialEntity ;
    owl:inverseOf ffonto:hasLocation .

ffonto:isManagedBy a owl:ObjectProperty ;
    rdfs:label "is managed by"@en ;
    rdfs:comment "Links an incident, resource, or system to the specific command role, organization, or software responsible for its oversight."@en ;
    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:AirspaceManagement .

ffonto:isMeasuredByAQI a owl:ObjectProperty ;
    rdfs:label "is measured by AQI"@en ;
    rdfs:comment "Indicates that the concentration of atmospheric pollutants or general air quality is quantified using the standard Air Quality Index."@en ;
    rdfs:domain ffonto:ParticulateMatterPM25 ;
    rdfs:range ffonto:AirQualityIndex .

ffonto:isMitigatedBy a owl:ObjectProperty ;
    rdfs:label "is mitigated by"@en ;
    rdfs:comment "Links a hazard, operational risk, or negative impact to the strategy, action, or device actively used to reduce its severity."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:SafetyMeasure .

ffonto:isMitigatedByStrategy a owl:ObjectProperty ;
    rdfs:label "is mitigated by strategy"@en ;
    rdfs:comment "Inverse property indicating the mitigation strategy addressing an air pollution metric."@en ;
    rdfs:domain ffonto:AirPollutionMetric ;
    rdfs:range ffonto:AirQualityMitigationStrategy .

ffonto:isModelGovernedBy a owl:ObjectProperty ;
    rdfs:label "is model governed by"@en ;
    rdfs:comment "Inverse property linking an MLOps pipeline to its governing framework."@en ;
    rdfs:domain ffonto:MLOpsPipeline ;
    rdfs:range ffonto:AIModelGovernance .

ffonto:isModelMonitoredBy a owl:ObjectProperty ;
    rdfs:label "is model monitored by"@en ;
    rdfs:comment "Relates a computational or AI model to the oversight entity, system, or governance framework tracking its performance."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:ModelMonitoring .

ffonto:isModelProvenanceOf a owl:ObjectProperty ;
    rdfs:label "has model provenance",
        "is model provenance of"@en ;
    rdfs:comment "Links a lineage record, training dataset log, or version history back to the specific computational model it documents."@en ;
    rdfs:domain ffonto:ModelProvenance ;
    rdfs:range ffonto:ModelOutput .

ffonto:isObservationOf a owl:ObjectProperty ;
    rdfs:label "is observation of"@en ;
    rdfs:comment "Inverse relation linking observation records back to the phenomena or sites observed."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:ForestFire .

ffonto:isObservedBySensor a owl:ObjectProperty ;
    rdfs:label "is observed by sensor"@en ;
    rdfs:comment "Links a physical phenomenon, environmental event, or condition to the specific hardware device capturing data about it."@en,
        "Relates an observation to the sensor that recorded it."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range sosa:Sensor .

ffonto:isOperationGuidedBy a owl:ObjectProperty ;
    rdfs:label "is operation guided by"@en ;
    rdfs:comment "Inverse property linking an operations section to the strategy that guides it."@en ;
    rdfs:domain ffonto:OperationsSection ;
    rdfs:range ffonto:OperationalStrategy .

ffonto:isOperationalPeriodOf a owl:ObjectProperty ;
    rdfs:label "is operational period of"@en ;
    rdfs:comment "Connects a defined timeframe or shift to the specific incident or operation it regulates."@en ;
    rdfs:domain ffonto:OperationalPeriod ;
    rdfs:range ffonto:WildfireIncident .

ffonto:isOpportunityEvaluatedBy a owl:ObjectProperty ;
    rdfs:label "is opportunity evaluated by"@en ;
    rdfs:comment "Inverse property linking a challenge or opportunity back to its ethical consideration."@en ;
    rdfs:domain ffonto:ChallengeOpportunity ;
    rdfs:range ffonto:EthicalConsideration .

ffonto:isPerimeterOf a owl:ObjectProperty ;
    rdfs:label "is perimeter of"@en ;
    rdfs:comment "Connects a defined containment line or geospatial boundary to the specific wildfire incident it encloses."@en ;
    rdfs:domain ffonto:FirePerimeter ;
    rdfs:range ffonto:WildfireIncident .

ffonto:isPlannedByAerialDrop a owl:ObjectProperty ;
    rdfs:label "is planned by aerial drop"@en ;
    rdfs:comment "Relates a suppression tactic, resource allocation, or logistical delivery to the coordinated airborne operation executing it."@en ;
    rdfs:domain ffonto:UAV ;
    rdfs:range ffonto:AerialDropPlanning .

ffonto:isPlatformDeployedBy a owl:ObjectProperty ;
    rdfs:label "is platform deployed by"@en ;
    rdfs:comment "Inverse property linking a sensor platform back to the command section that deployed it."@en ;
    rdfs:domain sosa:Platform ;
    rdfs:range ffonto:IncidentCommandSection .

ffonto:isPredictedByModel a owl:ObjectProperty ;
    rdfs:label "is predicted by model"@en ;
    rdfs:comment "Indicates that a forecasted condition, spread rate, or metric is generated by a specific simulation or AI framework."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:FireBehaviorModel .

ffonto:isPreventedBy a owl:ObjectProperty ;
    rdfs:label "is prevented by"@en ;
    rdfs:comment "Relates a hazard, incident, or negative outcome to the action, policy, or entity that stops it from occurring."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:PreventionMeasure .

ffonto:isProtectedBy a owl:ObjectProperty ;
    rdfs:label "is protected by"@en ;
    rdfs:comment "Links a vulnerable entity, community, or system to the specific plan, physical barrier, or policy ensuring its safety."@en ;
    rdfs:domain ffonto:KnowledgeGraph ;
    rdfs:range ffonto:CyberSecurityPractice .

ffonto:isProtectedByPrivacyPolicy a owl:ObjectProperty ;
    rdfs:label "is protected by privacy policy"@en ;
    rdfs:comment "Relates a dataset, system, or user to the regulatory framework ensuring data confidentiality and ethical use."@en ;
    rdfs:domain ffonto:DataRepository ;
    rdfs:range ffonto:PrivacyProtection .

ffonto:isRecordedInDecisionLog a owl:ObjectProperty ;
    rdfs:label "is recorded in decision log"@en ;
    rdfs:comment "Links an action, command, or rationale to the official administrative record tracking operational choices."@en ;
    rdfs:domain ffonto:IncidentCommand ;
    rdfs:range ffonto:DecisionLog .

ffonto:isRecordedInInventory a owl:ObjectProperty ;
    rdfs:label "is recorded in inventory"@en ;
    rdfs:comment "Connects a physical resource, equipment, or supply to the logistical database or ledger that tracks its availability."@en ;
    rdfs:domain ffonto:EmissionEstimate ;
    rdfs:range ffonto:EmissionInventory .

ffonto:isReportedByCitizen a owl:ObjectProperty ;
    rdfs:label "is reported by citizen"@en ;
    rdfs:comment "Indicates that an incident, hazard, or observation was submitted by a member of the public rather than an automated system or official responder."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:CrowdsourcedReport .

ffonto:isReportedIn a owl:ObjectProperty ;
    rdfs:label "is reported in"@en ;
    rdfs:comment "Links an event, observation, or metric to the specific document, database, or official log where it is recorded."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:SituationReport .

ffonto:isRiskAssessmentInfluencedByFlammability a owl:ObjectProperty ;
    rdfs:label "is risk assessment influenced by flammability"@en ;
    rdfs:comment "Connects a calculated risk level to the specific combustible properties of the fuel load that affect it."@en ;
    rdfs:domain ffonto:RiskAssessment ;
    rdfs:range ffonto:SeasonalFlammability .

ffonto:isRiskLevelOf a owl:ObjectProperty ;
    rdfs:label "is risk level of" ;
    rdfs:domain ffonto:FireRiskAssessment ;
    rdfs:range geo:SpatialObject .

ffonto:isRollbackImplementedBy a owl:ObjectProperty ;
    rdfs:label "is rollback implemented by"@en ;
    rdfs:comment "Inverse property linking a rollback strategy to the MLOps pipeline executing it."@en ;
    rdfs:domain ffonto:RollbackStrategy ;
    rdfs:range ffonto:MLOpsPipeline .

ffonto:isShelteredFrom a owl:ObjectProperty ;
    rdfs:label "is sheltered from"@en ;
    rdfs:comment "Indicates that a population, entity, or facility is protected from a specific hazard, such as a fire or toxic smoke plume."@en ;
    rdfs:domain ffonto:SmokePlume ;
    rdfs:range ffonto:CleanAirShelter .

ffonto:isSidingDataIncorporatedIn a owl:ObjectProperty ;
    rdfs:label "is siding data incorporated in"@en ;
    rdfs:comment "Inverse property linking exterior siding data to the simulation model using it."@en ;
    rdfs:domain ffonto:ExteriorSiding ;
    rdfs:range ffonto:SimulationModel .

ffonto:isSpatialExtentof a owl:ObjectProperty ;
    rdfs:label "is spatial extent of" ;
    rdfs:comment "Inverse of has spatial extent" ;
    rdfs:domain ffonto:SpatialExtent ;
    rdfs:range ffonto:Observation .

ffonto:isSupervisedByAirAttack a owl:ObjectProperty ;
    rdfs:label "is supervised by air attack"@en ;
    rdfs:comment "Indicates that an aerial suppression operation or airspace zone is directed by an airborne tactical supervisor (Air Attack)."@en ;
    rdfs:domain ffonto:UAV ;
    rdfs:range ffonto:AirAttackSupervisor .

ffonto:isSupportedByDSS a owl:ObjectProperty ;
    rdfs:label "is supported by DSS"@en ;
    rdfs:comment "Links a decision, role, or operation to the Decision Support System providing data and analytical guidance."@en ;
    rdfs:domain ffonto:IncidentCommand ;
    rdfs:range ffonto:DecisionSupportSystem .

ffonto:isSystemMonitoredBy a owl:ObjectProperty ;
    rdfs:label "is system monitored by"@en ;
    rdfs:comment "Relates an information or operational system to the governing entity, software, or agent responsible for its oversight."@en ;
    rdfs:domain ffonto:DecisionSupportSystem ;
    rdfs:range ffonto:CanaryDeployment .

ffonto:isTrackedBy a owl:ObjectProperty ;
    rdfs:label "is tracked by"@en ;
    rdfs:comment "Relates an entity, such as an aircraft or resource, to the monitoring system or radar observing its position."@en ;
    rdfs:domain ffonto:UAV ;
    rdfs:range ffonto:AircraftTracking .

ffonto:isUsedInStrategy a owl:ObjectProperty ;
    rdfs:label "is used in strategy"@en ;
    rdfs:comment "Links a resource, tool, or tactic to the broader operational plan or strategy it supports."@en ;
    rdfs:domain ffonto:AirCleaner ;
    rdfs:range ffonto:IndoorAirQualityStrategy .

ffonto:isVerifiedBy a owl:ObjectProperty ;
    rdfs:label "is verified by"@en ;
    rdfs:comment "Connects a data point, report, or model output to the entity, system, or process confirming its accuracy."@en ;
    rdfs:domain ffonto:CrowdsourcedReport ;
    rdfs:range ffonto:ReportVerification .

ffonto:isWildlifeAffectedByImpact a owl:ObjectProperty ;
    rdfs:label "is wildlife affected by impact"@en ;
    rdfs:comment "Connects local animal populations or habitats to the specific environmental damage or event disrupting them."@en ;
    rdfs:domain ffonto:Wildlife ;
    rdfs:range ffonto:WildlifeImpact .

ffonto:issuesEvacuationWarning a owl:ObjectProperty ;
    rdfs:label "issues evacuation warning"@en ;
    rdfs:comment "Indicates that an authority, system, or command role broadcasts a notification for civilians to leave a hazardous area."@en ;
    rdfs:domain ffonto:PublicWarningSystem ;
    rdfs:range ffonto:EvacuationZone .

ffonto:labelSourceOf a owl:ObjectProperty ;
    rdfs:label "label source of" ;
    rdfs:comment "Indicates the source (caption/detector/human) that produced the label assignment." ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range ffonto:ModelProvenance .

ffonto:landsAtHelispot a owl:ObjectProperty ;
    rdfs:label "lands at helispot"@en ;
    rdfs:comment "Connects a rotary-wing aircraft or aerial mission to the designated temporary landing zone used during an incident."@en ;
    rdfs:domain ffonto:UAV ;
    rdfs:range ffonto:Helispot .

ffonto:leadsToEffect a owl:ObjectProperty ;
    rdfs:label "leads to ecological effect" ;
    rdfs:comment "Represents long-term ecological effects resulting from a fire event." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:EcologicalEffect .

ffonto:limitsFireSpread a owl:ObjectProperty ;
    rdfs:label "limits fire spread"@en ;
    rdfs:comment "Links a physical barrier, mitigation tactic, or environmental feature to its restricting effect on a fire's expansion."@en ;
    rdfs:domain ffonto:NaturalFirebreak ;
    rdfs:range ffonto:FireFront .

ffonto:locatedInWUI a owl:ObjectProperty ;
    rdfs:label "located in WUI" ;
    rdfs:comment "Indicates that a location or asset is situated within the Wildland–Urban Interface."@en ;
    rdfs:domain ffonto:WUICommunity ;
    rdfs:range ffonto:WildlandUrbanInterface .

ffonto:locatedNearStructure a owl:ObjectProperty ;
    rdfs:label "located near structure" ;
    rdfs:comment "Indicates portable tanks positioned near buildings for firefighting." ;
    rdfs:domain ffonto:PortableTank ;
    rdfs:range ffonto:House .

ffonto:locationOfEvent a owl:ObjectProperty ;
    rdfs:label "location of event"@en ;
    rdfs:comment "Connects a specific spatial extent, geographic feature, or coordinate to the incident or phenomenon that occurred there."@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:ForestFire .

ffonto:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by" ;
    rdfs:comment "Associates an entity or operation with the responsible managing organization or agency."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ResponseOrganization .

ffonto:managedByStrategy a owl:ObjectProperty ;
    rdfs:label "managed by strategy" ;
    rdfs:comment "Indicates which fire management strategies are used to control fire behavior." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range ffonto:FireManagementStrategy .

ffonto:managesFireEvent a owl:ObjectProperty ;
    rdfs:label "manages fire event"@en ;
    rdfs:comment "Inverse property linking an Incident Command Section to the forest fire it is actively managing."@en ;
    rdfs:domain ffonto:IncidentCommandSection ;
    rdfs:range ffonto:ForestFire .

ffonto:managesIncident a owl:ObjectProperty ;
    rdfs:label "manages incident"@en ;
    rdfs:comment "Connects an incident command role, organization, or system to the specific emergency event it oversees."@en ;
    rdfs:domain ffonto:IncidentCommand ;
    rdfs:range ffonto:ForestFire .

ffonto:managesPropaneTank a owl:ObjectProperty ;
    rdfs:label "manages propane tank" ;
    rdfs:comment "Indicates recommended management procedures for propane tanks." ;
    rdfs:domain ffonto:RecoveryGuideline ;
    rdfs:range ffonto:PropaneTank .

ffonto:mayCauseIgnition a owl:ObjectProperty ;
    rdfs:label "may cause ignition"@en ;
    rdfs:comment "Indicates the general capability of a condition, material, or event to act as a heat source that starts a fire."@en ;
    rdfs:domain ffonto:PowerInfrastructureFailure ;
    rdfs:range ffonto:IgnitionSource .

ffonto:mayIgnite a owl:ObjectProperty ;
    rdfs:label "may ignite"@en ;
    rdfs:comment "Indicates the potential for a specific material, fuel load, or area to catch fire under the current environmental conditions."@en ;
    rdfs:domain ffonto:FarmEquipment ;
    rdfs:range ffonto:IgnitionSource .

ffonto:measuredFrom a owl:ObjectProperty ;
    rdfs:label "measured from"@en ;
    rdfs:comment "Connects an observation, metric, or distance to the physical location or temporal baseline serving as its starting point."@en ;
    rdfs:domain ffonto:FireRadiativePower ;
    rdfs:range ffonto:SatelliteData .

ffonto:mediaKeptAtDistanceOf a owl:ObjectProperty ;
    rdfs:label "media kept at distance of" ;
    rdfs:comment "Inverse - Indicates media/observers are held at a safe distance by responders." ;
    rdfs:domain ffonto:MediaGroup ;
    rdfs:range ffonto:Responder .

ffonto:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by" ;
    rdfs:comment "Associates hazards or risks with measures that reduce their likelihood or impact."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:ProtectiveAction .

ffonto:mitigatesRisk a owl:ObjectProperty ;
    rdfs:label "mitigates risk" ;
    rdfs:comment "Indicates that an action or policy mitigates wildfire risk." ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:FireRiskAssessment .

ffonto:modeledBy a owl:ObjectProperty ;
    rdfs:label "modeled by" ;
    rdfs:comment "Link from incident/image to a probability model producing fire probability." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireProbabilityModel .

ffonto:modifiesSoilCondition a owl:ObjectProperty ;
    rdfs:label "modifies soil condition" ;
    rdfs:comment "Indicates that a wildfire alters the condition of soil, such as reducing infiltration or increasing hydrophobicity." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SoilCondition .

ffonto:monitoredBy a owl:ObjectProperty ;
    rdfs:label "monitored by"@en ;
    rdfs:comment "Links a wildfire incident or environment to the monitoring system observing it."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:RemoteSensing .

ffonto:monitoredUsing a owl:ObjectProperty ;
    rdfs:label "monitored using" ;
    rdfs:comment "Links wildfire monitoring to remote sensing systems." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:RemoteSensingSensor .

ffonto:monitorsAirspace a owl:ObjectProperty ;
    rdfs:label "monitors airspace"@en ;
    rdfs:comment "Links a system, sensor, or operational agent to the act of observing a designated aerial volume for traffic or hazards."@en ;
    rdfs:domain ffonto:AirspaceConflictDetection ;
    rdfs:range ffonto:Airspace .

ffonto:monitorsInfrastructure a owl:ObjectProperty ;
    rdfs:label "monitors infrastructure" ;
    rdfs:comment "The activity of observing and assessing the condition of critical infrastructure."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:Infrastructure .

ffonto:observedAtLocation a owl:ObjectProperty ;
    rdfs:label "observed at location" ;
    rdfs:comment "Location or feature where an observation was recorded (e.g., NE flank ridgeline)." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:Location .

ffonto:observedAtScene a owl:ObjectProperty ;
    rdfs:label "observed at scene"@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:WildfireScene .

ffonto:observedInImage a owl:ObjectProperty ;
    rdfs:label "observed in image" ;
    rdfs:comment "Relates an observation to the environmental image in which it was detected." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range owl:WildfireScene .

ffonto:observedProperty a owl:ObjectProperty ;
    rdfs:label "observed property" ;
    rdfs:comment "The property that was observed or estimated." ;
    rdfs:domain ffonto:Result ;
    rdfs:range ffonto:ObservableProperty .

ffonto:occursForPurpose a owl:ObjectProperty ;
    rdfs:label "occurs for purpose" ;
    rdfs:comment "Indicates the purpose for which an intentional fire is set." ;
    rdfs:domain ffonto:IntentionalFire ;
    rdfs:range ffonto:LandClearing .

ffonto:occursInAirspace a owl:ObjectProperty ;
    rdfs:label "occurs in airspace"@en ;
    rdfs:comment "Indicates that an aerial operation, flight path, or meteorological event takes place within a designated volumetric flight zone."@en ;
    rdfs:domain ffonto:FlightPath ;
    rdfs:range ffonto:Airspace .

ffonto:occursInTerrain a owl:ObjectProperty ;
    rdfs:label "occurs in terrain" ;
    rdfs:comment "Specifies the terrain where wildfire is occurring." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ForestTerrain .

ffonto:occursInWatershed a owl:ObjectProperty ;
    rdfs:label "occurs in watershed" ;
    rdfs:comment "Indicates the watershed where runoff flows and accumulates." ;
    rdfs:domain ffonto:Runoff ;
    rdfs:range ffonto:Watershed .

ffonto:onFlank a owl:ObjectProperty ;
    rdfs:label "located on flank" ;
    rdfs:comment "Frame-relative flank description (e.g. 'right' or 'left') stored as literal." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range rdfs:Literal .

ffonto:operatesAtScene a owl:ObjectProperty ;
    rdfs:label "operates at scene" ;
    rdfs:comment "Links responders or vehicles to the wildfire scene where they operate." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:WildfireScene .

ffonto:operatesEquipment a owl:ObjectProperty ;
    rdfs:label "operates equipment" ;
    rdfs:comment "Denotes the action of controlling or using a piece of equipment."@en ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:Equipment .

ffonto:operatesUnderBVLOS a owl:ObjectProperty ;
    rdfs:label "operates under BVLOS"@en ;
    rdfs:comment "Connects a UAV or aerial mission to the regulatory and operational framework of Beyond Visual Line of Sight flight."@en ;
    rdfs:domain ffonto:UAV ;
    rdfs:range ffonto:BVLOS .

ffonto:partOfBuilding a owl:ObjectProperty ;
    rdfs:label "part of building" ;
    rdfs:comment "Indicates an element (roof, gutter, chimney, meterbox) is part of a building." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:Chimney ffonto:MeterBox ) ] ;
    rdfs:range ffonto:Building .

ffonto:partOfIncidentCommand a owl:ObjectProperty ;
    rdfs:label "part of incident command"@en ;
    rdfs:comment "Indicates that a person, role, or unit operates within the organizational structure of the Incident Command System."@en ;
    rdfs:domain ffonto:Branch ;
    rdfs:range ffonto:IncidentCommand .

ffonto:partOfVehicle a owl:ObjectProperty ;
    rdfs:label "part of vehicle" ;
    rdfs:comment "Indicates that a window is part of a vehicle." ;
    rdfs:domain ffonto:Window ;
    rdfs:range ffonto:Vehicle .

ffonto:performsOperation a owl:ObjectProperty ;
    rdfs:label "performs operation" ;
    rdfs:comment "Relates a firefighter to an operation they perform." ;
    rdfs:domain ffonto:EmergencyResponder ;
    rdfs:range ffonto:EmergencyOperation .

ffonto:performsSuppression a owl:ObjectProperty ;
    rdfs:label "performs suppression action" ;
    rdfs:comment "Indicates that responders perform a suppression activity." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:FireSuppressionAction .

ffonto:performsTask a owl:ObjectProperty ;
    rdfs:label "performs CV task" ;
    rdfs:comment "Denotes that an agent or resource is executing a specified task or duty."@en ;
    rdfs:domain ffonto:MachineLearningModel ;
    rdfs:range ffonto:ComputerVisionTask .

ffonto:posesHealthRisk a owl:ObjectProperty ;
    rdfs:label "poses health risk" ;
    rdfs:comment "Indicates health risks caused by wildfire smoke." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:HealthRisk .

ffonto:positionedBetween a owl:ObjectProperty ;
    rdfs:label "positioned between" ;
    rdfs:comment "Resources placed between fire and a structure to protect it." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:StructureFire .

ffonto:practices a owl:ObjectProperty ;
    rdfs:label "practices" ;
    rdfs:comment "Links an EvacuationDrill to participating households or organizations." ;
    rdfs:domain ffonto:EvacuationDrill ;
    rdfs:range ffonto:EvacuationPreparation .

ffonto:predictsSmokePlume a owl:ObjectProperty ;
    rdfs:label "predicts smoke plume"@en ;
    rdfs:comment "Links a simulation or meteorological model to its forecast of the trajectory and density of particulate emissions."@en ;
    rdfs:domain ffonto:SmokeDispersionModel ;
    rdfs:range ffonto:SmokePlume .

ffonto:prioritizes a owl:ObjectProperty ;
    rdfs:label "prioritizes" ;
    rdfs:comment "Indicates which value (life, property, environment) is prioritized." ;
    rdfs:domain ffonto:ResourcePrioritization ;
    rdfs:range owl:Thing .

ffonto:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by",
        "produced by"@en ;
    rdfs:comment "Links an output, emission, physical artifact, or dataset back to the process, event, or entity that created it."@en ;
    rdfs:domain ffonto:ModelOutput ;
    rdfs:range ffonto:ModelExecution .

ffonto:producedCaptionBy a owl:ObjectProperty ;
    rdfs:label "produced caption by" ;
    rdfs:comment "Links image to caption output (model & caption text)." ;
    rdfs:domain ffonto:ImageAsset ;
    rdfs:range ffonto:CaptionModelOutput .

ffonto:producedInArea a owl:ObjectProperty ;
    rdfs:label "produced in area"@en ;
    rdfs:comment "Relates an AgriculturalProduce instance to the Location in which it was produced."@en ;
    rdfs:domain ffonto:AgriculturalProduce ;
    rdfs:range ffonto:Location .

ffonto:producesAirPollution a owl:ObjectProperty ;
    rdfs:label "produces air pollution" ;
    rdfs:comment "Smoke and particulate emissions resulting from a fire event." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AirPollution .

ffonto:producesCarbonEmission a owl:ObjectProperty ;
    rdfs:label "produces carbon emission"@en ;
    rdfs:comment "Links a physical process or event, such as a wildfire combustion, to the greenhouse gases it releases."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:CarbonEmission .

ffonto:producesPollution a owl:ObjectProperty ;
    rdfs:label "produces pollution" ;
    rdfs:comment "Indicates that a wildfire produces wildfire smoke pollution." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:WildfireSmoke .

ffonto:producesSmokePlume a owl:ObjectProperty ;
    rdfs:label "produces smoke plume"@en ;
    rdfs:comment "Links a combustion event, like a wildfire, to the visible, measurable column of smoke it generates."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:SmokePlume .

ffonto:producesToxic a owl:ObjectProperty ;
    rdfs:label "produces toxic pollutant" ;
    rdfs:comment "Indicates toxic pollutants produced during wildfire combustion." ;
    rdfs:domain ffonto:Smoke ;
    rdfs:range ffonto:AirToxic .

ffonto:promotesRegeneration a owl:ObjectProperty ;
    rdfs:label "promotes regeneration" ;
    rdfs:comment "Fire can stimulate forest regrowth." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ForestRegeneration .

ffonto:protectedBy a owl:ObjectProperty ;
    rdfs:label "protected by" ;
    rdfs:comment "Indicates a protection method reduces smoke exposure." ;
    rdfs:domain ffonto:PopulationGroup ;
    rdfs:range ffonto:ProtectionMethod .

ffonto:protectingAsset a owl:ObjectProperty ;
    rdfs:label "protecting asset" ;
    rdfs:comment "Indicates responders are protecting a particular structure/asset." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:StructureFire .

ffonto:protectsStructure a owl:ObjectProperty ;
    rdfs:label "firefighter protects structure" ;
    rdfs:comment "Indicates firefighters protecting a structure from fire." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:House .

ffonto:providedBy a owl:ObjectProperty ;
    rdfs:label "provided by organization" ;
    rdfs:comment "Indicates the organization providing health information." ;
    rdfs:domain ffonto:HealthAdvice ;
    rdfs:range ffonto:ResponseOrganization .

ffonto:providesCarbonStorage a owl:ObjectProperty ;
    rdfs:label "provides carbon storage" ;
    rdfs:comment "Indicates that an ecosystem stores carbon and reduces atmospheric CO2." ;
    rdfs:domain ffonto:Forest ;
    rdfs:range ffonto:CarbonSink .

ffonto:providesEcosystemService a owl:ObjectProperty ;
    rdfs:label "provides ecosystem service" ;
    rdfs:comment "Relates ecosystems to the ecosystem services they provide." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:EcosystemService .

ffonto:providesHabitat a owl:ObjectProperty ;
    rdfs:label "provides habitat" ;
    rdfs:comment "Relates vegetation or ecosystems to habitats available for wildlife." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:Habitat .

ffonto:providesInformation a owl:ObjectProperty ;
    rdfs:label "provides information about health risk" ;
    rdfs:comment "Indicates that an entity offers data, guidance, or descriptive content."@en ;
    rdfs:domain ffonto:InformationResource ;
    rdfs:range ffonto:HealthRisk .

ffonto:providesService a owl:ObjectProperty ;
    rdfs:label "provides ecosystem service" ;
    rdfs:domain [ owl:unionOf ( ffonto:Ecosystem ffonto:WaterBody ) ] ;
    rdfs:range ffonto:EcosystemService .

ffonto:providesWater a owl:ObjectProperty ;
    rdfs:label "provides water"@en ;
    rdfs:comment "Indicates that a resource or infrastructure supplies water for consumption, firefighting, or ecological use."@en ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range ffonto:WaterSource .

ffonto:reachedAgriculturalLand a owl:ObjectProperty ;
    rdfs:label "reached agricultural land" ;
    rdfs:comment "Indicates that fire or hazard has spread into agricultural areas."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AgriculturalLand .

ffonto:reachedWUI a owl:ObjectProperty ;
    rdfs:label "reached urban-wildland interface" ;
    rdfs:comment "Indicates that wildfire activity has extended into the Wildland–Urban Interface."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:UrbanWildlandInterface .

ffonto:receivesEDXLMessage a owl:ObjectProperty ;
    rdfs:label "receives EDXL message"@en ;
    rdfs:comment "Indicates that a system, agency, or device is configured to accept Emergency Data Exchange Language (EDXL) formatted communications."@en ;
    rdfs:domain ffonto:PublicWarningSystem ;
    rdfs:range ffonto:EDXLMessage .

ffonto:receivesTrackingFrom a owl:ObjectProperty ;
    rdfs:label "receives tracking from"@en ;
    rdfs:comment "Indicates that a system, command center, or entity gets location telemetry from a specific sensor or monitoring device."@en ;
    rdfs:domain ffonto:AircraftTracking ;
    rdfs:range ffonto:ADSB .

ffonto:recommendedFor a owl:ObjectProperty ;
    rdfs:label "recommended for population group" ;
    rdfs:comment "Links protection advice to vulnerable populations." ;
    rdfs:domain ffonto:HealthAdvice ;
    rdfs:range ffonto:PopulationGroup .

ffonto:recommendedProtection a owl:ObjectProperty ;
    rdfs:label "recommended protection method" ;
    rdfs:comment "Links health advice to recommended protection methods." ;
    rdfs:domain ffonto:HealthAdvice ;
    rdfs:range ffonto:ProtectionMethod .

ffonto:recommendsAction a owl:ObjectProperty ;
    rdfs:label "recommends protective action" ;
    rdfs:comment "Links health guidelines to recommended protective actions." ;
    rdfs:domain ffonto:HealthGuideline ;
    rdfs:range ffonto:ProtectiveAction .

ffonto:reducesFireSpreadOf a owl:ObjectProperty ;
    rdfs:label "reduces fire spread of" ;
    rdfs:comment "Indicates that an environmental condition reduces the likelihood or rate of fire spread of a fire event or area." ;
    rdfs:domain ffonto:FireSpreadCondition ;
    rdfs:range ffonto:ForestFire .

ffonto:reducesSpreadOf a owl:ObjectProperty ;
    rdfs:label "reduces spread of" ;
    rdfs:comment "Indicates that snow cover reduces the spread or likelihood of fire propagation." ;
    rdfs:domain ffonto:SnowCover ;
    rdfs:range ffonto:ForestFire .

ffonto:regrowthOfSpecies a owl:ObjectProperty ;
    rdfs:label "regrowth of species" ;
    rdfs:comment "Relates a regrowth process to the specific species that are recovering." ;
    rdfs:domain ffonto:VegetationRegrowth ;
    rdfs:range ffonto:PlantSpecies .

ffonto:relatedWaterSource a owl:ObjectProperty ;
    rdfs:label "related water source" ;
    rdfs:comment "Nearby water body or source useful for suppression." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Location .

ffonto:releasesCarbon a owl:ObjectProperty ;
    rdfs:label "releases carbon" ;
    rdfs:comment "Relates a fire event to carbon released by combustion." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:CarbonRelease .

ffonto:removesVegetation a owl:ObjectProperty ;
    rdfs:label "removes vegetation" ;
    rdfs:comment "Indicates that wildfire removes or destroys vegetation cover." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Vegetation .

ffonto:reportedThrough a owl:ObjectProperty ;
    rdfs:label "reported through"@en ;
    rdfs:comment "Relates an incident or data point to the communication channel or system used to transmit it."@en ;
    rdfs:domain ffonto:CitizenObservation ;
    rdfs:range ffonto:CrowdsourcedReport .

ffonto:requiresClearance a owl:ObjectProperty ;
    rdfs:label "requires clearance" ;
    rdfs:comment "Clear zone must be implemented before drops." ;
    rdfs:domain ffonto:DropZone ;
    rdfs:range ffonto:ProtectiveAction .

ffonto:requiresHandlingGuideline a owl:ObjectProperty ;
    rdfs:label "requires handling guideline" ;
    rdfs:comment "Indicates that a hazardous material must be handled according to a specific hazardous waste guideline." ;
    rdfs:domain ffonto:HazardousMaterial ;
    rdfs:range ffonto:HazardousWasteGuideline .

ffonto:requiresItem a owl:ObjectProperty ;
    rdfs:label "requires item" ;
    rdfs:comment "Items required in emergency preparedness kits." ;
    rdfs:domain ffonto:EvacuationProcedure ;
    rdfs:range ffonto:PreparednessItem .

ffonto:requiresResource a owl:ObjectProperty ;
    rdfs:label "requires suppression resource" ;
    rdfs:comment "Specifies firefighting resources required to manage the wildfire." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuppressionResource .

ffonto:respondedBy a owl:ObjectProperty ;
    rdfs:label "responded by" ;
    rdfs:comment "Associates an incident or request with the responding unit(s) or agency(ies)."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuppressionResource .

ffonto:simulatesFire a owl:ObjectProperty ;
    rdfs:label "simulates fire"@en ;
    rdfs:comment "Inverse property linking a computational or analytical activity to the fire it simulates."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range ffonto:ForestFire .

ffonto:stagedNear a owl:ObjectProperty ;
    rdfs:label "staged near" ;
    rdfs:comment "Indicates that resources or personnel are positioned in proximity to a location for rapid deployment."@en ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range ffonto:CommandPost .

ffonto:storesWater a owl:ObjectProperty ;
    rdfs:label "stores water" ;
    rdfs:comment "Indicates that a water tank stores water that can be used as a water source." ;
    rdfs:domain ffonto:WaterTank ;
    rdfs:range ffonto:WaterSource .

ffonto:structureAffected a owl:ObjectProperty ;
    rdfs:label "structure affected by fire" ;
    rdfs:comment "Identifies a building or structure that is impacted by an event."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:StructureFire .

ffonto:suggestsEnvironmentalProcess a owl:ObjectProperty ;
    rdfs:label "suggests environmental process" ;
    rdfs:comment "Indicates that an observation suggests the occurrence of an environmental process such as wildfire or ecological disturbance." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:ForestFire .

ffonto:supportsBiodiversity a owl:ObjectProperty ;
    rdfs:label "supports biodiversity" ;
    rdfs:comment "Indicates that an ecosystem or vegetation type supports biodiversity." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:Biodiversity .

ffonto:supportsEcosystemHealth a owl:ObjectProperty ;
    rdfs:label "supports ecosystem health" ;
    rdfs:comment "Indicates that a feature such as a water body contributes to ecosystem services." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range ffonto:EcosystemService .

ffonto:suppresses a owl:ObjectProperty ;
    rdfs:label "protects structure" ;
    rdfs:comment "A general relation indicating that an entity provides protection to another."@en ;
    rdfs:domain ffonto:HoseLine ;
    rdfs:range ffonto:StructureFire .

ffonto:threatenedByHazard a owl:ObjectProperty ;
    rdfs:label "threatened by hazard" ;
    rdfs:comment "Indicates responders or civilians are threatened by operational hazards." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:Hazard .

ffonto:threatens a owl:ObjectProperty ;
    rdfs:label "threatens" ;
    rdfs:comment "Who/what is threatened by a given hazard." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ffonto:Person ffonto:StructureFire ffonto:Animal ffonto:Infrastructure ) ] .

ffonto:threatensCommunity a owl:ObjectProperty ;
    rdfs:label "threatens community" ;
    rdfs:comment "Indicates that a hazard or event poses risk to a specific community."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Community .

ffonto:threatensFarmland a owl:ObjectProperty ;
    rdfs:label "threatens farmland" ;
    rdfs:comment "Indicates that a hazard or event poses risk to agricultural lands and production."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Farmland .

ffonto:threatensInfrastructure a owl:ObjectProperty ;
    rdfs:label "threatens infrastructure" ;
    rdfs:comment "Indicates that a hazard or event poses risk to built infrastructure."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Infrastructure .

ffonto:toolInUse a owl:ObjectProperty ;
    rdfs:label "tool in use" ;
    rdfs:comment "Denotes that a specific tool is currently being employed in an operation."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Tool .

ffonto:trainedThrough a owl:ObjectProperty ;
    rdfs:label "trained through" ;
    rdfs:comment "Specifies training programs attended by firefighters." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:TrainingProgram .

ffonto:trainedWith a owl:ObjectProperty ;
    rdfs:label "trained with method" ;
    rdfs:comment "Relates a machine learning model to the technique or data used for its training."@en ;
    rdfs:domain ffonto:MachineLearningModel ;
    rdfs:range ffonto:ModelTrainingTechnique .

ffonto:transitionsBetween a owl:ObjectProperty ;
    rdfs:label "transitions between ecosystems" ;
    rdfs:comment "Indicates that an ecosystem lies between two ecological zones." ;
    rdfs:domain ffonto:TransitionalEcosystem ;
    rdfs:range ffonto:Ecosystem .

ffonto:transitionsTo a owl:ObjectProperty ;
    rdfs:label "transitions to" ;
    rdfs:comment "Long-term land-cover or succession outcome following a fire event." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuccessionStage .

ffonto:triggeredByFireOf a owl:ObjectProperty ;
    rdfs:label "triggered by fire of" ;
    rdfs:comment "Inverse - Indicates that a seed release mechanism is activated by wildfire heat or fire conditions." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SeedReleaseMechanism .

ffonto:updatesModel a owl:ObjectProperty ;
    rdfs:label "updates model"@en ;
    rdfs:comment "Links incoming data, a revision process, or an observer to the computational model being refined with new information."@en ;
    rdfs:domain ffonto:DataAssimilation ;
    rdfs:range ffonto:FireBehavior .

ffonto:usedAsSafetyZone a owl:ObjectProperty ;
    rdfs:label "used as safety zone" ;
    rdfs:comment "Indicates that a road or area is being used as a safety zone or refuge location." ;
    rdfs:domain ffonto:Road ;
    rdfs:range ffonto:SafetyZone .

ffonto:usedAsWaterSourceOf a owl:ObjectProperty ;
    rdfs:label "used as water source of"@en ;
    rdfs:comment "Connects a natural body of water or municipal supply system to the specific incident or suppression effort drawing from it."@en ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:WaterBody .

ffonto:usedBy a owl:ObjectProperty ;
    rdfs:label "used by"@en ;
    rdfs:comment "Connects a resource, tool, tactic, or system to the specific agent, responder, or organization utilizing it."@en ;
    rdfs:domain ffonto:DataRepository ;
    rdfs:range ffonto:FireRiskAssessment .

ffonto:usedFor a owl:ObjectProperty ;
    rdfs:label "used for" ;
    rdfs:comment "A general-purpose relation indicating the intended use or function of an entity."@en ;
    rdfs:domain ffonto:Aircraft ;
    rdfs:range ffonto:FirefightingOperation .

ffonto:usedInSuppression a owl:ObjectProperty ;
    rdfs:label "used in suppression"@en ;
    rdfs:comment "Relates a tactic, resource, or chemical retardant to its active application in extinguishing or controlling a fire."@en ;
    rdfs:domain ffonto:WaterHose ;
    rdfs:range ffonto:SuppressionTactic .

ffonto:usedModel a owl:ObjectProperty ;
    rdfs:label "used model",
        "used model"@en ;
    rdfs:comment "Relates a forecast, analysis, or decision process to the specific simulation, mathematical framework, or AI deployed to generate it."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range ffonto:MLModel .

ffonto:usesAirCleaner a owl:ObjectProperty ;
    rdfs:label "uses air cleaner"@en ;
    rdfs:comment "Indicates that a facility, location, or operation utilizes a filtration device to improve local air quality."@en ;
    rdfs:domain ffonto:IndoorAirQualityStrategy ;
    rdfs:range ffonto:AirCleaner .

ffonto:usesDataFormat a owl:ObjectProperty ;
    rdfs:label "uses data format" ;
    rdfs:comment "Indicates the data format used to encode or exchange information."@en ;
    rdfs:domain ffonto:ForestFirePredictionModel ;
    rdfs:range ffonto:GeospatialDataFormat .

ffonto:usesDetectionMethod a owl:ObjectProperty ;
    rdfs:label "uses detection method" ;
    rdfs:comment "Indicates that a particular technique or sensor is used for detection tasks."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:DetectionMethod .

ffonto:usesEquipment a owl:ObjectProperty ;
    rdfs:label "uses equipment" ;
    rdfs:comment "Indicates that an operation or task makes use of specific equipment."@en ;
    rdfs:domain ffonto:EmergencyResponder ;
    rdfs:range ffonto:ProtectiveEquipment .

ffonto:usesGIS a owl:ObjectProperty ;
    rdfs:label "uses GIS" ;
    rdfs:comment "Denotes that geographic information systems are used for mapping or analysis."@en ;
    rdfs:domain ffonto:FireRiskAssessment ;
    rdfs:range ffonto:GISApplication .

ffonto:usesHomeHardeningOf a owl:ObjectProperty ;
    rdfs:label "uses home hardening of" ;
    rdfs:comment "Inverse - Indicates that a structure protection strategy uses home hardening techniques." ;
    rdfs:domain ffonto:HomeHardening ;
    rdfs:range ffonto:StructureProtection .

ffonto:usesHose a owl:ObjectProperty ;
    rdfs:label "uses hose" ;
    rdfs:comment "Indicates firefighters using hoses to apply water to fire." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:FireHose .

ffonto:usesMapBoard a owl:ObjectProperty ;
    rdfs:label "uses map board" ;
    rdfs:comment "Indicates a map board used during operational briefings." ;
    rdfs:domain ffonto:BriefingArea ;
    rdfs:range ffonto:MapBoard .

ffonto:usesModel a owl:ObjectProperty ;
    rdfs:label "use model" ;
    rdfs:comment "Indicates that an entity or process employs a specific model for analysis or prediction."@en ;
    rdfs:domain ffonto:ModelExecution ;
    rdfs:range ffonto:MLModel .

ffonto:usesProtectionMethod a owl:ObjectProperty ;
    rdfs:label "protects with" ;
    rdfs:comment "Links a HomeProtectionMeasure to tools or actions used to protect the home (e.g., wetting roof, sealing vents)." ;
    rdfs:domain ffonto:HomeProtectionMeasure ;
    rdfs:range ffonto:EvacuationAction .

ffonto:usesRadio a owl:ObjectProperty ;
    rdfs:label "uses radio"@en ;
    rdfs:comment "Links an entity, vehicle, or responder to the radio communication device, network, or frequency it utilizes."@en ;
    rdfs:domain ffonto:FirefightingResource ;
    rdfs:range ffonto:Radio .

ffonto:usesResource a owl:ObjectProperty ;
    rdfs:label "uses resource" ;
    rdfs:comment "Suppression assets assigned to the incident." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuppressionResource .

ffonto:usesSensor a owl:ObjectProperty ;
    rdfs:label "uses sensor"@en ;
    rdfs:comment "Indicates the sensor used for wildfire detection, monitoring, or analysis."@en ;
    rdfs:domain ffonto:ForestFirePredictionModel ;
    rdfs:range ffonto:RemoteSensingSensor .

ffonto:usesSuppressionMethod a owl:ObjectProperty ;
    rdfs:label "uses suppression method" ;
    rdfs:comment "Indicates reliance on a specific firefighting technique or tactic."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuppressionMethod .

ffonto:usesTechnology a owl:ObjectProperty ;
    rdfs:label "uses technology" ;
    rdfs:comment "Denotes that technology or technical systems are utilized within an activity."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ForestFireTechnology .

ffonto:usesVehicle a owl:ObjectProperty ;
    rdfs:label "uses vehicle" ;
    rdfs:comment "Indicates that firefighters operate or use a vehicle during firefighting." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:Vehicle .

ffonto:usesWaterSource a owl:ObjectProperty ;
    rdfs:label "uses water source" ;
    rdfs:comment "Indicates that a firefighting operation uses a water source." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range ffonto:WaterSource .

ffonto:utilityImplementsPSPS a owl:ObjectProperty ;
    rdfs:label "utility implements PSPS" ;
    rdfs:comment "References utility organizations that implement planned shutoffs." ;
    rdfs:domain ffonto:UtilityPowerShutoff ;
    rdfs:range owl:Thing .

ffonto:validatesData a owl:ObjectProperty ;
    rdfs:label "validates data"@en ;
    rdfs:comment "Indicates that a process, algorithm, or authority checks and confirms the accuracy or integrity of a specific dataset."@en ;
    rdfs:domain ffonto:QualityControlProcess ;
    rdfs:range ffonto:SatelliteData .

ffonto:visibleAircraft a owl:ObjectProperty ;
    rdfs:label "visible aircraft" ;
    rdfs:comment "Aircraft visible in camera frames." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range ffonto:Aircraft .

ffonto:wearsPPE a owl:ObjectProperty ;
    rdfs:label "wears protective equipment" ;
    rdfs:comment "Links firefighters to protective equipment they wear." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:PPE .

ffonto:workingNear a owl:ObjectProperty ;
    rdfs:label "working near" ;
    rdfs:comment "Indicates a responder group is operating near (or adjacent to) a structure." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:StructureFire .


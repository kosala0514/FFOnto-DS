    rdfs:comment "Indicates the act of constructing or establishing a fire control line."@en ;
    rdfs:domain ffonto:SuppressionMethod ;
    rdfs:range ffonto:Fireline .

ffonto:createsFuelLoad a owl:ObjectProperty ;

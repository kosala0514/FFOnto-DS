ffonto:assemblyAreaVisible a owl:DatatypeProperty ;
    rdfs:label "assembly area visible" ;
    rdfs:comment "Indicates presence of a designated gathering or assembly area for personnel or evacuees."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:assessesArea a owl:ObjectProperty ;
    rdfs:label "assesses area"@en ;
    rdfs:comment "Links an analytical process, human agent, or model to the specific geographic region it is evaluating for risk, damage, or fuel load."@en ;
    rdfs:domain ffonto:BAERAssessment ;
    rdfs:range ffonto:BurnSeverityMap ;
    owl:inverseOf ffonto:isAssessedBy .

ffonto:assessmentStep a owl:DatatypeProperty ;
    rdfs:label "assessment step" ;
    rdfs:comment "Steps used in the risk assessment workflow." ;
    rdfs:domain ffonto:FireRiskAssessment ;
    rdfs:range xsd:string .

ffonto:assignedLabelOf a owl:ObjectProperty ;
    rdfs:label "assigned label of" ;
    rdfs:comment "Inverse - Links a LabelAssignment to the Label assigned." ;
    rdfs:domain ffonto:PredictedLabel ;
    rdfs:range ffonto:LabelAssignment ;
    owl:inverseOf ffonto:assignedLabel .

ffonto:audioAttachedToInverse a owl:ObjectProperty ;
    rdfs:label "inverse of audio attached to"@en ;
    rdfs:comment "Inverse relation linking audio attachments back to the primary records or assets they are attached to."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:ImageAsset ffonto:ForestFire ) ] ;
    rdfs:range ffonto:AudioRecord ;
    owl:inverseOf ffonto:audioAttachedTo .

ffonto:audioClipCount rdfs:comment "A count of discrete audio clips associated with an event or dataset."@en .

ffonto:audioClipDurationS a owl:DatatypeProperty ;
    rdfs:label "audio clip duration (s)" ;
    rdfs:comment "Duration of the monitoring audio clip in seconds." ;

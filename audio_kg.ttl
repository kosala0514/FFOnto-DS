ffonto:EyeIrritation a ffonto:HealthEffect,
        ffonto:HealthSymptom ;
    rdfs:label "Eye Irritation" .

ffonto:FARSITE a ffonto:FireSimulationSoftware ;
    rdfs:label "FARSITE Fire Spread Model" ;
    ffonto:comment "Simulation system used to predict wildfire spread." .

ffonto:FEMA a owl:NamedIndividual ;
    rdfs:label "Federal Emergency Management Agency (FEMA)" ;
    ffonto:infoURL "https://www.fema.gov"^^xsd:anyURI ;

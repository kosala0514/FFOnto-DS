    rdfs:comment "An observation indicating visible flames, burn marks, or other indicators suggesting that a fire event is occurring." ;
    rdfs:subClassOf ffonto:ImageObservation .

ffonto:FireRiskMLModel a ffonto:MachineLearningModel ;
    rdfs:label "Fire Risk Prediction ML Model" ;
    ffonto:evaluatedBy ffonto:Precision ;
    ffonto:trainedWith ffonto:DataAugmentation ;
    ffonto:usesSensor ffonto:ThermalSensor .

ffonto:FireSeverityReduction a owl:Class ;
    rdfs:label "Fire Severity Reduction" ;

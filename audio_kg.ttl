    rdfs:comment "Actions or behaviors by people that may influence or indicate conditions in an area."@en ;
    rdfs:subClassOf ffonto:ForestFireRiskFactor .

ffonto:HumanExpertAssessment a ffonto:HumanEstimation ;
    rdfs:label "Human expert wildfire assessment" .

ffonto:Hydrocarbons a ffonto:SmokeComponent ;

    rdfs:subClassOf ffonto:Equipment .

ffonto:Drone a ffonto:FirefightingResource ;
    rdfs:label "Fire Monitoring Drone" ;
    rdfs:comment "Drone used to monitor wildfire spread and fuel conditions." .

ffonto:DroneFireMonitoring a ffonto:DroneMonitoring ;
    rdfs:label "ForestFire Drone Surveillance System" .

ffonto:DropImpactHigh a ffonto:ImpactHazard ;
    rdfs:label "Drop impact - high force" ;
    ffonto:dropForce 120.5 .

ffonto:Drought a owl:Class ;
    rdfs:label "Drought",
        "Drought Condition" ;

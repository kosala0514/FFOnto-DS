    rdfs:comment "Relates environmental conditions to increased wildfire risk." ;
    rdfs:domain ffonto:EnvironmentalCondition ;
    rdfs:range ffonto:FireBehavior .

ffonto:controlsAccess a owl:ObjectProperty ;
    rdfs:label "controls access" ;
    rdfs:comment "Indicates traffic control devices are used to control access on a road." ;
    rdfs:domain ffonto:TrafficControlDevice ;
    rdfs:range ffonto:Road .

ffonto:coversDamage a owl:ObjectProperty ;
    rdfs:label "covers damage" ;

ffonto:EquipmentUse a owl:Class ;
    rdfs:label "Equipment / Vehicle Use" ;
    rdfs:comment "The application or operation of equipment for a specific task or response activity."@en ;
    rdfs:subClassOf ffonto:HumanIgnition .

ffonto:ErosionSeedMix a ffonto:ErosionControl ;
    rdfs:label "Erosion Control Seed Mix" ;
    ffonto:recommendedAction "Use native grass species for rapid slope stabilization." .

ffonto:EvacuateBringDocs a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Take Important Documents and Kit" ;
    rdfs:comment "Bring waterproof/fireproof documents, go-kit with 5-7 days supplies if advised, medications, and pet supplies." .

ffonto:EvacuationBlockage a ffonto:InfrastructureRisk ;
    rdfs:label "Evacuation Route Blockage" .

ffonto:EvacuationOperation a owl:Class ;

ffonto:reportsStatisticFor a owl:ObjectProperty ;
    rdfs:label "reports statistic for"@en ;
    rdfs:comment "Relates a quantitative data point or statistical document to the specific incident or geographic region it describes."@en .

ffonto:representsPhysicalSystem a owl:ObjectProperty ;

    rdfs:subClassOf ffonto:EcologicalEffect .

ffonto:HandCrewLineConstruction a ffonto:FireSuppressionAction ;
    rdfs:label "Hand crew line construction" ;
    ffonto:hasSuppressionLimit ffonto:AccessTerrainLimit .

ffonto:HandTool a owl:Class ;

ffonto:ExtraCarKeys a ffonto:PreparednessItem ;
    rdfs:label "Extra Car Keys" ;
    rdfs:comment "Spare set of vehicle keys kept with go-kit." .

ffonto:ExtremeWeather a owl:Class ;
    rdfs:label "Extreme weather" ;
    rdfs:comment "Severe weather events affecting ecosystems." ;

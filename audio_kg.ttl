    rdfs:range xsd:string .

ffonto:ashContaminationLevel a owl:DatatypeProperty ;
    rdfs:label "ash contamination level"@en ;
    rdfs:comment "A human-readable or coded value describing the level of ash contamination (e.g. 'low', 'moderate', 'high', or measurement notes)."@en ;
    rdfs:domain ffonto:AgriculturalProduce ;
    rdfs:range xsd:string .

ffonto:ashDepositsVisible a owl:DatatypeProperty ;
    rdfs:label "ash deposits visible" ;
    rdfs:comment "Indicates whether ash drifts or deep ash deposits are visible." ;

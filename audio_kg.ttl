    rdfs:comment "Inverse relation linking vehicle damage records back to the incidents or hazards causing them."@en ;
    rdfs:domain ffonto:StructuralDamage ;
    rdfs:range ffonto:Vehicle ;
    owl:inverseOf ffonto:hasVehicleDamage .

ffonto:isVisionModelScoresOf a owl:ObjectProperty ;
    rdfs:label "has vision model scores",
        "is vision model scores of"@en ;
    rdfs:comment "Links a set of confidence ratings or classification metrics back to the specific computer vision model that output them."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range ffonto:ImageObservation ;
    owl:inverseOf ffonto:hasVisionModelScores .

ffonto:isWaterTankOf a owl:ObjectProperty ;
    rdfs:label "is water tank of" ;
    rdfs:comment "Inverse - Indicates a house having a rooftop water tank or cistern." ;
    rdfs:domain ffonto:WaterTank ;
    rdfs:range ffonto:House ;
    owl:inverseOf ffonto:hasWaterTank .

ffonto:isZoneOf a owl:ObjectProperty ;
    rdfs:label "inverse of is zone"@en ;
    rdfs:comment "Inverse relation linking zone classifications back to the areas or jurisdictions they apply to."@en ;
    rdfs:domain ffonto:DefensibleZone ;
    rdfs:range ffonto:DefensibleSpace ;
    owl:inverseOf ffonto:hasZone .

ffonto:issuesEvacuationWarningOf a owl:ObjectProperty ;
    rdfs:label "issues evacuation warning of"@en ;
    rdfs:comment "Connects an authority or system to the specific geographic area or incident requiring civilian evacuation."@en ;
    rdfs:domain ffonto:EvacuationZone ;
    rdfs:range ffonto:PublicWarningSystem ;
    owl:inverseOf ffonto:issuesEvacuationWarning .

ffonto:kitDurationDays a owl:DatatypeProperty ;
    rdfs:label "kit duration days" ;
    rdfs:comment "Recommended number of days the preparedness kit should sustain occupants." ;
    rdfs:domain ffonto:PreparednessKit ;
    rdfs:range xsd:integer .

ffonto:labelConfidence a owl:DatatypeProperty ;
    rdfs:label "label confidence",
        "label confidence"@en ;
    rdfs:comment "Indicates the statistical probability or subjective certainty that a specific annotation or tag is correct."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:decimal .

ffonto:labelCount a owl:DatatypeProperty ;
    rdfs:label "label count" ;
    rdfs:comment "Number of labels attached to an image record." ;
    rdfs:domain ffonto:ImageAsset ;
    rdfs:range xsd:integer .

ffonto:labelSeverity a owl:DatatypeProperty ;
    rdfs:label "label severity",
        "label severity"@en ;
    rdfs:comment "Indicates the level of intensity, danger, or urgency associated with a specific classification or alert."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:labelSourceLiteral a owl:DatatypeProperty ;
    rdfs:label "label source literal",
        "label source literal"@en ;
    rdfs:comment "Specifies the entity, system, or annotator responsible for generating a specific data tag, recorded as a text string."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:labelSourceOfOf a owl:ObjectProperty ;
    rdfs:label "inverse of label source of"@en ;
    rdfs:comment "Inverse relation linking label sources back to the entities or datasets they annotate."@en ;
    rdfs:domain ffonto:ModelProvenance ;
    rdfs:range ffonto:LabelAssignment ;
    owl:inverseOf ffonto:labelSourceOf .

ffonto:labelText a owl:DatatypeProperty ;
    rdfs:label "label text" ;
    rdfs:comment "Text of the label (e.g., 'high', 'smoke', 'fire')." ;
    rdfs:domain ffonto:PredictedLabel ;
    rdfs:range xsd:string .

ffonto:labelType a owl:DatatypeProperty ;
    rdfs:label "label type",
        "label type"@en ;
    rdfs:comment "Specifies the classification category or semantic nature of a given annotation or data tag."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:ladderFuelsMostlyGone a owl:DatatypeProperty ;
    rdfs:label "ladder fuels mostly gone" ;
    rdfs:comment "Indicates whether low branches and ladder fuels are mostly gone." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:landslideRiskVisible a owl:DatatypeProperty ;
    rdfs:label "landslide risk visible" ;
    rdfs:comment "Indicates whether landslide or rockfall risk is visible." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:leadsToEffectOf a owl:ObjectProperty ;
    rdfs:label "inverse of leads to effect"@en ;
    rdfs:comment "Inverse relation linking causal chains back to the effects they produce for specified targets."@en ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:leadsToEffect .

ffonto:leafLitterConsumed a owl:DatatypeProperty ;
    rdfs:label "leaf litter or duff consumed" ;
    rdfs:comment "Indicates whether leaf litter and duff were consumed by fire." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:boolean .

ffonto:licensePlateCondition a owl:DatatypeProperty ;
    rdfs:label "license plate condition" ;
    rdfs:comment "Condition of license plates (e.g., 'readable', 'warped', 'melted')." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:string .

ffonto:licenseText a owl:DatatypeProperty ;
    rdfs:label "license text",
        "license text"@en ;
    rdfs:comment "Provides the legal terms, attribution requirements, or usage rights string associated with a dataset or media asset."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:lifeThreateningForVehicles a owl:DatatypeProperty ;
    rdfs:label "situation life-threatening for vehicle occupants" ;
    rdfs:comment "Indicates whether vehicles are exposed to immediate life-threatening wildfire hazards." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:limitsFireSpreadOf a owl:ObjectProperty ;
    rdfs:label "limits fire spread of"@en ;
    rdfs:comment "Connects a physical barrier, weather event, or suppression tactic to the specific wildfire whose expansion it hinders."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:NaturalFirebreak ;
    owl:inverseOf ffonto:limitsFireSpread .

ffonto:liveFuelMoistureLiteral a owl:DatatypeProperty ;
    rdfs:label "live fuel moisture (description)" ;
    rdfs:comment "Descriptive assessment of live fuel moisture in dominant brush." ;
    rdfs:domain ffonto:FuelCondition ;
    rdfs:range xsd:string .

ffonto:livestockTrailerPresent a owl:DatatypeProperty ;
    rdfs:label "livestock trailer present" ;
    rdfs:comment "Indicates the presence of a trailer used for transporting livestock."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:locatedAt a owl:ObjectProperty ;
    rdfs:label "located at"@en ;
    rdfs:comment "Relates an event or physical phenomenon to the geographic place/entity where it occurs."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SpatialEntity ;
    owl:inverseOf ffonto:isLocationOf .

ffonto:locatedInWUIOf a owl:ObjectProperty ;
    rdfs:label "located in WUI of",
        "located in WUI of"@en ;
    rdfs:comment "Connects a structure, incident, or operation to the specific Wildland-Urban Interface zone where human development meets natural terrain."@en ;
    rdfs:domain ffonto:WildlandUrbanInterface ;
    rdfs:range ffonto:WUICommunity ;
    owl:inverseOf ffonto:locatedInWUI .

ffonto:locatedNearStructureOf a owl:ObjectProperty ;
    rdfs:label "located near structure of" ;
    rdfs:comment "Inverse - Indicates portable tanks positioned near buildings for firefighting." ;
    rdfs:domain ffonto:House ;
    rdfs:range ffonto:PortableTank ;
    owl:inverseOf ffonto:locatedNearStructure .

ffonto:locatedOf rdfs:comment "Inverse relation linking location assertions back to the features or entities located."@en .

ffonto:locatedfireOf a owl:ObjectProperty ;
    rdfs:label "located fire of"@en ;
    rdfs:comment "Connects a geospatial coordinate, containment zone, or geographical feature to the specific fire incident burning there."@en .

ffonto:loudActivityIndicatingEscalation a owl:DatatypeProperty ;
    rdfs:label "loud activity escalation" ;
    rdfs:comment "Indicates sustained loud activity suggesting hazard escalation." ;
    rdfs:domain ffonto:EmergencyActivity ;
    rdfs:range xsd:boolean .

ffonto:lowHumidityIncreasesIgnitionRisk a owl:DatatypeProperty ;
    rdfs:label "low humidity increases ignition risk" ;
    rdfs:comment "Indicates whether low relative humidity increases structure ignition risk." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:lowRelativeHumidity a owl:DatatypeProperty ;
    rdfs:label "low relative humidity" ;
    rdfs:comment "A condition of relatively low atmospheric moisture, increasing flammability of fuels."@en ;
    rdfs:domain ffonto:EnvironmentalCondition ;
    rdfs:range xsd:boolean .

ffonto:madeObservation a owl:ObjectProperty ;
    rdfs:label "made observation"@en ;
    rdfs:comment "Relates a sensor to an observation it performed."@en ;
    rdfs:domain sosa:Sensor ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:isObservedBySensor .

ffonto:mailboxScorched a owl:DatatypeProperty ;
    rdfs:label "mailbox scorched" ;
    rdfs:comment "Whether a mailbox appears scorched or burned." ;
    rdfs:domain ffonto:Mailbox ;
    rdfs:range xsd:boolean .

ffonto:managedBySection a owl:ObjectProperty ;
    rdfs:label "managed by section"@en ;
    rdfs:comment "Links a forest fire to the specific Incident Command Section managing its response."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:IncidentCommandSection ;
    owl:inverseOf ffonto:managesFireEvent .

ffonto:managedByStrategyOf a owl:ObjectProperty ;
    rdfs:label "managed by strategy of" ;
    rdfs:comment "Inverse - Indicates which fire management strategies are used to control fire behavior." ;
    rdfs:domain ffonto:FireManagementStrategy ;
    rdfs:range ffonto:FireBehavior ;
    owl:inverseOf ffonto:managedByStrategy .

ffonto:managedOf a owl:ObjectProperty ;
    rdfs:label "managed of",
        "managed of"@en ;
    rdfs:comment "Relates an overseen incident, resource, or operational phase back to the commanding entity or agency responsible for it."@en ;
    rdfs:domain ffonto:ResponseOrganization ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:managedBy .

ffonto:managesAirspace a owl:ObjectProperty ;
    rdfs:label "manages airspace"@en ;
    rdfs:comment "Relates an air traffic control entity, tactical supervisor, or system to the designated flight zone it regulates."@en ;
    rdfs:domain ffonto:AirspaceManagement ;
    rdfs:range ffonto:Airspace ;
    owl:inverseOf ffonto:isManagedBy .

ffonto:managesIncidentOf a owl:ObjectProperty ;
    rdfs:label "manages incident of"@en ;
    rdfs:comment "Relates a command structure, software platform, or administrative section to the specific emergency event it controls."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:IncidentCommand ;
    owl:inverseOf ffonto:managesIncident .

ffonto:managesPropaneTankOf a owl:ObjectProperty ;
    rdfs:label "manages propane tank of" ;
    rdfs:comment "Inverse - Indicates recommended management procedures for propane tanks." ;
    rdfs:domain ffonto:PropaneTank ;
    rdfs:range ffonto:RecoveryGuideline ;
    owl:inverseOf ffonto:managesPropaneTank .

ffonto:mapBoardVisible a owl:DatatypeProperty ;
    rdfs:label "map board visible" ;
    rdfs:comment "Indicates whether a briefing map board is visible at the staging area." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:mapUpdateFrequency a owl:DatatypeProperty ;
    rdfs:label "map update frequency" ;
    rdfs:comment "How frequently wildfire risk maps are updated." ;
    rdfs:domain ffonto:FireRiskMap ;
    rdfs:range xsd:string .

ffonto:mayCauseIgnitionOf a owl:ObjectProperty ;
    rdfs:label "may cause ignition of"@en ;
    rdfs:comment "Indicates the potential for a heat source, event, or material to start a fire in a specific target or environment."@en ;
    rdfs:domain ffonto:IgnitionSource ;
    rdfs:range ffonto:PowerInfrastructureFailure ;
    owl:inverseOf ffonto:mayCauseIgnition .

ffonto:mayIgniteOf a owl:ObjectProperty ;
    rdfs:label "may ignite of"@en ;
    rdfs:comment "Indicates the potential relationship between a heat source (like an ember) and the specific combustible target material it could set on fire."@en ;
    rdfs:domain ffonto:IgnitionSource ;
    rdfs:range ffonto:FarmEquipment ;
    owl:inverseOf ffonto:mayIgnite .

ffonto:mcleodInUse a owl:DatatypeProperty ;
    rdfs:label "McLeod (rake/hoe) in use" ;
    rdfs:comment "Indicates that a McLeod tool (hand tool for clearing) is currently being used."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:measuredOf a owl:ObjectProperty ;
    rdfs:label "measured of"@en ;
    rdfs:comment "Relates a recorded value, statistic, or qualitative observation back to the specific entity, area, or phenomenon that was analyzed."@en ;
    rdfs:domain ffonto:SatelliteData ;
    rdfs:range ffonto:FireRadiativePower ;
    owl:inverseOf ffonto:measuredFrom .

ffonto:measuresPollution a owl:ObjectProperty ;
    rdfs:label "measures pollution"@en ;
    rdfs:comment "Indicates that a device, system, or observation process quantifies the concentration of contaminants or particulates in the environment."@en ;
    rdfs:domain ffonto:AirQualityIndex ;
    rdfs:range ffonto:ParticulateMatterPM25 ;
    owl:inverseOf ffonto:isMeasuredByAQI .

ffonto:mediaKeptAtDistance a owl:ObjectProperty ;
    rdfs:label "media kept at distance" ;
    rdfs:comment "Indicates media/observers are held at a safe distance by responders." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:MediaGroup ;
    owl:inverseOf ffonto:mediaKeptAtDistanceOf .

ffonto:mediaKeptSafeDistance a owl:DatatypeProperty ;
    rdfs:label "media/observers kept at safe distance" ;
    rdfs:comment "Indicates whether media personnel are maintaining a recommended safety distance."@en ;
    rdfs:domain ffonto:MediaGroup ;
    rdfs:range xsd:boolean .

ffonto:mediaURI a owl:DatatypeProperty ;
    rdfs:label "media uri" ;
    rdfs:comment "The URI pointing to a digital media file (image an daudio) that captures or supports the observation." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:medicalUnitsStaged a owl:DatatypeProperty ;
    rdfs:label "medical/EMS units staged visibly" ;
    rdfs:comment "Indicates that medical response units are positioned and ready for deployment."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:meteorologicalVariableAffectsRateOfSpread a owl:ObjectProperty ;
    rdfs:label "meteorological variable affects rate of spread"@en ;
    rdfs:comment "Links weather-related data, such as wind velocity or relative humidity, to its direct impact on how rapidly a fire perimeter expands."@en .

ffonto:meterBoxBurned a owl:DatatypeProperty ;
    rdfs:label "meter box burned" ;
    rdfs:comment "Indicates whether a meter box on a building appears burned." ;
    rdfs:domain ffonto:MeterBox ;
    rdfs:range xsd:boolean .

ffonto:mineralSoilExposed a owl:DatatypeProperty ;
    rdfs:label "mineral soil exposed" ;
    rdfs:comment "Indicates whether mineral soil is exposed due to duff consumption." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:boolean .

ffonto:mitigatedOf a owl:ObjectProperty ;
    rdfs:label "inverse of mitigated by"@en ;
    rdfs:comment "Inverse relation linking mitigated risks or impacts back to the mitigation measures applied."@en ;
    rdfs:domain ffonto:ProtectiveAction ;
    rdfs:range ffonto:Hazard ;
    owl:inverseOf ffonto:mitigatedBy .

ffonto:mitigatesAirPollution a owl:ObjectProperty ;
    rdfs:label "mitigates air pollution"@en ;
    rdfs:comment "Relates an air quality mitigation strategy to the specific air pollution metric it addresses."@en ;
    rdfs:domain ffonto:AirQualityMitigationStrategy ;
    rdfs:range ffonto:AirPollutionMetric ;
    owl:inverseOf ffonto:isMitigatedByStrategy .

ffonto:mitigatesRiskOf a owl:ObjectProperty ;
    rdfs:label "inverse of mitigates risk"@en ;
    rdfs:comment "Inverse relation linking mitigation measures to the risks they reduce for specific targets."@en ;
    rdfs:domain ffonto:FireRiskAssessment ;
    rdfs:range owl:Thing ;
    owl:inverseOf ffonto:mitigatesRisk .

ffonto:modality a owl:DatatypeProperty ;
    rdfs:label "modality" ;
    rdfs:comment "Record modality such as Image, Audio, or tabular/weather." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:modalityConflict a owl:DatatypeProperty ;
    rdfs:label "modality conflict present" ;
    rdfs:comment "Indicates conflicting information between different data modalities (e.g., audio vs. imagery)."@en ;
    rdfs:domain ffonto:ModalityConsistency ;
    rdfs:range xsd:boolean .

ffonto:modelName a owl:DatatypeProperty ;
    rdfs:label "model name"@en ;
    rdfs:comment "Specifies the formal, human-readable designation or title of a computational, predictive, or AI model."@en ;
    rdfs:domain ffonto:MLModel ;
    rdfs:range xsd:string .

ffonto:modelOf a owl:ObjectProperty ;
    rdfs:label "model of" ;
    rdfs:comment "inverse of use model" ;
    rdfs:domain ffonto:MLModel ;
    rdfs:range ffonto:VisionModelScores ;
    owl:inverseOf ffonto:usedModel .

ffonto:modelRepoUrl a owl:DatatypeProperty ;
    rdfs:label "model repository / provenance URL" ;
    rdfs:comment "URL to model repository or TF-Hub page used for provenance." ;
    rdfs:domain ffonto:ModelProvenance ;
    rdfs:range xsd:string .

ffonto:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version"@en ;
    rdfs:comment "Indicates the specific iteration, release number, or update stage of a software or analytical model."@en ;
    rdfs:domain ffonto:MLModel ;
    rdfs:range xsd:string .

ffonto:modelVersionsRecorded a owl:DatatypeProperty ;
    rdfs:label "model versions recorded?" ;
    rdfs:comment "Whether model versions are recorded for audit." ;
    rdfs:domain ffonto:ModelProvenance ;
    rdfs:range xsd:boolean .

ffonto:modeledOf a owl:ObjectProperty ;
    rdfs:label "modeled of" ;
    rdfs:comment "Inverse - Link from incident/image to a probability model producing fire probability." ;
    rdfs:domain ffonto:FireProbabilityModel ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:modeledBy .

ffonto:modifiesSoilConditionOf a owl:ObjectProperty ;
    rdfs:label "inverse of modifies soil condition"@en ;
    rdfs:comment "Inverse relation linking soil modification actions back to the locations or projects they affect."@en ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:modifiesSoilCondition .

ffonto:monitoredOf a owl:ObjectProperty ;
    rdfs:label "inverse of monitored by"@en ;
    rdfs:comment "Inverse relation linking monitoring records back to the objects or sites monitored."@en ;
    rdfs:domain ffonto:RemoteSensing ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:monitoredBy .

ffonto:monitoredUsingInverse a owl:ObjectProperty ;
    rdfs:label "inverse of monitored using"@en ;
    rdfs:comment "Inverse relation linking monitoring methods back to the systems or sites they monitor."@en ;
    rdfs:domain ffonto:RemoteSensingSensor ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:monitoredUsing .

ffonto:monitorsAirspaceOf a owl:ObjectProperty ;
    rdfs:label "monitors airspace of"@en ;
    rdfs:comment "Indicates that a system or entity is observing the aerial zone above a specific location or incident."@en ;
    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:AirspaceConflictDetection ;
    owl:inverseOf ffonto:monitorsAirspace .

ffonto:monitorsInfrastructureOf a owl:ObjectProperty ;
    rdfs:label "inverse of monitors infrastructure"@en ;
    rdfs:comment "Inverse relation linking infrastructure monitoring activities back to the organizations or systems responsible."@en ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:monitorsInfrastructure .

ffonto:monitorsModel a owl:ObjectProperty ;
    rdfs:label "monitors model"@en ;
    rdfs:comment "Connects a governance framework, overarching system, or human operator to the AI or simulation model being overseen."@en ;
    rdfs:domain ffonto:ModelMonitoring ;
    rdfs:range ffonto:FireBehaviorModel ;
    owl:inverseOf ffonto:isModelMonitoredBy .

ffonto:monitorsSystem a owl:ObjectProperty ;
    rdfs:label "monitors system"@en ;
    rdfs:comment "Links an oversight framework, human agent, or diagnostic software to the specific operational or IT system it observes."@en ;
    rdfs:domain ffonto:CanaryDeployment ;
    rdfs:range ffonto:DecisionSupportSystem ;
    owl:inverseOf ffonto:isSystemMonitoredBy .

ffonto:multipleAircraftOperating a owl:DatatypeProperty ;
    rdfs:label "multiple aircraft operating simultaneously" ;
    rdfs:comment "Indicates presence of multiple aircraft actively engaged in operations."@en ;
    rdfs:domain ffonto:AircraftAction ;
    rdfs:range xsd:boolean .

ffonto:multipleFireClusters a owl:DatatypeProperty ;
    rdfs:label "multiple fire clusters present" ;
    rdfs:comment "The occurrence of more than one spatially separated area of active burning."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range xsd:boolean .

ffonto:multipleSmokeLayers a owl:DatatypeProperty ;
    rdfs:label "multiple smoke layers present" ;
    rdfs:comment "Indicates if multiple distinct vertical smoke layers are visible." ;
    rdfs:domain ffonto:SmokeLayerObservation ;
    rdfs:range xsd:boolean .

ffonto:mustFollowGuideline a owl:ObjectProperty ;
    rdfs:label "must follow guideline"@en ;
    rdfs:comment "Inverse - Links a wildfire scene to the hazardous waste guidelines that apply to it post-fire." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:HazardousWasteGuideline ;
    owl:inverseOf ffonto:isApplicableToScene .

ffonto:needlesBrownedAttached a owl:DatatypeProperty ;
    rdfs:label "needles/leaves browned but still attached" ;
    rdfs:comment "Indicates whether foliage is browned but still attached to branches." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:nightOperationsGearVisible a owl:DatatypeProperty ;
    rdfs:label "night operations gear visible" ;
    rdfs:comment "Indicates whether responders wear headlamps or night-operations gear." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:nomexClothingVisible a owl:DatatypeProperty ;
    rdfs:label "Nomex fire-resistant clothing visible" ;
    rdfs:comment "Indicates whether firefighters wear Nomex or fire-resistant suits." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:nozzleActivelyFlowing a owl:DatatypeProperty ;
    rdfs:label "nozzle actively flowing water/foam" ;
    rdfs:comment "Indicates that a fire hose nozzle is actively discharging water or suppressant."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:numberOfFlameFronts a owl:DatatypeProperty ;
    rdfs:label "number of flame fronts" ;
    rdfs:comment "Count of distinct flame fronts visible in the frame." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:integer .

ffonto:observedAt a owl:DatatypeProperty ;
    rdfs:label "observed at" ;
    rdfs:comment "Timestamp for the image observation." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:dateTime .

ffonto:observedAtLocationOf a owl:ObjectProperty ;
    rdfs:label "inverse of observed at location"@en ;
    rdfs:comment "Inverse relation linking observations back to the locations where they were recorded."@en ;
    rdfs:domain ffonto:Location ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:observedAtLocation .

ffonto:observedInImageOf a owl:ObjectProperty ;
    rdfs:label "inverse of observed in image"@en ;
    rdfs:comment "Inverse relation linking observations to the images in which they were detected."@en ;
    rdfs:domain owl:WildfireScene ;
    rdfs:range ffonto:ImageObservation ;
    owl:inverseOf ffonto:observedInImage .

ffonto:observedPropertyOf a owl:ObjectProperty ;
    rdfs:label "observed property of" ;
    rdfs:comment "Inverse of observed property." ;
    rdfs:domain ffonto:ObservableProperty ;
    rdfs:range ffonto:Result ;
    owl:inverseOf ffonto:observedProperty .

ffonto:observesProperty a owl:ObjectProperty ;
    rdfs:label "observes property"@en ;
    rdfs:comment "Links a sensor, platform, or observation act to the specific physical or chemical characteristic it measures."@en .

ffonto:occurs a owl:ObjectProperty ;
    rdfs:label "occurs" ;
    rdfs:comment "Inverse - Specifies the forest ecosystem where a fire event takes place." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:occursIn .

ffonto:occursAtLocation a owl:ObjectProperty ;
    rdfs:label "occurs at location"@en ;
    rdfs:comment "Relates an incident, observation, or action to the specific geospatial coordinates or boundary area where it takes place."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range geo:SpatialObject ;
    owl:inverseOf ffonto:locationOfEvent .

ffonto:occursDuring a owl:ObjectProperty ;
    rdfs:label "occurs during"@en ;
    rdfs:comment "A temporal relationship linking an event or action to the timeframe or larger incident in which it happens."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:OperationalPeriod ;
    owl:inverseOf ffonto:isOperationalPeriodOf .

ffonto:occursForPurposeOf a owl:ObjectProperty ;
    rdfs:label "inverse of occurs for purpose"@en ;
    rdfs:comment "Inverse relation linking activities to the purposes for which they occur."@en ;
    rdfs:domain ffonto:LandClearing ;
    rdfs:range ffonto:IntentionalFire ;
    owl:inverseOf ffonto:occursForPurpose .

ffonto:occursInArea a owl:ObjectProperty ;
    rdfs:label "occurs in area"@en ;
    rdfs:comment "Connects an event, operation, or incident to its specific geospatial location or physical boundary."@en ;
    rdfs:domain ffonto:DebrisFlowRisk ;
    rdfs:range geo:SpatialObject ;
    owl:inverseOf ffonto:hasDebrisFlowRisk .

ffonto:occursInEcosystem a owl:ObjectProperty ;
    rdfs:label "occurs in ecosystem"@en ;
    rdfs:comment "Relates specific vegetation back to the forest ecosystem it inhabits."@en ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:ForestEcosystem ;
    owl:inverseOf ffonto:hasVegetation .

ffonto:occursInSceneOf rdfs:comment "Inverse relation linking scene occurrences back to the events or objects within those scenes."@en .

ffonto:occursInTerrainOf a owl:ObjectProperty ;
    rdfs:label "inverse of occurs in terrain"@en ;
    rdfs:comment "Inverse relation linking occurrences to the terrain types where they take place."@en ;
    rdfs:domain ffonto:ForestTerrain ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:occursInTerrain .

ffonto:occursInWatershedOf a owl:ObjectProperty ;
    rdfs:label "occurs in watershed of" ;
    rdfs:comment "Inverse - Indicates the watershed where runoff flows and accumulates." ;
    rdfs:domain ffonto:Watershed ;
    rdfs:range ffonto:Runoff ;
    owl:inverseOf ffonto:occursInWatershed .

ffonto:onFlankOf a owl:ObjectProperty ;
    rdfs:label "inverse of on flank"@en ;
    rdfs:comment "Inverse relation linking flank-location descriptors back to the fire incidents or stretches they describe."@en ;
    rdfs:domain rdfs:Literal ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:onFlank .

ffonto:opacity a owl:DatatypeProperty ;
    rdfs:label "opacity",
        "opacity"@en ;
    rdfs:comment "Quantifies the degree to which an emission, such as a smoke plume, obscures visibility or blocks light transmission."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:operatesAtSceneOf a owl:ObjectProperty ;
    rdfs:label "operates at scene of" ;
    rdfs:comment "Inverse - Links responders or vehicles to the wildfire scene where they operate." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:operatesAtScene .

ffonto:operatesEquipmentOf a owl:ObjectProperty ;
    rdfs:label "inverse of operates equipment"@en ;
    rdfs:comment "Inverse relation indicating which agent or unit operates particular equipment."@en ;
    rdfs:domain ffonto:Equipment ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:operatesEquipment .

ffonto:operatesFromFacility a owl:ObjectProperty ;
    rdfs:label "operates from facility"@en ;
    rdfs:comment "Links an Incident Command Section to the physical emergency facility (e.g., basecamp) it operates from."@en ;
    rdfs:domain ffonto:IncidentCommandSection ;
    rdfs:range ffonto:EmergencyFacility ;
    owl:inverseOf ffonto:isFacilityOperatedBy .

ffonto:operatingInLine a owl:DatatypeProperty ;
    rdfs:label "operating in line formation" ;
    rdfs:comment "Indicates firefighters operating shoulder-to-shoulder." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:outrunWildfireGuidance a owl:DatatypeProperty ;
    rdfs:label "can you outrun a wildfire guidance" ;
    rdfs:comment "Guidance describing actions if a vehicle or person cannot escape an approaching fire."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:overheadCablesSagging a owl:DatatypeProperty ;
    rdfs:label "overhead cables sagging" ;
    rdfs:comment "Indicates whether overhead cables are sagging from heat." ;
    rdfs:domain ffonto:PowerLine ;
    rdfs:range xsd:boolean .

ffonto:overheadPowerlinesOverRoute a owl:DatatypeProperty ;
    rdfs:label "powerlines over evacuation route" ;
    rdfs:comment "Indicates whether powerlines cross evacuation routes." ;
    rdfs:domain ffonto:PowerInfrastructure ;
    rdfs:range xsd:boolean .

ffonto:parkingLotSurfaceDamaged a owl:DatatypeProperty ;
    rdfs:label "parking lot surface damaged" ;
    rdfs:comment "Indicates whether parking lot surfaces are blackened or cracked." ;
    rdfs:domain ffonto:Roadway ;
    rdfs:range xsd:boolean .

ffonto:partOfBuildingOf a owl:ObjectProperty ;
    rdfs:label "inverse of part of building"@en ;
    rdfs:comment "Inverse relation linking building component records back to the parent building they belong to."@en ;
    rdfs:domain ffonto:Building ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ffonto:Chimney ffonto:MeterBox ) ] ;
    owl:inverseOf ffonto:partOfBuilding .

ffonto:partOfFire a owl:ObjectProperty ;
    rdfs:label "part of fire"@en ;
    rdfs:comment "Relates a specific zone, such as a flank or head, or a secondary ignition to the primary wildfire incident."@en ;
    rdfs:domain ffonto:FireFlank ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasFireFlank .

ffonto:partOfIncidentCommandOf a owl:ObjectProperty ;
    rdfs:label "part of incident command of"@en ;
    rdfs:comment "Links a role, section, or individual within the Incident Command System to the specific emergency event they are managing."@en ;
    rdfs:domain ffonto:IncidentCommand ;
    rdfs:range ffonto:Branch ;
    owl:inverseOf ffonto:partOfIncidentCommand .

ffonto:partOfWildfire a owl:ObjectProperty ;
    rdfs:label "part of wildfire"@en ;
    rdfs:comment "Connects a distinct spatial zone (like a flank or spot fire) or temporal phase to the overarching natural fire incident."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasFireFront .

ffonto:particulateConcentration a owl:DatatypeProperty ;
    rdfs:label "particulate concentration" ;
    rdfs:comment "Represents the concentration of particulate matter in the air pollution measurement." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range xsd:float .

ffonto:particulateLevel a owl:DatatypeProperty ;
    rdfs:label "particulate level"@en ;
    rdfs:comment "The measured concentration of airborne particulate matter present in the atmosphere."@en ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range xsd:float .

ffonto:patioFurnitureBurned a owl:DatatypeProperty ;
    rdfs:label "patio furniture burned" ;
    rdfs:comment "Indicates whether patio furniture or outdoor items appear burned." ;
    rdfs:domain ffonto:OutdoorItems ;
    rdfs:range xsd:boolean .

ffonto:patioFurnitureMelted a owl:DatatypeProperty ;
    rdfs:label "patio furniture melted" ;
    rdfs:comment "Indicates whether patio furniture or plastic outdoor items melted from heat." ;
    rdfs:domain ffonto:OutdoorItems ;
    rdfs:range xsd:boolean .

ffonto:patrollingPerimeter a owl:DatatypeProperty ;
    rdfs:label "patrolling perimeter" ;
    rdfs:comment "Indicates firefighters walking along the fire perimeter." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:peopleCongregatingAtAssemblyPoint a owl:DatatypeProperty ;
    rdfs:label "people congregating at designated assembly point" ;
    rdfs:comment "Indicates that people are gathering at a designated assembly or rendezvous point."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:peopleEvacuating a owl:DatatypeProperty ;
    rdfs:label "people evacuating" ;
    rdfs:comment "An observation that people are in the process of leaving an area due to an emergency."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:peopleVisible a owl:DatatypeProperty ;
    rdfs:label "people visible" ;
    rdfs:comment "Indicates that people are observable in imagery or reports for situational awareness."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:peopleWearingMasks a owl:DatatypeProperty ;
    rdfs:label "people wearing masks" ;
    rdfs:comment "Observation that individuals are using masks, often for smoke or particulate protection."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:performingMopUp a owl:DatatypeProperty ;
    rdfs:label "performing mop-up" ;
    rdfs:comment "Indicates mop-up operations such as stirring and soaking hotspots." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range xsd:boolean .

ffonto:performsOperationOf a owl:ObjectProperty ;
    rdfs:label "performs operation of" ;
    rdfs:comment "Inverse - Relates a firefighter to an operation they perform." ;
    rdfs:domain ffonto:EmergencyOperation ;
    rdfs:range ffonto:EmergencyResponder ;
    owl:inverseOf ffonto:performsOperation .

ffonto:performsSuppressionOf a owl:ObjectProperty ;
    rdfs:label "performs suppression action of" ;
    rdfs:comment "Inverse - Indicates that responders perform a suppression activity." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:performsSuppression .

ffonto:performsTaskOf a owl:ObjectProperty ;
    rdfs:label "performs CV task of",
        "performs task of"@en ;
    rdfs:comment "Connects a specific action, duty, or assignment back to the operational role, team, or agent executing it."@en ;
    rdfs:domain ffonto:ComputerVisionTask ;
    rdfs:range ffonto:MachineLearningModel ;
    owl:inverseOf ffonto:performsTask .

ffonto:perimeterEstablished a owl:DatatypeProperty ;
    rdfs:label "perimeter established by responders" ;
    rdfs:comment "Indicates that a control or safety perimeter has been set up around an incident area."@en ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:personAssistingOthers a owl:DatatypeProperty ;
    rdfs:label "person assisting children/elderly" ;
    rdfs:comment "Observation that an individual is actively helping others during an event."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "phone number" ;
    rdfs:comment "Contact phone number." ;
    rdfs:domain ffonto:Contact ;
    rdfs:range xsd:string .

ffonto:pilotNavigationRisk a owl:DatatypeProperty ;
    rdfs:label "smoke risk for pilot navigation" ;
    rdfs:comment "Indicates whether smoke affects pilot navigation and visibility." ;
    rdfs:domain ffonto:AerialVehicle ;
    rdfs:range xsd:boolean .

ffonto:placeName a owl:DatatypeProperty ;
    rdfs:label "place name" ;
    rdfs:comment "Name of the place." ;
    rdfs:domain ffonto:SpatialEntity ;
    rdfs:range xsd:string .

ffonto:plansAerialDrop a owl:ObjectProperty ;
    rdfs:label "plans aerial drop"@en ;
    rdfs:comment "Connects an operational strategy or command role to the scheduled deployment of retardant or water from an aircraft."@en ;
    rdfs:domain ffonto:AerialDropPlanning ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:isPlannedByAerialDrop .

ffonto:portablePumpPlacedNearWaterSource a owl:DatatypeProperty ;
    rdfs:label "portable pump placed near water source" ;
    rdfs:comment "Indicates placement of a portable pump adjacent to a water source for supply operations."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:portableTankSetup a owl:DatatypeProperty ;
    rdfs:label "portable tank setup" ;
    rdfs:comment "Indicates whether portable tanks are set up near structures." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:posesHealthRiskOf a owl:ObjectProperty ;
    rdfs:label "inverse of poses health risk"@en ;
    rdfs:comment "Inverse relation linking posed health risks back to the hazardous source or condition."@en ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:posesHealthRisk .

ffonto:positionedBetweenFireAndStructureFire a owl:DatatypeProperty ;
    rdfs:label "positioned between fire and structure" ;
    rdfs:comment "Indicates a resource or barrier placed between a fire and a structure to protect it."@en ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:positionedBetweenOf a owl:ObjectProperty ;
    rdfs:label "positioned between" ;
    rdfs:comment "Inverse - Resources placed between fire and a structure to protect it." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:positionedBetween .

ffonto:postFireHazards a owl:DatatypeProperty ;
    rdfs:label "hazards in recently burned areas" ;
    rdfs:comment "Hazards that emerge after a fire, such as unstable trees, ash pits, or erosion."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code of a city or region." ;
    rdfs:domain ffonto:SpatialEntity ;
    rdfs:range xsd:string .

ffonto:powerLinesDown a owl:DatatypeProperty ;
    rdfs:label "power lines down" ;
    rdfs:comment "Indicates whether overhead electrical wires are visibly downed." ;
    rdfs:domain ffonto:PowerLine ;
    rdfs:range xsd:boolean .

ffonto:powerPoleBaseCharred a owl:DatatypeProperty ;
    rdfs:label "power pole base charred" ;
    rdfs:comment "Indicates whether the base of a power pole is charred." ;
    rdfs:domain ffonto:PowerPole ;
    rdfs:range xsd:boolean .

ffonto:powerPoleDamaged a owl:DatatypeProperty ;
    rdfs:label "power pole damaged or on fire" ;
    rdfs:comment "Indicates visible damage to an electrical power pole that may affect services or safety."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:powerShutoffPossibility a owl:DatatypeProperty ;
    rdfs:label "can power shutoffs occur during extreme fire weather" ;
    rdfs:comment "The potential for intentional power shutdowns to reduce ignition risk."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:powerlineArcing a owl:DatatypeProperty ;
    rdfs:label "powerline arcing detected" ;
    rdfs:comment "Indicates whether electrical powerlines are producing sparks or arcing." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:powerlineDown a owl:DatatypeProperty ;
    rdfs:label "powerline down" ;
    rdfs:comment "Indicates whether powerlines are down and potentially hazardous." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:powerlinesArcingOrDowned a owl:DatatypeProperty ;
    rdfs:label "powerlines arcing or downed" ;
    rdfs:comment "Indicates whether powerlines show sparks, arcing or are downed." ;
    rdfs:domain ffonto:PowerInfrastructure ;
    rdfs:range xsd:boolean .

ffonto:powerlinesVisible a owl:DatatypeProperty ;
    rdfs:label "powerlines visible" ;
    rdfs:comment "Observation that overhead powerlines are present and observable in imagery or reports."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:practicesOf a owl:ObjectProperty ;
    rdfs:label "inverse of practices"@en ;
    rdfs:comment "Inverse relation linking practices back to the programs, communities, or agencies that implement them."@en ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:EvacuationDrill ;
    owl:inverseOf ffonto:practices .

ffonto:precipitation a owl:DatatypeProperty ;
    rdfs:label "precipitation" ;
    rdfs:comment "Daily accumulated precipitation in millimeters (mm)." ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range xsd:decimal .

ffonto:predictsFireSpread a owl:ObjectProperty ;
    rdfs:label "predicts fire spread"@en ;
    rdfs:comment "Links a computational model, simulation, or analytical process to its forecast of how a fire perimeter will expand."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:isPredictedByModel .

ffonto:predictsSmokePlumeOf a owl:ObjectProperty ;
    rdfs:label "predicts smoke plume of"@en ;
    rdfs:comment "Connects a computational model or forecast to the specific wildfire whose particulate emissions and dispersion it estimates."@en ;
    rdfs:domain ffonto:SmokePlume ;
    rdfs:range ffonto:SmokeDispersionModel ;
    owl:inverseOf ffonto:predictsSmokePlume .

ffonto:preparedForZone a owl:ObjectProperty ;
    rdfs:label "prepared for zone"@en ;
    rdfs:comment "Connects a mitigation plan, resource cache, or community strategy to the specific geographic area it is designed to protect."@en ;
    rdfs:domain ffonto:ReadySetGoPlan ;
    rdfs:range ffonto:EvacuationZone ;
    owl:inverseOf ffonto:hasPreparednessPlan .

ffonto:prioritizesOf a owl:ObjectProperty ;
    rdfs:label "inverse of prioritizes"@en ;
    rdfs:comment "Inverse relation linking prioritization decisions back to the plans or authorities that set them."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:ResourcePrioritization ;
    owl:inverseOf ffonto:prioritizes .

ffonto:privateCarsPresent a owl:DatatypeProperty ;
    rdfs:label "private cars present" ;
    rdfs:comment "Observation that privately owned vehicles are present at a scene or location."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:processedByPlatform a owl:ObjectProperty ;
    rdfs:label "processed by platform"@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:ComputingPlatform .

ffonto:processesCloudCover a owl:ObjectProperty ;
    rdfs:label "processes cloud cover"@en ;
    rdfs:comment "Relates an atmospheric transport model to the cloud cover quality data it processes."@en ;
    rdfs:domain ffonto:AtmosphericTransportModel ;
    rdfs:range ffonto:CloudCoverQuality ;
    owl:inverseOf ffonto:isCloudCoverProcessedBy .

ffonto:produceSafeToEat a owl:DatatypeProperty ;
    rdfs:label "produce safe to eat"@en ;
    rdfs:comment "Indicates whether the agricultural produce is considered safe for consumption (true/false) after contamination assessment."@en ;
    rdfs:domain ffonto:AgriculturalProduce ;
    rdfs:range xsd:boolean .

ffonto:producedByFire a owl:ObjectProperty ;
    rdfs:label "produced by fire"@en ;
    rdfs:comment "Relates an emission, physical artifact (like ash), or environmental impact to the specific combustion event that created it."@en ;
    rdfs:domain ffonto:SmokePlume ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:producesSmokePlume .

ffonto:producedInAreaOf a owl:ObjectProperty ;
    rdfs:label "inverse of produced in area"@en ;
    rdfs:comment "Inverse relation linking produced materials or datasets back to the geographic area of production."@en ;
    rdfs:domain ffonto:Location ;
    rdfs:range ffonto:AgriculturalProduce ;
    owl:inverseOf ffonto:producedInArea .

ffonto:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:comment "A general relation indicating that an entity, event, or process generates a specific output, emission, or artifact."@en ;
    rdfs:domain ffonto:ModelExecution ;
    rdfs:range ffonto:ModelOutput ;
    owl:inverseOf ffonto:producedBy .

ffonto:producesAirPollutionOf a owl:ObjectProperty ;
    rdfs:label "produces air pollution of" ;
    rdfs:comment "Inverse - Smoke and particulate emissions resulting from a fire event." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:producesAirPollution .

ffonto:producesPollutionOf a owl:ObjectProperty ;
    rdfs:label "inverse of produces pollution"@en ;
    rdfs:comment "Inverse relation linking pollution production records back to the sources or activities responsible."@en ;
    rdfs:domain ffonto:WildfireSmoke ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:producesPollution .

ffonto:producesToxicOf a owl:ObjectProperty ;
    rdfs:label "inverse of produces toxic"@en ;
    rdfs:comment "Inverse relation linking production of toxic substances back to the generating process or event."@en ;
    rdfs:domain ffonto:AirToxic ;
    rdfs:range ffonto:Smoke ;
    owl:inverseOf ffonto:producesToxic .

ffonto:promotesRegenerationOf a owl:ObjectProperty ;
    rdfs:label "promotes regeneration of" ;
    rdfs:comment "Inverse - Fire can stimulate forest regrowth." ;
    rdfs:domain ffonto:ForestRegeneration ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:promotesRegeneration .

ffonto:propaneTankVisible a owl:DatatypeProperty ;
    rdfs:label "propane or gas tank visible" ;
    rdfs:comment "Indicates whether a propane or gas tank is visible near a structure." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:protectedOf a owl:ObjectProperty ;
    rdfs:label "inverse of protected by"@en ;
    rdfs:comment "Inverse relation linking protection status back to the assets or areas that are protected."@en ;
    rdfs:domain ffonto:ProtectionMethod ;
    rdfs:range ffonto:PopulationGroup ;
    owl:inverseOf ffonto:protectedBy .

ffonto:protectingAssetOf a owl:ObjectProperty ;
    rdfs:label "inverse of protecting asset"@en ;
    rdfs:comment "Inverse relation linking protection actions back to the assets being safeguarded."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:protectingAsset .

ffonto:protectingSpecificBuilding a owl:DatatypeProperty ;
    rdfs:label "protecting specific building" ;
    rdfs:comment "Indicates focused protection efforts directed toward a particular structure."@en ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:protectiveEquipmentDescription a owl:DatatypeProperty ;
    rdfs:label "protective equipment description" ;
    rdfs:comment "Text describing protective equipment worn by responders." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:string .

ffonto:protectsAgainst a owl:ObjectProperty ;
    rdfs:label "protects against"@en ;
    rdfs:comment "Indicates the specific hazard, threat, or condition that an entity, policy, or mitigation strategy defends against."@en ;
    rdfs:domain ffonto:SafetyMeasure ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:isMitigatedBy .

ffonto:protectsData a owl:ObjectProperty ;
    rdfs:label "protects data"@en ;
    rdfs:comment "Indicates that a cybersecurity protocol, privacy policy, or governance framework secures a specific information asset."@en ;
    rdfs:domain ffonto:PrivacyProtection ;
    rdfs:range ffonto:DataRepository ;
    owl:inverseOf ffonto:isProtectedByPrivacyPolicy .

ffonto:protectsStructureOf a owl:ObjectProperty ;
    rdfs:label "inverse of protects structure"@en ;
    rdfs:comment "Inverse relation linking structure protection measures back to the structures they protect."@en ;
    rdfs:domain ffonto:House ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:protectsStructure .

ffonto:protectsSystem a owl:ObjectProperty ;
    rdfs:label "protects system"@en ;
    rdfs:comment "Indicates that a mitigation strategy, policy, or device safeguards a technological or infrastructural system."@en ;
    rdfs:domain ffonto:CyberSecurityPractice ;
    rdfs:range ffonto:KnowledgeGraph ;
    owl:inverseOf ffonto:isProtectedBy .

ffonto:provenanceChecksumSHA256 a owl:DatatypeProperty ;
    rdfs:label "provenance checksum sha256",
        "provenance checksum SHA256"@en ;
    rdfs:comment "Records the SHA-256 cryptographic hash value used to verify the integrity and unchanged state of a digital asset."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range xsd:string .

ffonto:provenanceURI a owl:DatatypeProperty ;
    rdfs:label "provenance uri",
        "provenance URI"@en ;
    rdfs:comment "Provides the standard Uniform Resource Identifier linking to the detailed origin and lineage metadata of a resource."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range xsd:string .

ffonto:providedOf a owl:ObjectProperty ;
    rdfs:label "inverse of provided by"@en ;
    rdfs:comment "Inverse relation linking provided services or resources back to the providers."@en ;
    rdfs:domain ffonto:ResponseOrganization ;
    rdfs:range ffonto:HealthAdvice ;
    owl:inverseOf ffonto:providedBy .

ffonto:providesCarbonStorageOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides carbon storage"@en ;
    rdfs:comment "Inverse relation linking carbon storage services back to the ecosystems that provide them."@en ;
    rdfs:domain ffonto:CarbonSink ;
    rdfs:range ffonto:Forest ;
    owl:inverseOf ffonto:providesCarbonStorage .

ffonto:providesEcosystemServiceOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides ecosystem service"@en ;
    rdfs:comment "Inverse relation indicating that an entity supplies a particular ecosystem service to another."@en ;
    rdfs:domain ffonto:EcosystemService ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:providesEcosystemService .

ffonto:providesHabitatOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides habitat"@en ;
    rdfs:comment "Inverse relation linking habitat provisions back to the ecosystems or areas providing them."@en ;
    rdfs:domain ffonto:Habitat ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:providesHabitat .

ffonto:providesImageFor a owl:ObjectProperty ;
    rdfs:label "provides image for"@en ;
    rdfs:comment "Connects a camera, satellite, or visual dataset to the specific analysis, report, or system that utilizes its imagery."@en ;
    rdfs:domain ffonto:ImageContribution ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasImageContribution .

ffonto:providesInformationOf a owl:ObjectProperty ;
    rdfs:label "inverse of provides information"@en ;
    rdfs:comment "Inverse relation linking informational resources back to the topics or entities they describe."@en ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range ffonto:InformationResource ;
    owl:inverseOf ffonto:providesInformation .

ffonto:providesProtectionFromSmoke a owl:ObjectProperty ;
    rdfs:label "provides protection from smoke"@en ;
    rdfs:comment "Indicates that a device, shelter, or policy shields individuals or equipment from the harmful effects of airborne particulate matter."@en ;
    rdfs:domain ffonto:CleanAirShelter ;
    rdfs:range ffonto:SmokePlume ;
    owl:inverseOf ffonto:isShelteredFrom .

ffonto:providesResourcesFor a owl:ObjectProperty ;
    rdfs:label "provides resources for"@en ;
    rdfs:comment "Links an organization, logistics hub, or mutual aid agreement to the specific incident or operation it supplies."@en ;
    rdfs:domain ffonto:LogisticsSection ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasLogisticsSupport .

ffonto:providesTrackingData a owl:ObjectProperty ;
    rdfs:label "provides tracking data"@en ;
    rdfs:comment "Links a sensor, GPS device, or system to the continuous location and movement telemetry it generates."@en ;
    rdfs:domain ffonto:ADSB ;
    rdfs:range ffonto:AircraftTracking ;
    owl:inverseOf ffonto:receivesTrackingFrom .

ffonto:providesWaterOf a owl:ObjectProperty ;
    rdfs:label "provides water of"@en ;
    rdfs:comment "Inverse - Indicates that a resource or infrastructure supplies water for consumption, firefighting, or ecological use."@en ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:Infrastructure ;
    owl:inverseOf ffonto:providesWater .

ffonto:pulaskiInUse a owl:DatatypeProperty ;
    rdfs:label "Pulaski in use" ;
    rdfs:comment "Indicates that a Pulaski tool (combination axe and adze) is being used."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:pyrocumulusForming a owl:DatatypeProperty ;
    rdfs:label "pyrocumulus forming" ;
    rdfs:comment "Indicates whether pyrocumulus (pyroCb) cloud formation is observed/suspected." ;
    rdfs:domain ffonto:SmokeLayerObservation ;
    rdfs:range xsd:boolean .

ffonto:quantifiesPrediction a owl:ObjectProperty ;
    rdfs:label "quantifies prediction"@en ;
    rdfs:comment "Links a numerical metric or model output to the specific forecast or estimate it represents."@en ;
    rdfs:domain ffonto:PredictionUncertainty ;
    rdfs:range ffonto:FireBehaviorModel ;
    owl:inverseOf ffonto:hasPredictionUncertainty .

ffonto:radiantHeatIgnitionRisk a owl:DatatypeProperty ;
    rdfs:label "radiant heat can ignite secondary fuels" ;
    rdfs:comment "Indicates whether radiant heat may ignite nearby fuels." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:radioHarnessVisible a owl:DatatypeProperty ;
    rdfs:label "radio chest harness visible" ;
    rdfs:comment "Indicates whether firefighters wear radio harness systems." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:rainGuttersMelted a owl:DatatypeProperty ;
    rdfs:label "rain gutters melted" ;
    rdfs:comment "Indicates whether rain gutters have melted." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:rainGuttersScorched a owl:DatatypeProperty ;
    rdfs:label "rain gutters scorched" ;
    rdfs:comment "Indicates whether rain gutters are scorched." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:rainMm a owl:DatatypeProperty ;
    rdfs:label "rain mm",
        "rain mm"@en ;
    rdfs:comment "Records the accumulated precipitation volume at a specific location, measured in millimeters."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:decimal .

ffonto:rainSupportsSmokePersistence a owl:DatatypeProperty ;
    rdfs:label "rain conditions consistent with smoke persistence" ;
    rdfs:comment "Notes conditions where rainfall may nevertheless contribute to lingering smoke due to complex interactions."@en ;
    rdfs:domain ffonto:ModalityConsistency ;
    rdfs:range xsd:boolean .

ffonto:rateOfSpreadAffectedBy a owl:ObjectProperty ;
    rdfs:label "rate of spread affected by"@en ;
    rdfs:domain ffonto:RateOfSpread ;
    rdfs:range ffonto:MeteorologicalObservation ;
    owl:inverseOf ffonto:affectsRateOfSpread .

ffonto:rateOfSpreadAffectedByMeteorologicalVariable a owl:ObjectProperty ;
    rdfs:label "rate of spread affected by meteorological variable"@en ;
    rdfs:comment "Relates the speed of fire growth to the specific weather conditions, such as wind or humidity, influencing its acceleration."@en .

ffonto:rawLabel a owl:DatatypeProperty ;
    rdfs:label "raw label",
        "raw label"@en ;
    rdfs:comment "Records the original, unprocessed annotation or category tag assigned to data before standardization or transformation."@en ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:string .

ffonto:reachedAgriculturalLandOf a owl:ObjectProperty ;
    rdfs:label "reached agricultural land of",
        "reached agricultural land of"@en ;
    rdfs:comment "Relates the expanding perimeter of a fire or environmental hazard back to the specific farming or pastoral region it encroached upon."@en ;
    rdfs:domain ffonto:AgriculturalLand ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:reachedAgriculturalLand .

ffonto:reachedWUIOf a owl:ObjectProperty ;
    rdfs:label "reached urban-wildland interface" ;
    rdfs:comment "Indicates that wildfire activity has extended into the Wildland–Urban Interface."@en ;
    rdfs:domain ffonto:UrbanWildlandInterface ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:reachedWUI .

ffonto:recentRetardantLineVisible a owl:DatatypeProperty ;
    rdfs:label "recent retardant line visible (red stain)" ;
    rdfs:comment "Observation of recently applied fire retardant along a control line."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:recommendedAction a owl:DatatypeProperty ;
    rdfs:label "recommended action" ;
    rdfs:comment "A suggested course of action intended to mitigate risk or achieve objectives."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ffonto:recommendedBy a owl:DatatypeProperty ;
    rdfs:label "recommended by" ;
    rdfs:comment "Authority recommending the guidance (e.g., FEMA, local fire agency)." ;
    rdfs:domain ffonto:SurvivalGuidance ;
    rdfs:range xsd:string .

ffonto:recommendedDistance a owl:DatatypeProperty ;
    rdfs:label "recommended distance" ;
    rdfs:comment "Human-readable recommended distance (units)." ;
    rdfs:domain ffonto:DefensibleZone ;
    rdfs:range xsd:string .

ffonto:recommendedOf a owl:ObjectProperty ;
    rdfs:label "inverse of recommended for"@en ;
    rdfs:comment "Inverse relation linking recommendations back to the contexts or topics they address."@en ;
    rdfs:domain ffonto:PopulationGroup ;
    rdfs:range ffonto:HealthAdvice ;
    owl:inverseOf ffonto:recommendedFor .

ffonto:recommendedProtectionOf a owl:ObjectProperty ;
    rdfs:label "inverse of recommended protection"@en ;
    rdfs:comment "Inverse relation linking recommended protection measures to the assets they protect."@en ;
    rdfs:domain ffonto:ProtectionMethod ;
    rdfs:range ffonto:HealthAdvice ;
    owl:inverseOf ffonto:recommendedProtection .

ffonto:recommendsActionOf a owl:ObjectProperty ;
    rdfs:label "inverse of recommends action"@en ;
    rdfs:comment "Inverse relation linking recommended actions back to the guidance or authority issuing them."@en ;
    rdfs:domain ffonto:ProtectiveAction ;
    rdfs:range ffonto:HealthGuideline ;
    owl:inverseOf ffonto:recommendsAction .

ffonto:recordUUID a owl:DatatypeProperty ;
    rdfs:label "record UUID" ;
    rdfs:comment "Unique identifier of the stored record." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:recordsDecision a owl:ObjectProperty ;
    rdfs:label "records decision"@en ;
    rdfs:comment "Indicates that a log, database, or administrative document captures a specific operational choice or command action."@en ;
    rdfs:domain ffonto:DecisionLog ;
    rdfs:range ffonto:IncidentCommand ;
    owl:inverseOf ffonto:isRecordedInDecisionLog .

ffonto:recordsEmission a owl:ObjectProperty ;
    rdfs:label "records emission"@en ;
    rdfs:comment "Links a sensor, log, or database to the specific release of gases or particulates it measures."@en ;
    rdfs:domain ffonto:EmissionInventory ;
    rdfs:range ffonto:EmissionEstimate ;
    owl:inverseOf ffonto:isRecordedInInventory .

ffonto:reducesFireRisk a owl:ObjectProperty ;
    rdfs:label "reduces fire risk"@en ;
    rdfs:comment "Indicates that a specific mitigation strategy, environmental change, or policy lowers the probability of fire ignition or spread."@en ;
    rdfs:domain ffonto:PreventionMeasure ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:isPreventedBy .

ffonto:reducesSpreadOfOf rdfs:comment "Inverse relation linking spread-reduction measures back to the targets or areas they protect."@en .

ffonto:reflectiveSignageVisible a owl:DatatypeProperty ;
    rdfs:label "reflective signage visible to guide evacuees" ;
    rdfs:comment "Observation that reflective road or safety signage is visible and legible."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:regenerationRate a owl:DatatypeProperty ;
    rdfs:label "regeneration rate (seedlings/ha/yr)" ;
    rdfs:comment "Rate of seedling establishment per hectare per year after disturbance." ;
    rdfs:domain ffonto:ForestRegeneration ;
    rdfs:range xsd:decimal .

ffonto:regionLiteral a owl:DatatypeProperty ;
    rdfs:label "region literal",
        "region literal"@en ;
    rdfs:comment "Records the administrative state, province, or localized geographic area of an incident or observation as a text string."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:regrowthDensity a owl:DatatypeProperty ;
    rdfs:label "regrowth density" ;
    rdfs:comment "Describes the density level of vegetation regrowth (e.g., sparse, moderate, dense)." ;
    rdfs:domain ffonto:VegetationRegrowth ;
    rdfs:range xsd:string .

ffonto:regrowthOfSpeciesOf rdfs:comment "Inverse relation linking species regrowth records back to the areas or treatments where they occurred."@en .

ffonto:rehabAreaVisible a owl:DatatypeProperty ;
    rdfs:label "rehab area visible" ;
    rdfs:comment "Indicates a visible firefighter rest area." ;

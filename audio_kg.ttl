    rdfs:comment "Inverse relation linking carbon release measurements back to the sources or events causing them."@en ;
    rdfs:domain ffonto:CarbonRelease ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:releasesCarbon .

ffonto:reliesOnData a owl:ObjectProperty ;

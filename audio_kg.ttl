    rdfs:subClassOf ffonto:RegulatingService .

ffonto:FireSpreadModel a ffonto:ModelEstimation ;
    rdfs:label "Fire spread prediction model" .

ffonto:FireTriangleConcept a ffonto:FireTriangle ;

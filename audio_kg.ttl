    rdfs:domain ffonto:Vehicle ;
    rdfs:range ffonto:StructuralDamage .

ffonto:hasVisibilityCategory a owl:ObjectProperty ;
    rdfs:label "has visibility category"@en ;
    rdfs:comment "Relates an atmospheric observation or geographic area to a standardized classification of visual range, often degraded by smoke."@en ;
    rdfs:domain ffonto:SmokePlume ;

    owl:inverseOf ffonto:receivesTrackingFrom .

ffonto:providesWaterOf a owl:ObjectProperty ;
    rdfs:label "provides water of"@en ;
    rdfs:comment "Inverse - Indicates that a resource or infrastructure supplies water for consumption, firefighting, or ecological use."@en ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:Infrastructure ;
    owl:inverseOf ffonto:providesWater .

ffonto:pulaskiInUse a owl:DatatypeProperty ;

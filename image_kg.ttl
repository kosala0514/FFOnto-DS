ffonto:blurQualityPresent a owl:DatatypeProperty ;
    rdfs:label "blur quality metadata present?" ;
    rdfs:comment "Whether blur quality metadata is present." ;
    rdfs:domain ffonto:ImageQualityMetadata ;

    rdfs:comment "Inverse relation linking factors that increase human access back to the areas or resources affected."@en ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:Road ;
    owl:inverseOf ffonto:increasesHumanAccess .

ffonto:increasesRunoffOf a owl:ObjectProperty ;
    rdfs:label "inverse of increases runoff"@en ;

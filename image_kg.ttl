    rdfs:comment "Inverse relation indicating that a factor increases wildfire risk for a given area or population."@en ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range ffonto:ForestFireRiskFactor ;
    owl:inverseOf ffonto:increasesWildfireRisk .

ffonto:indicatesCombustionOf a owl:ObjectProperty ;
    rdfs:label "indicates combustion of"@en ;
    rdfs:comment "Links a metric, observation, or sensor reading to the specific material or geographic area currently burning."@en ;
    rdfs:domain ffonto:CombustionProcess ;

    rdfs:comment "Observation that an airtanker aircraft is present in the area of operations."@en ;
    rdfs:domain ffonto:AircraftAction ;
    rdfs:range xsd:boolean .

ffonto:alertFieldsComplete a owl:DatatypeProperty ;
    rdfs:label "all alerting fields present" ;
    rdfs:comment "Indicates that required alert metadata fields have been populated."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:alertReady a owl:DatatypeProperty ;
    rdfs:label "alert ready" ;
    rdfs:comment "Indicates if all required fields are present for automated alerts." ;
    rdfs:domain ffonto:AlertSystemStatus ;
    rdfs:range xsd:boolean .

ffonto:allocatesResourceOf a owl:ObjectProperty ;

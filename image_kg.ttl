    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:roofHasDebris a owl:DatatypeProperty ;
    rdfs:label "roof has debris" ;
    rdfs:comment "Specifies whether the roof contains leaves or debris that could ignite." ;
    rdfs:domain ffonto:Roof ;
    rdfs:range xsd:boolean .

ffonto:rootsExposed a owl:DatatypeProperty ;
    rdfs:label "roots exposed by combustion or erosion" ;
    rdfs:comment "Indicates whether roots are exposed due to combustion or erosion." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:rowIndex a owl:DatatypeProperty ;
    rdfs:label "rowI index",
        "row index"@en ;
    rdfs:comment "Indicates the specific sequential line number or tabular position of a record within a dataset."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:integer .

ffonto:runoffIntensity a owl:DatatypeProperty ;
    rdfs:label "runoff intensity" ;
    rdfs:comment "Describes the intensity of surface runoff (e.g., low, moderate, high)." ;
    rdfs:domain ffonto:Runoff ;
    rdfs:range xsd:string .

ffonto:satelliteSmokeVisible a owl:DatatypeProperty ;
    rdfs:label "smoke visible in satellite imagery" ;
    rdfs:comment "Indicates today's satellite passes show the smoke plume." ;
    rdfs:domain ffonto:SatelliteObservation ;
    rdfs:range xsd:boolean .

ffonto:sceneFeaturesObservation a owl:ObjectProperty ;
    rdfs:label "scene features observation"@en ;
    rdfs:comment "Inverse of observedAtScene - Links a scene to the observations made within it." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:observedAtScene .

ffonto:sceneLocatedIn rdfs:label "scene located in"@en ;
    rdfs:comment "Specifies the geographic area or location where an observed scene or event occurs."@en .

ffonto:sceneLocatedOf rdfs:comment "Inverse relation linking scene location statements back to the incident or report referencing them."@en .

ffonto:schemaVersion a owl:DatatypeProperty ;
    rdfs:label "schema version",
        "schema version"@en ;
    rdfs:comment "Specifies the numeric or alphanumeric release identifier of the ontological or structural framework governing the dataset."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:schoolsCloseGuidance a owl:DatatypeProperty ;
    rdfs:label "will schools close during severe smoke/fire" ;
    rdfs:comment "Guidance on closure of educational institutions during hazardous events."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:scoreFire a owl:DatatypeProperty ;
    rdfs:label "fire score" ;
    rdfs:comment "Fire score from vision model (0-1)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:scoreNoFire a owl:DatatypeProperty ;
    rdfs:label "no-fire score" ;
    rdfs:comment "No-fire score from vision model (0-1)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:scoreSmoke a owl:DatatypeProperty ;
    rdfs:label "smoke score" ;
    rdfs:comment "Smoke score from vision model (0-1)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:sendsAlert a owl:ObjectProperty ;
    rdfs:label "sends alert"@en ;
    rdfs:comment "Indicates that a system, device, or agent transmits a warning or notification regarding a specific condition."@en ;
    rdfs:domain ffonto:EDXLMessage ;
    rdfs:range ffonto:PublicWarningSystem ;
    owl:inverseOf ffonto:receivesEDXLMessage .

ffonto:sensorPoseRecorded a owl:DatatypeProperty ;
    rdfs:label "sensor orientation/pose recorded?" ;
    rdfs:comment "True if yaw/pitch/roll are recorded; false otherwise." ;
    rdfs:domain ffonto:ImageQualityMetadata ;
    rdfs:range xsd:boolean .

ffonto:shelterBurned a owl:DatatypeProperty ;
    rdfs:label "barn or shelter burned" ;
    rdfs:comment "Indicates whether a barn or livestock shelter is burned or shows burn damage." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:shelterInPlaceGuidance a owl:DatatypeProperty ;
    rdfs:label "when to shelter in place guidance" ;
    rdfs:comment "Instructions advising individuals to remain indoors and take protective actions during hazards."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:shelteringInPlace a owl:DatatypeProperty ;
    rdfs:label "sheltering in place" ;
    rdfs:comment "The act of remaining in a safe indoor location rather than evacuating."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:shovelsOrHoesScrapingToMineralSoil a owl:DatatypeProperty ;
    rdfs:label "shovels/hoes scraping to mineral soil" ;
    rdfs:comment "Indicates use of hand tools to remove vegetation to mineral soil as a fire control measure."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:shrubsBurnedToStems a owl:DatatypeProperty ;
    rdfs:label "shrubs burned to stems" ;
    rdfs:comment "Indicates whether shrubs or chaparral are burned down to stems." ;
    rdfs:domain ffonto:Shrub ;
    rdfs:range xsd:boolean .

ffonto:signpostScorched a owl:DatatypeProperty ;
    rdfs:label "signpost scorched" ;
    rdfs:comment "Whether a signpost appears scorched or burned." ;
    rdfs:domain ffonto:Signpost ;
    rdfs:range xsd:boolean .

ffonto:simulatedByActivity a owl:ObjectProperty ;
    rdfs:label "simulated by activity"@en ;
    rdfs:comment "Relates a forest fire to a provenance-tracked modeling or simulation activity."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range prov:Activity ;
    owl:inverseOf ffonto:simulatesFire .

ffonto:sirenVehiclePresent a owl:DatatypeProperty ;
    rdfs:label "siren vehicle present" ;
    rdfs:comment "Observation that a vehicle equipped with a siren is present at the scene."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:siteLiteral a owl:DatatypeProperty ;
    rdfs:label "site literal",
        "site literal"@en ;
    rdfs:comment "Records the localized name, physical designation, or descriptive text of an observation station or facility."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:smoke a ffonto:ObservableProperty .

ffonto:smokeAffectsAviation a owl:DatatypeProperty ;
    rdfs:label "smoke affecting aviation routes" ;
    rdfs:comment "Indicates that smoke conditions are impacting aviation operations and safety."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:smokeBlowingAcrossEvacRoutes a owl:DatatypeProperty ;
    rdfs:label "smoke blowing across evacuation routes" ;
    rdfs:comment "Observation that smoke is crossing designated evacuation routes, potentially affecting safety."@en ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:boolean .

ffonto:smokeColor a owl:DatatypeProperty ;
    rdfs:label "smoke color" ;
    rdfs:comment "Indicates smoke color such as white, gray, brown, or black." ;
    rdfs:domain ffonto:SmokeCondition ;
    rdfs:range xsd:string .

ffonto:smokeColorLiteral a owl:DatatypeProperty ;
    rdfs:label "smoke color description" ;
    rdfs:comment "Literal description of smoke color (e.g., 'dark-gray with a brown tinge')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokeDensity a owl:DatatypeProperty ;
    rdfs:label "smoke density level" ;
    rdfs:comment "Describes smoke density level (low, medium, high)." ;
    rdfs:domain ffonto:SmokeCondition ;
    rdfs:range xsd:string .

ffonto:smokeExposureDuration a owl:DatatypeProperty ;
    rdfs:label "smoke exposure duration" ;
    rdfs:comment "Duration of exposure to wildfire smoke." ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range xsd:duration .

ffonto:smokeLayerLowerDesc a owl:DatatypeProperty ;
    rdfs:label "lower smoke layer description" ;
    rdfs:comment "Descriptive text for lower smoke layer (dense, ground-hugging, etc.)." ;
    rdfs:domain ffonto:SmokeLayerObservation ;
    rdfs:range xsd:string .

ffonto:smokeLayerUpperDesc a owl:DatatypeProperty ;
    rdfs:label "upper smoke layer description" ;
    rdfs:comment "Descriptive text for higher/aloft plumes (rising columns, pyrocumulus building)." ;
    rdfs:domain ffonto:SmokeLayerObservation ;
    rdfs:range xsd:string .

ffonto:smokePM25 a owl:DatatypeProperty ;
    rdfs:label "smoke PM2.5 (ug/m3)" ;
    rdfs:comment "Measured PM2.5 concentration in micrograms per cubic meter from smoke." ;
    rdfs:domain ffonto:ParticulateMatter ;
    rdfs:range xsd:decimal .

ffonto:smokePlumeHeight a owl:DatatypeProperty ;
    rdfs:label "smoke plume height (descriptive)" ;
    rdfs:comment "Descriptive height of the smoke plume (e.g., 'very tall, extending high into the atmosphere')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokePlumeOrientation a owl:DatatypeProperty ;
    rdfs:label "smoke plume orientation" ;
    rdfs:comment "Whether plume is rising vertically or drifting horizontally (plus direction)." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokeReachedStratosphere a owl:DatatypeProperty ;
    rdfs:label "smoke reached stratosphere" ;
    rdfs:comment "Indicates that smoke from a fire has risen into the stratospheric layer of the atmosphere."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:smokeRising a owl:DatatypeProperty ;
    rdfs:label "smoke rising" ;
    rdfs:comment "Indicates whether smoke is still rising from a building after a wildfire." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:smokeScore a owl:DatatypeProperty ;
    rdfs:label "smoke score",
        "smoke score"@en ;
    rdfs:comment "Indicates a numerical value or algorithmic confidence metric representing the likelihood or density of detected smoke."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:smokeScoreAboveThreshold a owl:DatatypeProperty ;
    rdfs:label "smoke score above threshold",
        "smoke score above threshold"@en ;
    rdfs:comment "A boolean flag or indicator denoting whether the calculated smoke density metric exceeds the established warning limit."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:boolean .

ffonto:smokeThickness a owl:DatatypeProperty ;
    rdfs:label "smoke thickness (descriptive)" ;
    rdfs:comment "Descriptive thickness of smoke (e.g., 'extremely thick')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:smokeThreshold a owl:DatatypeProperty ;
    rdfs:label "smoke threshold",
        "smoke threshold"@en ;
    rdfs:comment "Defines the specific numerical boundary or concentration level at which a smoke detection alert is triggered."@en ;
    rdfs:domain ffonto:ThresholdSet ;
    rdfs:range xsd:decimal .

ffonto:smokeVisibilityDistance a owl:DatatypeProperty ;
    rdfs:label "visibility distance in miles" ;
    rdfs:comment "Estimated distance at which smoke visibility is reduced or obscured."@en ;
    rdfs:domain ffonto:EnvironmentalCondition ;
    rdfs:range xsd:decimal .

ffonto:smolderingPresent a owl:DatatypeProperty ;
    rdfs:label "smoldering present" ;
    rdfs:comment "Indicates smoldering patches are visible without open flames." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:boolean .

ffonto:snagsCount a owl:DatatypeProperty ;
    rdfs:label "snags count" ;
    rdfs:comment "Approximate number of snags visible (integer)." ;
    rdfs:domain ffonto:Snag ;
    rdfs:range xsd:integer .

ffonto:snagsPresent a owl:DatatypeProperty ;
    rdfs:label "snags present" ;
    rdfs:comment "Indicates whether dead standing trees (snags) are common in the frame." ;
    rdfs:domain ffonto:Snag ;
    rdfs:range xsd:boolean .

ffonto:snagsVisible a owl:DatatypeProperty ;
    rdfs:label "snags visible" ;
    rdfs:comment "Indicates whether many dead standing trees (snags) are visible." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:snowDepth a owl:DatatypeProperty ;
    rdfs:label "Snow Depth",
        "snow depth" ;
    rdfs:comment "Represents the depth of snow cover in the forest ecosystem." ;
    rdfs:domain ffonto:MeteorologicalObservation,
        ffonto:SnowCover ;
    rdfs:range xsd:decimal .

ffonto:soilMoisturePercent a owl:DatatypeProperty ;
    rdfs:label "soil moisture percent" ;
    rdfs:comment "Soil moisture percentage (volumetric or gravimetric as specified)." ;
    rdfs:domain ffonto:SoilQuality ;
    rdfs:range xsd:decimal .

ffonto:soilNutrientIndex a owl:DatatypeProperty ;
    rdfs:label "soil nutrient index" ;
    rdfs:comment "Index indicating soil nutrient availability." ;
    rdfs:domain ffonto:SoilQuality ;
    rdfs:range xsd:decimal .

ffonto:soilNutrientLevel a owl:DatatypeProperty ;
    rdfs:label "soil nutrient level" ;
    rdfs:comment "Represents the level of nutrients present in the soil." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:decimal .

ffonto:solarPanelDamaged a owl:DatatypeProperty ;
    rdfs:label "solar panel damaged" ;
    rdfs:comment "Indicates whether solar panels installed on a building are damaged." ;
    rdfs:domain ffonto:SolarPanel ;
    rdfs:range xsd:boolean .

ffonto:sourceLiteral a owl:DatatypeProperty ;
    rdfs:label "source literal",
        "source literal"@en ;
    rdfs:comment "Specifies the origin, creating agency, or foundational system of a dataset or observation as a text string."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:speciesDiversityIncrease a owl:DatatypeProperty ;
    rdfs:label "species diversity increase" ;
    rdfs:comment "Indicates whether plant species diversity increases after vegetation regrowth." ;
    rdfs:domain ffonto:VegetationRegrowth ;
    rdfs:range xsd:boolean .

ffonto:speciesRichness a owl:DatatypeProperty ;
    rdfs:label "species richness" ;
    rdfs:comment "Count of species observed in the habitat (richness metric)." ;
    rdfs:domain ffonto:HabitatType ;
    rdfs:range xsd:decimal .

ffonto:spotFiresDetected a owl:DatatypeProperty ;
    rdfs:label "spot fires detected" ;
    rdfs:comment "Indicates detection of new fires ignited ahead of the main fire front."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range xsd:boolean .

ffonto:spotFiresVisible a owl:DatatypeProperty ;
    rdfs:label "spot fires visible" ;
    rdfs:comment "Indicates visible spot fires ahead of main flame." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:boolean .

ffonto:spottersVisible a owl:DatatypeProperty ;
    rdfs:label "spotters or lookouts visible" ;
    rdfs:comment "Indicates whether spotters are positioned on higher ground." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:spottingNearStructureFires a owl:DatatypeProperty ;
    rdfs:label "spotting occurring near structures" ;
    rdfs:comment "True if ember spotting or small spot fires are visible near structures." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:boolean .

ffonto:spottingPotential a owl:DatatypeProperty ;
    rdfs:label "spotting potential present" ;
    rdfs:comment "The likelihood that firebrands will generate spot fires beyond the main fire front."@en ;
    rdfs:domain ffonto:SpottingEvent ;
    rdfs:range xsd:boolean .

ffonto:sprinklersOperating a owl:DatatypeProperty ;
    rdfs:label "sprinklers or misters operating" ;
    rdfs:comment "Indicates that sprinkler systems are actively discharging water for protection or suppression."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:sprinklersOrHoseRunning a owl:DatatypeProperty ;
    rdfs:label "sprinklers or hose running" ;
    rdfs:comment "Indicates whether water hoses or sprinklers are operating." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:stagedNearOf a owl:ObjectProperty ;
    rdfs:label "staged near of",
        "staged near of"@en ;
    rdfs:comment "Connects a deployed resource, equipment cache, or staging area back to the geographic feature or incident it is positioned for."@en ;
    rdfs:domain ffonto:CommandPost ;
    rdfs:range ffonto:Vehicle ;
    owl:inverseOf ffonto:stagedNear .

ffonto:stagingAreaVisible a owl:DatatypeProperty ;
    rdfs:label "staging area visible" ;
    rdfs:comment "Indicates whether a staging area for firefighting resources is visible." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:standingTreesCondition a owl:DatatypeProperty ;
    rdfs:label "standing trees condition" ;
    rdfs:comment "Condition of standing trees: 'mostly alive', 'mixed', 'mostly dead'." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:statisticDate rdfs:comment "The date associated with a statistical measure or reporting period."@en .

ffonto:steamVisible a owl:DatatypeProperty ;
    rdfs:label "steam visible where hot ground meets water" ;
    rdfs:comment "Indicates whether steam is visible where hot ground meets water." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range xsd:boolean .

ffonto:storesWaterOf a owl:ObjectProperty ;
    rdfs:label "stores water of" ;
    rdfs:comment "Inverse - Indicates that a water tank stores water that can be used as a water source." ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:WaterTank ;
    owl:inverseOf ffonto:storesWater .

ffonto:streamsRunningLow a owl:DatatypeProperty ;
    rdfs:label "streams running low or dry" ;
    rdfs:comment "Boolean indicating likely low streamflow conditions nearby." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:streetlightsDamaged a owl:DatatypeProperty ;
    rdfs:label "streetlights damaged or dark" ;
    rdfs:comment "Indicates whether streetlights appear damaged or unlit during daytime smoke conditions." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:structureAffectedOf a owl:ObjectProperty ;
    rdfs:label "inverse of structure affected"@en ;
    rdfs:comment "Inverse relation linking affected structures back to the incidents or hazards impacting them."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:structureAffected .

ffonto:structureCollapseRisk a owl:DatatypeProperty ;
    rdfs:label "structure collapse risk" ;
    rdfs:comment "Indicates whether a burning structure is likely to collapse." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:structureIgnitionRisk a owl:DatatypeProperty ;
    rdfs:label "structural ignition risk from radiant heat" ;
    rdfs:comment "Indicates whether structures are likely to ignite due to radiant heat." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:stumpsSmoking a owl:DatatypeProperty ;
    rdfs:label "stumps smoking" ;
    rdfs:comment "Indicates whether stumps are still smoking." ;
    rdfs:domain ffonto:Stump ;
    rdfs:range xsd:boolean .

ffonto:suggestsEnvironmentalProcessOf a owl:ObjectProperty ;
    rdfs:label "inverse of suggests environmental process"@en ;
    rdfs:comment "Inverse relation linking proposed environmental processes back to the evidence or observations supporting them."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Observation ;
    owl:inverseOf ffonto:suggestsEnvironmentalProcess .

ffonto:sunVisible a owl:DatatypeProperty ;
    rdfs:label "sun visible through smoke" ;
    rdfs:comment "Indicates whether the sun is visible through smoke." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:boolean .

ffonto:supervisesAircraft a owl:ObjectProperty ;
    rdfs:label "supervises aircraft"@en ;
    rdfs:comment "Connects an air tactical group supervisor or air traffic control entity to the aerial assets under their direction."@en ;
    rdfs:domain ffonto:AirAttackSupervisor ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:isSupervisedByAirAttack .

ffonto:supportsBiodiversityOf a owl:ObjectProperty ;
    rdfs:label "supports biodiversity of" ;
    rdfs:comment "Inverse - Indicates that an ecosystem or vegetation type supports biodiversity." ;
    rdfs:domain ffonto:Biodiversity ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:supportsBiodiversity .

ffonto:supportsCommunity a owl:ObjectProperty ;
    rdfs:label "supports community"@en ;
    rdfs:comment "Links a plan, resource, or organization to the civilian population it aids or protects."@en ;
    rdfs:domain ffonto:NeighborSupportPlan ;
    rdfs:range ffonto:EvacuationZone ;
    owl:inverseOf ffonto:hasNeighborSupportPlan .

ffonto:supportsDecision a owl:ObjectProperty ;
    rdfs:label "supports decision"@en ;
    rdfs:comment "Links analytical data, a DSS (Decision Support System), or an observation to the operational command choice it informs."@en ;
    rdfs:domain ffonto:DecisionSupportSystem ;
    rdfs:range ffonto:IncidentCommand ;
    owl:inverseOf ffonto:isSupportedByDSS .

ffonto:supportsEcosystemHealthOf a owl:ObjectProperty ;
    rdfs:label "supports ecosystem health of" ;
    rdfs:comment "Inverse - Indicates that a feature such as a water body contributes to ecosystem services." ;
    rdfs:domain ffonto:EcosystemService ;
    rdfs:range ffonto:WaterBody ;
    owl:inverseOf ffonto:supportsEcosystemHealth .

ffonto:suppressionDifficultyLevel a owl:DatatypeProperty ;
    rdfs:label "suppression difficulty level" ;
    rdfs:comment "A categorical or numeric indicator of the difficulty in suppressing a fire."@en ;
    rdfs:domain ffonto:SuppressionDifficulty ;
    rdfs:range xsd:string .

ffonto:tankHeatDamage a owl:DatatypeProperty ;
    rdfs:label "tank heat damage visible" ;
    rdfs:comment "Indicates whether a tank shows heat damage (soot, warping)." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:teamworkObserved a owl:DatatypeProperty ;
    rdfs:label "teamwork evident" ;
    rdfs:comment "Indicates whether coordinated teamwork among firefighters is visible." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:comment "The textual content of the annotation." ;
    rdfs:domain ffonto:TextAnnotation ;
    rdfs:range xsd:string .

ffonto:threatenedByHazardOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatened by hazard"@en ;
    rdfs:comment "Inverse relation linking threats back to the hazards that threaten specified entities or areas."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:threatenedByHazard .

ffonto:threatensCommunityOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatens community"@en ;
    rdfs:comment "Inverse relation linking threats back to the communities that are endangered."@en ;
    rdfs:domain ffonto:Community ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:threatensCommunity .

ffonto:threatensFarmlandOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatens farmland"@en ;
    rdfs:comment "Inverse relation linking threats to farmland back to the hazards or events responsible."@en ;
    rdfs:domain ffonto:Farmland ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:threatensFarmland .

ffonto:threatensInfrastructureOf a owl:ObjectProperty ;
    rdfs:label "inverse of threatens infrastructure"@en ;
    rdfs:comment "Inverse relation linking infrastructure threats back to the hazards or events that cause them."@en ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:threatensInfrastructure .

ffonto:threatensOf a owl:ObjectProperty ;
    rdfs:label "threatens of" ;
    rdfs:comment "Inverse - Who/what is threatened by a given hazard." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:Person ffonto:StructureFire ffonto:Animal ffonto:Infrastructure ) ] ;
    rdfs:range ffonto:Hazard ;
    owl:inverseOf ffonto:threatens .

ffonto:toolInUseOf a owl:ObjectProperty ;
    rdfs:label "inverse of tool in use"@en ;
    rdfs:comment "Inverse relation linking tools in use back to the crews, tasks, or operations employing them."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:toolInUse .

ffonto:torchingEvidence a owl:DatatypeProperty ;
    rdfs:label "evidence of torching" ;
    rdfs:comment "Indicates whether torching (single trees fully burned) is evident." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:boolean .

ffonto:tracksAircraft a owl:ObjectProperty ;
    rdfs:label "tracks aircraft"@en ;
    rdfs:comment "Links a system, radar, or operational role to the specific aerial vehicle whose flight path is being monitored."@en ;
    rdfs:domain ffonto:AircraftTracking ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:isTrackedBy .

ffonto:trafficControlSignsDeployed a owl:DatatypeProperty ;
    rdfs:label "traffic control signs deployed" ;
    rdfs:comment "Indicates whether responders deployed cones or warning signs." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:trafficSignsCharred a owl:DatatypeProperty ;
    rdfs:label "traffic signs charred" ;
    rdfs:comment "Indicates whether traffic signs or posts are charred." ;
    rdfs:domain ffonto:Signpost ;
    rdfs:range xsd:boolean .

ffonto:trailSignsBurned a owl:DatatypeProperty ;
    rdfs:label "trail signs burned" ;
    rdfs:comment "Indicates whether trail signs or markers are burned." ;
    rdfs:domain ffonto:Signpost ;
    rdfs:range xsd:boolean .

ffonto:trainedThroughOf a owl:ObjectProperty ;
    rdfs:label "inverse of trained through"@en ;
    rdfs:comment "Inverse relation linking training-through relationships back to the methods or data used."@en ;
    rdfs:domain ffonto:TrainingProgram ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:trainedThrough .

ffonto:trainedWithOf a owl:ObjectProperty ;
    rdfs:label "inverse of trained with"@en ;
    rdfs:comment "Inverse relation linking training-with associations back to the model or technique used."@en ;
    rdfs:domain ffonto:ModelTrainingTechnique ;
    rdfs:range ffonto:MachineLearningModel ;
    owl:inverseOf ffonto:trainedWith .

ffonto:transformerNearFlame a owl:DatatypeProperty ;
    rdfs:label "transformer exposed to flames" ;
    rdfs:comment "Specifies whether an electrical transformer is near active flames." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range xsd:boolean .

ffonto:transformerNearbyExposedToFlame a owl:DatatypeProperty ;
    rdfs:label "transformer nearby exposed to flame" ;
    rdfs:comment "Indicates whether a transformer near the scene is exposed to flames." ;
    rdfs:domain ffonto:PowerInfrastructure ;
    rdfs:range xsd:boolean .

ffonto:transformerScorched a owl:DatatypeProperty ;
    rdfs:label "transformer scorched" ;
    rdfs:comment "Indicates that a transformer casing is scorched or heat-damaged." ;
    rdfs:domain ffonto:Transformer ;
    rdfs:range xsd:boolean .

ffonto:transitionsBetweenOf a owl:ObjectProperty ;
    rdfs:label "inverse of transitions between"@en ;
    rdfs:comment "Inverse relation linking transition descriptors back to the states or units they connect."@en ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:TransitionalEcosystem ;
    owl:inverseOf ffonto:transitionsBetween .

ffonto:transitionsOf a owl:ObjectProperty ;
    rdfs:label "inverse of transitions to"@en ;
    rdfs:comment "Inverse relation linking transition events back to the entities between which they occur."@en ;
    rdfs:domain ffonto:SuccessionStage ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:transitionsTo .

ffonto:trappedInVehicleGuidance a owl:DatatypeProperty ;
    rdfs:label "what to do if trapped in vehicle by fire" ;
    rdfs:comment "Instructions for individuals trapped in vehicles during fire or smoke events."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:treeCharHeight a owl:DatatypeProperty ;
    rdfs:label "tree char height" ;
    rdfs:comment "Describes the height of visible charring on tree trunks (e.g., 'low', 'mid', 'high' or meters)." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:string .

ffonto:treeCrownCondition a owl:DatatypeProperty ;
    rdfs:label "tree crown condition" ;
    rdfs:comment "Describes whether tree crowns appear scorched, intact, or mixed." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:treeCrownStatus a owl:DatatypeProperty ;
    rdfs:label "tree crown status" ;
    rdfs:comment "Status of tree crowns: 'scorched', 'partially consumed', 'fully consumed', 'unaffected'." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:string .

ffonto:treeSpacing a owl:DatatypeProperty ;
    rdfs:label "tree spacing" ;
    rdfs:comment "Represents the spacing between trees within a forest ecosystem." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range xsd:string .

ffonto:treeTrunksCharred a owl:DatatypeProperty ;
    rdfs:label "tree trunks charred" ;
    rdfs:comment "Indicates whether tree trunks are blackened up to visible char heights." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:boolean .

ffonto:treesCondition a owl:DatatypeProperty ;
    rdfs:label "trees condition" ;
    rdfs:comment "Description of tree condition (e.g., 'many dead and dry')." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:string .

ffonto:treesFallingNearRoute a owl:DatatypeProperty ;
    rdfs:label "trees falling near route" ;
    rdfs:comment "Indicates whether trees or branches are actively falling near evacuation routes." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:triggeredByAirPollution a owl:ObjectProperty ;
    rdfs:label "triggered by air pollution"@en ;
    rdfs:comment "Indicates that a health condition, alert, or mitigation strategy is activated by poor atmospheric quality."@en ;
    rdfs:domain ffonto:CardiacIssue ;
    rdfs:range ffonto:ParticulateMatterPM25 ;
    owl:inverseOf ffonto:causesCardiacIssue .

ffonto:triggeredByFire a owl:ObjectProperty ;
    rdfs:label "triggered by fire" ;
    rdfs:comment "Indicates that a seed release mechanism is activated by wildfire heat or fire conditions." ;
    rdfs:domain ffonto:SeedReleaseMechanism ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:triggeredByFireOf .

ffonto:triggeredBySmoke a owl:ObjectProperty ;
    rdfs:label "triggered by smoke"@en ;
    rdfs:comment "Relates an alert, health symptom, or automated response to the presence of airborne combustion particulates."@en ;
    rdfs:domain ffonto:RespiratoryIssue ;
    rdfs:range ffonto:SmokePlume ;
    owl:inverseOf ffonto:causesRespiratoryIssue .

ffonto:triggersEvacuationOrder a owl:ObjectProperty ;
    rdfs:label "requires evacuation" ;
    rdfs:comment "If the hazard or conditions should prompt evacuation." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:EvacuationOrder ;
    owl:inverseOf ffonto:isEvacuationOrderFor .

ffonto:unauthorizedCiviliansInside a owl:DatatypeProperty ;
    rdfs:label "unauthorized civilians inside restricted area" ;
    rdfs:comment "Indicates presence of unauthorized civilians within a restricted or hazardous area."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:unburnedGreenPatches a owl:DatatypeProperty ;
    rdfs:label "unburned green patches visible" ;
    rdfs:comment "Indicates whether unburned green vegetation patches are visible within the burned area." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:understoryDensity a owl:DatatypeProperty ;
    rdfs:label "understory density" ;
    rdfs:comment "Density metric for understory vegetation (e.g., stems per m2 or qualitative index)." ;
    rdfs:domain ffonto:Understory ;
    rdfs:range xsd:decimal .

ffonto:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:comment "Specifies the scale or unit used to quantify the value of a ffonto:Result instance." ;
    rdfs:domain ffonto:Result ;
    rdfs:range xsd:string .

ffonto:updatesModelOf a owl:ObjectProperty ;
    rdfs:label "updates model of"@en ;
    rdfs:comment "Links incoming data, observed conditions, or human feedback to the specific predictive algorithm or simulation it refines."@en ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range ffonto:DataAssimilation ;
    owl:inverseOf ffonto:updatesModel .

ffonto:useOf a owl:ObjectProperty ;
    rdfs:label "inverse of used for"@en ;
    rdfs:comment "A general relation indicating use or utilization of an entity or resource."@en ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range ffonto:Aircraft ;
    owl:inverseOf ffonto:usedFor .

ffonto:usedAsSafetyZoneOf a owl:ObjectProperty ;
    rdfs:label "used as safety zone of" ;
    rdfs:comment "Inverse - Indicates that a road or area is being used as a safety zone or refuge location." ;
    rdfs:domain ffonto:SafetyZone ;
    rdfs:range ffonto:Road ;
    owl:inverseOf ffonto:usedAsSafetyZone .

ffonto:usedAsWaterSource a owl:ObjectProperty ;
    rdfs:label "used as water source"@en ;
    rdfs:comment "Indicates that a natural or artificial resource is utilized as a source of water."@en ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range ffonto:WaterSource ;
    owl:inverseOf ffonto:usedAsWaterSourceOf .

ffonto:usedByHelicopter a owl:ObjectProperty ;
    rdfs:label "used by helicopter"@en ;
    rdfs:comment "Indicates that a specific suppression resource, tactic, drop zone, or airspace corridor is utilized by rotary-wing aircraft during an operation."@en ;
    rdfs:domain ffonto:Helispot ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:landsAtHelispot .

ffonto:usedByResponder a owl:ObjectProperty ;
    rdfs:label "used by responder"@en ;
    rdfs:comment "Links a piece of equipment, communication device, or tactic to the specific emergency personnel utilizing it."@en ;
    rdfs:domain ffonto:Radio ;
    rdfs:range ffonto:FirefightingResource ;
    owl:inverseOf ffonto:usesRadio .

ffonto:usedForFlight a owl:ObjectProperty ;
    rdfs:label "used for flight"@en ;
    rdfs:comment "Connects a specific airspace corridor, resource, or meteorological dataset to its application in aviation operations."@en ;
    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:FlightPath ;
    owl:inverseOf ffonto:occursInAirspace .

ffonto:usedInSuppressionOf a owl:ObjectProperty ;
    rdfs:label "used in suppression of"@en ;
    rdfs:comment "Links a tactic, resource, or piece of equipment to the specific fire incident it is deployed to contain or extinguish."@en ;
    rdfs:domain ffonto:SuppressionTactic ;
    rdfs:range ffonto:WaterHose ;
    owl:inverseOf ffonto:usedInSuppression .

ffonto:usedOf a owl:ObjectProperty ;
    rdfs:label "used of"@en ;
    rdfs:comment "Relates a consumed or applied resource back to its original source, system, or categorical classification."@en ;
    rdfs:domain ffonto:FireRiskAssessment ;
    rdfs:range ffonto:DataRepository ;
    owl:inverseOf ffonto:usedBy .

ffonto:usesDataFormatOf a owl:ObjectProperty ;
    rdfs:label "uses data format of",
        "uses data format of"@en ;
    rdfs:comment "Links a specific file type, schema, or encoding standard back to the database, software, or data exchange process requiring it."@en ;
    rdfs:domain ffonto:GeospatialDataFormat ;
    rdfs:range ffonto:ForestFirePredictionModel ;
    owl:inverseOf ffonto:usesDataFormat .

ffonto:usesDetectionMethodOf a owl:ObjectProperty ;
    rdfs:label "uses detection method of",
        "uses detection method of"@en ;
    rdfs:comment "Links a specific sensor technology, analytical technique, or human observation protocol back to the early warning system relying on it."@en ;
    rdfs:domain ffonto:DetectionMethod ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:usesDetectionMethod .

ffonto:usesEquipmentOf a owl:ObjectProperty ;
    rdfs:label "inverse of uses equipment"@en ;
    rdfs:comment "Inverse relation linking equipment usage records back to the personnel or units using them."@en ;
    rdfs:domain ffonto:ProtectiveEquipment ;
    rdfs:range ffonto:EmergencyResponder ;
    owl:inverseOf ffonto:usesEquipment .

ffonto:usesGISOf a owl:ObjectProperty ;
    rdfs:label "inverse of uses gis"@en ;
    rdfs:comment "Inverse relation linking GIS usage back to the projects or analyses employing it."@en ;
    rdfs:domain ffonto:GISApplication ;
    rdfs:range ffonto:FireRiskAssessment ;
    owl:inverseOf ffonto:usesGIS .

ffonto:usesHomeHardening a owl:ObjectProperty ;
    rdfs:label "uses home hardening" ;
    rdfs:comment "Indicates that a structure protection strategy uses home hardening techniques." ;
    rdfs:domain ffonto:StructureProtection ;
    rdfs:range ffonto:HomeHardening ;
    owl:inverseOf ffonto:usesHomeHardeningOf .

ffonto:usesHoseof a owl:ObjectProperty ;
    rdfs:label "inverse of uses hose"@en ;
    rdfs:comment "Inverse relation linking hose use records back to the operations or crews employing them."@en ;
    rdfs:domain ffonto:FireHose ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:usesHose .

ffonto:usesMapBoardOf a owl:ObjectProperty ;
    rdfs:label "inverse of uses map board"@en ;
    rdfs:comment "Inverse relation linking map board usage back to the teams or incidents that used them."@en ;
    rdfs:domain ffonto:MapBoard ;
    rdfs:range ffonto:BriefingArea ;
    owl:inverseOf ffonto:usesMapBoard .

ffonto:usesModelOf rdfs:label "uses model (inverse)"@en ;
    rdfs:comment "Inverse relation linking an output, dataset, or decision back to the model or modelling process that was used."@en .

ffonto:usesResourceOf a owl:ObjectProperty ;
    rdfs:label "uses resource of" ;
    rdfs:comment "Inverse - Suppression assets assigned to the incident." ;
    rdfs:domain ffonto:SuppressionResource ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:usesResource .

ffonto:usesSensorOf a owl:ObjectProperty ;
    rdfs:label "uses sensor of"@en ;
    rdfs:comment "Inverse - Indicates the sensor used for wildfire detection, monitoring, or analysis."@en ;
    rdfs:domain ffonto:RemoteSensingSensor ;
    rdfs:range ffonto:ForestFirePredictionModel ;
    owl:inverseOf ffonto:usesSensor .

ffonto:usesSuppressionMethodOf a owl:ObjectProperty ;
    rdfs:label "inverse of uses suppression method"@en ;
    rdfs:comment "Inverse relation linking suppression methods back to the incidents or units that use them."@en ;
    rdfs:domain ffonto:SuppressionMethod ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:usesSuppressionMethod .

ffonto:usesTechnologyOf a owl:ObjectProperty ;
    rdfs:label "uses technology of",
        "uses technology of"@en ;
    rdfs:comment "Relates a specific technological system or device back to the operational process or organization utilizing it."@en ;
    rdfs:domain ffonto:ForestFireTechnology ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:usesTechnology .

ffonto:usesVehicleOf a owl:ObjectProperty ;
    rdfs:label "uses vehicle of" ;
    rdfs:comment "Inverse - Indicates that firefighters operate or use a vehicle during firefighting." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:usesVehicle .

ffonto:usesWaterSourceOf a owl:ObjectProperty ;
    rdfs:label "inverse of uses water source"@en ;
    rdfs:comment "Inverse relation linking water source usage back to the operations or facilities that used them."@en ;
    rdfs:domain ffonto:WaterSource ;
    rdfs:range ffonto:FirefightingOperation ;
    owl:inverseOf ffonto:usesWaterSource .

ffonto:usingHandTools a owl:DatatypeProperty ;
    rdfs:label "using hand tools" ;
    rdfs:comment "Indicates firefighters using manual tools." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:utilityCrewPresent a owl:DatatypeProperty ;
    rdfs:label "utility crew present" ;
    rdfs:comment "True if utility crews are visible (power company, etc.)." ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:utilityImplementsPSPSOf a owl:ObjectProperty ;
    rdfs:label "utility implements PSPS Of" ;
    rdfs:comment "References utility organizations that implement planned shutoffs." ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:UtilityPowerShutoff ;
    owl:inverseOf ffonto:utilityImplementsPSPS .

ffonto:utilityPoleStatus a owl:DatatypeProperty ;
    rdfs:label "utility pole status" ;
    rdfs:comment "Utility pole condition: 'standing', 'leaning', or 'down'." ;
    rdfs:domain ffonto:PowerPole ;
    rdfs:range xsd:string .

ffonto:utilizesDevice a owl:ObjectProperty ;
    rdfs:label "utilizes device"@en ;
    rdfs:comment "Indicates the hardware or equipment utilized by an air quality mitigation strategy."@en ;
    rdfs:domain ffonto:AirQualityMitigationStrategy ;
    rdfs:range ffonto:AirQualityMitigationDevice ;
    owl:inverseOf ffonto:isDeviceUtilizedBy .

ffonto:validatesDataOf a owl:ObjectProperty ;
    rdfs:label "validates data of"@en ;
    rdfs:comment "Links a verification process, algorithm, or authority to the information source or dataset being checked for accuracy."@en ;
    rdfs:domain ffonto:SatelliteData ;
    rdfs:range ffonto:QualityControlProcess ;
    owl:inverseOf ffonto:validatesData .

ffonto:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "The numeric or literal value of the observed property." ;
    rdfs:domain ffonto:Result ;
    rdfs:range xsd:float .

ffonto:vegetationAlongCreekBlackened a owl:DatatypeProperty ;
    rdfs:label "vegetation along creek blackened" ;
    rdfs:comment "Indicates whether vegetation along a creek appears blackened from wildfire." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:vegetationDensity a owl:DatatypeProperty ;
    rdfs:label "vegetation density" ;
    rdfs:comment "Describes the density of vegetation such as sparse, moderate, or dense." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:vegetationDry a owl:DatatypeProperty ;
    rdfs:label "vegetation dry" ;
    rdfs:comment "Indicates whether vegetation is observed dry." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:vegetationMostAffected a owl:DatatypeProperty ;
    rdfs:label "vegetation most affected" ;
    rdfs:comment "Indicates which vegetation type appears most affected (grass, shrubs, trees)." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:vegetationPatchArea a owl:DatatypeProperty ;
    rdfs:label "vegetation patch area (ha)" ;
    rdfs:comment "Area of the vegetation patch in hectares." ;
    rdfs:domain ffonto:VegetationDistribution ;
    rdfs:range xsd:decimal .

ffonto:vehicleCarryingPeopleOrPets a owl:DatatypeProperty ;
    rdfs:label "vehicle carrying people or pets" ;
    rdfs:comment "Indicates that a vehicle contains occupants such as people or pets."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:vehicleCount a owl:DatatypeProperty ;
    rdfs:label "vehicle count" ;
    rdfs:comment "A count of vehicles observed or recorded in a given area."@en ;
    rdfs:domain ffonto:EmergencyVehicle ;
    rdfs:range xsd:integer .

ffonto:vehicleDamaged a owl:DatatypeProperty ;
    rdfs:label "vehicle damaged" ;
    rdfs:comment "Indicates whether a vehicle suffered wildfire damage." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehicleFuelLevel a owl:DatatypeProperty ;
    rdfs:label "vehicle fuel level" ;
    rdfs:comment "Suggested minimum fuel level before evacuation (e.g., percentage or fraction)." ;
    rdfs:domain ffonto:VehiclePreparation ;
    rdfs:range xsd:string .

ffonto:vehicleHeatDamageVisible a owl:DatatypeProperty ;
    rdfs:label "vehicle heat damage visible" ;
    rdfs:comment "Indicates whether vehicles show damage from fire or smoke." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehicleOnFire a owl:DatatypeProperty ;
    rdfs:label "vehicle on fire" ;
    rdfs:comment "Observation that a vehicle is actively burning."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:vehiclePartOf a owl:ObjectProperty ;
    rdfs:label "vehicle part of" ;
    rdfs:comment "Inverse - Indicates that a window is part of a vehicle." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range ffonto:Window ;
    owl:inverseOf ffonto:partOfVehicle .

ffonto:vehicleSafeDistance a owl:DatatypeProperty ;
    rdfs:label "vehicle parked safe distance from fire" ;
    rdfs:comment "Indicates whether a vehicle is parked safely away from flames." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehicleWindowsMelted a owl:DatatypeProperty ;
    rdfs:label "vehicle windows melted" ;
    rdfs:comment "Indicates whether the windows of a vehicle melted due to extreme heat." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehiclesOrderlyFlow a owl:DatatypeProperty ;
    rdfs:label "vehicles evacuating in orderly flow" ;
    rdfs:comment "Observation that traffic is moving in an organized and controlled manner."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:vehiclesParkedSafeDistance a owl:DatatypeProperty ;
    rdfs:label "vehicles parked safe distance from flames" ;
    rdfs:comment "Indicates whether vehicles are parked a safe distance away from flames." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:vehiclesTurningAround a owl:DatatypeProperty ;
    rdfs:label "vehicles reversing/turning due to blockage" ;
    rdfs:comment "Observation that vehicles are reversing course or turning to avoid hazards."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:verifiesReport a owl:ObjectProperty ;
    rdfs:label "verifies report"@en ;
    rdfs:comment "Indicates that a designated authority, secondary sensor, or validation process confirms the details of an incident log or alert."@en ;
    rdfs:domain ffonto:ReportVerification ;
    rdfs:range ffonto:CrowdsourcedReport ;
    owl:inverseOf ffonto:isVerifiedBy .

ffonto:visibilityCategory a owl:DatatypeProperty ;
    rdfs:label "visibility category (low/medium/high)" ;
    rdfs:comment "Categorical visibility derived from smoke observations." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:visibilityDistanceMiles a owl:DatatypeProperty ;
    rdfs:label "visibility distance miles" ;
    rdfs:comment "Visibility distance used to estimate air quality conditions." ;
    rdfs:domain ffonto:VisibilityRange ;
    rdfs:range xsd:float .

ffonto:visibilityForDriversCompromised a owl:DatatypeProperty ;
    rdfs:label "visibility for drivers compromised" ;
    rdfs:comment "Indicates whether smoke or flames reduce visibility for drivers." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:visibilityImpairedBySmoke a owl:DatatypeProperty ;
    rdfs:label "visibility impaired by smoke" ;
    rdfs:comment "Indicates whether smoke impairs visibility for responders or residents." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:visibilityKm a owl:DatatypeProperty ;
    rdfs:label "visibility (km)" ;
    rdfs:comment "Numeric visibility estimate in kilometers." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:decimal .

ffonto:visibilityReduced a owl:DatatypeProperty ;
    rdfs:label "visibility reduced by smoke" ;
    rdfs:comment "A general descriptor that visibility is impaired due to smoke, dust, or weather."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:visibilityReducedBySmoke a owl:DatatypeProperty ;
    rdfs:label "visibility reduced by smoke" ;
    rdfs:comment "An observation that atmospheric visibility is diminished due to smoke presence."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:visibilityValue a owl:DatatypeProperty ;
    rdfs:label "visibility value (km)" ;
    rdfs:comment "Numeric visibility in kilometers." ;
    rdfs:domain ffonto:VisibilityCondition ;
    rdfs:range xsd:decimal .

ffonto:visibleAircraftOf a owl:ObjectProperty ;
    rdfs:label "visible aircraft of" ;
    rdfs:comment "Inverse - Aircraft visible in camera frames." ;
    rdfs:domain ffonto:Aircraft ;
    rdfs:range ffonto:CameraObservation ;
    owl:inverseOf ffonto:visibleAircraft .

ffonto:warningVsOrder a owl:DatatypeProperty ;
    rdfs:label "difference between evacuation warning and order" ;
    rdfs:comment "A distinction between advisory warnings and mandatory evacuation orders."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:waterContaminationRisk a owl:DatatypeProperty ;
    rdfs:label "water contamination risk" ;
    rdfs:comment "Indicates whether runoff from burned areas may contaminate nearby water bodies." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range xsd:boolean .

ffonto:waterDiscolored a owl:DatatypeProperty ;
    rdfs:label "water discolored" ;
    rdfs:comment "Indicates whether water appears discolored due to soot, ash, or sediment." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range xsd:boolean .

ffonto:waterOrRetardantBeingDropped a owl:DatatypeProperty ;
    rdfs:label "water or retardant being dropped"@en ;
    rdfs:comment "Indicates that water or fire retardant is being released from an aircraft or other aerial platform over a target area."@en ;
    rdfs:domain ffonto:AircraftAction ;
    rdfs:range xsd:string .

ffonto:waterSafeToDrink a owl:DatatypeProperty ;
    rdfs:label "water safe to drink"@en ;
    rdfs:comment "Indicates whether a water source is considered safe for human consumption."@en ;
    rdfs:domain ffonto:WellWater ;
    rdfs:range xsd:boolean .

ffonto:waterSafetyNotice a owl:DatatypeProperty ;
    rdfs:label "water safety notice" ;
    rdfs:comment "Notice indicating whether tap water is safe after wildfire." ;
    rdfs:domain ffonto:WaterSafetyAdvisory ;
    rdfs:range xsd:string .

ffonto:waterSourceVisible a owl:DatatypeProperty ;
    rdfs:label "water source visible" ;
    rdfs:comment "Indicates visible water sources such as streams or ponds." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:waterTableDepth a owl:DatatypeProperty ;
    rdfs:label "water table depth (m)" ;
    rdfs:comment "Depth to groundwater table in meters." ;
    rdfs:domain ffonto:WaterAvailability ;
    rdfs:range xsd:decimal .

ffonto:waterTankVisible a owl:DatatypeProperty ;
    rdfs:label "water tank visible" ;
    rdfs:comment "Indicates whether water tanks or cisterns are visible in the scene." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:wayfindingSignsToSheltersVisible a owl:DatatypeProperty ;
    rdfs:label "wayfinding signs to shelters visible" ;
    rdfs:comment "Indicates that directional signage to shelters is observable and legible."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:wearsPPEOf a owl:ObjectProperty ;
    rdfs:label "inverse of wears ppe"@en ;
    rdfs:comment "Inverse relation linking PPE usage observations back to the personnel or roles wearing them."@en ;
    rdfs:domain ffonto:PPE ;
    rdfs:range ffonto:Firefighter ;
    owl:inverseOf ffonto:wearsPPE .

ffonto:weatherFlagForFire a owl:DatatypeProperty ;
    rdfs:label "weather fire flag" ;
    rdfs:comment "Indicator in weather record whether fire conditions are flagged (e.g., 'fire')." ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:string .

ffonto:weatherInfluencesFireBehaviorModel a owl:ObjectProperty ;
    rdfs:label "weather influences fire behavior model"@en ;
    rdfs:comment "Relates meteorological conditions to the computational model predicting fire spread and dynamics."@en ;
    rdfs:domain ffonto:WeatherFactor ;
    rdfs:range ffonto:FireBehaviorModel ;
    owl:inverseOf ffonto:isFireBehaviorModelInfluencedByWeather .

ffonto:weatherRow a owl:DatatypeProperty ;
    rdfs:label "weather row raw" ;
    rdfs:comment "Optional raw CSV row or JSON serialization for audit." ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:string .

ffonto:whiteGrayAshVisible a owl:DatatypeProperty ;
    rdfs:label "white or gray ash visible" ;
    rdfs:comment "Indicates presence of white or gray ash suggesting complete combustion." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:boolean .

ffonto:wildlifeAfterFireGuidance a owl:DatatypeProperty ;
    rdfs:label "guidance about wildlife encounters after a fire" ;
    rdfs:comment "Recommendations for protecting and managing wildlife in post-fire environments."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:windConsistentWithSmoke a owl:DatatypeProperty ;
    rdfs:label "wind consistent with smoke movement" ;
    rdfs:comment "Indicates that observed wind direction and speed align with smoke movement."@en ;
    rdfs:domain ffonto:ModalityConsistency ;
    rdfs:range xsd:boolean .

ffonto:windDirection a owl:DatatypeProperty ;
    rdfs:label "wind direction" ;
    rdfs:comment "The compass direction from which wind is blowing at a location."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:string .

ffonto:windEffectOnAerial a owl:DatatypeProperty ;
    rdfs:label "wind effect on aerial drops (yes/no/qualifier)" ;
    rdfs:comment "Assessment whether wind reduces aerial drop effectiveness." ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:string .

ffonto:windGust a owl:DatatypeProperty ;
    rdfs:label "wind gust (km/h)" ;
    rdfs:comment "Peak gust speed in km/h." ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range xsd:decimal .

ffonto:windSpeed a owl:DatatypeProperty ;
    rdfs:label "wind speed (km/h)" ;
    rdfs:comment "Sustained wind speed in km/h." ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range xsd:decimal .

ffonto:windStrong a owl:DatatypeProperty ;
    rdfs:label "is wind strong" ;
    rdfs:comment "High-level assessment whether wind is considered strong." ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:boolean .

ffonto:windowsBroken a owl:DatatypeProperty ;
    rdfs:label "windows broken" ;
    rdfs:comment "Indicates whether windows were broken due to heat or impact." ;
    rdfs:domain ffonto:Window ;
    rdfs:range xsd:boolean .

ffonto:windowsExposedToSmoke a owl:DatatypeProperty ;
    rdfs:label "windows exposed to smoke or embers" ;
    rdfs:comment "Indicates whether windows are exposed to smoke or embers during wildfire." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:windowsOrEavesExposedToSmoke a owl:DatatypeProperty ;
    rdfs:label "windows or eaves exposed to smoke" ;
    rdfs:comment "Indicates whether windows or eaves are exposed to flames or heavy smoke." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:workingNearOf a owl:ObjectProperty ;
    rdfs:label "inverse of working near"@en ;
    rdfs:comment "Inverse relation indicating personnel or equipment working near a referenced location or hazard."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:workingNear .

ffonto:zshotModel a owl:DatatypeProperty ;
    rdfs:label "zero-shot model"@en ;
    rdfs:comment "Relates an analytical process or system to the specific zero-shot learning AI model utilized for classification or prediction."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range xsd:string .

ffonto: a owl:Ontology ;
    cc:license "" ;
    dc:abstract "The Forest Fire Ontology (FFONTO) is designed to integrate multi-modal sensor data for early fire detection. It serves as an extensible framework with 'ForestFire' as the root class, incorporating concepts for visual detection, audio monitoring, and environmental conditions."@en ;
    dc:contributor [ foaf:name "Prof. Dulani Meedeniya"@en ;
            schema:identifier <https://orcid.org/0000-0002-4520-3819> ] ;
    dc:creator [ foaf:name "Ms. Charuni Kosala Jayaweera"@en ;
            schema:identifier <https://orcid.org/0009-0003-5790-62840> ] ;
    dc:description "This ontology describes forest fire detection observations including image, audio, and weather data."@en ;
    dc:title "Forest Fire Ontology (FFONTO)"@en ;
    dcterms:issued "2026-01-27"^^xsd:date ;
    dcterms:license "" ;
    vann:preferredNamespacePrefix "ffonto"@en ;
    rdfs:comment "Ontology for forest fire detection & observation (image, audio, weather). Root class: ForestFire. Designed for extensibility."@en ;
    rdfs:seeAlso <https://github.com/kosala0514/FFOnto> ;
    owl:versionIRI ffonto:V1.2 ;
    owl:versionInfo "Initial Release 1.0" ;
    ns2:status "Active" ;
    prov:generatedAtTime "2026-01-27T00:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo <https://github.com/kosala0514> .


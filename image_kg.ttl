ffonto:isRiskLevelOf a owl:ObjectProperty ;
    rdfs:label "is risk level of" ;
    rdfs:domain ffonto:FireRiskAssessment ;
    rdfs:range geo:SpatialObject .

ffonto:isRollbackImplementedBy a owl:ObjectProperty ;
    rdfs:label "is rollback implemented by"@en ;
    rdfs:comment "Inverse property linking a rollback strategy to the MLOps pipeline executing it."@en ;
    rdfs:domain ffonto:RollbackStrategy ;
    rdfs:range ffonto:MLOpsPipeline .

ffonto:isShelteredFrom a owl:ObjectProperty ;
    rdfs:label "is sheltered from"@en ;
    rdfs:comment "Indicates that a population, entity, or facility is protected from a specific hazard, such as a fire or toxic smoke plume."@en ;
    rdfs:domain ffonto:SmokePlume ;

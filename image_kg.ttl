    rdfs:subClassOf ffonto:SafetyMeasure .

ffonto:PreventionMethod a owl:Class ;
    rdfs:label "Prevention Method" ;
    rdfs:comment "Strategies or methods used to reduce wildfire risk." .

ffonto:ProtectionMethod a owl:Class ;
    rdfs:label "Protection Method" ;
    rdfs:comment "Method used to reduce smoke exposure or health risk." .

ffonto:ProtectiveEquipment a owl:Class ;

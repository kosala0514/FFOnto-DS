ffonto:hasEvacuationRoute a owl:ObjectProperty ;
    rdfs:label "has evacuation route" ;
    rdfs:comment "Associates a household or plan with one or more EvacuationRoute instances (including alternates)." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:EvacuationRoute .

ffonto:hasEventProvenanceRecord a owl:ObjectProperty ;
    rdfs:label "has event provenance record"@en ;
    rdfs:comment "Connects an incident, dataset, or decision to the historical log that documents its origin, timeline, and alterations."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range ffonto:ForestFire .

ffonto:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Connects a conclusion, assessment, or operational claim to the physical, digital, or observational data that supports it."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Observation .

ffonto:hasFinanceAdministrationSection a owl:ObjectProperty ;
    rdfs:label "has finance administration section"@en ;
    rdfs:comment "Links an incident command structure to the organizational unit responsible for tracking costs, time, and financial records."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:FinanceAdministrationSection .

ffonto:hasFireBehavior a owl:ObjectProperty ;
    rdfs:label "has fire behavior" ;
    rdfs:comment "Describes observed fire behavior (flame fronts, spot fires, torching)." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireBehavior .

ffonto:hasFireDriver a owl:ObjectProperty ;
    rdfs:label "has fire driver" ;
    rdfs:comment "Indicates the driver or cause responsible for a fire event." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireDriver .

ffonto:hasFireEngine a owl:ObjectProperty ;
    rdfs:label "has fire engine"@en ;
    rdfs:comment "Relates a firefighting organization, station, or incident response plan to the specific vehicular apparatus it deploys."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:FireEngine .

ffonto:hasFireEvent a owl:ObjectProperty ;
    rdfs:label "has fire event" ;
    rdfs:comment "Indicates that a forest ecosystem experienced a fire event." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range ffonto:ForestFire .

ffonto:hasFireFlank a owl:ObjectProperty ;
    rdfs:label "has fire flank"@en ;
    rdfs:comment "Connects a wildfire incident to its lateral boundaries (flanks), relative to the main direction of the fire's spread."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:FireFlank .

ffonto:hasFireFront a owl:ObjectProperty ;
    rdfs:label "has fire front"@en ;
    rdfs:comment "Relates a wildfire incident to its most active, rapidly advancing boundary of combustion."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:FireFront .

ffonto:hasFireRegime a owl:ObjectProperty ;
    rdfs:label "has fire regime"@en ;
    rdfs:comment "Links a specific ecosystem or geographic region to its historical pattern of fire frequency, seasonality, and intensity."@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:FireRegime .

ffonto:hasFireSpread a owl:ObjectProperty ;
    rdfs:label "has fire spread behavior" ;
    rdfs:comment "Relates an entity to information describing the progression or pattern of fire spread."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireSpread .

ffonto:hasFireSusceptibility a owl:ObjectProperty ;
    rdfs:label "has fire susceptibility" ;
    rdfs:comment "Relates an ecosystem or vegetation area to its wildfire susceptibility level." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:FireSusceptibility .

ffonto:hasFlammabilityLevel a owl:ObjectProperty ;
    rdfs:label "has flammability level" ;
    rdfs:comment "Associates a specific plant species with its inherent flammability trait." ;
    rdfs:domain ffonto:Plant ;
    rdfs:range ffonto:PlantFlammabilityTrait .

ffonto:hasForestStructure a owl:ObjectProperty ;
    rdfs:label "has forest structure" ;
    rdfs:comment "Relates a forest ecosystem to its structural characteristics." ;
    rdfs:domain ffonto:Forest ;
    rdfs:range ffonto:ForestStructure .

ffonto:hasFuel a owl:ObjectProperty ;
    rdfs:label "has fuel" ;
    rdfs:comment "Relates a fire event to the vegetation that acts as fuel." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Fuel .

ffonto:hasFuelCondition a owl:ObjectProperty ;
    rdfs:label "has fuel condition" ;
    rdfs:comment "Links an incident to observed/predicted fuel conditions." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FuelCondition .

ffonto:hasFuelType a owl:ObjectProperty ;
    rdfs:label "has fuel type" ;
    rdfs:comment "Links fuel materials to fuel categories." ;
    rdfs:domain ffonto:Fuel ;
    rdfs:range ffonto:FuelType .

ffonto:hasGridLocation a owl:ObjectProperty ;
    rdfs:label "has grid location" ;
    rdfs:comment "Provides a grid-based coordinate location for spatial referencing."@en ;
    rdfs:domain ffonto:SpatialExtent ;
    rdfs:range ffonto:GridLocation .

ffonto:hasGroundCrew a owl:ObjectProperty ;
    rdfs:label "has ground firefighting crew" ;
    rdfs:comment "Associates an incident or operation with assigned ground-based personnel."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:GroundCrew .

ffonto:hasGroundVisibility a owl:ObjectProperty ;
    rdfs:label "has ground visibility" ;
    rdfs:comment "Visibility condition for ground crews and public roads." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:GroundVisibility .

ffonto:hasHazard a owl:ObjectProperty ;
    rdfs:label "has hazard" ;
    rdfs:comment "Indicates hazards affecting roads or wildfire scenes." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:Road ffonto:WildfireScene ffonto:ForestFire ) ] ;
    rdfs:range ffonto:Hazard .

ffonto:hasHealthAffects a owl:ObjectProperty ;
    rdfs:label "affects (health/eco)" ;
    rdfs:comment "Relates an entity to health impacts or effects on people or animals."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SmokeHealthEffect .

ffonto:hasICSFunction a owl:ObjectProperty ;
    rdfs:label "has ICS function" ;
    rdfs:comment "Denotes assignment to an Incident Command System functional role (e.g., operations, planning)."@en ;
    rdfs:domain ffonto:IncidentCommandSystem ;
    rdfs:range ffonto:ICSFunction .

ffonto:hasIgnitionCause a owl:ObjectProperty ;
    rdfs:label "has ignition cause" ;
    rdfs:comment "Links a wildfire to its originating cause(s)." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:IgnitionCause .

ffonto:hasImageAsset a owl:ObjectProperty ;
    rdfs:label "has image asset" ;
    rdfs:comment "Relates an image-based observation to the actual digital or physical image file/asset." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range ffonto:ImageAsset .

ffonto:hasImageContribution a owl:ObjectProperty ;
    rdfs:label "has image contribution"@en ;
    rdfs:comment "Links a dataset, report, or analytical model to a specific photograph, satellite image, or visual data input that enhances it."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:ImageContribution .

ffonto:hasImageQualityMeta a owl:ObjectProperty ;
    rdfs:label "has image quality metadata" ;
    rdfs:comment "Links an image to its quality/metadata record." ;
    rdfs:domain ffonto:ImageAsset ;
    rdfs:range ffonto:ImageQualityMetadata .

ffonto:hasImpactHazard a owl:ObjectProperty ;
    rdfs:label "has impact hazard" ;
    rdfs:comment "Relates an entity to hazards that have tangible impacts on people, property, or environment."@en ;
    rdfs:domain ffonto:DropZone ;
    rdfs:range ffonto:ImpactHazard .

ffonto:hasLabelAssignment a owl:ObjectProperty ;
    rdfs:label "has label assignment"@en ;
    rdfs:comment "Connects an image observation to zero or more LabelAssignment instances."@en ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range ffonto:LabelAssignment .

ffonto:hasLandCover a owl:ObjectProperty ;
    rdfs:label "has land cover" ;
    rdfs:comment "Relates an ecosystem to the type of land cover present." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:LandCover .

ffonto:hasLocation a owl:ObjectProperty ;
    rdfs:label "located at" ;
    rdfs:comment "Indicates the place where a spatial entity is located." ;
    rdfs:domain ffonto:SpatialEntity ;
    rdfs:range ffonto:Observation .

ffonto:hasLogisticsSupport a owl:ObjectProperty ;
    rdfs:label "has logistics support"@en ;
    rdfs:comment "Connects an operation, incident, or entity to the supply chain and resource management framework sustaining it."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:LogisticsSection .

ffonto:hasMediaAsset a owl:ObjectProperty ;
    rdfs:label "has media asset" ;
    rdfs:comment "Connects incident to the captured media file." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:MediaAsset .

ffonto:hasModel a owl:ObjectProperty ;
    rdfs:label "has model",
        "has model"@en ;
    rdfs:comment "Relates a predictive system, research project, or hardware device to the specific computational framework or conceptual model it relies upon."@en ;
    rdfs:domain ffonto:ProvenanceRecord ;
    rdfs:range ffonto:MLModel .

ffonto:hasMonitoringObservation a owl:ObjectProperty ;
    rdfs:label "has monitoring observation" ;
    rdfs:comment "Links a spatial unit to remote-sensing or image-derived observations." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:Observation .

ffonto:hasNeighborSupportPlan a owl:ObjectProperty ;
    rdfs:label "has neighbor support plan"@en ;
    rdfs:comment "Links a community or jurisdiction to a mutual aid agreement or strategy for assisting adjacent areas."@en ;
    rdfs:domain ffonto:EvacuationZone ;
    rdfs:range ffonto:NeighborSupportPlan .

ffonto:hasOperation a owl:ObjectProperty ;
    rdfs:label "has operation" ;
    rdfs:comment "Indicates that an operation occurs in a wildfire scene." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range ffonto:WildfireScene .

ffonto:hasPerimeterSnapshot a owl:ObjectProperty ;
    rdfs:label "has perimeter snapshot" ;
    rdfs:comment "Links an incident to the latest perimeter snapshot used to compute area." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:PerimeterSnapshot .

ffonto:hasPlantComponent a owl:ObjectProperty ;
    rdfs:label "has plant component" ;
    rdfs:comment "Relates a vegetation unit or plant community to the plant species or plant types that constitute its biological components." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:Plant .

ffonto:hasPredictionUncertainty a owl:ObjectProperty ;
    rdfs:label "has prediction uncertainty"@en ;
    rdfs:comment "Relates a forecasted value or model output to its calculated margin of error or statistical confidence interval."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:PredictionUncertainty .

ffonto:hasPredictiveInterval a owl:ObjectProperty ;
    rdfs:label "has predictive interval"@en ;
    rdfs:comment "Links a forecasted value or simulation model to the specific time horizon (e.g., 24 hours, 7 days) it projects."@en ;
    rdfs:domain ffonto:EnsembleForecast ;
    rdfs:range ffonto:PredictiveInterval .

ffonto:hasPreparednessPlan a owl:ObjectProperty ;
    rdfs:label "has preparedness plan"@en ;
    rdfs:comment "Links a community, organization, or facility to its documented strategy for anticipating and responding to emergencies."@en ;
    rdfs:domain ffonto:EvacuationZone ;
    rdfs:range ffonto:ReadySetGoPlan .

ffonto:hasPreventionMethod a owl:ObjectProperty ;
    rdfs:label "has prevention method" ;
    rdfs:comment "Links wildfire management strategies to prevention methods." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:PreventionMethod .

ffonto:hasProtectionMeasure a owl:ObjectProperty ;
    rdfs:label "has protection measure" ;
    rdfs:comment "Associates an entity with a specific mitigation or protective action."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ProtectionMeasure .

ffonto:hasProvenanceRecord a owl:ObjectProperty ;
    rdfs:label "has provenance record",
        "has provenance record"@en ;
    rdfs:comment "Links a dataset, physical sample, or analytical conclusion to the detailed historical log of its origin and chain of custody."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:ProvenanceRecord .

ffonto:hasRateOfSpread a owl:ObjectProperty ;
    rdfs:label "has rate of spread"@en ;
    rdfs:comment "Relates a fire incident or moving phenomenon to the quantitative metric describing its speed of expansion."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:RateOfSpread .

ffonto:hasRecoveryGuideline a owl:ObjectProperty ;
    rdfs:label "has recovery guideline" ;
    rdfs:comment "Links wildfire scenes with recovery guidelines." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:RecoveryGuideline .

ffonto:hasRehabArea a owl:ObjectProperty ;
    rdfs:label "has rehab area" ;
    rdfs:comment "Indicates a firefighter rest area at the wildfire scene." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:RehabArea .

ffonto:hasRequiredItem a owl:ObjectProperty ;
    rdfs:label "has required item" ;
    rdfs:comment "Links a PreparednessKit or EvacuationProcedure to required PreparednessItem instances." ;
    rdfs:domain ffonto:PreparednessKit ;
    rdfs:range ffonto:PreparednessItem .

ffonto:hasResourcePlacement a owl:ObjectProperty ;
    rdfs:label "has resource placement" ;
    rdfs:comment "Describes the assigned location or staging of resources for operational use."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ResourcePlacement .

ffonto:hasRestorationStrategy a owl:ObjectProperty ;
    rdfs:label "has restoration strategy" ;
    rdfs:comment "Links wildfire scenes to recommended restoration strategies." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:RestorationStrategy .

ffonto:hasResult a owl:ObjectProperty ;
    rdfs:label "has result",
        "has result"@en ;
    rdfs:comment "Links a process, computation, or physical event to its direct outcome, measurement, or consequential state."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:Result .

ffonto:hasRiskAssessment a owl:ObjectProperty ;
    rdfs:label "has risk assessment" ;
    rdfs:comment "Links an entity to an assessment that evaluates potential risks and vulnerabilities."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireRiskAssessment .

ffonto:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Links ICS functions to named roles." ;
    rdfs:domain ffonto:ICSFunction ;
    rdfs:range ffonto:IncidentCommander .

ffonto:hasShelterOption a owl:ObjectProperty ;
    rdfs:label "has shelter option" ;
    rdfs:comment "Links a plan or household to potential shelter options (friend/family/shelter)." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:EvacuationShelter .

ffonto:hasSmokeComponent a owl:ObjectProperty ;
    rdfs:label "has component",
        "is smoke component"@en ;
    rdfs:comment "Indicates that a substance or particle is a component of smoke produced by fire."@en ;
    rdfs:domain ffonto:Smoke ;
    rdfs:range ffonto:SmokeComponent .

ffonto:hasSmokeLayers a owl:ObjectProperty ;
    rdfs:label "has smoke layers" ;
    rdfs:comment "Links smoke observation to one or more layer descriptions." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range ffonto:SmokeLayerObservation .

ffonto:hasSmokeObservation a owl:ObjectProperty ;
    rdfs:label "has smoke observation" ;
    rdfs:comment "Link from incident to smoke details observed in the frame." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SmokeObservation ;
    rdfs:subPropertyOf ffonto:hasObservation .

ffonto:hasSnowCover a owl:ObjectProperty ;
    rdfs:label "has snow cover" ;
    rdfs:comment "Indicates the presence of snow cover within the forest ecosystem." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range ffonto:SnowCover .

ffonto:hasSoilCondition a owl:ObjectProperty ;
    rdfs:label "has soil condition" ;
    rdfs:comment "Specifies the soil condition present in a forest ecosystem." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range ffonto:SoilCondition .

ffonto:hasSoilMoistureIndex a owl:ObjectProperty ;
    rdfs:label "has soil moisture index"@en ;
    rdfs:comment "Relates a geographic region or environmental dataset to a quantifiable metric representing the water content in the ground."@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:SoilMoistureIndex .

ffonto:hasSoilQuality a owl:ObjectProperty ;
    rdfs:label "has soil quality" ;
    rdfs:comment "Relates an ecosystem to the quality of its soil." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:SoilQuality .

ffonto:hasSpecialNeedsPlan a owl:ObjectProperty ;
    rdfs:label "has special needs plan" ;
    rdfs:comment "Links a household or organization to a SpecialNeedsPlan instance." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:SpecialNeedsPlan .

ffonto:hasSpottingEvent a owl:ObjectProperty ;
    rdfs:label "has spotting event" ;
    rdfs:comment "Indicates occurrence of fire spotting (embers igniting new fires separate from main front)."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SpottingEvent .

ffonto:hasStatistic a owl:ObjectProperty ;
    rdfs:label "has statistic" ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range ffonto:WildfireStatistic .

ffonto:hasStructureDefense a owl:ObjectProperty ;
    rdfs:label "has structure defense" ;
    rdfs:comment "Link a structure to defensive measures." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:StructureDefense .

ffonto:hasStructureLossStatus a owl:ObjectProperty ;
    rdfs:label "has structure loss status" ;
    rdfs:comment "Describes whether a structure has been lost, damaged, or remains intact."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range ffonto:StructureLossStatus .

ffonto:hasSuppressionDifficulty a owl:ObjectProperty ;
    rdfs:label "has suppression difficulty assessment" ;
    rdfs:comment "A descriptor indicating the relative difficulty of suppressing a fire or hazard."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuppressionDifficulty .

ffonto:hasSuppressionLimit a owl:ObjectProperty ;
    rdfs:label "has suppression limitation" ;
    rdfs:comment "Factors that reduce effectiveness of suppression methods." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range ffonto:Limitations .

ffonto:hasSuppressionOperation a owl:ObjectProperty ;
    rdfs:label "has suppression operation" ;
    rdfs:comment "Links an incident or area to an active suppression activity or campaign."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:SuppressionOperation .

ffonto:hasSymptom a owl:ObjectProperty ;
    rdfs:label "has symptom" ;
    rdfs:comment "Associates an entity (person or animal) with an observed symptom or sign."@en ;
    rdfs:domain ffonto:SmokeHealthEffect ;
    rdfs:range ffonto:HealthSymptom .

ffonto:hasTemporalExtent a owl:ObjectProperty ;
    rdfs:label "has temporal extent",
        "has temporal extent"@en ;
    rdfs:comment "has temporal extent for each observation",
        "Relates an event, phenomenon, or operation to the specific time interval or exact duration during which it occurs."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:TemporalExtent .

ffonto:hasTerrainFeature a owl:ObjectProperty ;
    rdfs:label "has terrain feature" ;
    rdfs:comment "Link fire to a specific terrain feature (slope, valley)." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:TerrainFeature .

ffonto:hasTerrainType a owl:ObjectProperty ;
    rdfs:label "has terrain type" ;
    rdfs:comment "Relates an ecosystem to its terrain classification." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:TerrainType .

ffonto:hasThresholdSet a owl:ObjectProperty ;
    rdfs:label "has threshold set" ;
    rdfs:comment "Associates predictions or model outputs with ThresholdSet instances." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range ffonto:ThresholdSet .

ffonto:hasTreeSpecies a owl:ObjectProperty ;
    rdfs:label "has tree species" ;
    rdfs:comment "Indicates the tree species present in a forest ecosystem." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range ffonto:Tree .

ffonto:hasTrend a owl:ObjectProperty ;
    rdfs:label "has trend"@en ;
    rdfs:comment "Relates a dataset, metric, or phenomenon to the observable directional change or pattern over time."@en ;
    rdfs:domain ffonto:FireRadiativePower ;
    rdfs:range ffonto:Trend .

ffonto:hasUnderstory a owl:ObjectProperty ;
    rdfs:label "has understory" ;
    rdfs:comment "Connects an ecosystem to its understory component." ;
    rdfs:domain ffonto:ForestEcosystem ;
    rdfs:range ffonto:Understory .

ffonto:hasVegetationCondition a owl:ObjectProperty ;
    rdfs:label "has vegetation condition" ;
    rdfs:comment "Relates vegetation to its health condition." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:VegetationCondition .

ffonto:hasVehicleDamage a owl:ObjectProperty ;
    rdfs:label "has vehicle damage" ;
    rdfs:comment "Indicates that a vehicle has suffered structural damage." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range ffonto:StructuralDamage .

ffonto:hasVisibilityCategory a owl:ObjectProperty ;
    rdfs:label "has visibility category"@en ;
    rdfs:comment "Relates an atmospheric observation or geographic area to a standardized classification of visual range, often degraded by smoke."@en ;
    rdfs:domain ffonto:SmokePlume ;
    rdfs:range ffonto:VisibilityCategory .

ffonto:hasVisionModelScores a owl:ObjectProperty ;
    rdfs:label "has vision model scores",
        "has vision model scores"@en ;
    rdfs:comment "Links an image, video frame, or visual dataset to the quantitative confidence scores generated by a computer vision model."@en ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range ffonto:VisionModelScores .

ffonto:hasWaterTank a owl:ObjectProperty ;
    rdfs:label "has water tank" ;
    rdfs:comment "Indicates a house having a rooftop water tank or cistern." ;
    rdfs:domain ffonto:House ;
    rdfs:range ffonto:WaterTank .

ffonto:hasZone a owl:ObjectProperty ;
    rdfs:label "has zone",
        "is zone"@en ;
    rdfs:comment "Relates a defensible space to its zones.",
        "Indicates that an area or region is classified as a specific type of zone."@en ;
    rdfs:domain ffonto:DefensibleSpace ;
    rdfs:range ffonto:DefensibleZone .

ffonto:healthAffectedByPM25 a owl:ObjectProperty ;
    rdfs:label "health affected by PM2.5"@en ;
    rdfs:comment "Indicates that a specific medical condition or public health metric is impacted by fine particulate matter (PM2.5) exposure."@en ;
    rdfs:domain ffonto:RespiratoryDisease ;
    rdfs:range ffonto:ParticulateMatterPM25 .

ffonto:heavyEquipmentInUse a owl:ObjectProperty ;
    rdfs:label "heavy equipment in use" ;
    rdfs:comment "Indicates that heavy machinery (e.g., dozers, graders) is being employed on-site."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:HeavyEquipment .

ffonto:impactsEcosystem a owl:ObjectProperty ;
    rdfs:label "impacts ecosystem" ;
    rdfs:comment "Indicates that an environmental factor affects an ecosystem." ;
    rdfs:domain ffonto:ClimateChange ;
    rdfs:range ffonto:Ecosystem .

ffonto:impactsTransportation a owl:ObjectProperty ;
    rdfs:label "impacts transportation routes" ;
    rdfs:comment "Indicates that an event or condition affects transport systems and mobility."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:TransportationRoute .

ffonto:impairsVisibility a owl:ObjectProperty ;
    rdfs:label "impairs visibility" ;
    rdfs:comment "Whether the hazard reduces visibility (true/false)." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:implementsPSPS a owl:ObjectProperty ;
    rdfs:label "implements PSPS" ;
    rdfs:comment "Indicates execution of Public Safety Power Shutoff procedures to reduce fire ignition risk."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range ffonto:PSPS .

ffonto:impliesHighSeverity a owl:ObjectProperty ;
    rdfs:label "implies high severity" ;
    rdfs:comment "Indicates that fuel load combined with ignition source conditions suggests high fire severity." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:FireSeverity ;
    owl:propertyChainAxiom ( ffonto:hasFuelLoad ffonto:hasIgnitionSource ) .

ffonto:improvesSafety a owl:ObjectProperty ;
    rdfs:label "improves safety using equipment" ;
    rdfs:comment "Indicates that an action or measure enhances safety or reduces risk."@en ;
    rdfs:domain ffonto:FirefighterHealthSafety ;
    rdfs:range ffonto:ProtectiveEquipment .

ffonto:includesPetPlan a owl:ObjectProperty ;
    rdfs:label "includes pet plan" ;
    rdfs:comment "Links a household plan to PetPreparation activities." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range ffonto:PetPreparation .

ffonto:increasesEnvironmentalRisk a owl:ObjectProperty ;
    rdfs:label "increases environmental risk" ;
    rdfs:comment "Indicates factors that increase environmental hazards." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:EnvironmentalRisk .

ffonto:increasesErosionRisk a owl:ObjectProperty ;
    rdfs:label "increases erosion risk" ;
    rdfs:comment "Indicates that a fire event elevates post-fire erosion risk." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ErosionRisk .

ffonto:increasesFireRisk a owl:ObjectProperty ;
    rdfs:label "increases fire risk" ;
    rdfs:comment "Indicates that an environmental factor increases wildfire risk through vegetation distribution and fuel load." ;
    rdfs:domain ffonto:SpatialUnit ;
    rdfs:range ffonto:ForestFireRisk ;
    owl:propertyChainAxiom ( ffonto:hasVegetationDistribution ffonto:hasFuelLoad ) .

ffonto:increasesHumanAccess a owl:ObjectProperty ;
    rdfs:label "increases human access" ;
    rdfs:comment "Indicates that infrastructure increases human access to ecosystems." ;
    rdfs:domain ffonto:Road ;
    rdfs:range ffonto:Ecosystem .

ffonto:increasesRunoff a owl:ObjectProperty ;
    rdfs:label "increases runoff" ;
    rdfs:comment "Indicates that a wildfire increases surface water runoff due to reduced vegetation and altered soil conditions." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Runoff .

ffonto:increasesWildfireRisk a owl:ObjectProperty ;
    rdfs:label "increases wildfire risk" ;
    rdfs:comment "Indicates that a condition contributes to increased wildfire risk." ;
    rdfs:domain ffonto:ForestFireRiskFactor ;
    rdfs:range ffonto:FireBehavior .

ffonto:indicatesCombustion a owl:ObjectProperty ;
    rdfs:label "indicates combustion"@en ;
    rdfs:comment "Relates a chemical, thermal, or visual signature to the active presence of burning material."@en ;
    rdfs:domain ffonto:SmokeColor ;
    rdfs:range ffonto:CombustionProcess .

ffonto:indicatesEcologicalStress a owl:ObjectProperty ;
    rdfs:label "indicates ecological stress" ;
    rdfs:comment "Relates vegetation conditions to ecological stress indicators." ;
    rdfs:domain ffonto:VegetationCondition ;
    rdfs:range ffonto:EcologicalStress .

ffonto:influencedByGroundwater a owl:ObjectProperty ;
    rdfs:label "influenced by groundwater"@en ;
    rdfs:comment "Indicates that an environmental condition or feature is affected by groundwater presence or movement."@en ;
    rdfs:domain ffonto:WaterAvailability ;
    rdfs:range ffonto:Groundwater .

ffonto:influencedBySoilQuality a owl:ObjectProperty ;
    rdfs:label "influenced by soil quality" ;
    rdfs:comment "Indicates soil quality factors influencing vegetation distribution." ;
    rdfs:domain ffonto:VegetationDistribution ;
    rdfs:range ffonto:SoilQuality .

ffonto:influencedByWaterAvailability a owl:ObjectProperty ;
    rdfs:label "influenced by water availability" ;
    rdfs:comment "Indicates water availability effects on vegetation distribution." ;
    rdfs:domain ffonto:VegetationDistribution ;
    rdfs:range ffonto:WaterAvailability .

ffonto:influencedByWeather a owl:ObjectProperty ;
    rdfs:label "influenced by weather" ;
    rdfs:comment "Indicates wildfire risk influenced by weather variability." ;
    rdfs:domain ffonto:ForestFireRisk ;
    rdfs:range ffonto:WeatherCondition .

ffonto:influencesFireBehaviorByCharacteristic a owl:ObjectProperty ;
    rdfs:label "influences fire behavior by characteristic"@en ;
    rdfs:comment "Links a terrain feature or environmental condition to the specific physical attributes (like slope or density) that alter fire dynamics."@en ;
    rdfs:domain ffonto:FuelCharacteristic ;
    rdfs:range ffonto:FireBehavior .

ffonto:inhibitsSpecies a owl:ObjectProperty ;
    rdfs:label "inhibits species group" ;
    rdfs:comment "Indicates which functional groups are suppressed by a given ecological effect." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:VegetationFunctionalGroup .

ffonto:involvesFirefighter a owl:ObjectProperty ;
    rdfs:label "involves firefighter" ;
    rdfs:comment "Indicates firefighters participating in an operation." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range ffonto:Firefighter .

ffonto:isAccessRestrictedBy a owl:ObjectProperty ;
    rdfs:label "is access restricted by"@en ;
    rdfs:comment "Links a geographic area or facility to the policy, hazard, or authority that limits entry."@en ;
    rdfs:domain ffonto:DataRepository ;
    rdfs:range ffonto:AccessConstraint .

ffonto:isAffectedByAnomaly a owl:ObjectProperty ;
    rdfs:label "is affected by anomaly"@en ;
    rdfs:comment "Connects a system, dataset, or operational baseline to an unexpected deviation or irregular event impacting it."@en ;
    rdfs:domain ffonto:FireRegime ;
    rdfs:range ffonto:ClimateAnomaly .

ffonto:isAffectedByEvapotranspiration a owl:ObjectProperty ;
    rdfs:label "is affected by evapotranspiration"@en ;
    rdfs:comment "Indicates that fuel moisture, fire behavior, or local climate is influenced by the transfer of water from land and plants to the atmosphere."@en ;
    rdfs:domain ffonto:FuelMoisture ;
    rdfs:range ffonto:Evapotranspiration .

ffonto:isAirspaceRestrictedBy a owl:ObjectProperty ;
    rdfs:label "is airspace restricted by"@en ;
    rdfs:comment "Links a designated flight zone to the authority, incident, or condition enforcing a temporary flight restriction (TFR)."@en ;
    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:TemporaryFlightRestriction .

ffonto:isAnalyzedByAudio a owl:ObjectProperty ;
    rdfs:label "is analyzed by audio"@en ;
    rdfs:comment "Relates an event, operational environment, or mechanical system to the acoustic processing techniques used to monitor it."@en ;
    rdfs:domain ffonto:TelemetryData ;
    rdfs:range ffonto:AudioAnalytics .

ffonto:isAnalyzedTemporally a owl:ObjectProperty ;
    rdfs:label "is analyzed temporally"@en ;
    rdfs:comment "Indicates that a dataset, event sequence, or phenomenon is examined based on its chronological patterns and time-based progression."@en ;
    rdfs:domain ffonto:TelemetryData ;
    rdfs:range ffonto:TimeSeriesAnalysis .

ffonto:isAnnotationOf a owl:ObjectProperty ;
    rdfs:label "is annotation of" ;
    rdfs:comment "inverse of has annotation" ;
    rdfs:domain ffonto:Annotation ;
    rdfs:range ffonto:Observation .

ffonto:isApplicableToScene a owl:ObjectProperty ;
    rdfs:label "is applicable to scene"@en ;
    rdfs:comment "Indicates that a hazardous waste guideline must be followed in a specific wildfire scene after the fire." ;
    rdfs:domain ffonto:HazardousWasteGuideline ;
    rdfs:range ffonto:WildfireScene .

ffonto:isAssessedBy a owl:ObjectProperty ;
    rdfs:label "is assessed by"@en ;
    rdfs:comment "Relates a risk level, operational situation, or geographic area to the analytical process, system, or personnel evaluating it."@en ;
    rdfs:domain ffonto:BurnSeverityMap ;
    rdfs:range ffonto:BAERAssessment .

ffonto:isBriefedBy a owl:ObjectProperty ;
    rdfs:label "is briefed by"@en ;
    rdfs:comment "Relates an incident, operational period, or responder to the specific role or document providing status updates and situational awareness."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:IncidentBriefing .

ffonto:isCloudCoverProcessedBy a owl:ObjectProperty ;
    rdfs:label "is cloud cover processed by"@en ;
    rdfs:comment "Inverse property indicating which atmospheric transport model processes the cloud cover quality."@en ;
    rdfs:domain ffonto:CloudCoverQuality ;
    rdfs:range ffonto:AtmosphericTransportModel .

ffonto:isCombinedInForecast a owl:ObjectProperty ;
    rdfs:label "is combined in forecast"@en ;
    rdfs:comment "Indicates that a specific dataset, meteorological variable, or individual model is integrated into a larger synthesized prediction."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:EnsembleForecast .

ffonto:isCombustionAffectedByChemicalComponent a owl:ObjectProperty ;
    rdfs:label "is combustion affected by chemical component"@en ;
    rdfs:comment "Indicates that the burning characteristics of a fuel are modulated by its specific chemical makeup, such as volatile oils."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:VegetationChemicalComponent .

ffonto:isCombustionAffectedByFuelMoisture a owl:ObjectProperty ;
    rdfs:label "is combustion affected by fuel moisture"@en ;
    rdfs:comment "Relates the burning process of a fire to the modulating influence of water content within the available biomass."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:FuelMoisture .

ffonto:isConsumedIn a owl:ObjectProperty ;
    rdfs:label "is consumed in"@en ;
    rdfs:comment "Connects a resource, such as water, retardant, or fuel, to the specific incident or operational process that depletes it."@en ;
    rdfs:domain ffonto:FuelCharacteristic ;
    rdfs:range ffonto:CombustionProcess .

ffonto:isContainedByFireLine a owl:ObjectProperty ;
    rdfs:label "is contained by fire line"@en ;
    rdfs:comment "Links a fire incident or advancing front to the physical barrier constructed or utilized to stop its spread."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:FireLine .

ffonto:isDataEntityGeneratedBy a owl:ObjectProperty ;
    rdfs:label "is data entity generated by"@en ;
    rdfs:comment "Inverse property linking a data entity back to the activity that generated it."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity .

ffonto:isDataReliedOnBy a owl:ObjectProperty ;
    rdfs:label "is data relied on by"@en ;
    rdfs:comment "Inverse property indicating the sensor fusion process that depends on specific observation data."@en ;
    rdfs:domain ffonto:EarthObservationData ;
    rdfs:range ffonto:SensorFusion .

ffonto:isDetectedBy a owl:ObjectProperty ;
    rdfs:label "is detected by"@en ;
    rdfs:comment "Connects a phenomenon, incident, or entity to the sensor, system, or agent that discovers it."@en ;
    rdfs:domain ffonto:FireFront ;
    rdfs:range ffonto:ActiveFireDetection .

ffonto:isDetectedByThermalCamera a owl:ObjectProperty ;
    rdfs:label "is detected by thermal camera"@en ;
    rdfs:comment "Indicates that an entity, heat source, or phenomenon is identified specifically using an infrared or thermal imaging device."@en ;
    rdfs:domain ffonto:ActiveFireDetection ;
    rdfs:range ffonto:ThermalCamera .

ffonto:isDeviceUtilizedBy a owl:ObjectProperty ;
    rdfs:label "is device utilized by"@en ;
    rdfs:comment "Inverse property linking a device to the mitigation strategy utilizing it."@en ;
    rdfs:domain ffonto:AirQualityMitigationDevice ;
    rdfs:range ffonto:AirQualityMitigationStrategy .

ffonto:isEcologicalEffectOf a owl:ObjectProperty ;
    rdfs:label "is ecological effect of" ;
    rdfs:comment "Connects a biological or environmental impact (like habitat loss) back to the specific natural disaster that caused it."@en ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:ForestFire ;

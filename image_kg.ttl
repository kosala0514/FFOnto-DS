    rdfs:comment "Connects a physical resource, equipment, or supply to the logistical database or ledger that tracks its availability."@en ;
    rdfs:domain ffonto:EmissionEstimate ;
    rdfs:range ffonto:EmissionInventory .

ffonto:isReportedByCitizen a owl:ObjectProperty ;
    rdfs:label "is reported by citizen"@en ;
    rdfs:comment "Indicates that an incident, hazard, or observation was submitted by a member of the public rather than an automated system or official responder."@en ;
    rdfs:domain ffonto:WildfireIncident ;

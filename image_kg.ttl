ffonto:imageResolutionHeight a owl:DatatypeProperty ;
    rdfs:label "image height (px)" ;
    rdfs:comment "Image height in pixels." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:integer ;
    owl:deprecated true .

ffonto:imageResolutionWidth a owl:DatatypeProperty ;
    rdfs:label "image width (px)" ;
    rdfs:comment "Image width in pixels." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:integer ;
    owl:deprecated true .

ffonto:imageSourceLiteral a owl:DatatypeProperty ;
    rdfs:label "image source literal",
        "image source literal"@en ;
    rdfs:comment "Records the specific camera, satellite platform, or digital repository from which a visual asset was acquired."@en ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:string .

ffonto:imageSpatialFootprintStored a owl:DatatypeProperty ;
    rdfs:label "spatial footprint polygon stored" ;
    rdfs:comment "Whether a spatial footprint polygon is stored for the image." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:boolean .

ffonto:imageWidthPx a owl:DatatypeProperty ;
    rdfs:label "image width px",
        "image width px"@en ;
    rdfs:comment "Specifies the horizontal dimension of a digital image or visual matrix, measured in pixels."@en ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:integer .

ffonto:impactAffectsWildlife a owl:ObjectProperty ;
    rdfs:label "impact affects wildlife"@en ;
    rdfs:comment "Indicates that a particular environmental or physical impact has direct consequences for local animal populations or habitats."@en ;
    rdfs:domain ffonto:WildlifeImpact ;
    rdfs:range ffonto:Wildlife ;
    owl:inverseOf ffonto:isWildlifeAffectedByImpact .

ffonto:impactsEcosystemOf a owl:ObjectProperty ;
    rdfs:label "inverse of impacts ecosystem"@en ;
    rdfs:comment "Inverse relation linking ecosystem impacts back to the actions or disturbances that produce them."@en ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:ClimateChange ;
    owl:inverseOf ffonto:impactsEcosystem .

ffonto:impactsTransportationOf a owl:ObjectProperty ;
    rdfs:label "impacts transportation routes of",
        "impacts transportation of"@en ;
    rdfs:comment "Links a hazard, visibility reduction, or physical barrier back to the specific road network, railway, or logistical route it impedes."@en ;
    rdfs:domain ffonto:TransportationRoute ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:impactsTransportation .

ffonto:impairsVisibilityOf a owl:ObjectProperty ;
    rdfs:label "impairs visibility of" ;
    rdfs:comment "Inverse - Whether the hazard reduces visibility (true/false)." ;
    rdfs:domain xsd:boolean ;
    rdfs:range ffonto:Hazard ;
    owl:inverseOf ffonto:impairsVisibility .

ffonto:implementsPSPSOf a owl:ObjectProperty ;
    rdfs:label "implements PSPS of",
        "implements PSPS of"@en ;
    rdfs:comment "Connects an executed Public Safety Power Shutoff (PSPS) event back to the utility policy or hazard mitigation plan that required it."@en ;
    rdfs:domain ffonto:PSPS ;
    rdfs:range owl:Thing ;
    owl:inverseOf ffonto:implementsPSPS .

ffonto:implementsRollback a owl:ObjectProperty ;
    rdfs:label "implements rollback"@en ;
    rdfs:comment "Connects an MLOps Pipeline to its corresponding data or model rollback strategy."@en ;
    rdfs:domain ffonto:MLOpsPipeline ;
    rdfs:range ffonto:RollbackStrategy ;
    owl:inverseOf ffonto:isRollbackImplementedBy .

ffonto:impliesHighSeverityOf a owl:ObjectProperty ;
    rdfs:label "inverse of implies high severity"@en ;
    rdfs:comment "Inverse relation indicating that certain conditions imply high severity for a specific event or location."@en ;
    rdfs:domain ffonto:FireSeverity ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:impliesHighSeverity .

ffonto:improvesAirQuality a owl:ObjectProperty ;
    rdfs:label "improves air quality"@en ;
    rdfs:comment "Connects an action, mitigation strategy, or device to its positive effect on atmospheric conditions."@en ;
    rdfs:domain ffonto:AirCleaner ;
    rdfs:range ffonto:IndoorAirQualityStrategy ;
    owl:inverseOf ffonto:usesAirCleaner .

ffonto:improvesIndoorAir a owl:ObjectProperty ;
    rdfs:label "improves indoor air"@en ;
    rdfs:comment "Indicates that a mitigation strategy or filtration device specifically targets and enhances the air quality inside a structure."@en ;
    rdfs:domain ffonto:IndoorAirQualityStrategy ;
    rdfs:range ffonto:AirCleaner ;
    owl:inverseOf ffonto:isUsedInStrategy .

ffonto:improvesSafetyOf a owl:ObjectProperty ;
    rdfs:label "inverse of improves safety"@en ;
    rdfs:comment "Inverse relation linking safety improvements back to the measures or programs implementing them."@en ;
    rdfs:domain ffonto:ProtectiveEquipment ;
    rdfs:range ffonto:FirefighterHealthSafety ;
    owl:inverseOf ffonto:improvesSafety .

ffonto:incidentCommandPostVisible a owl:DatatypeProperty ;
    rdfs:label "incident command post visible" ;
    rdfs:comment "Indicates whether a visible incident command post sign exists." ;
    rdfs:domain ffonto:WildfireScene ;

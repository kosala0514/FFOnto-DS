ffonto:captionSuggestsGrowth a owl:DatatypeProperty ;
    rdfs:label "caption suggests active growth?" ;
    rdfs:comment "Whether the caption implies active growth rather than static smoke." ;
    rdfs:domain ffonto:CaptionModelOutput ;
    rdfs:range xsd:boolean .

ffonto:captionText a owl:DatatypeProperty ;
    rdfs:label "caption text" ;
    rdfs:comment "Caption text output by the caption model." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:string .

ffonto:captionVisionConsistency a owl:DatatypeProperty ;
    rdfs:label "caption consistent with vision scores" ;
    rdfs:comment "A measure indicating alignment between captions and the visual content of media."@en ;
    rdfs:domain ffonto:ModalityConsistency ;
    rdfs:range xsd:boolean .

ffonto:captureTimeUTC a owl:DatatypeProperty ;
    rdfs:label "capture time UTC",
        "capture time UTC"@en ;
    rdfs:comment "Records the exact temporal instant an image, audio clip, or observation was recorded, standardized to Coordinated Universal Time."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:dateTime .

ffonto:carbonReleased a owl:DatatypeProperty ;
    rdfs:label "carbon released" ;
    rdfs:comment "Amount of carbon released into the atmosphere due to a fire event." ;
    rdfs:domain ffonto:FireImpact ;
    rdfs:range xsd:decimal .

ffonto:carbonReleasedKg a owl:DatatypeProperty ;
    rdfs:label "carbon released (kg)" ;
    rdfs:comment "Estimated carbon mass released by the fire event in kilograms." ;
    rdfs:domain ffonto:CarbonRelease ;
    rdfs:range xsd:decimal .

ffonto:carriesSensor a owl:ObjectProperty ;
    rdfs:label "carries sensor"@en ;
    rdfs:comment "Links a platform, such as a UAV or ground vehicle, to the observational hardware it physically transports."@en .

ffonto:carriesSensorOf a owl:ObjectProperty ;
    rdfs:label "carries sensor of"@en ;
    rdfs:comment "Relates a carrying platform to the specific type, network, or owner of the sensor it is equipped with."@en .

ffonto:carsParkedFacingRoad a owl:DatatypeProperty ;
    rdfs:label "cars parked facing road" ;
    rdfs:comment "Observation that vehicles are parked oriented toward the roadway."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:causedByBurnSeverityOf a owl:ObjectProperty ;
    rdfs:label "caused by burn severity of"@en ;
    rdfs:comment "Connects a secondary environmental consequence (like soil erosion) to the specific intense heat damage of a designated fire."@en ;
    rdfs:domain ffonto:BurnSeverityMap ;
    rdfs:range ffonto:PostFireFloodRisk ;
    owl:inverseOf ffonto:causedByBurnSeverity .

ffonto:causedByDisturbanceOf a owl:ObjectProperty ;
    rdfs:label "inverse of caused by disturbance"@en ;
    rdfs:comment "Inverse relation linking observed outcomes back to the disturbances that caused them."@en ;
    rdfs:domain ffonto:Disturbance ;
    rdfs:range ffonto:VegetationCondition ;
    owl:inverseOf ffonto:causedByDisturbance .

ffonto:causedByEmbers a owl:ObjectProperty ;
    rdfs:label "caused by embers"@en ;
    rdfs:comment "Indicates that a secondary fire or ignition was started by airborne burning debris (embers)."@en ;
    rdfs:domain ffonto:SpotFire ;
    rdfs:range ffonto:CombustionProcess ;
    owl:inverseOf ffonto:createsSpotFire .

ffonto:causedByPollutant a owl:ObjectProperty ;
    rdfs:label "caused by pollutant"@en ;
    rdfs:comment "Indicates that a health impact, environmental degradation, or degraded visibility condition is the direct result of a specific contaminant."@en ;
    rdfs:domain ffonto:RespiratoryDisease ;
    rdfs:range ffonto:AirPollutantProperty ;
    owl:inverseOf ffonto:causesDisease .

ffonto:causesAnimalSmokeExposureOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes animal smoke exposure"@en ;
    rdfs:comment "Inverse relation linking animal smoke exposure records back to the events causing the exposure."@en ;
    rdfs:domain ffonto:AnimalSmokeExposure ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:causesAnimalSmokeExposure .

ffonto:causesEcologicalImpactOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes ecological impact"@en ;
    rdfs:comment "Inverse relation linking ecological impacts back to the causing events or processes."@en ;
    rdfs:domain ffonto:EcologicalImpact ;
    rdfs:range ffonto:FireBehavior ;
    owl:inverseOf ffonto:causesEcologicalImpact .

ffonto:causesEffect a owl:ObjectProperty ;
    rdfs:label "causes effect"@en ;
    rdfs:comment "Links a forest fire event to the specific environmental or socio-economic effects it causes."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ForestFireEffect ;
    owl:inverseOf ffonto:isEffectCausedBy .

ffonto:causesHabitatLossOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes habitat loss"@en ;
    rdfs:comment "Inverse relation linking habitat loss events back to the causing agent or disturbance."@en ;
    rdfs:domain ffonto:HabitatLoss ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:causesHabitatLoss .

ffonto:causesHealthEffectOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes health effect"@en ;
    rdfs:comment "Inverse relation linking health effects back to exposures or events that caused them."@en ;
    rdfs:domain ffonto:HealthEffect ;
    rdfs:range ffonto:AirToxic ;
    owl:inverseOf ffonto:causesHealthEffect .

ffonto:causesHealthRiskOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes health risk"@en ;
    rdfs:comment "Inverse relation linking health risk records back to the exposures or events causing them."@en ;
    rdfs:domain ffonto:HealthRisk ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:causesHealthRisk .

ffonto:causesImpactOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes impact"@en ;
    rdfs:comment "Inverse relation linking impacts back to the events or agents that cause them."@en ;
    rdfs:domain ffonto:FireImpact ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:causesImpact .

ffonto:causesRegrowthInverse a owl:ObjectProperty ;
    rdfs:label "causes regrowth (inverse)"@en,
        "inverse of causes regrowth"@en ;
    rdfs:comment "Inverse relation linking recorded regrowth or vegetation recovery back to the disturbance or management action that caused it."@en ;
    rdfs:domain ffonto:VegetationRegrowth ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:causesRegrowth .

ffonto:causesSmokeHealthEffectOf a owl:ObjectProperty ;
    rdfs:label "inverse of causes smoke health effect"@en ;
    rdfs:comment "Inverse relation linking smoke-related health effects back to the exposure events that caused them."@en ;
    rdfs:domain ffonto:SmokeHealthEffect ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:causesSmokeHealthEffect .

ffonto:causesSymptomOf a owl:ObjectProperty ;
    rdfs:label "causes symptom of" ;
    rdfs:comment "Inverse - Links smoke exposure to resulting symptoms." ;
    rdfs:domain ffonto:HealthSymptom ;
    rdfs:range ffonto:HealthRisk ;
    owl:inverseOf ffonto:causesSymptom .

ffonto:cautionTapeMarkingHazard a owl:DatatypeProperty ;
    rdfs:label "caution tape marking hazard" ;
    rdfs:comment "Indicates that caution tape is specifically marking a hazardous area or condition."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:centerLiteral a owl:DatatypeProperty ;
    rdfs:label "center literal" ;
    rdfs:comment "Center point as WKT or JSON string." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:chainsawSafeUseGuidance a owl:DatatypeProperty ;
    rdfs:label "is chainsaw use safe during cleanup guidance" ;
    rdfs:comment "Safety instructions for the correct operation of chainsaws to prevent injury."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:chainsawsOperatingForFelling a owl:DatatypeProperty ;
    rdfs:label "chainsaws operating for felling/clearing" ;
    rdfs:comment "Indicates chainsaws are in use specifically for cutting or felling trees."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:characterizesRegion a owl:ObjectProperty ;
    rdfs:label "characterizes region"@en ;
    rdfs:comment "Relates a demographic statistic, environmental baseline, or climate regime to the specific geographic area it describes."@en ;
    rdfs:domain ffonto:FireRegime ;
    rdfs:range geo:SpatialObject ;
    owl:inverseOf ffonto:hasFireRegime .

ffonto:chargedHoseLineDeployed a owl:DatatypeProperty ;
    rdfs:label "charged hose line deployed" ;
    rdfs:comment "Indicates that a hose line is pressurized and ready for operational use."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:checksumsRecorded a owl:DatatypeProperty ;
    rdfs:label "checksums recorded?" ;
    rdfs:comment "Boolean whether checksums (image, class-map) stored for audit." ;
    rdfs:domain ffonto:AuditRecord ;
    rdfs:range xsd:boolean .

ffonto:chemicalComponentAffectsCombustion a owl:ObjectProperty ;
    rdfs:label "chemical component affects combustion"@en ;
    rdfs:comment "Relates the chemical composition of a fuel source to how it influences the burning process and fire intensity."@en ;
    rdfs:domain ffonto:VegetationChemicalComponent ;
    rdfs:range ffonto:CombustionProcess ;
    owl:inverseOf ffonto:isCombustionAffectedByChemicalComponent .

ffonto:chimneyStanding a owl:DatatypeProperty ;
    rdfs:label "chimney standing" ;
    rdfs:comment "Indicates whether a chimney remains standing after the wildfire." ;
    rdfs:domain ffonto:Chimney ;
    rdfs:range xsd:boolean .

ffonto:civilianVehiclesPresent a owl:DatatypeProperty ;
    rdfs:label "civilian vehicles present in danger zone" ;
    rdfs:comment "Indicates whether civilian vehicles are present near the wildfire hazard area." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:claimRequired a owl:DatatypeProperty ;
    rdfs:label "claim required" ;
    rdfs:comment "Specifies whether a formal insurance claim must be submitted to receive compensation for the damage." ;
    rdfs:domain ffonto:InsurancePolicy ;
    rdfs:range xsd:boolean .

ffonto:classMapChecksum a owl:DatatypeProperty ;
    rdfs:label "class-map checksum" ;
    rdfs:comment "Checksum for the class-to-label mapping used in audit." ;
    rdfs:domain ffonto:AuditRecord ;
    rdfs:range xsd:string .

ffonto:classMapSHA1 a owl:DatatypeProperty ;
    rdfs:label "class map sha1",
        "class map SHA1"@en ;
    rdfs:comment "Records the SHA-1 cryptographic hash value used to uniquely identify and verify a specific classification map or schema file."@en ;
    rdfs:domain ffonto:AudioObservation ;
    rdfs:range xsd:string .

ffonto:classifiedAsInverse a owl:ObjectProperty ;
    rdfs:label "inverse of classified as"@en ;
    rdfs:comment "Inverse relation indicating classification assignments pointing back to the classifier."@en ;
    rdfs:domain ffonto:FireType ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:classifiedAs .

ffonto:classifiesVisibility a owl:ObjectProperty ;
    rdfs:label "classifies visibility"@en ;
    rdfs:comment "Connects an observation, sensor, or metric to the categorization of visual range through the atmosphere, which is often degraded by smoke."@en ;
    rdfs:domain ffonto:VisibilityCategory ;
    rdfs:range ffonto:SmokePlume ;
    owl:inverseOf ffonto:hasVisibilityCategory .

ffonto:cleanupInstruction a owl:DatatypeProperty ;
    rdfs:label "cleanup instruction" ;
    rdfs:comment "Instructions for safely cleaning wildfire ash." ;
    rdfs:domain ffonto:AshCleanupGuideline ;
    rdfs:range xsd:string .

ffonto:climateDriverInfluencesFireWeatherIndex a owl:ObjectProperty ;
    rdfs:label "climate driver influences fire weather index"@en ;
    rdfs:comment "Connects overarching climate phenomena to the calculated daily fire danger metrics they impact."@en ;
    rdfs:domain ffonto:ClimateDriver ;
    rdfs:range ffonto:FireWeatherIndex ;
    owl:inverseOf ffonto:isFireWeatherIndexInfluencedByClimateDriver .

ffonto:clothingMaterial a owl:DatatypeProperty ;
    rdfs:label "clothing material" ;
    rdfs:comment "Notes about fabric suitability for fire/smoke environments." ;
    rdfs:domain ffonto:ClothingRecommendation ;
    rdfs:range xsd:string .

ffonto:cloudCover a owl:DatatypeProperty ;
    rdfs:label "cloud cover" ;
    rdfs:comment "Indicates image cloud cover." ;
    rdfs:domain ffonto:ImageObservation ;
    rdfs:range xsd:decimal .

ffonto:cloudCoverPercentBySmoke a owl:DatatypeProperty ;
    rdfs:label "cloud cover percent (by smoke)" ;
    rdfs:comment "Percentage of sky covered — here representing smoke/cloud-like cover." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:decimal .

ffonto:cloudCoverPresent a owl:DatatypeProperty ;
    rdfs:label "cloud cover present" ;
    rdfs:comment "Indicates whether cloud cover was present." ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:boolean .

ffonto:cloudCoverQualityPresent a owl:DatatypeProperty ;
    rdfs:label "cloud cover quality metadata present?" ;
    rdfs:comment "Whether cloud_cover quality metadata is present." ;
    rdfs:domain ffonto:ImageQualityMetadata ;
    rdfs:range xsd:boolean .

ffonto:cloudTypeLiteral a owl:DatatypeProperty ;
    rdfs:label "cloud type (literal)" ;
    rdfs:comment "Describes cloud type (e.g., 'pyrocumulus-like')." ;
    rdfs:domain ffonto:SmokeObservation ;
    rdfs:range xsd:string .

ffonto:collectedBySatellite a owl:ObjectProperty ;
    rdfs:label "collected by satellite"@en ;
    rdfs:comment "Indicates that specific earth observation data or imagery was gathered by an orbital platform."@en ;
    rdfs:domain ffonto:SatelliteData ;
    rdfs:range ffonto:EarthObservationPlatform ;
    owl:inverseOf ffonto:collectsSatelliteData .

ffonto:collectsEnvironmentalData a owl:ObjectProperty ;
    rdfs:label "collects environmental data"@en ;
    rdfs:comment "Indicates that an entity, such as a sensor platform or UAV, gathers data regarding environmental conditions."@en .

ffonto:combinesForecastModels a owl:ObjectProperty ;
    rdfs:label "combines forecast models"@en ;
    rdfs:comment "Indicates that a system or process integrates multiple predictive models to generate a synthesized output."@en ;
    rdfs:domain ffonto:EnsembleForecast ;
    rdfs:range ffonto:FireBehaviorModel ;
    owl:inverseOf ffonto:isCombinedInForecast .

ffonto:combustibleSidingPresent a owl:DatatypeProperty ;
    rdfs:label "combustible siding present" ;
    rdfs:comment "Indicates whether a building has combustible siding." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:communicatesBy a owl:ObjectProperty ;
    rdfs:label "communicates by network",
        "communicates by"@en ;
    rdfs:comment "Connects a responder, system, or organization to the specific protocol, device, or network used to transmit information."@en ;
    rdfs:domain ffonto:CommunicationNetwork ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:communicatesVia .

ffonto:communicationTowerIntact a owl:DatatypeProperty ;
    rdfs:label "communication tower intact" ;
    rdfs:comment "Indicates if a visible communication tower appears intact." ;
    rdfs:domain ffonto:CommunicationTower ;
    rdfs:range xsd:boolean .

ffonto:communicationTowerVisible a owl:DatatypeProperty ;
    rdfs:label "communication tower visible" ;
    rdfs:comment "Indicates if a communication tower is present in the scene." ;
    rdfs:domain ffonto:CommunicationTower ;
    rdfs:range xsd:boolean .

ffonto:computesEvacuationRouteOf a owl:ObjectProperty ;
    rdfs:label "computes evacuation route of",
        "computes evacuation route of"@en ;
    rdfs:comment "Connects a generated escape path or traffic model back to the spatial analysis software or incident action plan that created it."@en ;
    rdfs:domain ffonto:ShortestSafePath ;
    rdfs:range ffonto:EvacuationRoutingAlgorithm ;
    owl:inverseOf ffonto:computesEvacuationRoute .

ffonto:conductingBurnout a owl:DatatypeProperty ;
    rdfs:label "conducting burnout" ;
    rdfs:comment "Indicates a controlled burnout or backburn operation." ;
    rdfs:domain ffonto:FirefightingOperation ;
    rdfs:range xsd:boolean .

ffonto:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:comment "Confidence score associated with the result." ;
    rdfs:domain ffonto:Result ;
    rdfs:range xsd:float .

ffonto:constructedForFire a owl:ObjectProperty ;
    rdfs:label "constructed for fire"@en ;
    rdfs:comment "Relates a physical barrier, such as a fireline, or an emergency facility to the specific wildfire incident it was built to manage."@en ;
    rdfs:domain ffonto:FireLine ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:isContainedByFireLine .

ffonto:consumesFuel a owl:ObjectProperty ;
    rdfs:label "consumes fuel"@en ;
    rdfs:comment "Relates a combustion event, such as a wildfire or engine, to the physical biomass or energy source it depletes."@en ;
    rdfs:domain ffonto:CombustionProcess ;
    rdfs:range ffonto:FuelCharacteristic ;
    owl:inverseOf ffonto:isConsumedIn .

ffonto:contactsOf a owl:ObjectProperty ;
    rdfs:label "contacts of" ;
    rdfs:comment "Inverse - Links a CommunicationPlan to organization or person contact individuals." ;
    rdfs:domain ffonto:ResponseOrganization ;
    rdfs:range ffonto:CommunicationPlan ;
    owl:inverseOf ffonto:contacts .

ffonto:containmentPercent a owl:DatatypeProperty ;
    rdfs:label "containment percent" ;
    rdfs:comment "The percentage of a fire perimeter that is secured or contained."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:containsLandscapeFeatureOf a owl:ObjectProperty ;
    rdfs:label "inverse of contains landscape feature"@en ;
    rdfs:comment "Inverse relation linking landscape features back to the larger area or parcel that contains them."@en ;
    rdfs:domain ffonto:LandscapeFeature ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:containsLandscapeFeature .

ffonto:containsParticulateOf a owl:ObjectProperty ;
    rdfs:label "inverse of contains particulate"@en ;
    rdfs:comment "Inverse relation linking particulate measurements to the source or sample from which they were taken."@en ;
    rdfs:domain ffonto:ParticulateMatter ;
    rdfs:range ffonto:AirPollution ;
    owl:inverseOf ffonto:containsParticulate .

ffonto:containsSceneElement a owl:ObjectProperty ;
    rdfs:label "contains scene element"@en ;
    rdfs:comment "Relates a scene or image to an element detected within it."@en ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:SceneElement ;
    owl:inverseOf ffonto:isElementOfScene .

ffonto:containsVegetationOf a owl:ObjectProperty ;
    rdfs:label "contains vegetation of" ;
    rdfs:comment "Inverse - Indicates vegetation types that occur within an ecosystem." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range ffonto:Ecosystem ;
    owl:inverseOf ffonto:containsVegetation .

ffonto:contributesOf a owl:ObjectProperty ;
    rdfs:label "inverse of contributes to"@en ;
    rdfs:comment "Inverse relation linking contributing factors or resources back to the outcomes they help produce."@en ;
    rdfs:domain ffonto:ClimateMitigation ;
    rdfs:range ffonto:ForestFireTechnology ;
    owl:inverseOf ffonto:contributesTo .

ffonto:contributesToFireIntensityOf a owl:ObjectProperty ;
    rdfs:label "inverse of contributes to fire intensity"@en ;
    rdfs:comment "Inverse relation linking contributing factors to the fire intensity measurements or models they influence."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Tree ;
    owl:inverseOf ffonto:contributesToFireIntensity .

ffonto:countryLiteral a owl:DatatypeProperty ;
    rdfs:label "country literal",
        "country literal"@en ;
    rdfs:comment "Specifies the sovereign nation encompassing a geographic coordinate or incident as a text string."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:coverageAvailable a owl:DatatypeProperty ;
    rdfs:label "coverage available" ;
    rdfs:comment "Indicates whether coverage is available under the insurance policy." ;
    rdfs:domain ffonto:InsurancePolicy ;
    rdfs:range xsd:boolean .

ffonto:coveredWithAsh a owl:DatatypeProperty ;
    rdfs:label "covered with ash" ;
    rdfs:comment "Indicates whether a vehicle is covered with ash from wildfire smoke." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:coversDamageOf a owl:ObjectProperty ;
    rdfs:label "inverse of covers damage"@en ;
    rdfs:comment "Inverse relation linking coverage policies to the damages or claim events they cover."@en ;
    rdfs:domain ffonto:SmokeDamage ;
    rdfs:range ffonto:InsurancePolicy ;
    owl:inverseOf ffonto:coversDamage .

ffonto:coversSmokeDamage a owl:DatatypeProperty ;
    rdfs:label "covers smoke damage"@en ;
    rdfs:comment "Indicates that an insurance policy or coverage includes damage caused by smoke."@en ;
    rdfs:domain ffonto:InsurancePolicy ;
    rdfs:range xsd:boolean .

ffonto:createsFirelineOf a owl:ObjectProperty ;
    rdfs:label "inverse of creates fireline"@en ;
    rdfs:comment "Inverse relation linking fireline construction activities back to the incidents or plans that initiated them."@en ;
    rdfs:domain ffonto:Fireline ;
    rdfs:range ffonto:SuppressionMethod ;
    owl:inverseOf ffonto:createsFireline .

ffonto:createsFuelLoadOf a owl:ObjectProperty ;
    rdfs:label "inverse of creates fuel load"@en ;
    rdfs:comment "Inverse relation linking fuel load contributions back to the processes or areas causing accumulation."@en ;
    rdfs:domain ffonto:FuelAccumulation ;
    rdfs:range ffonto:ClimateDriver ;
    owl:inverseOf ffonto:createsFuelLoad .

ffonto:createsHazardOf a owl:ObjectProperty ;
    rdfs:label "inverse of creates hazard"@en ;
    rdfs:comment "Inverse relation linking hazards back to the actions or conditions that create them."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:createsHazard .

ffonto:createsPyroWeatherOf a owl:ObjectProperty ;
    rdfs:label "inverse of creates pyro weather"@en ;
    rdfs:comment "Inverse relation linking pyro-weather events back to the fires or conditions that created them."@en ;
    rdfs:domain ffonto:FireGeneratedWeather ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:createsPyroWeather .

ffonto:crewsOperatingInTeams a owl:DatatypeProperty ;
    rdfs:label "crews operating in teams (buddy system)" ;
    rdfs:comment "Indicates that responders are organized and working in defined teams."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:cropsOrOrchardsDamaged a owl:DatatypeProperty ;
    rdfs:label "crops or orchards damaged" ;
    rdfs:comment "Indicates whether nearby crops or orchards show wildfire damage." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:crossedWatershedOf a owl:ObjectProperty ;
    rdfs:label "crossed watershed boundary of",
        "crossed watershed of"@en ;
    rdfs:comment "Relates a fire's progression or environmental impact back to the specific hydrological boundary it breached."@en ;
    rdfs:domain ffonto:Watershed ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:crossedWatershed .

ffonto:crossesOf a owl:ObjectProperty ;
    rdfs:label "inverse of crosses"@en ;
    rdfs:comment "Inverse relation linking crossing relationships back to the spatial features that intersect."@en ;
    rdfs:domain ffonto:SpatialFeature ;
    rdfs:range ffonto:HoseLine ;
    owl:inverseOf ffonto:crosses .

ffonto:crownFireVisible a owl:DatatypeProperty ;
    rdfs:label "crown fire visible" ;
    rdfs:comment "Observation that a fire is burning in the canopy of trees, spreading through crowns."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range xsd:boolean .

ffonto:crsLiteral a owl:DatatypeProperty ;
    rdfs:label "CRS literal"@en ;
    rdfs:comment "Specifies the Coordinate Reference System (e.g., EPSG code) used for spatial data as a literal string."@en .

ffonto:culvertInletsClogged a owl:DatatypeProperty ;
    rdfs:label "culvert inlets clogged with ash or debris" ;
    rdfs:comment "Indicates whether culvert inlets are clogged with ash/debris." ;
    rdfs:domain ffonto:Culvert ;
    rdfs:range xsd:boolean .

ffonto:culvertsFilledWithAsh a owl:DatatypeProperty ;
    rdfs:label "culverts filled with ash or debris" ;
    rdfs:comment "Indicates whether culverts or roadside ditches are filled with ash or debris." ;
    rdfs:domain ffonto:ErosionFeature ;
    rdfs:range xsd:boolean .

ffonto:dataProvidedOf a owl:ObjectProperty ;
    rdfs:label "inverse of data provided by"@en ;
    rdfs:comment "Inverse relation linking provided datasets back to the providers or collection campaigns."@en ;
    rdfs:domain ffonto:DataProvider ;
    rdfs:range ffonto:MonitoringSystem ;
    owl:inverseOf ffonto:dataProvidedBy .

ffonto:dataSource a owl:DatatypeProperty ;
    rdfs:label "data source" ;
    rdfs:comment "Meteorological variables used in wildfire risk calculation." ;
    rdfs:domain ffonto:FireWeatherIndex ;
    rdfs:range xsd:string .

ffonto:decisionHumanValidated a owl:DatatypeProperty ;
    rdfs:label "decision human validated?" ;
    rdfs:comment "Whether the label/decision was human validated." ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range xsd:boolean .

ffonto:defensibleSpaceBlackened a owl:DatatypeProperty ;
    rdfs:label "defensible space blackened" ;
    rdfs:comment "Indicates whether the defensible space around a house is blackened yet cleared." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:defensibleSpacePresent a owl:DatatypeProperty ;
    rdfs:label "defensible space around homes" ;
    rdfs:comment "Indicates whether defensible space exists around structures." ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:defensiveStrategyRequired a owl:DatatypeProperty ;
    rdfs:label "defensive firefighting strategy required" ;
    rdfs:comment "Indicates whether defensive strategy is recommended instead of interior attack." ;
    rdfs:domain ffonto:FireSuppressionAction ;
    rdfs:range xsd:boolean .

ffonto:definesPerimeter a owl:ObjectProperty ;
    rdfs:label "defines perimeter"@en ;
    rdfs:comment "Connects a set of geospatial coordinates, a containment line, or an observation to the established geographic boundary of a fire."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:FirePerimeter ;
    owl:inverseOf ffonto:isPerimeterOf .

ffonto:deploysAirTankerOf a owl:ObjectProperty ;
    rdfs:label "inverse of deploys air tanker"@en ;
    rdfs:comment "Inverse relation linking air tanker deployments back to the incidents or commands that ordered them."@en ;
    rdfs:domain ffonto:AirTanker ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:deploysAirTanker .

ffonto:deploysFireTruckOf a owl:ObjectProperty ;
    rdfs:label "deploys fire truck of",
        "deploys fire truck of"@en ;
    rdfs:comment "Connects a dispatch action or operational decision back to the specific fire engine resource mobilized."@en ;
    rdfs:domain ffonto:FireTruck ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:deploysFireTruck .

ffonto:deploysPlatform a owl:ObjectProperty ;
    rdfs:label "deploys platform"@en ;
    rdfs:comment "Indicates the observational platform (e.g., drone, tower) deployed by an incident command section."@en ;
    rdfs:domain ffonto:IncidentCommandSection ;
    rdfs:range sosa:Platform ;
    owl:inverseOf ffonto:isPlatformDeployedBy .

ffonto:derivedFromDataOf a owl:ObjectProperty ;
    rdfs:label "inverse of derived from data"@en ;
    rdfs:comment "Inverse relation indicating that an artifact or estimate is derived from specified input data sources."@en ;
    rdfs:domain ffonto:DatasetVersion ;
    rdfs:range ffonto:ModelOutput ;
    owl:inverseOf ffonto:derivedFromData .

ffonto:derivedFromFireOf a owl:ObjectProperty ;
    rdfs:label "derived from fire of"@en ;
    rdfs:comment "Links data, emissions, impacts, or statistics back to the specific fire incident that generated them."@en ;
    rdfs:domain ffonto:WildfireIncident ;
    rdfs:range ffonto:BurnSeverityMap ;
    owl:inverseOf ffonto:derivedFromFire .

ffonto:derivedRemoteSensingIndexOf a owl:ObjectProperty ;
    rdfs:label "derived of" ;
    rdfs:comment "Inverse - Links remote sensing indices to methods or satellite data." ;
    rdfs:domain ffonto:RemoteSensingMethod ;
    rdfs:range ffonto:RemoteSensingIndex ;
    owl:inverseOf ffonto:derivedRemoteSensingIndexFrom .

ffonto:describesSpreadOf a owl:ObjectProperty ;
    rdfs:label "describes spread of"@en ;
    rdfs:comment "Connects a metric, temporal analysis, or model to the specific fire or phenomenon whose expansion it tracks."@en ;
    rdfs:domain ffonto:RateOfSpread ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:hasRateOfSpread .

ffonto:describesTrendOf a owl:ObjectProperty ;
    rdfs:label "describes trend of"@en ;
    rdfs:comment "Links a statistical analysis, graph, or temporal dataset to the specific phenomenon or variable whose changes it maps over time."@en ;
    rdfs:domain ffonto:Trend ;
    rdfs:range ffonto:FireRadiativePower ;
    owl:inverseOf ffonto:hasTrend .

ffonto:detectedBySatelliteOf a owl:ObjectProperty ;
    rdfs:label "inverse of detected by satellite"@en ;
    rdfs:comment "Inverse relation linking detections back to the satellite instrument or mission that recorded them."@en ;
    rdfs:domain ffonto:SatelliteDetection ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:detectedBySatellite .

ffonto:detectedModelOf a owl:ObjectProperty ;
    rdfs:label "detected model of"@en ;
    rdfs:comment "Links a recognized pattern, anomaly, or simulation output back to the specific computational model that generated it."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:ModelDrift ;
    owl:inverseOf ffonto:detectedInModel .

ffonto:detectionsTrend a owl:DatatypeProperty ;
    rdfs:label "detections trend" ;
    rdfs:comment "Textual trend of detection (increasing/decreasing/stable)." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:string .

ffonto:detectsFire a owl:ObjectProperty ;
    rdfs:label "detects fire"@en ;
    rdfs:comment "Links a system, sensor, or observer to the active combustion event it identifies."@en ;
    rdfs:domain ffonto:ActiveFireDetection ;
    rdfs:range ffonto:FireFront ;
    owl:inverseOf ffonto:isDetectedBy .

ffonto:detectsThermalSignature a owl:ObjectProperty ;
    rdfs:label "detects thermal signature"@en ;
    rdfs:comment "Relates a sensor or platform to the infrared or heat-based anomaly it identifies."@en ;
    rdfs:domain ffonto:ThermalCamera ;
    rdfs:range ffonto:ActiveFireDetection ;
    owl:inverseOf ffonto:isDetectedByThermalCamera .

ffonto:deviceID a owl:DatatypeProperty ;
    rdfs:label "device id",
        "device ID"@en ;
    rdfs:comment "Specifies the unique alphanumeric identifier or serial number assigned to a specific hardware sensor or tool."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:diggingHandLine a owl:DatatypeProperty ;
    rdfs:label "digging hand line" ;
    rdfs:comment "Indicates whether firefighters are digging a hand line." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:diminishesService a owl:ObjectProperty ;
    rdfs:label "diminishes ecosystem service" ;
    rdfs:comment "Indicates that an ecological effect (like erosion) harms a service." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:EcosystemService .

ffonto:dipSiteBeingUsed a owl:DatatypeProperty ;
    rdfs:label "dip site (lake/pond) being used" ;
    rdfs:comment "Indicates active use of a water dip site for aircraft refilling or supply."@en ;
    rdfs:domain ffonto:AircraftAction ;
    rdfs:range xsd:boolean .

ffonto:directAttackFavored a owl:DatatypeProperty ;
    rdfs:label "direct attack favored (hand tools)" ;
    rdfs:comment "Indicates if current RH/conditions favor direct hand-tool attack." ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:boolean .

ffonto:directingEvacuationInverse a owl:ObjectProperty ;
    rdfs:label "inverse of directing evacuation"@en ;
    rdfs:comment "Inverse relation linking evacuation direction actions back to the authority or unit issuing directions."@en ;
    rdfs:domain ffonto:Civilian ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:directingEvacuation .

ffonto:disabledVehicleBlocking a owl:DatatypeProperty ;
    rdfs:label "disabled vehicle blocking road" ;
    rdfs:comment "Indicates a nonfunctional vehicle obstructing a route or access."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:disposalInstruction a owl:DatatypeProperty ;
    rdfs:label "disposal instruction" ;
    rdfs:comment "Provides instructions for safely disposing of hazardous waste after a wildfire." ;
    rdfs:domain ffonto:HazardousWasteGuideline ;
    rdfs:range xsd:string .

ffonto:distanceInMeters a owl:DatatypeProperty ;
    rdfs:label "distance in meters" ;
    rdfs:comment "A measure of linear distance expressed in meters."@en ;
    rdfs:domain ffonto:DefensibleZone ;
    rdfs:range xsd:float .

ffonto:documentStorageMethod a owl:DatatypeProperty ;
    rdfs:label "document storage method" ;
    rdfs:comment "How important documents are safeguarded (fire-safe, waterproof pouch, cloud backup)." ;
    rdfs:domain ffonto:ImportantDocument ;
    rdfs:range xsd:string .

ffonto:dominantAspectOf a owl:ObjectProperty ;
    rdfs:label "inverse of dominant aspect"@en ;
    rdfs:comment "Inverse relation linking the dominant slope aspect back to the terrain unit described."@en ;
    rdfs:domain ffonto:AspectCategory ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:dominantAspect .

ffonto:downedLogsSmoldering a owl:DatatypeProperty ;
    rdfs:label "downed logs smoldering" ;
    rdfs:comment "Indicates whether downed logs are smoldering (true) or cold (false)." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:downedPowerLineAdvice a owl:DatatypeProperty ;
    rdfs:label "what to do around downed power lines" ;
    rdfs:comment "Guidance provided to the public regarding safety around downed power lines."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:dozerCuttingControlLine a owl:DatatypeProperty ;
    rdfs:label "dozer actively cutting control line" ;
    rdfs:comment "Indicates use of bulldozers to cut a control line for fire suppression."@en ;
    rdfs:domain ffonto:HeavyEquipment ;
    rdfs:range xsd:boolean .

ffonto:driptorchVisible a owl:DatatypeProperty ;
    rdfs:label "driptorch visible (ignition/backburn)" ;
    rdfs:comment "Observation that a driptorch or similar ignition tool is present and in use."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:driverAdviceIfInHeavySmoke a owl:DatatypeProperty ;
    rdfs:label "driver advice if caught in heavy smoke" ;
    rdfs:comment "Guidance provided to drivers for safe actions when driving in heavy smoke."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:droneRestrictionNearWildfire a owl:DatatypeProperty ;
    rdfs:label "can hobby drones fly near wildfire operations" ;
    rdfs:comment "Restrictions or advisories limiting drone operations near active wildfire for safety."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:dropForce a owl:DatatypeProperty ;
    rdfs:label "drop force (N/m2)" ;
    rdfs:comment "Approximate force per area of the drop." ;
    rdfs:domain ffonto:ImpactHazard ;
    rdfs:range xsd:decimal .

ffonto:earProtectionVisible a owl:DatatypeProperty ;
    rdfs:label "ear protection visible" ;
    rdfs:comment "Indicates whether headsets or ear protection are worn." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:earlyRegrowthVisible a owl:DatatypeProperty ;
    rdfs:label "early regrowth visible" ;
    rdfs:comment "Indicates whether early vegetation regrowth is visible." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:boolean .

ffonto:educatesPublicOf a owl:ObjectProperty ;
    rdfs:label "inverse of educates public"@en ;
    rdfs:comment "Inverse relation linking public education outputs back to the programs or organizations delivering them."@en ;
    rdfs:domain ffonto:ForestFirePrevention ;
    rdfs:range ffonto:PublicEducationProgram ;
    owl:inverseOf ffonto:educatesPublic .

ffonto:elevatedFireDanger a owl:DatatypeProperty ;
    rdfs:label "elevated fire danger indicator" ;
    rdfs:comment "A condition indicating that fire danger indices are above normal levels."@en ;
    rdfs:domain ffonto:FireDangerAssessment ;
    rdfs:range xsd:boolean .

ffonto:email a owl:DatatypeProperty ;
    rdfs:label "email address" ;
    rdfs:comment "Contact email address." ;
    rdfs:domain ffonto:Contact ;
    rdfs:range xsd:string .

ffonto:emergencyLightsOn a owl:DatatypeProperty ;
    rdfs:label "emergency lights illuminated" ;
    rdfs:comment "Observation that emergency lighting is active on vehicles or at scenes."@en ;
    rdfs:domain ffonto:EmergencyVehicle ;
    rdfs:range xsd:boolean .

ffonto:emergencyVehiclesStaged a owl:DatatypeProperty ;
    rdfs:label "emergency vehicles staged for evacuation" ;
    rdfs:comment "Indicates whether emergency vehicles are positioned for evacuation." ;
    rdfs:domain ffonto:EmergencyVehicle ;
    rdfs:range xsd:boolean .

ffonto:emsSupportVisible a owl:DatatypeProperty ;
    rdfs:label "medical or EMS support visible" ;
    rdfs:comment "Indicates whether EMS support is present at the wildfire scene." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:enablesOf a owl:ObjectProperty ;
    rdfs:label "inverse of enables"@en ;
    rdfs:comment "Inverse relation linking capabilities back to the enabling resources or conditions."@en ;
    rdfs:domain ffonto:ComputerVisionTask ;
    rdfs:range ffonto:EdgeDevice ;
    owl:inverseOf ffonto:enables .

ffonto:enhancesEcosystemServiceOf a owl:ObjectProperty ;
    rdfs:label "inverse of enhances ecosystem service"@en ;
    rdfs:comment "Inverse relation linking enhanced ecosystem services back to the management actions that produce them."@en ;
    rdfs:domain ffonto:EcosystemService ;
    rdfs:range ffonto:ManagementAction ;
    owl:inverseOf ffonto:enhancesEcosystemService .

ffonto:enhancesService a owl:ObjectProperty ;
    rdfs:label "enhances ecosystem service" ;
    rdfs:comment "Indicates that an ecological effect (like regeneration) improves a service." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:EcosystemService .

ffonto:ensuresContinuityOf a owl:ObjectProperty ;
    rdfs:label "ensures continuity of"@en ;
    rdfs:comment "Links a system, plan, or entity to the operational process or service it sustains during disruptions."@en ;
    rdfs:domain ffonto:ContinuityStrategy ;
    rdfs:range ffonto:DecisionSupportSystem ;
    owl:inverseOf ffonto:hasContinuityStrategy .

ffonto:environmentSafeForAnimals a owl:DatatypeProperty ;
    rdfs:label "environment safe for animals or civilians" ;
    rdfs:comment "Indicates whether the environment is safe for animals or civilians." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:environmentalAffectedOf a owl:ObjectProperty ;
    rdfs:label "environmentally affected of" ;
    rdfs:comment "Inverse - Indicates environmental factors influencing wildfire behavior." ;
    rdfs:domain ffonto:EnvironmentalFactor ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:environmentalAffectedBy .

ffonto:environmentalFactorAffectsFireSpread a owl:ObjectProperty ;
    rdfs:label "environmental factor affects fire spread"@en ;
    rdfs:comment "Relates a natural condition (like wind or terrain) to its influence on the rate and direction of a fire."@en ;
    rdfs:domain ffonto:EnvironmentalFactor ;
    rdfs:range ffonto:FireSpread ;
    owl:inverseOf ffonto:fireSpreadAffectedByEnvironmentalFactor .

ffonto:erosionRillsForming a owl:DatatypeProperty ;
    rdfs:label "erosion rills forming on slopes" ;
    rdfs:comment "Indicates whether erosion rills or channels are forming on slopes." ;
    rdfs:domain ffonto:ErosionFeature ;
    rdfs:range xsd:boolean .

ffonto:erosionRiskAvailable a owl:DatatypeProperty ;
    rdfs:label "erosion risk increased" ;
    rdfs:comment "Indicates whether wildfire disturbance increases soil erosion risk." ;
    rdfs:domain ffonto:ErosionFeature ;
    rdfs:range xsd:boolean .

ffonto:escapeRoutesViable a owl:DatatypeProperty ;
    rdfs:label "escape routes viable" ;
    rdfs:comment "Indicates whether evacuation routes remain open and usable." ;
    rdfs:domain ffonto:EvacuationStatus ;
    rdfs:range xsd:boolean .

ffonto:estimatedOf a owl:ObjectProperty ;
    rdfs:label "estimated of"@en ;
    rdfs:comment "Relates a calculated or predicted value to the physical entity or phenomenon being measured."@en ;
    rdfs:domain ffonto:FireRadiativePower ;
    rdfs:range ffonto:EmissionEstimate ;
    owl:inverseOf ffonto:estimatedFrom .

ffonto:estimatesFire a owl:ObjectProperty ;
    rdfs:label "estimates fire" ;
    rdfs:comment "Denotes an assessment or model output that quantifies fire extent or behavior."@en ;
    rdfs:domain ffonto:EstimationMethod ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:estimatedBy .

ffonto:evacHelpForNoTransport a owl:DatatypeProperty ;
    rdfs:label "what to do if someone lacks transportation to evacuate" ;
    rdfs:comment "Indicates provision of evacuation assistance for people without transportation."@en ;
    rdfs:domain ffonto:PublicSafetyGuidance ;
    rdfs:range xsd:string .

ffonto:evacuationActionInverse a owl:ObjectProperty ;
    rdfs:label "inverse of evacuation action"@en ;
    rdfs:comment "Inverse relation linking specific evacuation actions back to the plans or authorities that issued them."@en ;
    rdfs:domain ffonto:EvacuationAction ;
    rdfs:range ffonto:SurvivalGuidance ;
    owl:inverseOf ffonto:evacuationAction .

ffonto:evacuationNotice a owl:DatatypeProperty ;
    rdfs:label "evacuation notice" ;
    rdfs:comment "Text of official evacuation instruction or advice." ;
    rdfs:domain ffonto:EvacuationPreparation ;
    rdfs:range xsd:string .

ffonto:evacuationPreparationOf a owl:ObjectProperty ;
    rdfs:label "inverse of evacuation preparation"@en ;
    rdfs:comment "Inverse relation linking preparation activities back to the plans or households for which they are intended."@en ;
    rdfs:domain ffonto:EvacuationAction ;
    rdfs:range ffonto:EvacuationPreparation ;
    owl:inverseOf ffonto:evacuationPreparation .

ffonto:evacuationRecommended a owl:DatatypeProperty ;
    rdfs:label "immediate evacuation recommended" ;
    rdfs:comment "Indicates whether residents should evacuate immediately." ;
    rdfs:domain ffonto:EvacuationStatus ;
    rdfs:range xsd:boolean .

ffonto:evacuationSirensActive a owl:DatatypeProperty ;
    rdfs:label "evacuation sirens active" ;
    rdfs:comment "Indicates that community evacuation sirens are currently sounding."@en ;
    rdfs:domain ffonto:EmergencyActivity ;
    rdfs:range xsd:boolean .

ffonto:evaluatedOf a owl:ObjectProperty ;
    rdfs:label "inverse of evaluated by"@en ;
    rdfs:comment "Inverse relation linking evaluations back to the subjects or systems evaluated."@en ;
    rdfs:domain ffonto:EvaluationMetric ;
    rdfs:range ffonto:MachineLearningModel ;
    owl:inverseOf ffonto:evaluatedBy .

ffonto:evaluatesOpportunity a owl:ObjectProperty ;
    rdfs:label "evaluates opportunity"@en ;
    rdfs:comment "Connects an ethical consideration to the challenge or opportunity it evaluates."@en ;
    rdfs:domain ffonto:EthicalConsideration ;
    rdfs:range ffonto:ChallengeOpportunity ;
    owl:inverseOf ffonto:isOpportunityEvaluatedBy .

ffonto:evaluatesPrediction a owl:ObjectProperty ;
    rdfs:label "evaluates prediction"@en ;
    rdfs:comment "Links a review process, system, or human agent to the forecast or model output it is assessing for accuracy."@en ;
    rdfs:domain ffonto:ConfidenceScore ;
    rdfs:range ffonto:FireBehaviorModel ;
    owl:inverseOf ffonto:hasConfidenceScore .

ffonto:evaluatesRiskBy a owl:ObjectProperty ;
    rdfs:label "evaluates risk by"@en ;
    rdfs:comment "Relates an assessment process or entity to the methodology, metric, or model used to calculate danger."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:RiskAssessment ;
    owl:inverseOf ffonto:evaluatesRiskOf .

ffonto:eventId a owl:DatatypeProperty ;
    rdfs:label "event id" ;
    rdfs:comment "Event identifier from the source record; may be missing." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:explainsModelPrediction a owl:ObjectProperty ;
    rdfs:label "explains model prediction"@en ;
    rdfs:comment "Links a set of input features, rationale, or Explainable AI (XAI) output to the specific forecast it clarifies."@en ;
    rdfs:domain ffonto:ExplainableAI ;
    rdfs:range ffonto:FireBehaviorModel ;
    owl:inverseOf ffonto:isExplainedBy .

ffonto:explosionAlertConfidenceHigh a owl:DatatypeProperty ;
    rdfs:label "explosion alert confidence high" ;
    rdfs:comment "Indicates whether explosion detection confidence is high enough to trigger alerts." ;
    rdfs:domain ffonto:AudioObservation ;
    rdfs:range xsd:boolean .

ffonto:explosionAlertThreshold a owl:DatatypeProperty ;
    rdfs:label "explosion alert threshold" ;
    rdfs:comment "Threshold above which special crew safety actions are required." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:explosionConfidence a owl:DatatypeProperty ;
    rdfs:label "explosion confidence high" ;
    rdfs:comment "A measure indicating confidence that an explosion event has occurred based on observations."@en ;
    rdfs:domain ffonto:ExplosionEvent ;
    rdfs:range xsd:boolean .

ffonto:explosionDetected a owl:DatatypeProperty ;
    rdfs:label "explosion detected" ;
    rdfs:comment "Boolean indicating whether an explosion-like audio event was detected." ;
    rdfs:domain ffonto:AudioObservation ;
    rdfs:range xsd:boolean .

ffonto:explosionRiskPresent a owl:DatatypeProperty ;
    rdfs:label "explosion risk present" ;
    rdfs:comment "Indicates whether materials may explode under heat." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:explosionSoundDetected a owl:DatatypeProperty ;
    rdfs:label "explosion sound detected in audio" ;
    rdfs:comment "Indicates whether an explosion sound was detected in audio." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:exposureDuration a owl:DatatypeProperty ;
    rdfs:label "exposure duration" ;
    rdfs:comment "Represents the length of time individuals are exposed to air pollution." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range xsd:duration .

ffonto:extractedOf a owl:ObjectProperty ;
    rdfs:label "extracted of" ;
    rdfs:comment "Inverse - Indicates that well water is extracted from groundwater." ;
    rdfs:domain ffonto:Groundwater ;
    rdfs:range ffonto:WellWater ;
    owl:inverseOf ffonto:extractedFrom .

ffonto:faceShieldsOrGogglesVisible a owl:DatatypeProperty ;
    rdfs:label "face shields or goggles visible" ;
    rdfs:comment "Indicates whether protective eye shields or goggles are visible." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:favorsSpeciesOf a owl:ObjectProperty ;
    rdfs:label "inverse of favors species"@en ;
    rdfs:comment "Inverse relation indicating that conditions support or promote a species in an area."@en ;
    rdfs:domain ffonto:VegetationFunctionalGroup ;
    rdfs:range ffonto:EcologicalEffect ;
    owl:inverseOf ffonto:favorsSpecies .

ffonto:fenceBurnStatus a owl:DatatypeProperty ;
    rdfs:label "fence burn status" ;
    rdfs:comment "Status of fence: 'intact', 'partially burned', or 'fully burned'." ;
    rdfs:domain ffonto:Fence ;
    rdfs:range xsd:string .

ffonto:filtersAirInShelter a owl:ObjectProperty ;
    rdfs:label "filters air in shelter"@en ;
    rdfs:comment "Indicates that a mitigation device or HVAC system actively cleans the indoor atmosphere of a designated safe facility."@en ;
    rdfs:domain ffonto:AirConditioner ;
    rdfs:range ffonto:CleanAirShelter ;
    owl:inverseOf ffonto:hasAirConditioner .

ffonto:fineFuelsConsumed a owl:DatatypeProperty ;
    rdfs:label "fine fuels completely consumed" ;
    rdfs:comment "Indicates whether fine fuels (grasses) are completely consumed." ;
    rdfs:domain ffonto:Grass ;
    rdfs:range xsd:boolean .

ffonto:fineFuelsCuring a owl:DatatypeProperty ;
    rdfs:label "fine fuels curing status" ;
    rdfs:comment "Describes whether fine fuels are cured, partially cured, or green." ;
    rdfs:domain ffonto:FuelCondition ;
    rdfs:range xsd:string .

ffonto:fire a ffonto:ObservableProperty .

ffonto:fireConfidenceLevel a owl:DatatypeProperty ;
    rdfs:label "fire confidence level" ;
    rdfs:comment "Represents the confidence level of fire detection, often derived from satellite observations." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:string .

ffonto:fireHydrantVisible a owl:DatatypeProperty ;
    rdfs:label "fire hydrant visible" ;
    rdfs:comment "Indicates that a fire hydrant is present and observable at a location."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:fireOccurred a owl:DatatypeProperty ;
    rdfs:label "fire occurred",
        "fire occurred"@en ;
    rdfs:comment "A boolean flag or categorical indicator recording whether a combustion event actually took place at a given location and time."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:boolean .

ffonto:firePerimeterExpanding a owl:DatatypeProperty ;
    rdfs:label "fire perimeter expanding" ;
    rdfs:comment "Indicates that the mapped boundary of fire is increasing in area or extent."@en ;
    rdfs:domain ffonto:FireSpread ;
    rdfs:range xsd:boolean .

ffonto:firePersistence a owl:DatatypeProperty ;
    rdfs:label "fire persistence" ;
    rdfs:comment "Represents the duration or persistence of a fire event over time." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:float .

ffonto:fireProbabilityScore a owl:DatatypeProperty ;
    rdfs:label "fire probability" ;
    rdfs:comment "Model-provided fire probability score (0.0-1.0)." ;
    rdfs:domain ffonto:FireProbabilityModel ;
    rdfs:range xsd:decimal .

ffonto:fireRadiativePower a owl:DatatypeProperty ;
    rdfs:label "fire radiative power" ;
    rdfs:comment "Represents the radiative power of a fire event, indicating its intensity." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:float .

ffonto:fireReachedWaterEdge a owl:DatatypeProperty ;
    rdfs:label "fire reached water edge" ;
    rdfs:comment "Indicates whether the fire reached the visible edge of a stream or pond." ;
    rdfs:domain ffonto:WaterBody ;
    rdfs:range xsd:boolean .

ffonto:fireScore a owl:DatatypeProperty ;
    rdfs:label "fire score",
        "fire score"@en ;
    rdfs:comment "Indicates a numerical value or confidence metric representing the likelihood or intensity of a detected fire."@en ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:decimal .

ffonto:fireScoreAboveThreshold a owl:DatatypeProperty ;
    rdfs:label "fire score above threshold?" ;
    rdfs:comment "Boolean indicating whether the fire score exceeds the configured fire threshold (system-declared)." ;
    rdfs:domain ffonto:VisionModelScores ;
    rdfs:range xsd:boolean .

ffonto:fireSheltersVisible a owl:DatatypeProperty ;
    rdfs:label "fire shelters visible" ;
    rdfs:comment "Indicates whether fire shelters are visible or deployed." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:fireThreshold a owl:DatatypeProperty ;
    rdfs:label "fire threshold",
        "fire threshold"@en ;
    rdfs:comment "Defines the specific thermal, visual, or algorithmic limit at which a system classifies an anomaly as a fire."@en ;
    rdfs:domain ffonto:ThresholdSet ;
    rdfs:range xsd:decimal .

ffonto:fireTypeValue a owl:DatatypeProperty ;
    rdfs:label "fire type (string)" ;
    rdfs:comment "Textual description of fire type (e.g., 'Primarily surface/ground with intermittent torching')." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:string .

ffonto:firefighterKneelingOrCover a owl:DatatypeProperty ;
    rdfs:label "firefighter kneeling or taking cover" ;
    rdfs:comment "Indicates whether firefighters are kneeling or using cover." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:firefighterSafetyRisk a owl:DatatypeProperty ;
    rdfs:label "firefighter safety risk present" ;
    rdfs:comment "Indicates whether hazards threaten firefighter safety." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:firefightersAssistingCivilian a owl:DatatypeProperty ;
    rdfs:label "firefighters assisting civilian" ;
    rdfs:comment "Indicates whether firefighters are assisting civilians." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:firefightersCloseToFlames a owl:DatatypeProperty ;
    rdfs:label "firefighters close to flames" ;
    rdfs:comment "Indicates whether firefighters are operating within close proximity to flames." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:firefightersCommunicating a owl:DatatypeProperty ;
    rdfs:label "firefighters communicating via radio" ;
    rdfs:comment "Indicates whether firefighters are communicating through radios." ;
    rdfs:domain ffonto:Communication ;
    rdfs:range xsd:boolean .

ffonto:firefightersMissingPPE a owl:DatatypeProperty ;
    rdfs:label "firefighters missing PPE" ;
    rdfs:comment "Indicates whether firefighters appear to lack essential protective equipment." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:firefightersMovingTowardFire a owl:DatatypeProperty ;
    rdfs:label "firefighters moving toward flames" ;
    rdfs:comment "Indicates whether firefighters are advancing toward the fire." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:firefightersRetreating a owl:DatatypeProperty ;
    rdfs:label "firefighters retreating from flames" ;
    rdfs:comment "Indicates whether firefighters are retreating from flames." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:firefightersWearingHeadlampsOrReflectiveGear a owl:DatatypeProperty ;
    rdfs:label "firefighters wearing headlamps or reflective gear" ;
    rdfs:comment "Observation that firefighters are using headlamps or wearing reflective safety equipment."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:boolean .

ffonto:firefightersWearingPPE a owl:DatatypeProperty ;
    rdfs:label "firefighters wearing protective gear" ;
    rdfs:comment "Indicates whether firefighters appear equipped with PPE." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:flameFrontsVisible a owl:DatatypeProperty ;
    rdfs:label "flame fronts visible" ;
    rdfs:comment "Indicates whether flame fronts are visible from the camera." ;
    rdfs:domain ffonto:CameraObservation ;
    rdfs:range xsd:boolean .

ffonto:flameLengthHighNearAssets a owl:DatatypeProperty ;
    rdfs:label "flame lengths high near assets" ;
    rdfs:comment "True if flame lengths are visibly long near critical assets." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:boolean .

ffonto:flamesAdvancingTowardPopulatedAreas a owl:DatatypeProperty ;
    rdfs:label "flames advancing toward populated areas (frame-relative)" ;
    rdfs:comment "True if flames are moving toward populated assets in the frame." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range xsd:boolean .

ffonto:flammabilityInfluencesRiskAssessment a owl:ObjectProperty ;
    rdfs:label "flammability influences risk assessment"@en ;
    rdfs:comment "Relates the combustible characteristics of an area or material to the calculated operational risk level."@en ;
    rdfs:domain ffonto:SeasonalFlammability ;
    rdfs:range ffonto:RiskAssessment ;
    owl:inverseOf ffonto:isRiskAssessmentInfluencedByFlammability .

ffonto:flammabilityLevel a owl:DatatypeProperty ;
    rdfs:label "flammability level" ;
    rdfs:comment "Indicates how flammable a tree species is (e.g., high, medium, low)." ;
    rdfs:domain ffonto:Tree ;
    rdfs:range xsd:string .

ffonto:foamVisible a owl:DatatypeProperty ;
    rdfs:label "foam visible on vegetation/ground/structures" ;
    rdfs:comment "Observation of firefighting foam present at the scene."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:foamVisibleAroundStructureFires a owl:DatatypeProperty ;
    rdfs:label "foam visible around structures" ;
    rdfs:comment "Indicates observation of firefighting foam applied near structure fires."@en ;
    rdfs:domain ffonto:ProtectionMeasure ;
    rdfs:range xsd:boolean .

ffonto:followedByAircraft a owl:ObjectProperty ;
    rdfs:label "followed by aircraft"@en ;
    rdfs:comment "Links a designated flight path, lead plane, or operational tactic to the aerial asset executing or tailing it."@en ;
    rdfs:domain ffonto:FlightPath ;
    rdfs:range ffonto:UAV ;
    owl:inverseOf ffonto:followsFlightPath .

ffonto:foodSafetyInstruction a owl:DatatypeProperty ;
    rdfs:label "food safety instruction" ;
    rdfs:comment "Instructions for handling food after long power outages." ;
    rdfs:domain ffonto:FoodSafetyProcedure ;
    rdfs:range xsd:string .

ffonto:footprintLiteral a owl:DatatypeProperty ;
    rdfs:label "footprint literal" ;
    rdfs:comment "Footprint geometry as WKT or JSON string." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:string .

ffonto:fragmentsHabitatOf a owl:ObjectProperty ;
    rdfs:label "inverse of fragments habitat"@en ;
    rdfs:comment "Inverse relation linking habitat fragmentation records back to the landscape processes causing them."@en ;
    rdfs:domain ffonto:HabitatFragmentation ;
    rdfs:range ffonto:Road ;
    owl:inverseOf ffonto:fragmentsHabitat .

ffonto:frameThreshold a owl:DatatypeProperty ;
    rdfs:label "frame threshold",
        "frame threshold"@en ;
    rdfs:comment "Defines the required number or interval of sequential video frames or images needed to trigger a confirmed detection."@en ;
    rdfs:domain ffonto:ThresholdSet ;
    rdfs:range xsd:integer .

ffonto:freshDozerLineVisible a owl:DatatypeProperty ;
    rdfs:label "fresh dozer line visible (bare soil track)" ;
    rdfs:comment "Observation of a recently constructed dozer line intended as a firebreak."@en ;
    rdfs:domain ffonto:HeavyEquipment ;
    rdfs:range xsd:boolean .

ffonto:fuelCansVisible a owl:DatatypeProperty ;
    rdfs:label "fuel cans or supply boxes visible" ;
    rdfs:comment "Indicates whether fuel cans or supply boxes are present." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range xsd:boolean .

ffonto:fuelInfluencesFireBehavior a owl:ObjectProperty ;
    rdfs:label "fuel influences fire behavior"@en ;
    rdfs:comment "Relates the combustible material (biomass) in an area to how its properties dictate the intensity and spread of a fire."@en ;
    rdfs:domain ffonto:FuelType ;
    rdfs:range ffonto:FireBehavior ;
    owl:inverseOf ffonto:isFireBehaviorInfluencedByFuel .

ffonto:fuelLeakVisible a owl:DatatypeProperty ;
    rdfs:label "fuel leak visible" ;
    rdfs:comment "Indicates visible vehicle fuel leaks or spills." ;
    rdfs:domain ffonto:Vehicle ;
    rdfs:range xsd:boolean .

ffonto:fuelLoadTonsPerHa a owl:DatatypeProperty ;
    rdfs:label "fuel load (tons/ha)" ;
    rdfs:comment "Quantitative fuel load expressed in tonnes per hectare." ;
    rdfs:domain ffonto:FuelLoad ;
    rdfs:range xsd:decimal .

ffonto:fuelMoistureAffectsCombustion a owl:ObjectProperty ;
    rdfs:label "fuel moisture affects combustion"@en ;
    rdfs:comment "Connects the water content of biomass to its influence on the ignition likelihood and burning rate of a fire."@en ;
    rdfs:domain ffonto:FuelMoisture ;
    rdfs:range ffonto:CombustionProcess ;
    owl:inverseOf ffonto:isCombustionAffectedByFuelMoisture .

ffonto:fuelsWetFromDewOrRain a owl:DatatypeProperty ;
    rdfs:label "fuels wet from rain or dew (description)" ;
    rdfs:comment "Describes whether fuels are wet from rain or dew this morning." ;
    rdfs:domain ffonto:FuelCondition ;
    rdfs:range xsd:string .

ffonto:fuseesVisible a owl:DatatypeProperty ;
    rdfs:label "fusees visible for spot ignition" ;
    rdfs:comment "Indicates that fusees or pyrotechnic markers are observed at a location."@en ;
    rdfs:domain ffonto:Tool ;
    rdfs:range xsd:boolean .

ffonto:fusesDataOf a owl:ObjectProperty ;
    rdfs:label "inverse of fuses data"@en ;
    rdfs:comment "Inverse relation indicating that data fusion outputs are associated with a specific source or dataset."@en ;
    rdfs:domain ffonto:DataStream ;
    rdfs:range ffonto:MultimodalDataFusion ;
    owl:inverseOf ffonto:fusesData .

ffonto:gasCylindersNearFlames a owl:DatatypeProperty ;
    rdfs:label "gas cylinders near flames" ;
    rdfs:comment "Indicates whether gas cylinders or propane tanks are near flames." ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range xsd:boolean .

ffonto:gateMelted a owl:DatatypeProperty ;
    rdfs:label "gate melted" ;
    rdfs:comment "Indicates whether a gate is melted by heat." ;
    rdfs:domain ffonto:Gate ;
    rdfs:range xsd:boolean .

ffonto:gateWarped a owl:DatatypeProperty ;
    rdfs:label "gate warped" ;
    rdfs:comment "Indicates whether a gate is warped by heat." ;
    rdfs:domain ffonto:Gate ;
    rdfs:range xsd:boolean .

ffonto:gatheringAtOf a owl:ObjectProperty ;
    rdfs:label "inverse of gathering at"@en ;
    rdfs:comment "Inverse relation linking gatherings back to the locations or assembly points where they occur."@en ;
    rdfs:domain ffonto:AssemblyArea ;
    rdfs:range ffonto:Civilian ;
    owl:inverseOf ffonto:gatheringAt .

ffonto:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated by" ;
    rdfs:comment "Indicates which model generated the annotation." ;
    rdfs:domain ffonto:Annotation ;
    rdfs:range ffonto:MLModel ;
    owl:inverseOf ffonto:generated .

ffonto:generatedByModelOf a owl:ObjectProperty ;
    rdfs:label "inverse of generated by model"@en ;
    rdfs:comment "Inverse relation linking model outputs back to the model that generated them."@en ;
    rdfs:domain ffonto:ModelVersion ;
    rdfs:range ffonto:ModelOutput ;
    owl:inverseOf ffonto:generatedByModel .

ffonto:generatedByWildfireOf a owl:ObjectProperty ;
    rdfs:label "inverse of generated by wildfire"@en ;
    rdfs:comment "Inverse relation linking outputs or impacts back to the wildfire events that generated them."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AshFall ;
    owl:inverseOf ffonto:generatedByWildfire .

ffonto:generatesAlertOf a owl:ObjectProperty ;
    rdfs:label "generates alert of"@en ;
    rdfs:comment "Connects an automated warning or notification back to the specific system, sensor, or threshold that triggered it."@en ;
    rdfs:domain ffonto:EmergencyAlert ;
    rdfs:range ffonto:FireAlertSystem ;
    owl:inverseOf ffonto:generatesAlert .

ffonto:generatesDataEntity a owl:ObjectProperty ;
    rdfs:label "generates data entity"@en ;
    rdfs:comment "Links a processing activity to the provenance entity (e.g., report, dataset) it produces."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity ;
    owl:inverseOf ffonto:isDataEntityGeneratedBy .

ffonto:generatesPyroWeatherOf a owl:ObjectProperty ;
    rdfs:label "inverse of generates pyro weather"@en ;
    rdfs:comment "Inverse relation linking pyro-weather generation back to the fires or conditions that produced it."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:ForestFire ;
    owl:inverseOf ffonto:generatesPyroWeather .

ffonto:generatorUsage a owl:DatatypeProperty ;
    rdfs:label "generator usage instructions" ;
    rdfs:comment "Short guidance on safe generator use (e.g., 'outdoors only')" ;
    rdfs:domain ffonto:GeneratorSafety ;
    rdfs:range xsd:string .

ffonto:globalDetectionThreshold a owl:DatatypeProperty ;
    rdfs:label "global detection threshold",
        "global detection threshold"@en ;
    rdfs:comment "Defines the overarching, system-wide baseline limit required to flag an anomaly or trigger an alert across all sensors."@en ;
    rdfs:domain ffonto:ThresholdSet ;
    rdfs:range xsd:decimal .

ffonto:glovesVisible a owl:DatatypeProperty ;
    rdfs:label "gloves visible on firefighters" ;
    rdfs:comment "Indicates whether protective gloves are worn." ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range xsd:boolean .

ffonto:governedOf a owl:ObjectProperty ;
    rdfs:label "inverse of governed by"@en ;
    rdfs:comment "Inverse relation linking governance relationships back to the entities or rules that govern them."@en ;
    rdfs:domain ffonto:LegalFramework ;
    rdfs:range owl:Thing ;
    owl:inverseOf ffonto:governedBy .

ffonto:governsModel a owl:ObjectProperty ;
    rdfs:label "governs model"@en ;
    rdfs:comment "Connects an AI model governance framework to the MLOps pipeline it oversees."@en ;
    rdfs:domain ffonto:AIModelGovernance ;
    rdfs:range ffonto:MLOpsPipeline ;
    owl:inverseOf ffonto:isModelGovernedBy .

ffonto:gradePercent a owl:DatatypeProperty ;
    rdfs:label "grade percent" ;
    rdfs:comment "The incline of a surface expressed as a percentage, used for access and safety assessments."@en ;
    rdfs:domain ffonto:Slope ;
    rdfs:range xsd:decimal .

ffonto:graderOrExcavatorAssistingLineConstruction a owl:DatatypeProperty ;
    rdfs:label "grader/excavator assisting line construction" ;
    rdfs:comment "Indicates use of heavy machinery to help construct control lines or clear fuels."@en ;
    rdfs:domain ffonto:HeavyEquipment ;
    rdfs:range xsd:boolean .

ffonto:grassHeightAndContinuity a owl:DatatypeProperty ;
    rdfs:label "grass height & continuity" ;
    rdfs:comment "Describes grass height (e.g., knee-high) and whether patchy or continuous." ;
    rdfs:domain ffonto:FuelCondition ;
    rdfs:range xsd:string .

ffonto:greenhouseDamaged a owl:DatatypeProperty ;
    rdfs:label "greenhouse or shed damaged" ;
    rdfs:comment "Whether a greenhouse or shed shows damage from fire or heat." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:gridX a owl:DatatypeProperty ;
    rdfs:label "grid x"@en ;
    rdfs:comment "Specifies the X-coordinate or horizontal index within a spatial grid system."@en,
        "The X coordinate index in a grid-based spatial indexing system."@en ;
    rdfs:domain ffonto:GridLocation ;
    rdfs:range xsd:integer .

ffonto:gridY a owl:DatatypeProperty ;
    rdfs:label "grid y"@en ;
    rdfs:comment "Specifies the Y-coordinate or vertical index within a spatial grid system."@en,
        "The Y coordinate index in a grid-based spatial indexing system."@en ;
    rdfs:domain ffonto:GridLocation ;
    rdfs:range xsd:integer .

ffonto:groundCrewRiskFromAerialDrops a owl:DatatypeProperty ;
    rdfs:label "ground crews at risk from aerial drops" ;
    rdfs:comment "Indicates whether aerial drops may endanger ground crews." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range xsd:boolean .

ffonto:groundSurfaceCharred a owl:DatatypeProperty ;
    rdfs:label "ground surface uniformly charred" ;
    rdfs:comment "Indicates whether the ground surface appears uniformly charred." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:boolean .

ffonto:groundVegetationPattern a owl:DatatypeProperty ;
    rdfs:label "ground vegetation burn pattern" ;
    rdfs:comment "Describes whether ground vegetation is 'entirely black', 'patchy', or 'mostly unburned'." ;
    rdfs:domain ffonto:Vegetation ;
    rdfs:range xsd:string .

ffonto:groundcoverConsumed a owl:DatatypeProperty ;
    rdfs:label "groundcover consumed exposing mineral soil" ;
    rdfs:comment "Indicates whether groundcover has been consumed exposing mineral soil." ;
    rdfs:domain ffonto:SoilCondition ;
    rdfs:range xsd:boolean .

ffonto:groundwaterRechargeRate a owl:DatatypeProperty ;
    rdfs:label "groundwater recharge rate" ;
    rdfs:comment "Represents the rate at which groundwater is replenished after infiltration." ;
    rdfs:domain ffonto:Groundwater ;
    rdfs:range xsd:float .

ffonto:guardrailsBurned a owl:DatatypeProperty ;
    rdfs:label "guardrails burned" ;
    rdfs:comment "Indicates whether guardrails show burn damage." ;
    rdfs:domain ffonto:Guardrail ;
    rdfs:range xsd:boolean .

ffonto:guardrailsWarped a owl:DatatypeProperty ;
    rdfs:label "guardrails warped" ;
    rdfs:comment "Indicates whether guardrails are warped due to heat." ;
    rdfs:domain ffonto:Guardrail ;
    rdfs:range xsd:boolean .

ffonto:guidesOperation a owl:ObjectProperty ;
    rdfs:label "guides operation"@en ;
    rdfs:comment "Relates an operational strategy to the specific operations section it guides."@en ;
    rdfs:domain ffonto:OperationalStrategy ;
    rdfs:range ffonto:OperationsSection ;
    owl:inverseOf ffonto:isOperationGuidedBy .

ffonto:guidingTrafficOf a owl:ObjectProperty ;
    rdfs:label "inverse of guiding traffic"@en ;
    rdfs:comment "Inverse relation linking traffic guidance actions back to the units or incidents responsible."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range ffonto:Responder ;
    owl:inverseOf ffonto:guidingTraffic .

ffonto:gutterHasDebris a owl:DatatypeProperty ;
    rdfs:label "gutters packed with debris" ;
    rdfs:comment "Indicates whether gutters contain accumulated debris." ;
    rdfs:domain ffonto:Gutter ;
    rdfs:range xsd:boolean .

ffonto:guttersPackedWithDebris a owl:DatatypeProperty ;
    rdfs:label "gutters packed with debris" ;
    rdfs:comment "Indicates whether gutters contain flammable debris." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:handlesFinanceFor a owl:ObjectProperty ;
    rdfs:label "handles finance for"@en ;
    rdfs:comment "Relates an administrative section, role, or system to the incident or operation it funds and tracks."@en ;
    rdfs:domain ffonto:FinanceAdministrationSection ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:hasFinanceAdministrationSection .

ffonto:hasAccuracy a owl:DatatypeProperty ;
    rdfs:label "model accuracy score" ;
    rdfs:comment "Indicates the measured or estimated accuracy of a value or prediction."@en ;
    rdfs:domain ffonto:ModelOutput ;
    rdfs:range xsd:decimal .

ffonto:hasAnnotation a owl:ObjectProperty ;
    rdfs:label "has annotation" ;
    rdfs:comment "Links an observation to an annotation derived from it." ;
    rdfs:domain ffonto:Observation ;
    rdfs:range ffonto:Annotation ;
    owl:inverseOf ffonto:isAnnotationOf .

ffonto:hasArea a owl:DatatypeProperty ;
    rdfs:label "area" ;
    rdfs:comment "Area of the spatial entity in square kilometers." ;
    rdfs:domain ffonto:SpatialEntity ;
    rdfs:range xsd:decimal .

ffonto:hasAverageTreeHeight a owl:DatatypeProperty ;
    rdfs:label "has average tree height" ;
    rdfs:comment "Relates a coniferous forest ecosystem to the average height of trees present within it." ;
    rdfs:domain ffonto:ConiferousForest ;
    rdfs:range xsd:float .

ffonto:hasBackburnArea a owl:DatatypeProperty ;
    rdfs:label "has backburn area" ;
    rdfs:comment "Relates a backburn strategy to the area intentionally burned to remove fuel." ;
    rdfs:domain ffonto:Backburn ;
    rdfs:range xsd:float .

ffonto:hasBarrierWidth a owl:DatatypeProperty ;
    rdfs:label "has barrier width" ;
    rdfs:comment "Relates a natural barrier to its width which may influence fire spread." ;
    rdfs:domain ffonto:NaturalBarrier ;
    rdfs:range xsd:float .

ffonto:hasBurnTemperature a owl:DatatypeProperty ;
    rdfs:domain ffonto:ControlledBurn ;
    rdfs:range xsd:float .

ffonto:hasCanopyCoverage a owl:DatatypeProperty ;
    rdfs:label "has canopy coverage" ;
    rdfs:comment "Represents the proportion of land covered by tree canopy." ;
    rdfs:domain ffonto:Forest ;
    rdfs:range xsd:float .

ffonto:hasCautionTape a owl:DatatypeProperty ;
    rdfs:label "has caution tape" ;
    rdfs:comment "Barrier tape used to mark hazards or restricted areas at an incident scene."@en,
        "Indicates that caution tape is present to mark hazards or restricted areas."@en ;
    rdfs:domain ffonto:Road ;
    rdfs:range xsd:boolean .

ffonto:hasChannelWidth a owl:DatatypeProperty ;
    rdfs:label "has channel width" ;
    rdfs:comment "Relates a water channel to its width measurement." ;
    rdfs:domain ffonto:WaterChannel ;
    rdfs:range xsd:float .

ffonto:hasCombustibleSiding a owl:DatatypeProperty ;
    rdfs:label "combustible siding present" ;
    rdfs:comment "Indicates whether the building siding material is combustible." ;
    rdfs:domain ffonto:Siding ;
    rdfs:range xsd:boolean .

ffonto:hasConfidence a owl:DatatypeProperty ;
    rdfs:label "confidence value" ;
    rdfs:comment "Associates an entity with a confidence metric expressing certainty."@en ;
    rdfs:domain ffonto:Observation ;
    rdfs:range xsd:decimal .

ffonto:hasCountry a owl:DatatypeProperty ;
    rdfs:label "has country"@en ;
    rdfs:comment "Links a geographic location, incident, or administrative entity to its sovereign national boundary."@en ;
    rdfs:domain ffonto:SpatialExtent ;
    rdfs:range xsd:string .

ffonto:hasCracklingSound a owl:DatatypeProperty ;
    rdfs:label "continuous crackling sound detected" ;
    rdfs:comment "Indicates detection of crackling noises typically associated with burning materials."@en ;
    rdfs:domain ffonto:AudioObservation ;
    rdfs:range xsd:boolean .

ffonto:hasDate a owl:DatatypeProperty ;
    rdfs:label "has date"@en ;
    rdfs:comment "Links an event, document, or observation to the specific calendar date on which it occurred or was recorded."@en ;
    rdfs:domain ffonto:TemporalExtent ;
    rdfs:range xsd:date .

ffonto:hasDateTime a owl:DatatypeProperty ;
    rdfs:label "has date time"@en ;
    rdfs:comment "Links an event, observation, or log entry to an exact timestamp combining both date and time of day."@en ;
    rdfs:domain ffonto:TemporalExtent ;
    rdfs:range xsd:dateTime .

ffonto:hasDay a owl:DatatypeProperty ;
    rdfs:label "has day"@en ;
    rdfs:comment "Connects a temporal entity or recorded event to the specific numerical day of the month."@en ;
    rdfs:domain ffonto:TemporalExtent ;
    rdfs:range xsd:gDay .

ffonto:hasDayName a owl:DatatypeProperty ;
    rdfs:label "has day name"@en ;
    rdfs:comment "Connects a temporal record or scheduled event to the specific day of the week (e.g., Monday, Tuesday)."@en ;
    rdfs:domain ffonto:TemporalExtent ;
    rdfs:range xsd:string .

ffonto:hasDeadBiomassVolume a owl:DatatypeProperty ;
    rdfs:label "has dead biomass volume" ;
    rdfs:comment "Volume of dead vegetation biomass present in an area." ;
    rdfs:domain ffonto:DeadVegetation ;
    rdfs:range xsd:float .

ffonto:hasDefensibleSpace a owl:DatatypeProperty ;
    rdfs:label "defensible space present" ;
    rdfs:comment "Specifies whether vegetation clearance exists around a structure to reduce wildfire spread." ;
    rdfs:domain ffonto:Building ;
    rdfs:range xsd:boolean .

ffonto:hasDegradedAreaPercentage a owl:DatatypeProperty ;
    rdfs:label "has degraded area percentage" ;
    rdfs:comment "Percentage of ecosystem area that is degraded or damaged." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range xsd:float .

ffonto:hasDescription a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "Associates an entity with a descriptive textual summary or definition."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:string .

ffonto:hasElementInverse a owl:ObjectProperty ;
    rdfs:label "inverse of has element"@en ;
    rdfs:comment "Inverse relation linking composite structures back to their constituent elements."@en ;
    rdfs:domain ffonto:FireElement ;
    rdfs:range ffonto:FireTriangle ;
    owl:inverseOf ffonto:hasElement .

ffonto:hasElevation a owl:DatatypeProperty ;
    rdfs:label "elevation" ;
    rdfs:comment "Elevation above sea level." ;

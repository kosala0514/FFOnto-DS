ffonto:buildingVisible a owl:DatatypeProperty ;
    rdfs:label "building visible" ;
    rdfs:comment "Indicates that a building is observable in imagery or situational reports."@en ;
    rdfs:domain ffonto:StructureFire ;
    rdfs:range xsd:boolean .

ffonto:bulldozerCuttingLine a owl:DatatypeProperty ;

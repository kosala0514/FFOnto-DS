ffonto:incidentName a owl:DatatypeProperty ;
    rdfs:label "incident name" ;
    rdfs:comment "The official or commonly used name of an incident for identification."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:string .

ffonto:incidentSizeAcres a owl:DatatypeProperty ;
    rdfs:label "incident size in acres" ;
    rdfs:comment "The area of an incident measured in acres."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:decimal .

ffonto:incidentStatus a owl:DatatypeProperty ;
    rdfs:label "incident status" ;
    rdfs:comment "Status values: spreading, contained, controlled, extinguished." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range xsd:string .

ffonto:includesCommandRole a owl:ObjectProperty ;
    rdfs:label "includes command role"@en ;
    rdfs:comment "Relates an Incident Command Section to the specific personnel roles assigned within it."@en ;
    rdfs:domain ffonto:IncidentCommandSection ;
    rdfs:range ffonto:IncidentCommandRole ;

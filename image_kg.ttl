ffonto:FireCountStatistic a owl:Class ;
    rdfs:label "Fire Count"@en ;
    rdfs:subClassOf ffonto:WildfireStatistic .

ffonto:FireDrivenEcologicalChange a owl:Class ;
    rdfs:label "Fire Driven Ecological Change" ;
    rdfs:comment "Any ecological effect that is logically linked to a forest fire event." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ffonto:EcologicalEffect [ a owl:Restriction ;
                        owl:onProperty ffonto:isEcologicalEffectOf ;
                        owl:someValuesFrom ffonto:ForestFire ] ) ] .

ffonto:FireEmergencyService a owl:NamedIndividual ;

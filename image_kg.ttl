ffonto:LockHomeBeforeLeaving a ffonto:BeforeEvacuationAction ;
    rdfs:label "Lock Home Before Leaving" ;
    rdfs:comment "Close and lock main doors and windows prior to evacuation but leave garage unlocked for responders if advised." .

ffonto:Logging a owl:Class ;
    rdfs:label "Logging" ;
    rdfs:comment "Human activity involving cutting down trees for timber." ;
    rdfs:subClassOf ffonto:Disturbance .

ffonto:LookoutTower a owl:Class ;

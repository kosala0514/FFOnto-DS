sosa:isHostedBy a owl:ObjectProperty ;
    rdfs:label "is hosted by"@en ;
    rdfs:comment "Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by."@en .

ffonto:AccessTerrainLimit a ffonto:Limitations ;
    rdfs:label "Inaccessible terrain limitation" ;
    rdfs:comment "Rugged terrain limits crew access and safe line construction." .

ffonto:AerialFirefighting a ffonto:SuppressionResource ;
    rdfs:label "Aerial Firefighting Aircraft" ;
    rdfs:comment "Aircraft dropping water or fire retardant." .

ffonto:AnthropogenicFactor a owl:Class ;
    rdfs:label "Anthropogenic Factor" ;
    rdfs:comment "Human activities that influence wildfire risk and environmental conditions." ;
    rdfs:subClassOf ffonto:ClimatePattern .

ffonto:AshCleanupGuideline a owl:Class ;
    rdfs:label "Ash Cleanup Guideline" ;
    rdfs:comment "Guidelines for safely cleaning wildfire ash from homes." ;
    rdfs:subClassOf ffonto:RecoveryGuideline .

ffonto:AwarenessCampaign a owl:Class ;
    rdfs:label "Awareness Campaign" ;
    rdfs:comment "An organized effort to inform the public about risks and preparedness actions."@en ;
    rdfs:subClassOf ffonto:PublicEducationProgram .

ffonto:Backburn a owl:Class ;
    rdfs:label "Backburn" ;
    rdfs:comment "A controlled fire set ahead of a wildfire to remove fuel." ;
    rdfs:subClassOf ffonto:FireManagementStrategy .

ffonto:BiodiversitySupport a owl:Class ;
    rdfs:label "Biodiversity Support" ;
    rdfs:comment "The maintenance of genetic and species diversity." ;
    rdfs:subClassOf ffonto:SupportingService .

ffonto:BuildingCode a owl:Class ;
    rdfs:label "Building Code / Regulations" ;
    rdfs:comment "Regulations that set standards for construction to ensure safety and performance."@en ;
    rdfs:subClassOf ffonto:LegalFramework .

ffonto:CDC a ffonto:ResponseOrganization,
        owl:NamedIndividual ;
    rdfs:label "Centers for Disease Control and Prevention",
        "Centers for Disease Control and Prevention (CDC)" ;
    ffonto:infoURL "https://www.cdc.gov"^^xsd:anyURI ;
    ffonto:phone "+1-800-232-4636" .

ffonto:CardiovascularEffect a owl:Class ;
    rdfs:label "Cardiovascular Effect" ;
    rdfs:comment "Any physiological effect that impacts the cardiovascular system."@en ;
    rdfs:subClassOf ffonto:SmokeHealthEffect .

ffonto:Children a ffonto:PopulationGroup ;
    rdfs:label "Children" .

ffonto:CleanRoom a ffonto:IndoorAirQualityStrategy,
        ffonto:SafetyMeasure ;
    rdfs:label "Clean Air Room" ;
    rdfs:comment "Indoor room sealed to reduce smoke infiltration.",
        "Indoor sealed room with HEPA filtration to reduce PM2.5 exposure." .

ffonto:ClearDropZoneAction a owl:Class ;
    rdfs:label "Clear Drop Zone Action" ;
    rdfs:comment "The operational activity where ground crews evacuate and secure a target area prior to an aerial drop." ;
    rdfs:subClassOf ffonto:ProtectiveAction .

ffonto:ClearedDropZone a owl:Class ;
    rdfs:label "Cleared Drop Zone" ;
    rdfs:comment "A drop zone that has successfully undergone a clearance action and is verified safe for aerial delivery." ;
    rdfs:subClassOf ffonto:DropZone .

ffonto:ClimateEvent a owl:Class ;
    rdfs:label "climate event"@en ;
    rdfs:comment "A specific, significant occurrence of weather or atmospheric conditions, such as a drought, heatwave, or storm."@en ;
    rdfs:subClassOf ffonto:TemporalExtent .

ffonto:CloseWindows a ffonto:ProtectiveAction ;
    rdfs:label "Close windows and doors" ;
    rdfs:comment "Recommended to prevent smoke from entering buildings." .

ffonto:CommandFunction a ffonto:ICSFunction ;
    rdfs:label "Command" .

ffonto:Communication a owl:Class ;
    rdfs:label "Communication Activity" ;
    rdfs:comment "Communication among firefighters such as radio coordination." .

ffonto:CommunicationDevice a owl:Class ;
    rdfs:label "communication device"@en ;
    rdfs:comment "Hardware used to transmit or receive information between responders, UAVs, or command centers."@en ;
    rdfs:subClassOf sosa:Platform .

ffonto:CommunityPreparednessPlan a owl:Class ;
    rdfs:label "community preparedness plan"@en ;
    rdfs:comment "A documented strategy outlining procedures and resources for a community to prepare for and respond to emergencies."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:ConiferousForest a owl:Class ;
    rdfs:label "Coniferous Forest" ;
    rdfs:comment "A forest ecosystem dominated by cone-bearing trees such as pines, spruces, and firs." ;
    rdfs:subClassOf ffonto:ForestEcosystem .

ffonto:ControlledBurn a owl:Class ;
    rdfs:label "Controlled Burn" ;
    rdfs:comment "A deliberately planned and managed fire used to reduce fuel loads, prevent severe forest fires, and promote forest regeneration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ffonto:occursIn ;
            owl:someValuesFrom ffonto:ForestEcosystem ],
        [ a owl:Restriction ;
            owl:onProperty ffonto:hasManagementPurpose ;
            owl:someValuesFrom ffonto:ManagementPurpose ],
        ffonto:FireManagementStrategy,
        ffonto:ForestFire,
        ffonto:PreventionMethod .

ffonto:CrownFireRisk a ffonto:Hazard ;
    rdfs:label "Crown Fire Risk" ;
    rdfs:comment "Risk that ground fire spreads into the tree canopy." .

ffonto:Culvert a owl:Class ;
    rdfs:label "Culvert" ;
    rdfs:comment "Culvert inlets/outlets along roadways." ;
    rdfs:subClassOf ffonto:TransportationInfrastructure .

ffonto:DataAnalysisProcess a owl:Class ;
    rdfs:label "data analysis process"@en ;
    rdfs:comment "The systematic computational or manual review of data to extract insights and inform decision-making."@en ;
    rdfs:subClassOf prov:Activity .

ffonto:DataAugmentation a owl:Class ;
    rdfs:label "Data Augmentation" ;
    rdfs:comment "Techniques to increase training data diversity by transforming existing examples."@en ;
    rdfs:subClassOf ffonto:ModelTrainingTechnique .

ffonto:DeadVegetation a owl:Class ;
    rdfs:label "Dead vegetation" ;
    rdfs:comment "Vegetation that has died due to fire, pests, drought, or disease." ;
    rdfs:subClassOf ffonto:VegetationCondition .

ffonto:DeciduousForest a owl:Class ;
    rdfs:label "Deciduous Forest" ;
    rdfs:comment "A forest ecosystem dominated by trees that seasonally shed their leaves." ;
    rdfs:subClassOf ffonto:ForestEcosystem,
        ffonto:VegetationType .

ffonto:DeciduousFunctional a owl:Class ;
    rdfs:label "Deciduous functional group" ;
    rdfs:comment "Deciduous-dominated functional group." ;
    rdfs:subClassOf ffonto:VegetationFunctionalGroup .

ffonto:DeployableShelter a owl:Class ;
    rdfs:label "Deployable Fire Shelter" ;
    rdfs:comment "A portable shelter intended for temporary housing during emergencies."@en ;
    rdfs:subClassOf ffonto:FireShelter .

ffonto:DownedLogs a ffonto:Fuel ;
    rdfs:label "Downed Logs" ;
    ffonto:hasFuelType ffonto:HeavyFuel ;
    rdfs:comment "Large woody debris that may smolder for long periods." .

ffonto:DroneMonitoring a owl:Class ;
    rdfs:label "Drone Monitoring" ;
    rdfs:comment "Use of unmanned aerial vehicles to observe, survey, or collect data over an area."@en ;
    rdfs:subClassOf ffonto:RemoteSensing .

ffonto:DryGrass a ffonto:Fuel ;
    rdfs:label "Dry Grass" ;
    rdfs:comment "Fine fuels that ignite easily and accelerate wildfire spread." .

ffonto:EmberSpotting a ffonto:Hazard ;
    rdfs:label "Ember Spotting Risk" ;
    rdfs:comment "Firebrands carried by wind igniting spot fires ahead of the main fire." .

ffonto:EmberTransport a owl:Class ;
    rdfs:label "Ember Transport" ;
    rdfs:comment "Movement of burning embers carried by wind." ;
    rdfs:subClassOf ffonto:FireBehavior .

ffonto:EnvironmentalImpact a owl:Class ;
    rdfs:label "environmental impact"@en ;
    rdfs:comment "The observable or measurable effect of an event or action on the natural environment, such as vegetation loss or soil degradation."@en ;
    rdfs:subClassOf ffonto:ForestFireEffect .

ffonto:EvacuateNow a ffonto:EvacuationAction ;
    rdfs:label "Evacuate immediately when ordered" ;
    rdfs:comment "Primary recommended action to maximize survival." .

ffonto:ExplosionEvent a owl:Class ;
    rdfs:label "Explosion Event" ;
    rdfs:comment "An explosion detected within the wildfire response environment." .

ffonto:ExtremeWindLimit a ffonto:Limitations ;
    rdfs:label "Extreme wind limitation" ;
    rdfs:comment "High winds may ground air tankers, increase ember transport, and reduce effectiveness of line construction." .

ffonto:F1Score a owl:Class ;
    rdfs:label "F1 Score" ;
    rdfs:comment "The harmonic mean of precision and recall, used as a performance metric for classification."@en ;
    rdfs:subClassOf ffonto:EvaluationMetric .

ffonto:Fence a owl:Class ;
    rdfs:label "Fence" ;
    rdfs:comment "Fences or barriers present at the scene." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:FinanceFunction a ffonto:ICSFunction ;
    rdfs:label "Finance / Administration" .

ffonto:FineFuel a ffonto:FuelType ;
    rdfs:label "Fine Fuel" ;
    rdfs:comment "Fast-drying, fast-burning materials like grass, leaves, and needles that ignite easily." .

ffonto:FireDangerAssessment a owl:Class ;
    rdfs:label "Fire Danger Assessment" ;
    rdfs:comment "Assessment of wildfire danger based on FWI system values." .

ffonto:FireIntensity a owl:Class ;
    rdfs:label "Fire Intensity" ;
    rdfs:comment "The energy output of a fire." ;
    rdfs:subClassOf ffonto:FireBehavior .

ffonto:Firebreak a ffonto:PreventionMethod,
        owl:Class ;
    rdfs:label "Firebreak" ;
    rdfs:comment "A gap in vegetation used to stop or slow fire spread.",
        "Cleared strips of land used to stop or slow wildfire spread." ;
    rdfs:subClassOf ffonto:FireManagementStrategy .

ffonto:FirstAidKit a ffonto:PreparednessItem ;
    rdfs:label "First Aid Kit" .

ffonto:FirstAidKitItem a ffonto:PreparednessItem ;
    rdfs:label "First Aid Kit Item" ;
    rdfs:comment "Includes basic medical supplies and family prescription medications." .

ffonto:FlameHeight a owl:Class ;
    rdfs:label "Flame Height" ;
    rdfs:comment "The vertical height of flames during a fire." ;
    rdfs:subClassOf ffonto:FireBehavior .

ffonto:FollowAlerts a ffonto:EvacuationAction ;
    rdfs:label "Subscribe to & follow official alerts (EAS, Wireless Emergency Alerts, agency apps)" .

ffonto:FoodSafetyProcedure a owl:Class ;
    rdfs:label "Food Safety Procedure" ;
    rdfs:comment "Food safety measures recommended after power outages." .

ffonto:FuelElement a ffonto:Fuel ;
    rdfs:label "Combustible Fuel" .

ffonto:GOES a owl:Class ;
    rdfs:label "GOES (geostationary thermal/IR)" ;
    rdfs:comment "Geostationary Operational Environmental Satellite; a family of weather-monitoring satellites."@en ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:GlovesAndEyeProtection a ffonto:ClothingRecommendation ;
    rdfs:label "Gloves and Eye Protection" ;
    rdfs:comment "Leather or heavy gloves and goggles or safety glasses." .

ffonto:GraphNeuralNetwork a owl:Class ;
    rdfs:label "Graph Neural Network" ;
    rdfs:comment "ML architecture capable of modeling connectivity relationships such as fuel networks or road evacuation routes." ;
    rdfs:subClassOf ffonto:MachineLearningModel .

ffonto:Grassland a owl:Class ;
    rdfs:label "Grassland" ;
    rdfs:comment "An ecosystem dominated primarily by grasses and herbaceous plants." ;
    rdfs:subClassOf ffonto:Ecosystem,
        ffonto:TerrainFeature .

ffonto:Gutter a owl:Class ;
    rdfs:label "Gutter" ;
    rdfs:comment "A drainage component attached to the roof edge that can collect leaves and debris, increasing fire risk." ;
    rdfs:subClassOf ffonto:BuildingComponent .

ffonto:HabitatProvision a owl:Class ;
    rdfs:label "Habitat Provision" ;
    rdfs:comment "Provision of living space for organisms." ;
    rdfs:subClassOf ffonto:EcosystemService .

ffonto:HaveEmergencyKit a ffonto:EvacuationAction ;
    rdfs:label "Maintain emergency kit (72-hour supply)" .

ffonto:HeartLungPatients a ffonto:PopulationGroup ;
    rdfs:label "People with Lung Disease" .

ffonto:Heat a owl:Class ;
    rdfs:label "Heat" ;
    rdfs:comment "Ignition energy source that starts combustion." ;
    rdfs:subClassOf ffonto:FireElement .

ffonto:HeatElement a ffonto:Heat ;
    rdfs:label "Heat Source" .

ffonto:HotspotLocalization a owl:Class ;
    rdfs:label "Hotspot Localization" ;
    rdfs:comment "Determining the geographic location of thermal anomalies indicating active fire or heat sources."@en ;
    rdfs:subClassOf ffonto:ComputerVisionTask .

ffonto:HumanEstimation a owl:Class ;
    rdfs:label "Human estimation" ;
    rdfs:comment "A wildfire estimation produced by human experts such as firefighters or analysts." ;
    rdfs:subClassOf ffonto:EstimationMethod .

ffonto:HumiditySensor a ffonto:Sensor ;
    rdfs:label "Humidity Sensor" .

ffonto:ImportantDocsContainer a ffonto:ImportantDocument ;
    rdfs:label "Important Documents Container - waterproof/fireproof container + cloud backup" ;
    ffonto:documentStorageMethod "fire-resistant safe; waterproof pouch; encrypted cloud backup" ;
    rdfs:comment "Birth certificates, wills, insurance policies, property deeds; store offline and in cloud backup." .

ffonto:IncidentReport a owl:Class ;
    rdfs:label "incident report"@en ;
    rdfs:comment "A formal document or record detailing the occurrence, response, and conditions of a specific emergency event."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:IncidentStabilization a owl:NamedIndividual ;
    rdfs:label "Incident Stabilization" .

ffonto:IndoorShelter a ffonto:SafetyMeasure ;
    rdfs:label "Stay Indoors" .

ffonto:InformationSystem a owl:Class ;
    rdfs:label "information system"@en ;
    rdfs:comment "A structured set of software, hardware, and networks used to collect, process, manage, and distribute data."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:InsectInfestation a owl:Class ;
    rdfs:label "Insect Infestation" ;
    rdfs:comment "Damage to forests caused by insect outbreaks." ;
    rdfs:subClassOf ffonto:ForestDisturbance .

ffonto:InsuranceDocumentationGuideline a owl:Class ;
    rdfs:label "Insurance Documentation Guideline" ;
    rdfs:comment "Guidelines for documenting wildfire damage for insurance claims." ;
    rdfs:subClassOf ffonto:RecoveryGuideline .

ffonto:Island a owl:Class ;
    rdfs:label "Island" ;
    rdfs:comment "A landmass surrounded by water." ;
    rdfs:subClassOf ffonto:LandscapeFeature .

ffonto:Lake a owl:Class ;
    rdfs:label "Lake" ;
    rdfs:comment "A large inland body of standing water." ;
    rdfs:subClassOf ffonto:WaterBody .

ffonto:LeafLitter a ffonto:Fuel ;
    rdfs:label "Leaf Litter" .

ffonto:LifeSafety a owl:NamedIndividual ;
    rdfs:label "Life Safety" .

ffonto:LightFuel a ffonto:FuelType ;
    rdfs:label "Light Fuel" ;
    rdfs:comment "Fast-burning fuels such as grass, leaves, and needles." .

ffonto:LimitExercise a ffonto:ProtectiveAction ;
    rdfs:label "Limit outdoor physical activity" ;
    rdfs:comment "Reducing outdoor exercise minimizes inhalation of smoke particles." .

ffonto:LimitOutdoorActivity a ffonto:SafetyMeasure ;
    rdfs:label "Limit Outdoor Activity During Smoke Events" .

ffonto:LogisticsFunction a ffonto:ICSFunction ;
    rdfs:label "Logistics" .

ffonto:LongSleevesAndPants a ffonto:ClothingRecommendation ;
    rdfs:label "Long Sleeves and Long Pants" ;
    ffonto:clothingMaterial "cotton or wool; avoid polyester or nylon" ;
    rdfs:comment "Natural fiber clothing such as cotton or wool to resist brief heat exposure." .

ffonto:MachineLearning a owl:Class ;
    rdfs:label "Machine learning"@en ;
    rdfs:comment "A computational approach where models learn patterns from data for wildfire prediction or analysis."@en ;
    rdfs:subClassOf ffonto:ForestFireTechnology .

ffonto:Mailbox a owl:Class ;
    rdfs:label "Mailbox" ;
    rdfs:comment "Mailboxes located near buildings or roads." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:ManualSuppression a owl:Class ;
    rdfs:label "Manual Suppression" ;
    rdfs:comment "Fire suppression performed using tools and human labor." ;
    rdfs:subClassOf ffonto:FireManagementStrategy .

ffonto:Medication a ffonto:PreparednessItem ;
    rdfs:label "Medication" .

ffonto:MixedForest a owl:Class ;
    rdfs:label "Mixed Forest" ;
    rdfs:comment "A forest ecosystem containing both coniferous and deciduous tree species." ;
    rdfs:subClassOf ffonto:ForestEcosystem .

ffonto:ModelEstimation a owl:Class ;
    rdfs:label "Model estimation" ;
    rdfs:comment "A wildfire estimation generated using computational or predictive models." ;
    rdfs:subClassOf ffonto:EstimationMethod .

ffonto:MoistureLevel a owl:Class ;
    rdfs:label "Moisture Level" ;
    rdfs:comment "Amount of moisture present in the environment." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor .

ffonto:NationalFireAgency a ffonto:ResponseOrganization ;
    rdfs:label "National Fire Management Agency" ;
    ffonto:contactNumber "+1-800-555-3473" ;
    ffonto:website "https://www.fire.gov" .

ffonto:NaturalBarrier a owl:Class ;
    rdfs:label "Natural Barrier" ;
    rdfs:comment "Natural features such as rivers or lakes that slow fire spread." ;
    rdfs:subClassOf ffonto:EnvironmentalFactor,
        ffonto:Topography .

ffonto:Nausea a ffonto:HealthSymptom ;
    rdfs:label "Nausea" .

ffonto:NeurologicalDevelopmentIssue a owl:Class ;
    rdfs:label "Neurodevelopmental Impact" ;
    rdfs:comment "A developmental condition affecting the nervous system and cognitive or motor function."@en ;
    rdfs:subClassOf ffonto:SmokeHealthEffect .

ffonto:ObservationSystem a owl:Class ;
    rdfs:label "Observation System" ;
    rdfs:comment "The system, sensor, or platform generating the data." .

ffonto:OlderAdults a ffonto:PopulationGroup ;
    rdfs:label "Older Adults" .

ffonto:OperationsFunction a ffonto:ICSFunction ;
    rdfs:label "Operations" .

ffonto:Oxygen a owl:Class ;
    rdfs:label "Oxygen" ;
    rdfs:comment "Oxidizing agent enabling combustion." ;
    rdfs:subClassOf ffonto:FireElement .

ffonto:OxygenElement a ffonto:Oxygen ;
    rdfs:label "Oxygen Supply" .

ffonto:PGEUtility a owl:NamedIndividual ;
    rdfs:label "Pacific Gas and Electric Company (Example utility)" ;
    ffonto:infoURL "https://www.pge.com"^^xsd:anyURI ;
    ffonto:phone "+1-800-743-5002" ;
    rdfs:comment "Utility often associated with pre-emptive de-energization programs (PSPS) in extreme fire weather." .

ffonto:PestInfestation a owl:Class ;
    rdfs:label "Pest infestation" ;
    rdfs:comment "Damage to vegetation caused by insects or pests." ;
    rdfs:subClassOf ffonto:Disturbance .

ffonto:PetCarrier a ffonto:PreparednessItem ;
    rdfs:label "Pet Carrier / Crate" ;
    rdfs:comment "Secure carrier for transporting pets safely." .

ffonto:PetFood a ffonto:PreparednessItem ;
    rdfs:label "Pet Food & Water" ;
    rdfs:comment "Sufficient pet food and water for evacuation duration." .

ffonto:PetVaccineRecord a ffonto:PreparednessItem ;
    rdfs:label "Pet Vaccination Record" ;
    rdfs:comment "Proof of vaccinations for pet shelter admission." .

ffonto:PhysicalProcess a owl:Class ;
    rdfs:label "physical process"@en ;
    rdfs:comment "A natural or environmental mechanism, such as combustion or wind dynamics, affecting the incident."@en ;
    rdfs:subClassOf prov:Activity .

ffonto:PineNeedles a ffonto:Fuel ;
    rdfs:label "Pine Needles" .

ffonto:PlanningFunction a ffonto:ICSFunction ;
    rdfs:label "Planning" .

ffonto:PlantSpecies a owl:Class ;
    rdfs:label "Plant Species" ;
    rdfs:comment "Specific biological taxa that respond to fire." ;
    rdfs:subClassOf ffonto:Plant .

ffonto:Precision a owl:Class ;
    rdfs:label "Precision" ;
    rdfs:comment "A measure of the proportion of true positive results among positive predictions."@en ;
    rdfs:subClassOf ffonto:EvaluationMetric .

ffonto:PredictionMetric a owl:Class ;
    rdfs:label "prediction metric"@en ;
    rdfs:comment "A forecasted value or indicator generated by a model, such as the predicted speed of fire spread."@en ;
    rdfs:subClassOf ffonto:ObservableProperty .

ffonto:PregnantPeople a ffonto:PopulationGroup ;
    rdfs:label "Pregnant Individuals" .

ffonto:PrescribedBurnPolicy a owl:Class ;
    rdfs:label "Prescribed Burning Policy" ;
    rdfs:comment "Regulatory or operational guidelines governing the planning and execution of prescribed fires."@en ;
    rdfs:subClassOf ffonto:LegalFramework .

ffonto:PrescriptionMedications a ffonto:PreparednessItem ;
    rdfs:label "Prescription Medications" ;
    rdfs:comment "Prescriptions (original or up-to-date list) and supplies needed for continuity of care." .

ffonto:PropertyProtection a owl:NamedIndividual ;
    rdfs:label "Property Protection" .

ffonto:ReducedVisibility a ffonto:Hazard ;
    rdfs:label "Reduced Visibility" ;
    ffonto:mitigatedBy ffonto:LimitOutdoorActivity .

ffonto:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A large geographic or administrative area within a country." ;
    rdfs:subClassOf ffonto:SpatialEntity .

ffonto:ResearchOrganization a owl:Class ;
    rdfs:label "Research Organization"@en ;
    rdfs:subClassOf prov:Organization .

ffonto:RespiratoryEffect a owl:Class ;
    rdfs:label "Respiratory Effect" ;
    rdfs:comment "Any effect that impacts the respiratory system, including irritation or disease."@en ;
    rdfs:subClassOf ffonto:SmokeHealthEffect .

ffonto:RespiratoryIrritation a ffonto:HealthEffect,
        ffonto:HealthRisk ;
    rdfs:label "Respiratory Irritation" .

ffonto:RockSurface a owl:Class ;
    rdfs:label "Rock Surface" ;
    rdfs:comment "Represents rocks or exposed mineral surfaces affected by wildfire heat." .

ffonto:RockyTerrain a owl:Class ;
    rdfs:label "Rocky terrain" ;
    rdfs:comment "Land cover dominated by exposed rocks or rocky surfaces." ;
    rdfs:subClassOf ffonto:LandCover .

ffonto:RouteAPlan a ffonto:EvacuationPlan ;
    rdfs:label "Primary Evacuation Route A" ;
    ffonto:recommendedAction "Designate primary and alternate routes and practice quarterly." .

ffonto:SAR a ffonto:RemoteSensingMethod,
        owl:Class ;
    rdfs:label "Synthetic Aperture Radar (SAR)" ;
    rdfs:comment "Radar-based remote sensing used to estimate forest structure and stand height." ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:SatelliteImagery a ffonto:RemoteSensingMethod ;
    rdfs:label "Satellite Imagery" .

ffonto:SatelliteObservation a owl:Class ;
    rdfs:label "Satellite Observation" ;
    rdfs:comment "An observation event derived from satellite passes on a given day to check for smoke plumes." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:SelfSupervisedLearning a owl:Class ;
    rdfs:label "Self Supervised Learning" ;
    rdfs:comment "A machine learning paradigm using automatically generated labels from input data structure."@en ;
    rdfs:subClassOf ffonto:ModelTrainingTechnique .

ffonto:ShortnessOfBreath a ffonto:HealthSymptom ;
    rdfs:label "Shortness of Breath",
        "Shortness of breath" .

ffonto:Shrubland a owl:Class ;
    rdfs:label "Shrubland" ;
    rdfs:comment "An ecosystem characterized by dense shrub vegetation." ;
    rdfs:subClassOf ffonto:Ecosystem .

ffonto:Siding a owl:Class ;
    rdfs:label "Siding Material" ;
    rdfs:comment "Exterior wall covering material that may be combustible or fire resistant." ;
    rdfs:subClassOf ffonto:BuildingComponent .

ffonto:Slope a owl:Class ;
    rdfs:label "Slope" ;
    rdfs:comment "The steepness or incline of terrain, commonly expressed as a percentage or angle."@en ;
    rdfs:subClassOf ffonto:Topography .

ffonto:SmokeDetection a owl:Class ;
    rdfs:label "Smoke/Flame Detection" ;
    rdfs:comment "The process or technology used to identify the presence of smoke in an environment."@en ;
    rdfs:subClassOf ffonto:ComputerVisionTask .

ffonto:SmokeHazard a owl:Class ;
    rdfs:label "Smoke Hazard" ;
    rdfs:comment "Respiratory and visibility impacts from PM2.5 and toxic smoke." ;
    rdfs:subClassOf ffonto:Hazard .

ffonto:SmokeInhalation a ffonto:HealthRisk ;
    rdfs:label "Smoke Inhalation Hazard" ;
    ffonto:affects ffonto:Person ;
    ffonto:affectsAnimal ffonto:Animal ;
    ffonto:mitigatedBy ffonto:CleanRoom,
        ffonto:IndoorShelter,
        ffonto:UseRespirator ;
    rdfs:comment "Fine particulate matter (PM2.5) in wildfire smoke causing respiratory issues." .

ffonto:SmokeSensor a ffonto:Sensor ;
    rdfs:label "Smoke Sensor" .

ffonto:SoilNutrientChange a owl:Class ;
    rdfs:label "Soil Nutrient Change" ;
    rdfs:comment "Changes in soil nutrient composition caused by fire." ;
    rdfs:subClassOf ffonto:EcologicalImpact .

ffonto:SolarPanel a owl:Class ;
    rdfs:label "Solar Panel" ;
    rdfs:comment "Photovoltaic panels installed on rooftops." .

ffonto:SoreThroat a ffonto:HealthSymptom ;
    rdfs:label "Sore Throat",
        "Sore throat" .

ffonto:SpotFireTriage a ffonto:EmergencyOperation ;
    rdfs:label "Spot Fire Triage Operation" .

ffonto:StandardKit a ffonto:EmergencyKit ;
    rdfs:label "72-Hour Emergency Kit" ;
    ffonto:recommendedAction "3 days of water, food, medications, documents, first-aid supplies." .

ffonto:StayIndoors a ffonto:ProtectiveAction ;
    rdfs:label "Stay indoors during heavy smoke" ;
    rdfs:comment "Advises individuals to remain indoors when smoke levels are hazardous." .

ffonto:StructureShelter a owl:Class ;
    rdfs:label "Structure / Vehicle Shelter" ;
    rdfs:comment "A building or structure designated to provide protection to people during emergencies."@en ;
    rdfs:subClassOf ffonto:FireShelter .

ffonto:Stump a owl:Class ;
    rdfs:label "Stump" ;
    rdfs:comment "Tree stumps that may smolder." ;
    rdfs:subClassOf ffonto:Vegetation .

ffonto:SturdyBoots a ffonto:ClothingRecommendation ;
    rdfs:label "Sturdy Boots" ;
    ffonto:clothingMaterial "leather or heavy canvas; avoid meltable synthetics" ;
    rdfs:comment "Closed-toe, durable footwear to protect feet from heat and debris." .

ffonto:SurfaceFuel a ffonto:FuelType ;
    rdfs:label "Surface Fuel" ;
    rdfs:comment "Fuel located on the ground surface, such as leaf litter, twigs, and low vegetation." .

ffonto:TemperatureSensor a ffonto:Sensor ;
    rdfs:label "Temperature Sensor" .

ffonto:TextAnnotation a owl:Class ;
    rdfs:label "Text Annotation" ;
    rdfs:comment "Textual annotation such as captions or descriptions." ;
    rdfs:subClassOf ffonto:Annotation .

ffonto:ThreeDayFoodSupply a ffonto:PreparednessItem ;
    rdfs:label "Three-day nonperishable food supply" ;
    rdfs:comment "Ready-to-eat and nonperishable foods for at least 3 days (extendable to 5-7 days as advised)." .

ffonto:TrafficControl a ffonto:EmergencyOperation ;
    rdfs:label "Traffic Control Deployment" .

ffonto:Transformer a owl:Class ;
    rdfs:label "Transformer" ;
    rdfs:comment "Electrical transformers and associated equipment." ;
    rdfs:subClassOf ffonto:UtilityInfrastructure .

ffonto:TreeRegeneration a owl:Class ;
    rdfs:label "Tree Regeneration" ;
    rdfs:comment "The process of tree regrowth following fire disturbance." ;
    rdfs:subClassOf ffonto:EcologicalImpact .

ffonto:TurnOffPropane a ffonto:BeforeEvacuationAction ;
    rdfs:label "Turn Off Propane Tanks" ;
    rdfs:comment "Shut off external propane tanks to reduce explosion risk if advised and safe to do so." .

ffonto:UAVOperation a owl:Class ;
    rdfs:label "UAV operation"@en ;
    rdfs:comment "A planned flight or deployment of an Unmanned Aerial Vehicle (UAV) for observation, communication, or mitigation."@en ;
    rdfs:subClassOf prov:Activity .

ffonto:USForestService a ffonto:ResponseOrganization ;
    rdfs:label "US Forest Service" ;
    ffonto:hasPhoneNumber "+1-202-205-8333" ;
    ffonto:hasWebsite "https://www.fs.usda.gov"^^xsd:anyURI .

ffonto:UseHEPAFilter a ffonto:ProtectiveAction ;
    rdfs:label "Use HEPA air filtration" ;
    rdfs:comment "Using HEPA filters helps reduce smoke particles indoors." .

ffonto:UseRespirator a ffonto:SafetyMeasure ;
    rdfs:label "Use Child-Sized Respirator" ;
    rdfs:comment "Respirators may help reduce smoke inhalation for children if tolerated." .

ffonto:VIIRS a owl:Class ;
    rdfs:label "VIIRS (polar thermal sensor)" ;
    rdfs:comment "Visible Infrared Imaging Radiometer Suite; satellite instrument used for thermal anomaly detection."@en ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:VegetationRecovery a owl:Class ;
    rdfs:label "Vegetation Recovery" ;
    rdfs:comment "Regrowth of vegetation following fire disturbance." ;
    rdfs:subClassOf ffonto:EcologicalImpact .

ffonto:VehicleAccess a owl:Class ;
    rdfs:label "Vehicle Access" ;
    rdfs:comment "The ability for vehicles to reach or traverse a location or route."@en ;
    rdfs:subClassOf ffonto:AccessConstraintDetail .

ffonto:VisibilityRange a owl:Class ;
    rdfs:label "Visibility Range" ;
    rdfs:comment "Distance-based visibility indicator used to estimate air quality." .

ffonto:Water a ffonto:PreparednessItem ;
    rdfs:label "Emergency Water Supply" .

ffonto:WaterChannel a owl:Class ;
    rdfs:label "Water Channel" ;
    rdfs:comment "A narrow water passage connecting bodies of water." ;
    rdfs:subClassOf ffonto:WaterBody .

ffonto:WaterOnePersonPerDay a ffonto:PreparednessItem ;
    rdfs:label "Water (1 gallon per person per day)" ;
    rdfs:comment "Recommended potable water per person per day." .

ffonto:WaterProtection a owl:Class ;
    rdfs:label "Water Protection" ;
    rdfs:comment "The regulation of water flow and filtration of pollutants." ;
    rdfs:subClassOf ffonto:RegulatingService .

ffonto:WaterTanker a ffonto:SuppressionResource ;
    rdfs:label "Water Tanker" .

ffonto:WindSensor a ffonto:Sensor ;
    rdfs:label "Wind Sensor" .

ffonto:adjacentToWaterBody a owl:ObjectProperty ;
    rdfs:label "adjacent to water body" ;
    rdfs:comment "Indicates that an ecosystem is located next to or near a water body." ;
    rdfs:domain ffonto:Ecosystem ;
    rdfs:range ffonto:WaterBody .

ffonto:advancingToward a owl:ObjectProperty ;
    rdfs:label "advancing toward fire front" ;
    rdfs:comment "Indicates directionality of movement toward a specified target or area."@en ;
    rdfs:domain ffonto:Firefighter ;
    rdfs:range ffonto:HoseLine .

ffonto:affectedBy a owl:ObjectProperty ;
    rdfs:label "affected by wildfire" ;
    rdfs:comment "Indicates infrastructure threatened by wildfire." ;
    rdfs:domain ffonto:Infrastructure ;
    rdfs:range ffonto:ForestFire .

ffonto:affectedByAsh a owl:ObjectProperty ;
    rdfs:label "affected by ash"@en ;
    rdfs:comment "Relates an AgriculturalProduce instance to one or more AshFall instances that affected it."@en ;
    rdfs:domain ffonto:AgriculturalProduce ;
    rdfs:range ffonto:AshFall .

ffonto:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    rdfs:comment "A general relation indicating influence or impact on another entity."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range ffonto:Person .

ffonto:affectsAnimalOf a owl:ObjectProperty ;
    rdfs:label "affects animals or pets of" ;
    rdfs:comment "Inverse - Indicates animals impacted by wildfire smoke." ;
    rdfs:domain ffonto:Animal ;
    rdfs:range ffonto:ForestFire .

ffonto:affectsAviationRoute a owl:ObjectProperty ;
    rdfs:label "affects aviation route" ;
    rdfs:comment "Indicates that conditions or events interfere with or endanger aviation routes."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AviationRoute .

ffonto:affectsEcosystem a owl:ObjectProperty ;
    rdfs:label "affects ecosystem" ;
    rdfs:comment "Indicates that a fire event affects an ecosystem through vegetation relationships." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Ecosystem ;
    owl:propertyChainAxiom ( ffonto:hasVegetation ffonto:influencedBy ) .

ffonto:affectsForestArea a owl:ObjectProperty ;
    rdfs:label "affects forest area"@en ;
    rdfs:comment "Indicates that an event, phenomenon, or policy impacts a specific wooded geographic region."@en ;
    rdfs:domain ffonto:ForestDisturbance ;
    rdfs:range geo:SpatialObject .

ffonto:affectsGroundwaterRecharge a owl:ObjectProperty ;
    rdfs:label "affects groundwater recharge" ;
    rdfs:comment "Indicates that a wildfire influences groundwater recharge rates by altering soil permeability and vegetation cover." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Groundwater .

ffonto:affectsHabitat a owl:ObjectProperty ;
    rdfs:label "affects habitat" ;
    rdfs:comment "Indicates that an ecological effect alters wildlife habitat type (mature forest, shrub land, grass land)." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:HabitatType .

ffonto:affectsHealth a owl:ObjectProperty ;
    rdfs:label "affects health"@en ;
    rdfs:comment "Indicates that an environmental condition, event, or pollutant has a measurable impact on the physical well-being of a population."@en ;
    rdfs:domain ffonto:AirPollutantProperty ;
    rdfs:range ffonto:RespiratoryIssue .

ffonto:affectsRateOfSpread a owl:ObjectProperty ;
    rdfs:label "affects rate of spread"@en ;
    rdfs:comment "Relates a meteorological variable or factor to the rate of spread it influences."@en ;
    rdfs:domain ffonto:MeteorologicalObservation ;
    rdfs:range ffonto:RateOfSpread .

ffonto:affectsRespiratoryHealth a owl:ObjectProperty ;
    rdfs:label "affects respiratory health" ;
    rdfs:comment "Represents the impact of air pollution on human respiratory health." ;
    rdfs:domain ffonto:AirPollution ;
    rdfs:range ffonto:HumanHealth .

ffonto:affectsVegetation a owl:ObjectProperty ;
    rdfs:label "affects vegetation" ;
    rdfs:comment "Indicates wildfire effects on vegetation." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:Vegetation .

ffonto:affectsWaterBody a owl:ObjectProperty ;
    rdfs:label "affects water body" ;
    rdfs:comment "Indicates that wildfire impacts affect a nearby water body." ;
    rdfs:domain ffonto:WildfireScene ;
    rdfs:range ffonto:WaterBody .

ffonto:affectsWildlife a owl:ObjectProperty ;
    rdfs:label "affects wildlife"@en ;
    rdfs:comment "Indicates an effect or impact on wildlife populations or habitats."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Wildlife .

ffonto:aircraftAction a owl:ObjectProperty ;
    rdfs:label "aircraft action" ;
    rdfs:comment "An action performed by an aircraft during operations (e.g., drop, reconnaissance)."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AircraftAction .

ffonto:allocatesResource a owl:ObjectProperty ;
    rdfs:label "allocates resource"@en ;
    rdfs:comment "Indicates the distribution or assignment of personnel, equipment, or funds to a specific task or location."@en ;
    rdfs:domain ffonto:ResourceAllocationOptimization ;
    rdfs:range ffonto:FirefightingResource .

ffonto:altersSpeciesComposition a owl:ObjectProperty ;
    rdfs:label "alters species composition" ;
    rdfs:comment "Fire may change species composition." ;
    rdfs:domain ffonto:EcologicalEffect ;
    rdfs:range ffonto:Vegetation .

ffonto:animalVisible a owl:ObjectProperty ;
    rdfs:label "animal visible" ;
    rdfs:comment "Indicates that one or more animals are visibly present in an observation or image."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Animal .

ffonto:appliedToFire a owl:ObjectProperty ;
    rdfs:label "applied to fire"@en ;
    rdfs:comment "Connects a mitigation strategy, resource allocation, or predictive model to the specific fire incident it addresses."@en ;
    rdfs:domain ffonto:SuppressionTactic ;
    rdfs:range ffonto:FireFront .

ffonto:appliesToUtility a owl:ObjectProperty ;
    rdfs:label "applies to utility" ;
    rdfs:comment "Indicates that a recovery guideline applies to a utility system." ;
    rdfs:domain ffonto:RecoveryGuideline ;
    rdfs:range ffonto:UtilitySystem .

ffonto:appliesToWater a owl:ObjectProperty ;
    rdfs:label "applies to water source" ;
    rdfs:comment "Indicates that a policy, action, or property is relevant to water resources."@en ;
    rdfs:domain ffonto:WaterSafetyAdvisory ;
    rdfs:range ffonto:WaterSource .

ffonto:assignedLabel a owl:ObjectProperty ;
    rdfs:label "assigned label" ;
    rdfs:comment "Links a LabelAssignment to the Label assigned." ;
    rdfs:domain ffonto:LabelAssignment ;
    rdfs:range ffonto:PredictedLabel .

ffonto:assignedToSection a owl:ObjectProperty ;
    rdfs:label "assigned to section"@en ;
    rdfs:comment "Inverse property mapping an Incident Command Role to its encompassing section."@en ;
    rdfs:domain ffonto:IncidentCommandRole ;
    rdfs:range ffonto:IncidentCommandSection .

ffonto:audioAttachedTo a owl:ObjectProperty ;
    rdfs:label "audio attached to" ;
    rdfs:comment "Relates AudioRecord to an ImageAsset (if attached) or to the incident." ;
    rdfs:domain ffonto:AudioRecord ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ffonto:ImageAsset ffonto:ForestFire ) ] .

ffonto:blockingRoad a owl:ObjectProperty ;
    rdfs:label "blocking road" ;
    rdfs:comment "Responder or device blocking a road." ;
    rdfs:domain ffonto:Responder ;
    rdfs:range ffonto:Road .

ffonto:burningNearRiver a owl:ObjectProperty ;
    rdfs:label "burning near river" ;
    rdfs:comment "The act or risk of burning activities occurring adjacent to riverine environments."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:River .

ffonto:burningVegetation a owl:ObjectProperty ;
    rdfs:label "burning vegetation type" ;
    rdfs:comment "Vegetation currently undergoing combustion and contributing to fire activity."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:VegetationType .

ffonto:burnsVegetation a owl:ObjectProperty ;
    rdfs:label "burns vegetation" ;
    rdfs:comment "Indicates that a wildfire burns vegetation within an ecosystem." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:Vegetation .

ffonto:causedByBurnSeverity a owl:ObjectProperty ;
    rdfs:label "caused by burn severity"@en ;
    rdfs:comment "Indicates that a secondary effect, such as soil degradation or debris flow, is a direct result of the intense heat damage from a fire."@en ;
    rdfs:domain ffonto:PostFireFloodRisk ;
    rdfs:range ffonto:BurnSeverityMap .

ffonto:causedByDisturbance a owl:ObjectProperty ;
    rdfs:label "caused by disturbance" ;
    rdfs:comment "Indicates that vegetation degradation or ecological change was caused by a disturbance." ;
    rdfs:domain ffonto:VegetationCondition ;
    rdfs:range ffonto:Disturbance .

ffonto:causesAnimalSmokeExposure a owl:ObjectProperty ;
    rdfs:label "causes animal smoke exposure" ;
    rdfs:comment "Indicates that an event or condition may expose animals to smoke and associated effects."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:AnimalSmokeExposure .

ffonto:causesCardiacIssue a owl:ObjectProperty ;
    rdfs:label "causes cardiac issue"@en ;
    rdfs:comment "Indicates that exposure to a hazard, such as severe air pollution or extreme stress, induces heart-related medical emergencies."@en ;
    rdfs:domain ffonto:ParticulateMatterPM25 ;
    rdfs:range ffonto:CardiacIssue .

ffonto:causesDisease a owl:ObjectProperty ;
    rdfs:label "causes disease"@en ;
    rdfs:comment "Indicates that an environmental hazard (like smoke inhalation) or event leads to specific health conditions or illnesses."@en ;
    rdfs:domain ffonto:AirPollutantProperty ;
    rdfs:range ffonto:RespiratoryDisease .

ffonto:causesEcologicalImpact a owl:ObjectProperty ;
    rdfs:label "causes ecological impact" ;
    rdfs:comment "Links fire behavior to ecological consequences such as erosion or habitat loss." ;
    rdfs:domain ffonto:FireBehavior ;
    rdfs:range ffonto:EcologicalImpact .

ffonto:causesHabitatLoss a owl:ObjectProperty ;
    rdfs:label "causes habitat loss" ;
    rdfs:comment "Indicates that an action or event results in loss or degradation of habitat."@en ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:HabitatLoss .

ffonto:causesHealthEffect a owl:ObjectProperty ;
    rdfs:label "causes health effect" ;
    rdfs:comment "Links pollutants to their associated health impacts." ;
    rdfs:domain ffonto:AirToxic ;
    rdfs:range ffonto:HealthEffect .


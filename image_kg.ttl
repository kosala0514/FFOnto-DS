ffonto:isFireBehaviorModelInfluencedByWeather a owl:ObjectProperty ;
    rdfs:label "is fire behavior model influenced by weather"@en ;
    rdfs:comment "Relates a predictive fire simulation to the meteorological data inputs that shape its calculations."@en ;
    rdfs:domain ffonto:FireBehaviorModel ;
    rdfs:range ffonto:WeatherFactor .

ffonto:isFireWeatherIndexInfluencedByClimateDriver a owl:ObjectProperty ;
    rdfs:label "is fire weather index influenced by climate driver"@en ;
    rdfs:comment "Connects a calculated fire danger rating to the overarching meteorological patterns affecting it."@en ;
    rdfs:domain ffonto:FireWeatherIndex ;
    rdfs:range ffonto:ClimateDriver .

ffonto:isInfluencedBy a owl:ObjectProperty ;
    rdfs:label "is influenced by climate/environmental driver" ;
    rdfs:comment "Indicates climatic or environmental conditions contributing to ignition/spread." ;
    rdfs:domain ffonto:ForestFire ;
    rdfs:range ffonto:ClimateDriver .

ffonto:isIntegratedIntoKG a owl:ObjectProperty ;
    rdfs:label "is integrated into KG"@en ;
    rdfs:comment "Relates a discrete dataset, entity, or document to the encompassing Knowledge Graph where it is semantically linked."@en ;
    rdfs:domain ffonto:SatelliteData ;
    rdfs:range ffonto:KnowledgeGraph .

ffonto:isLocationOf a owl:ObjectProperty ;
    rdfs:label "inverse of located at"@en,
        "is location of"@en ;
    rdfs:comment "A relation indicating geographic placement or position of an entity."@en,
        "Relates a spatial entity or natural feature to the event or phenomenon occurring at it."@en ;
    rdfs:domain ffonto:Observation,
        ffonto:SpatialEntity ;
    rdfs:range ffonto:ForestFire,
        ffonto:SpatialEntity ;
    owl:inverseOf ffonto:hasLocation .

ffonto:isManagedBy a owl:ObjectProperty ;
    rdfs:label "is managed by"@en ;
    rdfs:comment "Links an incident, resource, or system to the specific command role, organization, or software responsible for its oversight."@en ;
    rdfs:domain ffonto:Airspace ;
    rdfs:range ffonto:AirspaceManagement .

ffonto:isMeasuredByAQI a owl:ObjectProperty ;

    rdfs:subClassOf ffonto:Hazard .

ffonto:LeaveEarlyAdvice a ffonto:ImmediateEvacuationAction ;
    rdfs:label "Leave Early Advice" ;
    rdfs:comment "Recommendation to leave early to avoid traffic congestion and rapidly changing fire/smoke." .

ffonto:LeftFlank a owl:Class ;
    rdfs:label "Left Flank" ;
    rdfs:comment "The left lateral edge of a wildfire's active burning front."@en ;
    rdfs:subClassOf ffonto:FireFlank .

ffonto:LiDAR a owl:Class ;
    rdfs:label "LiDAR",
        "LiDAR sensor"@en ;
    rdfs:comment "A remote sensing technology that measures distance using laser light to produce terrain models."@en ;
    rdfs:subClassOf ffonto:RemoteSensor .

ffonto:LiabilityRule a owl:Class ;

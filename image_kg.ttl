    rdfs:domain ffonto:PreventionMeasure ;
    rdfs:range ffonto:WildfireIncident ;
    owl:inverseOf ffonto:isPreventedBy .

ffonto:reducesSpreadOfOf rdfs:comment "Inverse relation linking spread-reduction measures back to the targets or areas they protect."@en .

ffonto:reflectiveSignageVisible a owl:DatatypeProperty ;

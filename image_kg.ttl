    rdfs:range xsd:boolean .

ffonto:areaAcres a owl:DatatypeProperty ;
    rdfs:label "area (acres)" ;
    rdfs:comment "Perimeter-derived area in acres." ;
    rdfs:domain ffonto:PerimeterSnapshot ;
    rdfs:range xsd:decimal .

ffonto:areaHa a owl:DatatypeProperty ;
    rdfs:label "area ha",
        "area ha"@en ;
    rdfs:comment "Records the calculated spatial extent or geographic footprint of an entity or incident, measured in hectares."@en ;
    rdfs:domain ffonto:WeatherObservation ;
    rdfs:range xsd:decimal .

ffonto:ashAccumulationOnRoofOrDeck a owl:DatatypeProperty ;

    rdfs:label "Human Ignition" ;
    rdfs:comment "Ignitions resulting from human activity or infrastructure failure." ;
    rdfs:subClassOf ffonto:IgnitionCause,
        ffonto:IgnitionSource .

ffonto:LabelAssignment a owl:Class ;
    rdfs:label "Label Assignment" ;
    rdfs:comment "Represents the association of a Label to an ImageAsset, including source and count." ;
    rdfs:subClassOf ffonto:ModelOutput .

ffonto:ModelOutput a owl:Class ;
    rdfs:label "Model Output" ;
    rdfs:comment "Results produced by a model, including predictions, maps, or summary statistics."@en .

ffonto:SpatialUnit a owl:Class ;
    rdfs:label "Spatial unit" ;
    rdfs:comment "Spatial unit for measurement and observation (plot, patch, landscape unit)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ffonto:hasVegetationDistribution ;
            owl:someValuesFrom ffonto:VegetationDistribution ] .

ffonto:ClimateDriver a owl:Class ;
    rdfs:label "Climate Driver" ;
    rdfs:comment "Climate-related conditions that influence wildfire probability and behavior." .

ffonto:EvacuationAction a owl:Class ;
    rdfs:label "Evacuation Action" ;
    rdfs:comment "Actions and procedures for safe evacuation (routes, kits, sheltering)." .

ffonto:PopulationGroup a owl:Class ;
    rdfs:label "Population Group" ;
    rdfs:comment "Group of people potentially affected by wildfire smoke." .

ffonto:ProtectiveAction a owl:Class ;
    rdfs:label "Protective Action" ;
    rdfs:comment "An action recommended to protect people from wildfire smoke or fire-related hazards." .

ffonto:SmokeObservation a owl:Class ;
    rdfs:label "Smoke Observation" ;
    rdfs:comment "An observation indicating the presence of smoke within an environmental image, which may suggest an ongoing fire or combustion event." ;
    rdfs:subClassOf ffonto:ImageObservation .

ffonto:UAV a owl:Class ;
    rdfs:label "Uncrewed Aerial Vehicle (UAV) / Drone",
        "Unmanned Aerial Vehicle"@en,
        "Unmanned aerial vehicle"@en ;
    rdfs:comment "An aircraft without a human pilot used for aerial wildfire monitoring and data collection."@en ;
    rdfs:subClassOf ffonto:SensorPlatform .

ffonto:WeatherObservation a owl:Class ;
    rdfs:label "Weather Observation" ;
    rdfs:comment "Meteorological measurements at the incident site." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:CombustionProcess a owl:Class ;
    rdfs:label "Combustion Process" ;
    rdfs:comment "Chemical process of burning fuel that produces smoke, gases, and heat during wildfires." ;
    rdfs:subClassOf ffonto:PhysicalProcess .

ffonto:EcosystemService a owl:Class ;
    rdfs:label "Ecosystem Service" ;
    rdfs:comment "The benefits provided by ecosystems that support environmental health and human well-being." .

ffonto:EnvironmentalCondition a owl:Class ;
    rdfs:label "Environmental Condition" ;
    rdfs:comment "A physical environmental factor that influences ecological processes, such as temperature, moisture, or snow cover." .

ffonto:VisionModelScores a owl:Class ;
    rdfs:label "Vision Model Scores" ;
    rdfs:comment "Scores produced by a vision classifier/model (fire/smoke/no-fire etc.) and the producing model name/version." ;
    owl:subClassOf ffonto:ModelOutput .

ffonto:FireRiskAssessment a owl:Class ;
    rdfs:label "Fire Risk Assessment",
        "ForestFire Risk Assessment" ;
    rdfs:comment "Assessment of risk to infrastructure, people, and environment.",
        "Processes and outputs used to evaluate wildfire likelihood and consequences." .

ffonto:ResponseOrganization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization providing health or wildfire safety information." .

ffonto:SoilCondition a owl:Class ;
    rdfs:label "Soil Condition" ;
    rdfs:comment "Characteristics of soil such as moisture and nutrient content.",
        "Physical and chemical characteristics of soil that influence vegetation growth and ecosystem health." ;
    rdfs:subClassOf ffonto:EnvironmentalCondition,
        ffonto:EnvironmentalFactor .

ffonto:SpatialEntity a owl:Class ;
    rdfs:label "Spatial entity"@en ;
    rdfs:comment "An entity that exists in physical or geographic space and can have a spatial location or geometry."@en ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:FireBehaviorModel a owl:Class ;
    rdfs:label "Fire Behavior Model" ;
    rdfs:comment "A model that simulates the spread, intensity, and effects of fire under various conditions."@en ;
    rdfs:subClassOf ffonto:SimulationModel .

ffonto:PreparednessItem a owl:Class ;
    rdfs:label "Preparedness Item" ;
    rdfs:comment "Items included in emergency preparedness kits." .

ffonto:PublicSafetyGuidance a owl:Class ;
    rdfs:label "Public Safety Guidance" ;
    rdfs:comment "Advice for drivers/evacuees and general safety Q&A." .

ffonto:FireFront a owl:Class ;
    rdfs:label "Fire Front" ;
    rdfs:comment "Leading edge of the wildfire." ;
    rdfs:subClassOf geo:SpatialObject .

ffonto:HealthRisk a owl:Class ;
    rdfs:label "Health Risk" ;
    rdfs:comment "Health risk caused by wildfire smoke exposure." .

ffonto:AudioObservation a owl:Class ;
    rdfs:label "Audio Observation" ;
    rdfs:comment "Observation derived from audio captured at the wildfire scene." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:EcologicalEffect a owl:Class ;
    rdfs:label "Ecological Effect" ;
    rdfs:comment "The physical, chemical, or biological changes in an ecosystem resulting from a fire event." .

ffonto:ForestEcosystem a owl:Class ;
    rdfs:label "Forest Ecosystem" ;
    rdfs:comment "An ecosystem dominated by trees and woody vegetation." ;
    rdfs:subClassOf ffonto:Ecosystem .

ffonto:WaterBody a owl:Class ;
    rdfs:label "Water Body" ;
    rdfs:comment "A natural accumulation of water such as lakes or rivers." ;
    rdfs:subClassOf ffonto:LandscapeFeature .

ffonto:StructureFire a owl:Class ;
    rdfs:label "Structure Fire" ;
    rdfs:comment "Fire involving buildings / infrastructure (houses, outbuildings)." ;
    rdfs:subClassOf ffonto:ForestFire .

ffonto:Vehicle a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:comment "Ground vehicles used in wildfire operations." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:comment "A constructed structure such as a house or garage." ;
    rdfs:subClassOf ffonto:Infrastructure .

geo:SpatialObject rdfs:label "Spatial object"@en ;
    rdfs:comment "An entity that has a spatial representation or location in geographic space."@en .

ffonto:FireBehavior a owl:Class ;
    rdfs:label "Fire Behavior" ;
    rdfs:comment "Characteristics describing how a fire behaves and spreads." .

ffonto:Responder a owl:Class ;
    rdfs:label "Responder" ;
    rdfs:comment "Emergency personnel responding to wildfire incidents." .

ffonto:WildfireIncident a owl:Class ;
    rdfs:label "wildfire incident"@en ;
    rdfs:comment "An uncontrolled fire occurring in nature that requires an emergency response."@en .

ffonto:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure" ;
    rdfs:comment "Human-built structures within natural landscapes.",
        "Temporary or permanent structures used during wildfire response." ;
    rdfs:subClassOf ffonto:SceneElement .

ffonto:ImageObservation a owl:Class ;
    rdfs:label "Image observation" ;
    rdfs:comment "Observation derived from imagery analysis with provenance and confidence metadata." ;
    rdfs:subClassOf ffonto:Observation .

ffonto:Firefighter a owl:Class ;
    rdfs:label "Firefighter" ;
    rdfs:comment "Wildland or structural firefighters engaged in suppression operations." ;
    rdfs:subClassOf ffonto:Responder .

ffonto:Ecosystem a owl:Class ;
    rdfs:label "Ecosystem" ;
    rdfs:comment "A biological community interacting with its physical environment." .

ffonto:Vegetation a owl:Class ;
    rdfs:label "Vegetation" ;
    rdfs:comment "Plant life present in a forest ecosystem including trees, shrubs, and grasses." ;
    rdfs:subClassOf ffonto:SceneElement .

ffonto:Hazard a owl:Class ;
    rdfs:label "Hazard" ;
    rdfs:comment "A dangerous condition present during wildfire operations." .

ffonto:Road a owl:Class ;
    rdfs:label "Road" ;
    rdfs:comment "Transportation pathway crossing natural landscapes." ;
    rdfs:subClassOf ffonto:Infrastructure .

ffonto:WildfireScene a owl:Class ;
    rdfs:label "Wildfire Scene" ;
    rdfs:comment "The environmental context where a wildfire event occurs and observations are made." .

ffonto:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "An observation or record about conditions at a wildfire scene." .

ffonto:ForestFire a owl:Class ;
    rdfs:label "Forest Fire" ;
    rdfs:comment "An uncontrolled fire occurring in natural vegetation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ffonto:hasIgnitionSource ;
            owl:someValuesFrom ffonto:IgnitionSource ],
        [ a owl:Restriction ;
            owl:onProperty ffonto:hasBurnSeverity ;
            owl:someValuesFrom ffonto:FireSeverity ],
        [ a owl:Restriction ;
            owl:onClass ffonto:ForestEcosystem ;
            owl:onProperty ffonto:occursIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:altLabel "Wildfire" .

ffonto:smoke a ffonto:ObservableProperty ;
    rdfs:label "smoke" .

ffonto:fire a ffonto:ObservableProperty ;
    rdfs:label "fire" .

ffonto:TextAnnotation a owl:Class .

ffonto:MediaAsset a owl:Class .


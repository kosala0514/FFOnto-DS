    rdfs:comment "A single occurrence of lightning contacting the ground or an object."@en ;
    rdfs:subClassOf ffonto:NaturalCause,
        ffonto:NaturalIgnition .

ffonto:Lignin a ffonto:VegetationChemicalComponent ;
    rdfs:label "Lignin" .

ffonto:LitterFuel a owl:Class ;

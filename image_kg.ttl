    rdfs:subClassOf ffonto:ClimateDriver .

ffonto:PublicEducation a ffonto:PreventionMethod ;
    rdfs:label "Public Education" ;
    rdfs:comment "Awareness campaigns aimed at reducing accidental fire ignition." .

ffonto:PublicReporting a owl:Class ;
